---
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  bodyClass?: string;
  schema?: any;
  preloadImage?: string;
}

const {
  title = "SKYNODESUAV | Premium RC Flight Systems & Aeromodels",
  description = "Shop genuine Futaba Radios, O.S. Engines, DLE Gas Engines, Seagull ARF Aeromodels, and Balsa Wood sheets.",
  canonicalUrl,
  bodyClass = "",
  schema,
  preloadImage
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

  <!-- Preconnect to Font CDNs for Instant Handshake -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Preload High-Priority LCP Hero Image if specified -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <!-- Asynchronous Non-Blocking Google Fonts Loading -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@400;500;600;700;800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@400;500;600;700;800&display=swap" />
  </noscript>

  <GoogleTagManagerHead />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class={bodyClass}>
  <GoogleTagManagerBody />

  <Header />

  <slot />

  <CartDrawer />
  <MobileBottomNav />
  <Footer />
</body>
</html>
