---
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import FaviconAndSeoHead from '../components/FaviconAndSeoHead.astro';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  bodyClass?: string;
  schema?: any;
  preloadImage?: string;
}

const {
  title = "SKYNODESUAV | Premium RC Flight Systems & Aeromodels",
  description = "Shop genuine Futaba Radios, O.S. Engines, DLE Gas Engines, Seagull ARF Aeromodels, and Balsa Wood sheets.",
  canonicalUrl,
  bodyClass = "",
  schema,
  preloadImage
} = Astro.props;

// Explicitly send X-Robots-Tag: all for search engines
Astro.response.headers.set('X-Robots-Tag', 'all');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <FaviconAndSeoHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

  <!-- Search Engine Crawling & Robots Directives -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Preload High-Priority LCP Hero Image if specified -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <GoogleTagManagerHead />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class={bodyClass}>
  <GoogleTagManagerBody />

  <Header />

  <slot />

  <CartDrawer />
  <MobileBottomNav />
  <Footer />
</body>
</html>
