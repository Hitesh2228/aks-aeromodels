---
import { CATEGORIES } from '../data/products';
---

<section class="bellavita-categories-section">
  <div class="container">
    <h2 class="bellavita-title">LUXURY CATEGORIES</h2>

    <div class="category-cards-grid">
      {CATEGORIES.map(cat => (
        <a href={`/shop?category=${cat.id}`} class="category-card-item">
          <div class="cat-icon-card">
            <span class="cat-icon">{cat.icon}</span>
          </div>
          <span class="cat-label">{cat.label.toUpperCase()}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .bellavita-categories-section {
    padding: 3.5rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  .category-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    justify-content: center;
  }
  .category-card-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    transition: var(--transition-smooth);
  }
  .category-card-item:hover {
    transform: translateY(-4px);
  }
  .cat-icon-card {
    width: 130px;
    height: 130px;
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: var(--transition-fast);
  }
  .category-card-item:hover .cat-icon-card {
    background: #ffffff;
    border-color: #1a1a1a;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }
  .cat-icon {
    font-size: 2.8rem;
  }
  .cat-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: 0.05em;
    text-align: center;
  }
</style>
