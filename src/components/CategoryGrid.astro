---
const CATEGORY_ITEMS = [
  { 
    id: 'engine', 
    label: 'GAS ENGINES', 
    image: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=400&auto=format&fit=crop'
  },
  { 
    id: 'radio-receiver', 
    label: 'RADIOS & RECEIVERS', 
    image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=400&auto=format&fit=crop'
  },
  { 
    id: 'aeromodels', 
    label: 'SEAGULL AEROMODELS', 
    image: 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400&auto=format&fit=crop'
  },
  { 
    id: 'balsa-wood', 
    label: 'BALSA WOOD', 
    image: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=400&auto=format&fit=crop'
  },
  { 
    id: 'accessories', 
    label: 'FLIGHT ACCESSORIES', 
    image: 'https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=400&auto=format&fit=crop'
  },
  { 
    id: 'accessories', 
    label: 'PROPELLER TOOLS', 
    image: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=400&auto=format&fit=crop'
  },
];
---

<section class="bellavita-categories-section">
  <div class="container">
    <h2 class="bellavita-title">LUXURY CATEGORIES</h2>

    <div class="category-cards-grid">
      {CATEGORY_ITEMS.map(cat => (
        <a href={`/shop?category=${cat.id}`} class="category-card-item">
          <div class="cat-img-box">
            <img src={cat.image} alt={cat.label} loading="lazy" />
          </div>
          <span class="cat-label">{cat.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .bellavita-categories-section {
    padding: 3rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .category-cards-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }
  .category-card-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .category-card-item:hover {
    transform: translateY(-4px);
  }
  .cat-img-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f5f4f0;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border: 1px solid #e6e0d5;
    transition: all 0.3s ease;
  }
  .category-card-item:hover .cat-img-box {
    border-color: #3b0811;
    background: #ffffff;
    box-shadow: 0 8px 25px rgba(59, 8, 17, 0.1);
  }
  .cat-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  .cat-label {
    font-family: var(--font-main);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    text-align: center;
  }

  @media (max-width: 768px) {
    .bellavita-categories-section {
      padding: 2rem 0;
    }
    .category-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 1.25rem;
    }
    .cat-label {
      font-size: 0.72rem;
    }
  }
</style>
