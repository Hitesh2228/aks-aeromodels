---
import { CATEGORIES } from '../data/products';
---

<section class="categories-section">
  <div class="container">
    <h2 class="section-title">AEROMODELLING CATEGORIES</h2>
    <p class="section-subtitle">Discover world-class engines, aircraft airframes, and precision flight hardware</p>

    <div class="category-grid">
      {CATEGORIES.map(cat => (
        <a href={`/shop?category=${cat.id}`} class="category-card glass-panel">
          <div class="category-icon-circle">
            <span class="cat-icon">{cat.icon}</span>
          </div>
          <h3 class="category-name">{cat.label}</h3>
          <p class="category-desc">{cat.description}</p>
          <span class="explore-btn">EXPLORE <span>→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categories-section {
    padding: 4.5rem 0;
    background: #090a0e;
    border-bottom: 1px solid var(--border-subtle);
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .category-card {
    padding: 2rem 1.25rem;
    border-radius: var(--radius-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: var(--transition-smooth);
    position: relative;
    overflow: hidden;
  }
  .category-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    opacity: 0;
    transition: var(--transition-fast);
  }
  .category-card:hover {
    transform: translateY(-6px);
    border-color: rgba(230, 200, 117, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(230, 200, 117, 0.1);
  }
  .category-card:hover::before {
    opacity: 1;
  }
  .category-icon-circle {
    width: 76px;
    height: 76px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-glow);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    box-shadow: inset 0 0 15px rgba(230, 200, 117, 0.1);
    transition: var(--transition-fast);
  }
  .category-card:hover .category-icon-circle {
    background: linear-gradient(135deg, rgba(230, 200, 117, 0.2), rgba(255, 255, 255, 0.05));
    transform: scale(1.08);
  }
  .cat-icon {
    font-size: 2.2rem;
  }
  .category-name {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: #fff;
  }
  .category-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .explore-btn {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-gold);
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
