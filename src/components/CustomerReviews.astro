---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Simran Narang",
    handle: "simrannaranggg",
    rating: 5,
    text: "One of the best luxury aeromodelling stores and that too at an affordable price",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Pulkit Bangia",
    handle: "pulkitbangia",
    rating: 5,
    text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Ananya Roy",
    handle: "ananya_rc_flier",
    rating: 5,
    text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
    avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Karan Malhotra",
    handle: "karan_rc_pilot",
    rating: 5,
    text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  }
];

// Create 3x cloned array for seamless infinite physical gliding carousel
const LOOP_REVIEWS = [...REVIEWS, ...REVIEWS, ...REVIEWS];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage">
      
      <!-- 5-Avatar Gliding Carousel (Desktop 5 Avatars / Mobile 3 Avatars) -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatar-slider-viewport">
          <div class="avatar-track-flex" id="avatar-track-flex">
            {LOOP_REVIEWS.map((rev, idx) => (
              <div 
                class="avatar-card-item" 
                data-index={idx}
                data-real-index={idx % REVIEWS.length}
              >
                <img src={rev.avatar} alt={rev.name} loading="lazy" />
              </div>
            ))}
          </div>
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Exact Bellavita Style) -->
      <div class="center-review-content" id="review-content-box">
        <div class="stars-gold-center">★★★★★</div>
        <p class="review-quote-text" id="rev-quote-display">
          "{REVIEWS[0].text}"
        </p>
        <div class="review-author-name" id="rev-author-display">
          – {REVIEWS[0].name}
        </div>
        <div class="review-social-handle" id="rev-handle-display">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span id="handle-text">{REVIEWS[0].handle}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 3rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3.5rem;
    color: #111111;
    font-weight: 600;
  }

  .bellavita-review-stage {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Carousel Layout Container */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.4rem;
    color: #555555;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    user-select: none;
    flex-shrink: 0;
    opacity: 0.7;
    z-index: 10;
  }
  .carousel-arrow:hover {
    color: #111111;
    opacity: 1;
    transform: scale(1.3);
  }

  /* Viewport Window (Desktop: 480px fits exactly 5 avatars) */
  .avatar-slider-viewport {
    width: 480px;
    height: 130px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
  }

  /* Physical Gliding Flex Track (GPU Accelerated Translation) */
  .avatar-track-flex {
    display: flex;
    align-items: center;
    gap: 2rem;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -65px; /* Half of viewport height */
    height: 130px;
  }

  /* Individual Avatar Cards with Smooth Scale, Width & Opacity Animations */
  .avatar-card-item {
    cursor: pointer;
    overflow: hidden;
    transition: width 0.45s cubic-bezier(0.25, 1, 0.5, 1),
                height 0.45s cubic-bezier(0.25, 1, 0.5, 1),
                border-radius 0.45s ease,
                opacity 0.45s ease,
                box-shadow 0.45s ease;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    user-select: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    opacity: 0.4;
  }
  .avatar-card-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Card Positional States */
  .avatar-card-item.state-center {
    width: 110px !important;
    height: 110px !important;
    border-radius: 28px !important;
    opacity: 1 !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    border: 2px solid #ffffff;
    z-index: 5;
  }

  .avatar-card-item.state-near {
    width: 70px !important;
    height: 70px !important;
    border-radius: 20px !important;
    opacity: 0.75 !important;
    z-index: 3;
  }

  .avatar-card-item.state-far {
    width: 48px !important;
    height: 48px !important;
    border-radius: 14px !important;
    opacity: 0.4 !important;
    z-index: 1;
  }

  .avatar-card-item:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box */
  .center-review-content {
    text-align: center;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Responsive Adjustments (< 768px Mobile: Viewport 226px fits EXACTLY 3 Avatars) */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.4rem;
      margin-bottom: 1.75rem;
    }
    .avatar-slider-viewport {
      width: 226px;
      height: 95px;
    }
    .avatar-track-flex {
      gap: 1rem;
      margin-top: -47px;
      height: 95px;
    }
    .avatar-card-item.state-center {
      width: 82px !important;
      height: 82px !important;
      border-radius: 22px !important;
    }
    .avatar-card-item.state-near {
      width: 54px !important;
      height: 54px !important;
      border-radius: 16px !important;
    }
    .avatar-card-item.state-far {
      width: 36px !important;
      height: 36px !important;
      border-radius: 10px !important;
      opacity: 0.25 !important;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price"
    },
    {
      name: "Simran Narang",
      handle: "simrannaranggg",
      text: "One of the best luxury aeromodelling stores and that too at an affordable price"
    },
    {
      name: "Pulkit Bangia",
      handle: "pulkitbangia",
      text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well."
    },
    {
      name: "Ananya Roy",
      handle: "ananya_rc_flier",
      text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier."
    },
    {
      name: "Karan Malhotra",
      handle: "karan_rc_pilot",
      text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time."
    }
  ];

  function initPhysicalGlidingSlider() {
    const N = reviewsData.length;
    // Start at middle cloned set index 5 (Sanna Thakur)
    let currentGlobalIndex = N; 

    const viewport = document.querySelector('.avatar-slider-viewport') as HTMLElement;
    const trackFlex = document.getElementById('avatar-track-flex');
    const cards = document.querySelectorAll('.avatar-card-item');
    const contentBox = document.getElementById('review-content-box');
    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');

    if (!trackFlex || cards.length === 0 || !viewport) return;

    function updateGlidingPosition(animate = true) {
      if (!trackFlex || !viewport) return;

      const targetCard = cards[currentGlobalIndex] as HTMLElement;
      if (!targetCard) return;

      // Update card positional state classes FIRST so their dimensions update
      cards.forEach((card, idx) => {
        card.classList.remove('state-center', 'state-near', 'state-far');
        const diff = Math.abs(idx - currentGlobalIndex);
        if (diff === 0) {
          card.classList.add('state-center');
        } else if (diff === 1) {
          card.classList.add('state-near');
        } else {
          card.classList.add('state-far');
        }
      });

      // Calculate physical track translateX so active card sits at EXACT CENTER of viewport
      const viewportWidth = viewport.offsetWidth;
      const cardOffsetLeft = targetCard.offsetLeft;
      const cardWidth = targetCard.offsetWidth;

      // Shift track so card center aligns with viewport center
      const centerShift = cardOffsetLeft + (cardWidth / 2) - (viewportWidth / 2);

      if (!animate) {
        trackFlex.style.transition = 'none';
      } else {
        trackFlex.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
      }

      trackFlex.style.transform = `translateX(-${centerShift}px)`;

      // Smoothly update quote content below
      const realIdx = currentGlobalIndex % N;
      const activeRev = reviewsData[realIdx];

      if (activeRev && contentBox) {
        contentBox.style.opacity = '0.3';
        contentBox.style.transform = 'translateY(4px)';

        setTimeout(() => {
          if (quoteDisplay) quoteDisplay.textContent = `"${activeRev.text}"`;
          if (authorDisplay) authorDisplay.textContent = `– ${activeRev.name}`;
          if (handleDisplay) handleDisplay.textContent = activeRev.handle;

          contentBox.style.opacity = '1';
          contentBox.style.transform = 'translateY(0)';
        }, 140);
      }
    }

    function goToIndex(newIndex: number) {
      currentGlobalIndex = newIndex;
      updateGlidingPosition(true);

      // Infinite loop boundary reset seamlessly
      if (currentGlobalIndex >= N * 2) {
        setTimeout(() => {
          currentGlobalIndex -= N;
          updateGlidingPosition(false);
        }, 460);
      } else if (currentGlobalIndex < N) {
        setTimeout(() => {
          currentGlobalIndex += N;
          updateGlidingPosition(false);
        }, 460);
      }
    }

    // Next Arrow (Sanna Thakur -> Simran Narang -> Pulkit Bangia)
    nextBtn?.addEventListener('click', () => {
      goToIndex(currentGlobalIndex + 1);
    });

    // Prev Arrow
    prevBtn?.addEventListener('click', () => {
      goToIndex(currentGlobalIndex - 1);
    });

    // Avatar Card Click
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        goToIndex(idx);
      });
    });

    // Touch Swipe Gesture for Mobile
    let startX = 0;
    let endX = 0;

    trackFlex.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    trackFlex.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (diff > 35) {
        goToIndex(currentGlobalIndex + 1);
      } else if (diff < -35) {
        goToIndex(currentGlobalIndex - 1);
      }
    }, { passive: true });

    // Auto rotate every 4.5 seconds
    setInterval(() => {
      goToIndex(currentGlobalIndex + 1);
    }, 4500);

    // Initial positioning
    requestAnimationFrame(() => {
      updateGlidingPosition(false);
    });
  }

  // Auto initialize on DOM and Astro page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPhysicalGlidingSlider);
  } else {
    initPhysicalGlidingSlider();
  }
  document.addEventListener('astro:page-load', initPhysicalGlidingSlider);
</script>
