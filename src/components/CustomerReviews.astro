---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Capt. Rajesh Sharma",
    handle: "rajesh_aviator",
    rating: 5,
    text: "Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty! Fast dispatch to Mumbai in 24 hours.",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Vikramaditya Rao",
    handle: "vikram_rc_flier",
    rating: 5,
    text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Pooja Deshmukh",
    handle: "pooja_rc_pilot",
    rating: 5,
    text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Aman Verma",
    handle: "aman_balsa_builder",
    rating: 5,
    text: "Top-notch AAA grade balsa sheets! Consistent grain density for contest build models. Best aeromodelling store in India.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage">
      
      <!-- 5 Avatar Ring Carousel with Left & Right Arrows -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatar-ring-row" id="avatar-ring-container">
          <!-- Slot 0: Far Left -->
          <div class="avatar-slot slot-far-left" id="slot-0" data-slot="0">
            <img src={REVIEWS[3].avatar} alt={REVIEWS[3].name} />
          </div>
          <!-- Slot 1: Near Left -->
          <div class="avatar-slot slot-near-left" id="slot-1" data-slot="1">
            <img src={REVIEWS[4].avatar} alt={REVIEWS[4].name} />
          </div>
          <!-- Slot 2: CENTER ZOOMED -->
          <div class="avatar-slot slot-center" id="slot-2" data-slot="2">
            <img src={REVIEWS[0].avatar} alt={REVIEWS[0].name} />
          </div>
          <!-- Slot 3: Near Right -->
          <div class="avatar-slot slot-near-right" id="slot-3" data-slot="3">
            <img src={REVIEWS[1].avatar} alt={REVIEWS[1].name} />
          </div>
          <!-- Slot 4: Far Right -->
          <div class="avatar-slot slot-far-right" id="slot-4" data-slot="4">
            <img src={REVIEWS[2].avatar} alt={REVIEWS[2].name} />
          </div>
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Exact Bellavita Style) -->
      <div class="center-review-content">
        <div class="stars-gold-center">★★★★★</div>
        <p class="review-quote-text" id="rev-quote-display">
          "{REVIEWS[0].text}"
        </p>
        <div class="review-author-name" id="rev-author-display">
          – {REVIEWS[0].name}
        </div>
        <div class="review-social-handle" id="rev-handle-display">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span id="handle-text">{REVIEWS[0].handle}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 2.5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3rem;
    color: #1a1a1a;
    font-weight: 700;
  }

  .bellavita-review-stage {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 5-Avatar Ring Carousel Row */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    width: 100%;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.6rem;
    color: #333333;
    cursor: pointer;
    padding: 0.5rem 0.85rem;
    transition: transform 0.2s ease, color 0.2s ease;
    user-select: none;
    flex-shrink: 0;
  }
  .carousel-arrow:hover {
    color: #1a1a1a;
    transform: scale(1.25);
  }

  .avatar-ring-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    height: 130px;
    width: 100%;
  }

  /* Squircle Avatar Slots */
  .avatar-slot {
    cursor: pointer;
    overflow: hidden;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .avatar-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  /* Slot 2: CENTER ZOOMED (Exact Bellavita Match) */
  .avatar-slot.slot-center {
    width: 115px;
    height: 115px;
    border-radius: 28px;
    opacity: 1;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.16);
    border: 2px solid #ffffff;
    z-index: 5;
  }

  /* Slot 1 & 3: Near Left & Near Right */
  .avatar-slot.slot-near-left,
  .avatar-slot.slot-near-right {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    opacity: 0.75;
    z-index: 3;
  }

  /* Slot 0 & 4: Far Left & Far Right */
  .avatar-slot.slot-far-left,
  .avatar-slot.slot-far-right {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    opacity: 0.45;
    z-index: 1;
  }

  .avatar-slot:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box */
  .center-review-content {
    text-align: center;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.25rem;
    letter-spacing: 0.15em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.65;
    margin: 0;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Mobile Responsive Adjustments (< 768px) */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 1.75rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .carousel-arrow {
      font-size: 1.25rem;
      padding: 0.25rem;
    }
    .avatar-ring-row {
      gap: 1.1rem;
      height: 95px;
    }
    .avatar-slot.slot-center {
      width: 85px;
      height: 85px;
      border-radius: 22px;
    }
    .avatar-slot.slot-near-left,
    .avatar-slot.slot-near-right {
      width: 54px;
      height: 54px;
      border-radius: 16px;
    }
    .avatar-slot.slot-far-left,
    .avatar-slot.slot-far-right {
      width: 38px;
      height: 38px;
      border-radius: 10px;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price"
    },
    {
      name: "Capt. Rajesh Sharma",
      handle: "rajesh_aviator",
      text: "Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty! Fast dispatch to Mumbai in 24 hours."
    },
    {
      name: "Vikramaditya Rao",
      handle: "vikram_rc_flier",
      text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!"
    },
    {
      name: "Pooja Deshmukh",
      handle: "pooja_rc_pilot",
      text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!"
    },
    {
      name: "Aman Verma",
      handle: "aman_balsa_builder",
      text: "Top-notch AAA grade balsa sheets! Consistent grain density for contest build models. Best aeromodelling store in India."
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    let centerIndex = 0; // Initial center review: Sanna Thakur
    const N = reviewsData.length;

    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');

    const slotEls = [
      document.getElementById('slot-0'),
      document.getElementById('slot-1'),
      document.getElementById('slot-2'),
      document.getElementById('slot-3'),
      document.getElementById('slot-4')
    ];

    function updateCarousel() {
      // Calculate active review indices for 5 slots: [far-left, near-left, center, near-right, far-right]
      const slotIndices = [
        (centerIndex - 2 + N) % N,
        (centerIndex - 1 + N) % N,
        centerIndex,
        (centerIndex + 1) % N,
        (centerIndex + 2) % N
      ];

      slotIndices.forEach((revIdx, slotPos) => {
        const slotEl = slotEls[slotPos];
        const imgEl = slotEl?.querySelector('img');
        if (slotEl && imgEl) {
          // Smooth fade transition
          imgEl.style.opacity = '0.3';
          setTimeout(() => {
            imgEl.src = reviewsData[revIdx].avatar;
            imgEl.alt = reviewsData[revIdx].name;
            imgEl.style.opacity = '1';
          }, 150);
        }
      });

      // Update center quote text & metadata
      const activeRev = reviewsData[centerIndex];
      if (activeRev) {
        if (quoteDisplay) quoteDisplay.textContent = `"${activeRev.text}"`;
        if (authorDisplay) authorDisplay.textContent = `– ${activeRev.name}`;
        if (handleDisplay) handleDisplay.textContent = activeRev.handle;
      }
    }

    // Next arrow (Slides right -> next image moves to center)
    nextBtn?.addEventListener('click', () => {
      centerIndex = (centerIndex + 1) % N;
      updateCarousel();
    });

    // Prev arrow (Slides left -> prev image moves to center)
    prevBtn?.addEventListener('click', () => {
      centerIndex = (centerIndex - 1 + N) % N;
      updateCarousel();
    });

    // Clicking any visible slot moves that slot's image to the center!
    slotEls.forEach((slotEl, slotPos) => {
      slotEl?.addEventListener('click', () => {
        if (slotPos === 0) centerIndex = (centerIndex - 2 + N) % N;
        else if (slotPos === 1) centerIndex = (centerIndex - 1 + N) % N;
        else if (slotPos === 2) return; // Already center
        else if (slotPos === 3) centerIndex = (centerIndex + 1) % N;
        else if (slotPos === 4) centerIndex = (centerIndex + 2) % N;

        updateCarousel();
      });
    });

    // Touch Swipe Support for Mobile
    const track = document.getElementById('avatar-ring-container');
    let startX = 0;
    let endX = 0;

    track?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    track?.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (diff > 40) {
        // Swiped Left -> Next Image to Center
        centerIndex = (centerIndex + 1) % N;
        updateCarousel();
      } else if (diff < -40) {
        // Swiped Right -> Prev Image to Center
        centerIndex = (centerIndex - 1 + N) % N;
        updateCarousel();
      }
    }, { passive: true });

    // Auto-rotate timer every 4.5 seconds
    setInterval(() => {
      centerIndex = (centerIndex + 1) % N;
      updateCarousel();
    }, 4500);
  });
</script>
