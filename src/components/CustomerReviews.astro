---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    name: "Capt. Rajesh Sharma",
    handle: "@rajesh_aviator",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry in India. Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty!",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Vikramaditya Rao",
    handle: "@vikram_rc_flier",
    rating: 5,
    text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Sameer Deshmukh",
    handle: "@sameer_rc_pilot",
    rating: 5,
    text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR PILOTS HAVE TO SAY</h2>

    <div class="slider-wrapper-relative">
      <button class="slider-arrow prev-btn" id="reviews-slider-prev" aria-label="Previous Testimonial">‹</button>

      <!-- Avatar Selection Strip -->
      <div class="avatars-row">
        {REVIEWS.map((rev, i) => (
          <div class={`avatar-item ${i === 0 ? 'active' : ''}`} data-index={i}>
            <img src={rev.avatar} alt={rev.name} />
          </div>
        ))}
      </div>

      <!-- Active Quote Box -->
      <div class="active-quote-box">
        <div class="stars-gold">★★★★★</div>
        <p class="quote-text" id="quote-text-display">"{REVIEWS[0].text}"</p>
        <div class="quote-author" id="quote-author-display">– {REVIEWS[0].name}</div>
        <div class="quote-handle" id="quote-handle-display">{REVIEWS[0].handle}</div>
      </div>

      <button class="slider-arrow next-btn" id="reviews-slider-next" aria-label="Next Testimonial">›</button>
    </div>

  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4rem 0 1rem;
    background: #fbf9f5;
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .slider-wrapper-relative {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }

  .slider-arrow {
    position: absolute;
    top: 55%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid #1a1a1a;
    border-radius: 50%;
    color: #1a1a1a;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }
  .slider-arrow:hover {
    background: #1a1a1a;
    color: #ffffff;
  }
  .slider-arrow.prev-btn { left: -20px; }
  .slider-arrow.next-btn { right: -20px; }

  .avatars-row {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .avatar-item {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    transition: var(--transition-fast);
    border: 2px solid transparent;
  }
  .avatar-item.active, .avatar-item:hover {
    opacity: 1;
    transform: scale(1.15);
    border-color: #3b0811;
  }
  .avatar-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .active-quote-box {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 1.5rem;
    padding: 2rem;
    background: #ffffff;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  .stars-gold {
    color: #f59e0b;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .quote-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }
  .quote-author {
    font-weight: 800;
    font-size: 0.95rem;
    color: #1a1a1a;
  }
  .quote-handle {
    font-size: 0.8rem;
    color: #777777;
  }

  @media (max-width: 768px) {
    .bellavita-reviews-section { padding: 2rem 0 1rem; }
    .bellavita-title { font-size: 1.2rem; margin-bottom: 1.25rem; }

    .slider-arrow.prev-btn { left: -8px; width: 34px; height: 34px; font-size: 1.2rem; }
    .slider-arrow.next-btn { right: -8px; width: 34px; height: 34px; font-size: 1.2rem; }

    .avatars-row { gap: 1rem; margin-bottom: 1.25rem; }
    .avatar-item { width: 52px; height: 52px; }
    .active-quote-box { padding: 1.25rem 1rem; }
    .quote-text { font-size: 0.95rem; margin-bottom: 0.75rem; }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Capt. Rajesh Sharma",
      handle: "@rajesh_aviator",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry in India. Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty!"
    },
    {
      name: "Vikramaditya Rao",
      handle: "@vikram_rc_flier",
      text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!"
    },
    {
      name: "Sameer Deshmukh",
      handle: "@sameer_rc_pilot",
      text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!"
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const avatarItems = document.querySelectorAll('.avatar-item');
    const textEl = document.getElementById('quote-text-display');
    const authorEl = document.getElementById('quote-author-display');
    const handleEl = document.getElementById('quote-handle-display');
    const prevBtn = document.getElementById('reviews-slider-prev');
    const nextBtn = document.getElementById('reviews-slider-next');
    let currentIndex = 0;

    function selectReview(idx: number) {
      avatarItems.forEach(a => a.classList.remove('active'));
      avatarItems[idx]?.classList.add('active');

      const rev = reviewsData[idx];
      if (rev && textEl && authorEl && handleEl) {
        textEl.textContent = `"${rev.text}"`;
        authorEl.textContent = `– ${rev.name}`;
        handleEl.textContent = rev.handle;
      }
      currentIndex = idx;
    }

    avatarItems.forEach((item, idx) => {
      item.addEventListener('click', () => selectReview(idx));
    });

    prevBtn?.addEventListener('click', () => {
      const prevIdx = (currentIndex - 1 + reviewsData.length) % reviewsData.length;
      selectReview(prevIdx);
    });

    nextBtn?.addEventListener('click', () => {
      const nextIdx = (currentIndex + 1) % reviewsData.length;
      selectReview(nextIdx);
    });

    // Auto-rotate testimonials slider every 4.5 seconds
    setInterval(() => {
      const nextIndex = (currentIndex + 1) % reviewsData.length;
      selectReview(nextIndex);
    }, 4500);
  });
</script>
