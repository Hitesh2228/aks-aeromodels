---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Simran Narang",
    handle: "simrannaranggg",
    rating: 5,
    text: "One of the best luxury aeromodelling stores and that too at an affordable price",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Pulkit Bangia",
    handle: "pulkitbangia",
    rating: 5,
    text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Ananya Roy",
    handle: "ananya_rc_flier",
    rating: 5,
    text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
    avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Karan Malhotra",
    handle: "karan_rc_pilot",
    rating: 5,
    text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage">
      
      <!-- Fixed 5-Avatar Row on Desktop / 3-Avatar Row on Mobile -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatars-5-row" id="avatars-5-row">
          <!-- Slot 0: Far Left (Hidden on Mobile) -->
          <div class="avatar-card far-left" id="card-0" data-slot="0">
            <img src={REVIEWS[3].avatar} alt={REVIEWS[3].name} />
          </div>
          <!-- Slot 1: Near Left -->
          <div class="avatar-card near-left" id="card-1" data-slot="1">
            <img src={REVIEWS[4].avatar} alt={REVIEWS[4].name} />
          </div>
          <!-- Slot 2: CENTER ZOOMED ACTIVE -->
          <div class="avatar-card center-active" id="card-2" data-slot="2">
            <img src={REVIEWS[0].avatar} alt={REVIEWS[0].name} />
          </div>
          <!-- Slot 3: Near Right -->
          <div class="avatar-card near-right" id="card-3" data-slot="3">
            <img src={REVIEWS[1].avatar} alt={REVIEWS[1].name} />
          </div>
          <!-- Slot 4: Far Right (Hidden on Mobile) -->
          <div class="avatar-card far-right" id="card-4" data-slot="4">
            <img src={REVIEWS[2].avatar} alt={REVIEWS[2].name} />
          </div>
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Exact Bellavita Style) -->
      <div class="center-review-content" id="review-content-box">
        <div class="stars-gold-center">★★★★★</div>
        <p class="review-quote-text" id="rev-quote-display">
          "{REVIEWS[0].text}"
        </p>
        <div class="review-author-name" id="rev-author-display">
          – {REVIEWS[0].name}
        </div>
        <div class="review-social-handle" id="rev-handle-display">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span id="handle-text">{REVIEWS[0].handle}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 3rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3.5rem;
    color: #111111;
    font-weight: 600;
  }

  .bellavita-review-stage {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Carousel Outer Layout */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.4rem;
    color: #555555;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    user-select: none;
    flex-shrink: 0;
    opacity: 0.7;
    z-index: 10;
  }
  .carousel-arrow:hover {
    color: #111111;
    opacity: 1;
    transform: scale(1.3);
  }

  /* Exactly 5 Avatar Row Centered */
  .avatars-5-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    height: 130px;
  }

  /* Avatar Card Styling */
  .avatar-card {
    cursor: pointer;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    user-select: none;
  }
  .avatar-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  /* Slot 2: CENTER ZOOMED (110px) */
  .avatar-card.center-active {
    width: 110px;
    height: 110px;
    border-radius: 28px;
    opacity: 1;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    border: 2px solid #ffffff;
    z-index: 5;
  }

  /* Slot 1 & 3: Near Left & Near Right (70px) */
  .avatar-card.near-left,
  .avatar-card.near-right {
    width: 70px;
    height: 70px;
    border-radius: 20px;
    opacity: 0.75;
    z-index: 3;
  }

  /* Slot 0 & 4: Far Left & Far Right (48px) */
  .avatar-card.far-left,
  .avatar-card.far-right {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    opacity: 0.4;
    z-index: 1;
  }

  .avatar-card:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box */
  .center-review-content {
    text-align: center;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Mobile Adjustments (< 768px): Show EXACTLY 3 Avatars (Hide Far Left & Far Right) */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }
    .avatars-5-row {
      gap: 1.25rem;
      height: 95px;
    }
    .avatar-card.center-active {
      width: 82px;
      height: 82px;
      border-radius: 22px;
    }
    .avatar-card.near-left,
    .avatar-card.near-right {
      width: 54px;
      height: 54px;
      border-radius: 16px;
    }
    /* Hide far-left and far-right avatars so mobile screen has EXACTLY 3 avatars */
    .avatar-card.far-left,
    .avatar-card.far-right {
      display: none !important;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
      avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Simran Narang",
      handle: "simrannaranggg",
      text: "One of the best luxury aeromodelling stores and that too at an affordable price",
      avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Pulkit Bangia",
      handle: "pulkitbangia",
      text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
      avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Ananya Roy",
      handle: "ananya_rc_flier",
      text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
      avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Karan Malhotra",
      handle: "karan_rc_pilot",
      text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
      avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
    }
  ];

  function initFixedReviewSlider() {
    let centerIndex = 0; // Starts with Sanna Thakur at center
    const N = reviewsData.length;

    const cards = [
      document.getElementById('card-0'),
      document.getElementById('card-1'),
      document.getElementById('card-2'),
      document.getElementById('card-3'),
      document.getElementById('card-4')
    ];

    const contentBox = document.getElementById('review-content-box');
    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');

    if (!cards[2]) return;

    function update5Cards(direction = 'next') {
      // Review indices for 5 slots: [far-left, near-left, center, near-right, far-right]
      const indices = [
        (centerIndex - 2 + N) % N,
        (centerIndex - 1 + N) % N,
        centerIndex,
        (centerIndex + 1) % N,
        (centerIndex + 2) % N
      ];

      cards.forEach((card, slotPos) => {
        const img = card?.querySelector('img');
        const rev = reviewsData[indices[slotPos]];
        if (img && rev) {
          img.style.opacity = '0.2';
          img.style.transform = direction === 'next' ? 'scale(0.85)' : 'scale(1.15)';
          
          setTimeout(() => {
            img.src = rev.avatar;
            img.alt = rev.name;
            img.style.opacity = '1';
            img.style.transform = 'scale(1)';
          }, 140);
        }
      });

      // Update text quote box below
      const activeRev = reviewsData[centerIndex];
      if (activeRev && contentBox) {
        contentBox.style.opacity = '0.2';
        contentBox.style.transform = 'translateY(4px)';

        setTimeout(() => {
          if (quoteDisplay) quoteDisplay.textContent = `"${activeRev.text}"`;
          if (authorDisplay) authorDisplay.textContent = `– ${activeRev.name}`;
          if (handleDisplay) handleDisplay.textContent = activeRev.handle;

          contentBox.style.opacity = '1';
          contentBox.style.transform = 'translateY(0)';
        }, 140);
      }
    }

    function stepNext() {
      centerIndex = (centerIndex + 1) % N;
      update5Cards('next');
    }

    function stepPrev() {
      centerIndex = (centerIndex - 1 + N) % N;
      update5Cards('prev');
    }

    // Arrow clicks
    nextBtn?.addEventListener('click', stepNext);
    prevBtn?.addEventListener('click', stepPrev);

    // Card clicks
    cards.forEach((card, slotPos) => {
      card?.addEventListener('click', () => {
        if (slotPos === 0) {
          centerIndex = (centerIndex - 2 + N) % N;
          update5Cards('prev');
        } else if (slotPos === 1) {
          centerIndex = (centerIndex - 1 + N) % N;
          update5Cards('prev');
        } else if (slotPos === 2) {
          return; // Already active center
        } else if (slotPos === 3) {
          centerIndex = (centerIndex + 1) % N;
          update5Cards('next');
        } else if (slotPos === 4) {
          centerIndex = (centerIndex + 2) % N;
          update5Cards('next');
        }
      });
    });

    // Touch Swipe Gestures for Mobile
    const rowContainer = document.getElementById('avatars-5-row');
    let startX = 0;
    let endX = 0;

    rowContainer?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    rowContainer?.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (diff > 35) {
        stepNext();
      } else if (diff < -35) {
        stepPrev();
      }
    }, { passive: true });

    // Auto rotation every 4.5 seconds
    setInterval(stepNext, 4500);

    // Initial render
    update5Cards('next');
  }

  // Auto initialize on DOM and Astro page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFixedReviewSlider);
  } else {
    initFixedReviewSlider();
  }
  document.addEventListener('astro:page-load', initFixedReviewSlider);
</script>
