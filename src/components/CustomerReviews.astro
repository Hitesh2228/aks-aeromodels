---
const REVIEWS = [
  {
    name: "Capt. Rajesh Sharma",
    role: "Senior RC Aviator & Scale Pilot",
    rating: 5,
    text: "AKS Aeromodels has raised the bar for India's aeromodelling community. Purchased the Seagull Decathlon 122\" and DLE 65 gas engine. Excellent packaging, zero wing damage during freight, and true 100% genuine products!",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Vikramaditya Rao",
    role: "IMAC Aerobatic Champion",
    rating: 5,
    text: "The Futaba 6K radio and T-FHSS receivers are rock solid. No latency, zero signal loss during high-G harrier maneuvers. Outstanding customer support!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Dr. Ananya Kulkarni",
    role: "Drone & Aeromodel Researcher",
    rating: 5,
    text: "The contest grade AAA balsa sheets are cut to absolute perfection. 2mm and 3mm sheets have uniform density throughout. Best supplier in India!",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop"
  }
];

const GALLERY_IMAGES = [
  "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1519074069444-1ba4ea16028d?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=400&auto=format&fit=crop"
];
---

<section class="reviews-section">
  <div class="container">
    <h2 class="section-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>
    <p class="section-subtitle">Read real feedback from champion pilots, scale builders, and hobbyists across India</p>

    <!-- Rating Summary -->
    <div class="rating-summary">
      <div class="rating-stars">★★★★★</div>
      <div class="rating-number">4.9 out of 5.0</div>
      <div class="rating-total">Based on 1,420+ Verified Reviews</div>
    </div>

    <!-- Testimonials Grid -->
    <div class="testimonials-grid">
      {REVIEWS.map(rev => (
        <div class="testimonial-card glass-panel">
          <div class="user-header">
            <img src={rev.avatar} alt={rev.name} class="user-avatar" />
            <div>
              <h3 class="user-name">{rev.name}</h3>
              <p class="user-role">{rev.role}</p>
            </div>
          </div>
          <div class="card-stars">{'★'.repeat(rev.rating)}</div>
          <p class="card-quote">"{rev.text}"</p>
        </div>
      ))}
    </div>

    <!-- Lifestyle Gallery Strip (Bellavita Photo Wall) -->
    <div class="gallery-strip">
      {GALLERY_IMAGES.map((imgUrl, i) => (
        <div class="gallery-item">
          <img src={imgUrl} alt={`RC Flight Action ${i+1}`} loading="lazy" />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .reviews-section {
    padding: 5rem 0;
    background: #090a0e;
    border-bottom: 1px solid var(--border-subtle);
  }

  .rating-summary {
    text-align: center;
    margin-bottom: 3rem;
  }
  .rating-stars {
    font-size: 1.8rem;
    color: var(--accent-amber);
    margin-bottom: 0.25rem;
  }
  .rating-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    font-family: var(--font-display);
  }
  .rating-total {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
    margin-bottom: 4rem;
  }
  .testimonial-card {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
  }
  .user-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .user-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-gold);
  }
  .user-name {
    font-size: 1.05rem;
    color: #fff;
  }
  .user-role {
    font-size: 0.75rem;
    color: var(--accent-gold);
  }
  .card-stars {
    color: var(--accent-amber);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }
  .card-quote {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    font-style: italic;
  }

  /* Gallery Strip */
  .gallery-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gallery-item {
    height: 180px;
    overflow: hidden;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }
  .gallery-item:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 768px) {
    .gallery-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
