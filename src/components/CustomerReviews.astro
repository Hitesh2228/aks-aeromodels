---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Simran Narang",
    handle: "simrannaranggg",
    rating: 5,
    text: "One of the best luxury aeromodelling stores and that too at an affordable price",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Pulkit Bangia",
    handle: "pulkitbangia",
    rating: 5,
    text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Ananya Roy",
    handle: "ananya_rc_flier",
    rating: 5,
    text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
    avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Karan Malhotra",
    handle: "karan_rc_pilot",
    rating: 5,
    text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage" id="bellavita-review-stage">
      
      <!-- Fixed 5-Avatar Row on Desktop / 3-Avatar Row on Mobile -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatars-5-row" id="avatars-5-row">
          <!-- Slot 0: Far Left (Hidden on Mobile) -->
          <div class="avatar-card far-left" id="card-0" data-slot="0">
            <img src={REVIEWS[3].avatar} alt={REVIEWS[3].name} loading="lazy" decoding="async" width="70" height="70" />
          </div>
          <!-- Slot 1: Near Left -->
          <div class="avatar-card near-left" id="card-1" data-slot="1">
            <img src={REVIEWS[4].avatar} alt={REVIEWS[4].name} loading="lazy" decoding="async" width="70" height="70" />
          </div>
          <!-- Slot 2: CENTER ZOOMED ACTIVE -->
          <div class="avatar-card center-active" id="card-2" data-slot="2">
            <img src={REVIEWS[0].avatar} alt={REVIEWS[0].name} loading="lazy" decoding="async" width="70" height="70" />
          </div>
          <!-- Slot 3: Near Right -->
          <div class="avatar-card near-right" id="card-3" data-slot="3">
            <img src={REVIEWS[1].avatar} alt={REVIEWS[1].name} loading="lazy" decoding="async" width="70" height="70" />
          </div>
          <!-- Slot 4: Far Right (Hidden on Mobile) -->
          <div class="avatar-card far-right" id="card-4" data-slot="4">
            <img src={REVIEWS[2].avatar} alt={REVIEWS[2].name} loading="lazy" decoding="async" width="70" height="70" />
          </div>
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Smooth Right-to-Left Sliding Window) -->
      <div class="review-slide-window">
        <div class="center-review-content" id="review-content-box">
          <div class="stars-gold-center">★★★★★</div>
          <p class="review-quote-text" id="rev-quote-display">
            "{REVIEWS[0].text}"
          </p>
          <div class="review-author-name" id="rev-author-display">
            – {REVIEWS[0].name}
          </div>
          <div class="review-social-handle" id="rev-handle-display">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <span id="handle-text">{REVIEWS[0].handle}</span>
          </div>
        </div>
      </div>

      <!-- Smooth Progress Indicator Dots / Slider Pills -->
      <div class="reviews-slider-dots" id="reviews-dots" aria-label="Review Navigation">
        {REVIEWS.map((_, i) => (
          <button type="button" class={`review-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`View review ${i + 1} of ${REVIEWS.length}`} />
        ))}
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 3rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3.5rem;
    color: #111111;
    font-weight: 600;
  }

  .bellavita-review-stage {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    position: relative;
    user-select: none;
  }

  /* Carousel Outer Layout */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.4rem;
    color: #555555;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease, opacity 0.2s ease;
    user-select: none;
    flex-shrink: 0;
    opacity: 0.7;
    z-index: 10;
  }
  .carousel-arrow:hover {
    color: #111111;
    opacity: 1;
    transform: scale(1.3);
  }

  /* Exactly 5 Avatar Row Centered */
  .avatars-5-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    height: 130px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    will-change: transform, opacity;
  }

  /* Avatar Card Styling */
  .avatar-card {
    cursor: pointer;
    overflow: hidden;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    user-select: none;
  }
  .avatar-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Slot 2: CENTER ZOOMED (110px) */
  .avatar-card.center-active {
    width: 110px;
    height: 110px;
    border-radius: 28px;
    opacity: 1;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    border: 2px solid #ffffff;
    z-index: 5;
  }

  /* Slot 1 & 3: Near Left & Near Right (70px) */
  .avatar-card.near-left,
  .avatar-card.near-right {
    width: 70px;
    height: 70px;
    border-radius: 20px;
    opacity: 0.75;
    z-index: 3;
  }

  /* Slot 0 & 4: Far Left & Far Right (48px) */
  .avatar-card.far-left,
  .avatar-card.far-right {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    opacity: 0.4;
    z-index: 1;
  }

  .avatar-card:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box (Smooth Sliding Window) */
  .review-slide-window {
    width: 100%;
    max-width: 620px;
    overflow: hidden;
    position: relative;
    padding: 0.25rem 0.5rem;
  }

  .center-review-content {
    text-align: center;
    max-width: 620px;
    width: 100%;
    min-height: 145px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    will-change: transform, opacity;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
    min-height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Slider Navigation Dots / Indicator Pills */
  .reviews-slider-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .review-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #dcd8cf;
    border: none;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
  }
  .review-dot.active {
    width: 26px;
    background: #3b0811;
  }
  .review-dot:hover:not(.active) {
    background: #999999;
  }

  /* Mobile Adjustments (< 768px): Show EXACTLY 3 Avatars & Smooth Slide */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.75rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .avatars-5-row {
      gap: 1.25rem;
      height: 95px;
    }
    .avatar-card.center-active {
      width: 82px;
      height: 82px;
      border-radius: 22px;
    }
    .avatar-card.near-left,
    .avatar-card.near-right {
      width: 54px;
      height: 54px;
      border-radius: 16px;
    }
    /* Hide far-left and far-right avatars so mobile screen has EXACTLY 3 avatars */
    .avatar-card.far-left,
    .avatar-card.far-right {
      display: none !important;
    }
    .center-review-content {
      min-height: 135px;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
      min-height: 2.8rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
    .reviews-slider-dots {
      margin-top: 1.25rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
      avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Simran Narang",
      handle: "simrannaranggg",
      text: "One of the best luxury aeromodelling stores and that too at an affordable price",
      avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Pulkit Bangia",
      handle: "pulkitbangia",
      text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
      avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Ananya Roy",
      handle: "ananya_rc_flier",
      text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
      avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
    },
    {
      name: "Karan Malhotra",
      handle: "karan_rc_pilot",
      text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
      avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
    }
  ];

  function initFixedReviewSlider() {
    let centerIndex = 0;
    const N = reviewsData.length;
    let isAnimating = false;

    const cards = [
      document.getElementById('card-0'),
      document.getElementById('card-1'),
      document.getElementById('card-2'),
      document.getElementById('card-3'),
      document.getElementById('card-4')
    ];

    const contentBox = document.getElementById('review-content-box');
    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');
    const dots = document.querySelectorAll('.review-dot');
    const avatarRow = document.getElementById('avatars-5-row');
    const stage = document.getElementById('bellavita-review-stage');

    if (!cards[2] || !contentBox) return;

    function update5Cards(direction = 'next') {
      if (isAnimating) return;
      isAnimating = true;

      const indices = [
        (centerIndex - 2 + N) % N,
        (centerIndex - 1 + N) % N,
        centerIndex,
        (centerIndex + 1) % N,
        (centerIndex + 2) % N
      ];

      // 1. Smooth Avatar Row Shift Transition
      if (avatarRow) {
        avatarRow.style.transition = 'transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease';
        avatarRow.style.transform = direction === 'next' ? 'translateX(-28px)' : 'translateX(28px)';
        avatarRow.style.opacity = '0.65';

        setTimeout(() => {
          cards.forEach((card, slotPos) => {
            const img = card?.querySelector('img');
            const rev = reviewsData[indices[slotPos]];
            if (img && rev) {
              img.src = rev.avatar;
              img.alt = rev.name;
            }
          });

          // Reset to opposite side and smoothly slide into center
          avatarRow.style.transition = 'none';
          avatarRow.style.transform = direction === 'next' ? 'translateX(28px)' : 'translateX(-28px)';
          void avatarRow.offsetWidth; // Force browser reflow

          avatarRow.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease';
          avatarRow.style.transform = 'translateX(0)';
          avatarRow.style.opacity = '1';
        }, 150);
      }

      // 2. Smooth Right-to-Left / Left-to-Right Quote Slider Transition
      const activeRev = reviewsData[centerIndex];
      if (activeRev && contentBox) {
        contentBox.style.transition = 'transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease';
        contentBox.style.transform = direction === 'next' ? 'translateX(-45px)' : 'translateX(45px)';
        contentBox.style.opacity = '0';

        setTimeout(() => {
          if (quoteDisplay) quoteDisplay.textContent = `"${activeRev.text}"`;
          if (authorDisplay) authorDisplay.textContent = `– ${activeRev.name}`;
          if (handleDisplay) handleDisplay.textContent = activeRev.handle;

          contentBox.style.transition = 'none';
          contentBox.style.transform = direction === 'next' ? 'translateX(45px)' : 'translateX(-45px)';
          void contentBox.offsetWidth; // Force browser reflow

          contentBox.style.transition = 'transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.42s ease';
          contentBox.style.transform = 'translateX(0)';
          contentBox.style.opacity = '1';

          setTimeout(() => {
            isAnimating = false;
          }, 320);
        }, 150);
      } else {
        isAnimating = false;
      }

      // 3. Update Progress Dots
      dots.forEach((dot, idx) => {
        if (idx === centerIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    function stepNext() {
      if (isAnimating) return;
      centerIndex = (centerIndex + 1) % N;
      update5Cards('next');
    }

    function stepPrev() {
      if (isAnimating) return;
      centerIndex = (centerIndex - 1 + N) % N;
      update5Cards('prev');
    }

    // Auto-slide every 5 seconds (slides smoothly right to left)
    let autoTimer = setInterval(stepNext, 5000);

    function resetTimer() {
      clearInterval(autoTimer);
      autoTimer = setInterval(stepNext, 5000);
    }

    // Arrow navigation
    nextBtn?.addEventListener('click', () => {
      stepNext();
      resetTimer();
    });
    prevBtn?.addEventListener('click', () => {
      stepPrev();
      resetTimer();
    });

    // Dot navigation
    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        const target = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        if (target === centerIndex || isAnimating) return;
        const dir = target > centerIndex ? 'next' : 'prev';
        centerIndex = target;
        update5Cards(dir);
        resetTimer();
      });
    });

    // Card avatar click
    cards.forEach((card, slotPos) => {
      card?.addEventListener('click', () => {
        if (isAnimating) return;
        if (slotPos === 0) {
          centerIndex = (centerIndex - 2 + N) % N;
          update5Cards('prev');
          resetTimer();
        } else if (slotPos === 1) {
          centerIndex = (centerIndex - 1 + N) % N;
          update5Cards('prev');
          resetTimer();
        } else if (slotPos === 2) {
          return;
        } else if (slotPos === 3) {
          centerIndex = (centerIndex + 1) % N;
          update5Cards('next');
          resetTimer();
        } else if (slotPos === 4) {
          centerIndex = (centerIndex + 2) % N;
          update5Cards('next');
          resetTimer();
        }
      });
    });

    // Touch Swipe Gestures for Mobile (Right to Left & Left to Right)
    let touchStartX = 0;
    let touchStartY = 0;

    stage?.addEventListener('touchstart', (e: any) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      clearInterval(autoTimer);
    }, { passive: true });

    stage?.addEventListener('touchend', (e: any) => {
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const diffX = touchStartX - endX;
      const diffY = touchStartY - endY;

      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 35) {
        if (diffX > 35) {
          stepNext(); // Swipe right-to-left
        } else if (diffX < -35) {
          stepPrev(); // Swipe left-to-right
        }
      }
      resetTimer();
    }, { passive: true });

    // Pause auto-sliding when hovering with mouse
    stage?.addEventListener('mouseenter', () => clearInterval(autoTimer));
    stage?.addEventListener('mouseleave', () => resetTimer());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFixedReviewSlider);
  } else {
    initFixedReviewSlider();
  }
  document.addEventListener('astro:page-load', initFixedReviewSlider);
</script>
