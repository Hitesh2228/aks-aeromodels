---
const REVIEWS = [
  {
    name: "Capt. Rajesh Sharma",
    handle: "@rajesh_aviator",
    rating: 5,
    text: "AKS AEROMODELS has raised the bar for the aeromodelling industry in India. Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty!",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Vikramaditya Rao",
    handle: "@vikram_rc_flier",
    rating: 5,
    text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Sameer Deshmukh",
    handle: "@sameer_rc_pilot",
    rating: 5,
    text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop"
  }
];

const GALLERY_IMAGES = [
  { url: "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=600&auto=format&fit=crop", title: "Scale RC Aerobatics" },
  { url: "https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=600&auto=format&fit=crop", title: "Turbine Engine Testing" },
  { url: "https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop", title: "Field Flight Line" },
  { url: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop", title: "Precision Bench Tuning" },
  { url: "https://images.unsplash.com/photo-1581092335397-9583fe92d232?q=80&w=600&auto=format&fit=crop", title: "High-Thrust Testing" }
];
---

<section class="bellavita-reviews-section">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR PILOTS HAVE TO SAY</h2>

    <!-- Avatar Selection Strip -->
    <div class="avatars-row">
      {REVIEWS.map((rev, i) => (
        <div class={`avatar-item ${i === 0 ? 'active' : ''}`} data-index={i}>
          <img src={rev.avatar} alt={rev.name} />
        </div>
      ))}
    </div>

    <!-- Active Quote Box -->
    <div class="active-quote-box">
      <div class="stars-gold">★★★★★</div>
      <p class="quote-text" id="quote-text-display">"{REVIEWS[0].text}"</p>
      <div class="quote-author" id="quote-author-display">– {REVIEWS[0].name}</div>
      <div class="quote-handle" id="quote-handle-display">{REVIEWS[0].handle}</div>
    </div>

    <!-- Lifestyle 5-Photo Grid -->
    <div class="lifestyle-photo-grid">
      {GALLERY_IMAGES.map((imgObj, i) => (
        <div class="photo-tile">
          <img src={imgObj.url} alt={`Pilot Gallery - ${imgObj.title}`} loading="lazy" />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .bellavita-reviews-section {
    padding: 4rem 0 0;
    background: #fbf9f5;
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .avatars-row {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .avatar-item {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    transition: var(--transition-fast);
    border: 2px solid transparent;
  }
  .avatar-item.active, .avatar-item:hover {
    opacity: 1;
    transform: scale(1.15);
    border-color: #3b0811;
  }
  .avatar-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .active-quote-box {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    padding: 2rem;
    background: #ffffff;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  .stars-gold {
    color: #f59e0b;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .quote-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }
  .quote-author {
    font-weight: 800;
    font-size: 0.95rem;
    color: #1a1a1a;
  }
  .quote-handle {
    font-size: 0.8rem;
    color: #777777;
  }

  /* Lifestyle Photo Grid */
  .lifestyle-photo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    width: 100%;
    margin-top: 2rem;
  }
  .photo-tile {
    position: relative;
    padding-top: 80%;
    overflow: hidden;
    border-radius: 8px;
    background: #e6e0d5;
  }
  .photo-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .photo-tile:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 900px) {
    .lifestyle-photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Capt. Rajesh Sharma",
      handle: "@rajesh_aviator",
      text: "AKS AEROMODELS has raised the bar for the aeromodelling industry in India. Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty!"
    },
    {
      name: "Vikramaditya Rao",
      handle: "@vikram_rc_flier",
      text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!"
    },
    {
      name: "Sameer Deshmukh",
      handle: "@sameer_rc_pilot",
      text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!"
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const avatarItems = document.querySelectorAll('.avatar-item');
    const textEl = document.getElementById('quote-text-display');
    const authorEl = document.getElementById('quote-author-display');
    const handleEl = document.getElementById('quote-handle-display');

    avatarItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        avatarItems.forEach(a => a.classList.remove('active'));
        item.classList.add('active');

        const rev = reviewsData[idx];
        if (rev && textEl && authorEl && handleEl) {
          textEl.textContent = `"${rev.text}"`;
          authorEl.textContent = `– ${rev.name}`;
          handleEl.textContent = rev.handle;
        }
      });
    });
  });
</script>
