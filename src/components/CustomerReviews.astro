---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Simran Narang",
    handle: "simrannaranggg",
    rating: 5,
    text: "One of the best luxury aeromodelling stores and that too at an affordable price",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Pulkit Bangia",
    handle: "pulkitbangia",
    rating: 5,
    text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Ananya Roy",
    handle: "ananya_rc_flier",
    rating: 5,
    text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier.",
    avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Karan Malhotra",
    handle: "karan_rc_pilot",
    rating: 5,
    text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time.",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage">
      
      <!-- 5-Avatar Ring Carousel Row with Side Arrows -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatar-ring-track" id="avatar-ring-track">
          <!-- Slot 0: Far Left -->
          <div class="avatar-slot slot-far-left" id="slot-0" data-slot="0">
            <img src={REVIEWS[3].avatar} alt={REVIEWS[3].name} />
          </div>
          <!-- Slot 1: Near Left -->
          <div class="avatar-slot slot-near-left" id="slot-1" data-slot="1">
            <img src={REVIEWS[4].avatar} alt={REVIEWS[4].name} />
          </div>
          <!-- Slot 2: CENTER ZOOMED -->
          <div class="avatar-slot slot-center" id="slot-2" data-slot="2">
            <img src={REVIEWS[0].avatar} alt={REVIEWS[0].name} />
          </div>
          <!-- Slot 3: Near Right -->
          <div class="avatar-slot slot-near-right" id="slot-3" data-slot="3">
            <img src={REVIEWS[1].avatar} alt={REVIEWS[1].name} />
          </div>
          <!-- Slot 4: Far Right -->
          <div class="avatar-slot slot-far-right" id="slot-4" data-slot="4">
            <img src={REVIEWS[2].avatar} alt={REVIEWS[2].name} />
          </div>
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Exact Bellavita Style) -->
      <div class="center-review-content" id="review-content-box">
        <div class="stars-gold-center">★★★★★</div>
        <p class="review-quote-text" id="rev-quote-display">
          "{REVIEWS[0].text}"
        </p>
        <div class="review-author-name" id="rev-author-display">
          – {REVIEWS[0].name}
        </div>
        <div class="review-social-handle" id="rev-handle-display">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span id="handle-text">{REVIEWS[0].handle}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 3rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3.5rem;
    color: #111111;
    font-weight: 600;
  }

  .bellavita-review-stage {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 5 Avatar Ring Carousel Row */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    width: 100%;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.35rem;
    color: #555555;
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    transition: transform 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    user-select: none;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .carousel-arrow:hover {
    color: #111111;
    opacity: 1;
    transform: scale(1.25);
  }

  .avatar-ring-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.2rem;
    height: 130px;
    width: 100%;
  }

  /* Squircle Avatar Slots with Smooth Transitions */
  .avatar-slot {
    cursor: pointer;
    overflow: hidden;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    user-select: none;
  }
  .avatar-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  /* Slot 2: CENTER ZOOMED (Exact Bellavita 110px Rounded Squircle) */
  .avatar-slot.slot-center {
    width: 110px;
    height: 110px;
    border-radius: 28px;
    opacity: 1;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    border: 2px solid #ffffff;
    z-index: 5;
  }

  /* Slot 1 & 3: Near Left & Near Right (70px Rounded Squircle) */
  .avatar-slot.slot-near-left,
  .avatar-slot.slot-near-right {
    width: 70px;
    height: 70px;
    border-radius: 20px;
    opacity: 0.75;
    z-index: 3;
  }

  /* Slot 0 & 4: Far Left & Far Right (48px Rounded Squircle) */
  .avatar-slot.slot-far-left,
  .avatar-slot.slot-far-right {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    opacity: 0.4;
    z-index: 1;
  }

  .avatar-slot:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box */
  .center-review-content {
    text-align: center;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Responsive Adjustments (< 768px Mobile) */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.5rem;
      margin-bottom: 1.75rem;
    }
    .carousel-arrow {
      font-size: 1.1rem;
      padding: 0.2rem 0.3rem;
    }
    .avatar-ring-track {
      gap: 0.85rem;
      height: 90px;
    }
    .avatar-slot.slot-center {
      width: 82px;
      height: 82px;
      border-radius: 22px;
    }
    .avatar-slot.slot-near-left,
    .avatar-slot.slot-near-right {
      width: 52px;
      height: 52px;
      border-radius: 16px;
    }
    .avatar-slot.slot-far-left,
    .avatar-slot.slot-far-right {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price"
    },
    {
      name: "Simran Narang",
      handle: "simrannaranggg",
      text: "One of the best luxury aeromodelling stores and that too at an affordable price"
    },
    {
      name: "Pulkit Bangia",
      handle: "pulkitbangia",
      text: "Bought it cause it was so affordable but I never thought the flight quality would be this good as well."
    },
    {
      name: "Ananya Roy",
      handle: "ananya_rc_flier",
      text: "The balsa wood density and laser cut precision on Seagull kits is unbelievable. Truly top tier."
    },
    {
      name: "Karan Malhotra",
      handle: "karan_rc_pilot",
      text: "O.S. Engines 46AX II performance is super smooth! Zero tuning hassle and instant startup every time."
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    let centerIndex = 0; // Initial center review: Sanna Thakur
    const N = reviewsData.length;

    const contentBox = document.getElementById('review-content-box');
    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');

    const slotEls = [
      document.getElementById('slot-0'),
      document.getElementById('slot-1'),
      document.getElementById('slot-2'),
      document.getElementById('slot-3'),
      document.getElementById('slot-4')
    ];

    function updateCarousel() {
      // Smooth fade-out text content
      if (contentBox) {
        contentBox.style.opacity = '0.3';
        contentBox.style.transform = 'translateY(4px)';
      }

      // Calculate active review indices for 5 slots: [far-left, near-left, center, near-right, far-right]
      const slotIndices = [
        (centerIndex - 2 + N) % N,
        (centerIndex - 1 + N) % N,
        centerIndex,
        (centerIndex + 1) % N,
        (centerIndex + 2) % N
      ];

      setTimeout(() => {
        slotIndices.forEach((revIdx, slotPos) => {
          const slotEl = slotEls[slotPos];
          const imgEl = slotEl?.querySelector('img');
          if (slotEl && imgEl) {
            imgEl.src = reviewsData[revIdx].avatar;
            imgEl.alt = reviewsData[revIdx].name;
          }
        });

        // Update center quote text & metadata
        const activeRev = reviewsData[centerIndex];
        if (activeRev) {
          if (quoteDisplay) quoteDisplay.textContent = `"${activeRev.text}"`;
          if (authorDisplay) authorDisplay.textContent = `– ${activeRev.name}`;
          if (handleDisplay) handleDisplay.textContent = activeRev.handle;
        }

        // Fade-in text content
        if (contentBox) {
          contentBox.style.opacity = '1';
          contentBox.style.transform = 'translateY(0)';
        }
      }, 150);
    }

    // Next arrow (Slides right -> next image moves to center)
    nextBtn?.addEventListener('click', () => {
      centerIndex = (centerIndex + 1) % N;
      updateCarousel();
    });

    // Prev arrow (Slides left -> prev image moves to center)
    prevBtn?.addEventListener('click', () => {
      centerIndex = (centerIndex - 1 + N) % N;
      updateCarousel();
    });

    // Clicking any visible slot moves that slot's image to the center!
    slotEls.forEach((slotEl, slotPos) => {
      slotEl?.addEventListener('click', () => {
        if (slotPos === 0) centerIndex = (centerIndex - 2 + N) % N;
        else if (slotPos === 1) centerIndex = (centerIndex - 1 + N) % N;
        else if (slotPos === 2) return; // Already center
        else if (slotPos === 3) centerIndex = (centerIndex + 1) % N;
        else if (slotPos === 4) centerIndex = (centerIndex + 2) % N;

        updateCarousel();
      });
    });

    // Touch Swipe Support for Mobile
    const track = document.getElementById('avatar-ring-track');
    let startX = 0;
    let endX = 0;

    track?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    track?.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (diff > 35) {
        // Swiped Left -> Next Image to Center
        centerIndex = (centerIndex + 1) % N;
        updateCarousel();
      } else if (diff < -35) {
        // Swiped Right -> Prev Image to Center
        centerIndex = (centerIndex - 1 + N) % N;
        updateCarousel();
      }
    }, { passive: true });

    // Auto-rotate timer every 4.5 seconds
    setInterval(() => {
      centerIndex = (centerIndex + 1) % N;
      updateCarousel();
    }, 4500);
  });
</script>
