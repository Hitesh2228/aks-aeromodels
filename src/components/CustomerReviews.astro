---
import FAQ from './FAQ.astro';

const REVIEWS = [
  {
    id: 0,
    name: "Sanna Thakur",
    handle: "sannathakur_",
    rating: 5,
    text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 1,
    name: "Capt. Rajesh Sharma",
    handle: "rajesh_aviator",
    rating: 5,
    text: "Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty! Fast dispatch to Mumbai in 24 hours.",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 2,
    name: "Vikramaditya Rao",
    handle: "vikram_rc_flier",
    rating: 5,
    text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 3,
    name: "Pooja Deshmukh",
    handle: "pooja_rc_pilot",
    rating: 5,
    text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=300&auto=format&fit=crop"
  },
  {
    id: 4,
    name: "Aman Verma",
    handle: "aman_balsa_builder",
    rating: 5,
    text: "Top-notch AAA grade balsa sheets! Consistent grain density for contest build models. Best aeromodelling store in India.",
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="bellavita-reviews-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <div class="bellavita-review-stage">
      
      <!-- 5-Avatar Perspective Row with Side Arrows -->
      <div class="bellavita-avatar-carousel">
        <button class="carousel-arrow prev-arr" id="rev-arrow-prev" aria-label="Previous Review">←</button>

        <div class="avatar-perspective-row" id="avatar-track">
          {REVIEWS.map((rev, index) => (
            <div 
              class={`perspective-avatar-item ${index === 0 ? 'pos-center' : index === 1 ? 'pos-right-1' : index === 2 ? 'pos-right-2' : index === 3 ? 'pos-left-2' : 'pos-left-1'}`} 
              data-index={index}
            >
              <img src={rev.avatar} alt={rev.name} loading="lazy" />
            </div>
          ))}
        </div>

        <button class="carousel-arrow next-arr" id="rev-arrow-next" aria-label="Next Review">→</button>
      </div>

      <!-- Center Review Content Box (Exact Bellavita Style) -->
      <div class="center-review-content">
        <div class="stars-gold-center">★★★★★</div>
        <p class="review-quote-text" id="rev-quote-display">
          "{REVIEWS[0].text}"
        </p>
        <div class="review-author-name" id="rev-author-display">
          – {REVIEWS[0].name}
        </div>
        <div class="review-social-handle" id="rev-handle-display">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span id="handle-text">{REVIEWS[0].handle}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Frequently Asked Questions Section -->
<FAQ />

<style>
  .bellavita-reviews-section {
    padding: 4.5rem 0 2.5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3rem;
    color: #1a1a1a;
    font-weight: 700;
  }

  .bellavita-review-stage {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 5-Avatar Perspective Row Container */
  .bellavita-avatar-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    margin-bottom: 2rem;
    position: relative;
  }

  .carousel-arrow {
    background: transparent;
    border: none;
    font-size: 1.4rem;
    color: #444444;
    cursor: pointer;
    padding: 0.5rem;
    transition: transform 0.2s ease, color 0.2s ease;
    user-select: none;
  }
  .carousel-arrow:hover {
    color: #1a1a1a;
    transform: scale(1.2);
  }

  .avatar-perspective-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    height: 120px;
  }

  /* Squircle Avatar Items with Perspective Scaling */
  .perspective-avatar-item {
    cursor: pointer;
    overflow: hidden;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .perspective-avatar-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  /* Positional Classes for 3D Perspective Scaling (Exact Bellavita Screenshot) */
  .perspective-avatar-item.pos-center {
    width: 110px;
    height: 110px;
    border-radius: 28px;
    opacity: 1;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    border: 2px solid #ffffff;
    z-index: 5;
  }
  .perspective-avatar-item.pos-right-1,
  .perspective-avatar-item.pos-left-1 {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    opacity: 0.75;
    z-index: 3;
  }
  .perspective-avatar-item.pos-right-2,
  .perspective-avatar-item.pos-left-2 {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    opacity: 0.45;
    z-index: 1;
  }

  .perspective-avatar-item:hover {
    opacity: 1 !important;
  }

  /* Center Review Content Box */
  .center-review-content {
    text-align: center;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .stars-gold-center {
    color: #f59e0b;
    font-size: 1.25rem;
    letter-spacing: 0.15em;
  }
  .review-quote-text {
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: #222222;
    line-height: 1.6;
    margin: 0;
  }
  .review-author-name {
    font-style: italic;
    font-size: 0.92rem;
    color: #555555;
    font-weight: 500;
  }
  .review-social-handle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #777777;
  }
  .review-social-handle svg {
    color: #444444;
  }

  /* Mobile Responsive Adjustments (< 768px) */
  @media (max-width: 768px) {
    .bellavita-reviews-section {
      padding: 2.5rem 0 1.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 1.75rem;
    }
    .bellavita-avatar-carousel {
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .carousel-arrow {
      font-size: 1.1rem;
      padding: 0.25rem;
    }
    .avatar-perspective-row {
      gap: 0.65rem;
      height: 90px;
    }
    .perspective-avatar-item.pos-center {
      width: 82px;
      height: 82px;
      border-radius: 22px;
    }
    .perspective-avatar-item.pos-right-1,
    .perspective-avatar-item.pos-left-1 {
      width: 54px;
      height: 54px;
      border-radius: 16px;
    }
    .perspective-avatar-item.pos-right-2,
    .perspective-avatar-item.pos-left-2 {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }
    .review-quote-text {
      font-size: 0.92rem;
      padding: 0 0.5rem;
    }
    .review-author-name {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const reviewsData = [
    {
      name: "Sanna Thakur",
      handle: "sannathakur_",
      text: "SKYNODESUAV has raised the bar for the aeromodelling industry, Such good quality at very affordable price"
    },
    {
      name: "Capt. Rajesh Sharma",
      handle: "rajesh_aviator",
      text: "Outstanding quality ARF aircraft and O.S. Nitro engines with 100% genuine factory warranty! Fast dispatch to Mumbai in 24 hours."
    },
    {
      name: "Vikramaditya Rao",
      handle: "vikram_rc_flier",
      text: "Futaba 6K radio pairing was seamless. High speed response, zero signal drop, and telemetry works flawlessly in the field!"
    },
    {
      name: "Pooja Deshmukh",
      handle: "pooja_rc_pilot",
      text: "Ordered the Seagull Extra 330LX ARF. Excellent laser-cut balsa structure and fast dispatch to Nashik in 48 hours!"
    },
    {
      name: "Aman Verma",
      handle: "aman_balsa_builder",
      text: "Top-notch AAA grade balsa sheets! Consistent grain density for contest build models. Best aeromodelling store in India."
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const avatarItems = document.querySelectorAll('.perspective-avatar-item');
    const quoteDisplay = document.getElementById('rev-quote-display');
    const authorDisplay = document.getElementById('rev-author-display');
    const handleDisplay = document.getElementById('handle-text');
    const prevBtn = document.getElementById('rev-arrow-prev');
    const nextBtn = document.getElementById('rev-arrow-next');

    let currentIndex = 0;
    const totalReviews = reviewsData.length;

    function updatePerspectiveClasses(centerIdx: number) {
      avatarItems.forEach((item, idx) => {
        item.className = 'perspective-avatar-item';

        const diff = (idx - centerIdx + totalReviews) % totalReviews;

        if (diff === 0) {
          item.classList.add('pos-center');
        } else if (diff === 1) {
          item.classList.add('pos-right-1');
        } else if (diff === 2) {
          item.classList.add('pos-right-2');
        } else if (diff === totalReviews - 1) {
          item.classList.add('pos-left-1');
        } else if (diff === totalReviews - 2) {
          item.classList.add('pos-left-2');
        } else {
          item.classList.add('pos-right-2');
        }
      });

      const rev = reviewsData[centerIdx];
      if (rev && quoteDisplay && authorDisplay && handleDisplay) {
        quoteDisplay.textContent = `"${rev.text}"`;
        authorDisplay.textContent = `– ${rev.name}`;
        handleDisplay.textContent = rev.handle;
      }

      currentIndex = centerIdx;
    }

    // Avatar Tap / Click
    avatarItems.forEach((item) => {
      item.addEventListener('click', () => {
        const idx = parseInt(item.getAttribute('data-index') || '0', 10);
        updatePerspectiveClasses(idx);
      });
    });

    // Arrow Clicks
    prevBtn?.addEventListener('click', () => {
      const prevIdx = (currentIndex - 1 + totalReviews) % totalReviews;
      updatePerspectiveClasses(prevIdx);
    });

    nextBtn?.addEventListener('click', () => {
      const nextIdx = (currentIndex + 1) % totalReviews;
      updatePerspectiveClasses(nextIdx);
    });

    // Auto-rotate every 4.5 seconds
    setInterval(() => {
      const nextIdx = (currentIndex + 1) % totalReviews;
      updatePerspectiveClasses(nextIdx);
    }, 4500);

    // Initial setup
    updatePerspectiveClasses(0);
  });
</script>
