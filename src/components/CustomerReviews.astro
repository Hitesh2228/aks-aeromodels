---
const REVIEWS = [
  {
    name: "Sanna Thakur",
    handle: "@sannathakur_",
    rating: 5,
    text: "BELLAVITA / AKS AEROMODELS has raised the bar for the industry. Such good quality at very affordable price",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Capt. Rajesh Sharma",
    handle: "@rajesh_aviator",
    rating: 5,
    text: "Outstanding quality ARF aircraft and O.S. Nitro engines. Zero transit damage and 100% genuine factory warranty!",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
  },
  {
    name: "Vikramaditya Rao",
    handle: "@vikram_rc_flier",
    rating: 5,
    text: "Futaba 6K radio pairing was seamless. High speed response and excellent range telemetry!",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
  }
];

const GALLERY_IMAGES = [
  "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1519074069444-1ba4ea16028d?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=400&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=400&auto=format&fit=crop"
];
---

<section class="bellavita-reviews-section">
  <div class="container">
    <h2 class="bellavita-title">WHAT OUR CUSTOMERS HAVE TO SAY</h2>

    <!-- Avatar Selection Strip (Bellavita Style) -->
    <div class="avatars-row">
      {REVIEWS.map((rev, i) => (
        <div class={`avatar-item ${i === 0 ? 'active' : ''}`} data-index={i}>
          <img src={rev.avatar} alt={rev.name} />
        </div>
      ))}
    </div>

    <!-- Active Quote Box -->
    <div class="active-quote-box">
      <div class="stars-gold">★★★★★</div>
      <p class="quote-text">"{REVIEWS[0].text}"</p>
      <div class="quote-author">– {REVIEWS[0].name}</div>
      <div class="quote-handle">{REVIEWS[0].handle}</div>
    </div>

    <!-- Lifestyle 5-Photo Grid (Bellavita Photo Wall) -->
    <div class="lifestyle-photo-grid">
      {GALLERY_IMAGES.map((imgUrl, i) => (
        <div class="photo-tile">
          <img src={imgUrl} alt={`Customer Lifestyle ${i+1}`} loading="lazy" />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .bellavita-reviews-section {
    padding: 4rem 0 0;
    background: #fbf9f5;
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .avatars-row {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .avatar-item {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    transition: var(--transition-fast);
    border: 2px solid transparent;
  }
  .avatar-item.active, .avatar-item:hover {
    opacity: 1;
    transform: scale(1.15);
    border-color: #1a1a1a;
  }
  .avatar-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .active-quote-box {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }
  .stars-gold {
    color: #eab308;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .quote-text {
    font-size: 1.05rem;
    color: #333333;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .quote-author {
    font-weight: 800;
    font-size: 0.9rem;
    color: #1a1a1a;
  }
  .quote-handle {
    font-size: 0.75rem;
    color: #888888;
  }

  /* Photo Grid */
  .lifestyle-photo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .photo-tile {
    height: 220px;
    overflow: hidden;
  }
  .photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }
  .photo-tile:hover img {
    transform: scale(1.08);
  }

  @media (max-width: 768px) {
    .lifestyle-photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Simple review switcher
  document.addEventListener('DOMContentLoaded', () => {
    const avatars = document.querySelectorAll('.avatar-item');
    avatars.forEach(av => {
      av.addEventListener('click', () => {
        avatars.forEach(a => a.classList.remove('active'));
        av.classList.add('active');
      });
    });
  });
</script>
