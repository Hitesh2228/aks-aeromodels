<!-- Favicons for Browsers, Googlebot & Mobile Devices -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="alternate icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0f172a" />

<!-- Google Search Site Name & Web Application Identity -->
<meta property="og:site_name" content="SKYNODES UAV" />
<meta name="application-name" content="SKYNODES UAV" />
<meta name="apple-mobile-web-app-title" content="SKYNODES UAV" />

<!-- Official Google WebSite Structured Data Schema with Sitelinks SearchAction -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.skynodesuav.in/#website",
  "name": "SKYNODES UAV",
  "alternateName": ["SKYNODES", "SKYNODESUAV", "SKYNODES UAV India", "AKS Aeromodels"],
  "url": "https://www.skynodesuav.in",
  "description": "India's premier high-performance scale aeromodelling, RC aviation hardware, and UAV technology specialist store.",
  "inLanguage": "en-IN",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.skynodesuav.in/shop?search={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

