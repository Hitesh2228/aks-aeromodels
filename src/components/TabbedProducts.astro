---
import { PRODUCTS } from '../data/products';

const bestsellers = PRODUCTS.filter(p => p.isBestseller).slice(0, 8);
const newArrivals = PRODUCTS.filter(p => p.isNewArrival).slice(0, 8);
---

<section class="bellavita-tabbed-section">
  <div class="container">
    
    <!-- Tab Headers (Bellavita Style) -->
    <div class="tabs-header">
      <button class="tab-btn active" data-target="tab-bestsellers">BESTSELLERS</button>
      <span class="tab-divider">|</span>
      <button class="tab-btn" data-target="tab-newarrivals">NEW ARRIVALS</button>
    </div>

    <!-- Bestsellers Grid -->
    <div class="products-grid tab-content active" id="tab-bestsellers">
      {bestsellers.map(product => (
        <div class="bellavita-card">
          <div class="card-media">
            <span class="badge-bestseller">BESTSELLER</span>
            {product.discountBadge && <span class="bellavita-offer-badge">{product.discountBadge}</span>}
            <a href={`/product/${product.id}`}>
              <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
            </a>
          </div>

          <div class="card-body">
            <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
            <h3 class="product-title">
              <a href={`/product/${product.id}`}>{product.name}</a>
            </h3>

            <!-- Star Rating (Bellavita Style with Verified Check) -->
            <div class="rating-row">
              <span class="star-icon">★ {product.rating}</span>
              <span class="verified-check">✓</span>
              <span class="reviews-count">({product.reviewsCount} Reviews)</span>
            </div>

            <!-- Price Row -->
            <div class="price-row">
              <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
              <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
            </div>

            <!-- Action Button -->
            <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
              ADD TO CART
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- New Arrivals Grid -->
    <div class="products-grid tab-content" id="tab-newarrivals">
      {newArrivals.map(product => (
        <div class="bellavita-card">
          <div class="card-media">
            <span class="bellavita-offer-badge" style="background: #e0f2fe; color: #0284c7;">NEW ARRIVAL</span>
            <a href={`/product/${product.id}`}>
              <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
            </a>
          </div>

          <div class="card-body">
            <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
            <h3 class="product-title">
              <a href={`/product/${product.id}`}>{product.name}</a>
            </h3>

            <div class="rating-row">
              <span class="star-icon">★ {product.rating}</span>
              <span class="verified-check">✓</span>
              <span class="reviews-count">({product.reviewsCount} Reviews)</span>
            </div>

            <div class="price-row">
              <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
              <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
            </div>

            <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
              ADD TO CART
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- View All Button (Bellavita Centered Light Outlined Button) -->
    <div class="view-all-wrapper">
      <a href="/shop" class="bellavita-view-all-btn">VIEW ALL</a>
    </div>

  </div>
</section>

<style>
  .bellavita-tabbed-section {
    padding: 4rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tabs-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }
  .tab-btn {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: #888888;
    letter-spacing: 0.08em;
    transition: var(--transition-fast);
  }
  .tab-btn.active {
    color: #1a1a1a;
  }
  .tab-divider {
    font-size: 1.6rem;
    color: #cccccc;
  }

  /* Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.5rem;
  }
  .tab-content {
    display: none;
  }
  .tab-content.active {
    display: grid;
  }

  /* Card (Bellavita Off-White Light Card) */
  .bellavita-card {
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition-smooth);
  }
  .bellavita-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    border-color: #1a1a1a;
  }

  .card-media {
    position: relative;
    padding-top: 75%;
    background: #ffffff;
  }
  .product-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-bestseller {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #eab308;
    color: #000;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    z-index: 2;
  }
  .bellavita-offer-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: #c6f6d5;
    color: #22543d;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    z-index: 2;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .subtitle-tag {
    font-size: 0.65rem;
    color: #777777;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }
  .product-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 0.6rem;
    height: 2.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Rating Row */
  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    margin-bottom: 0.85rem;
  }
  .star-icon {
    color: #eab308;
    font-weight: 700;
  }
  .verified-check {
    background: #3b82f6;
    color: #ffffff;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    font-size: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  .reviews-count {
    color: #666666;
  }

  /* Price */
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    margin-top: auto;
  }
  .current-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1a1a1a;
  }
  .old-price {
    font-size: 0.85rem;
    color: #999999;
    text-decoration: line-through;
  }

  /* Cart Button */
  .bellavita-cart-btn {
    width: 100%;
    background: #1a1a1a;
    color: #ffffff;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    transition: var(--transition-fast);
  }
  .bellavita-cart-btn:hover {
    background: #333333;
  }

  /* View All Button */
  .view-all-wrapper {
    text-align: center;
    margin-top: 3.5rem;
  }
  .bellavita-view-all-btn {
    display: inline-block;
    background: #ffffff;
    color: #1a1a1a;
    border: 1.5px solid #1a1a1a;
    padding: 0.75rem 3rem;
    border-radius: var(--radius-sm);
    font-weight: 800;
  @media (max-width: 768px) {
    .bellavita-tabbed-section {
      padding: 2rem 0;
    }
    .tabs-header {
      gap: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .tab-btn, .tab-divider {
      font-size: 1.15rem;
    }
    /* Horizontal Touch Slider matching Bellavita Image 1 */
    .products-grid {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.85rem;
      padding: 0.25rem 0.85rem 1rem;
      margin: 0 -0.85rem;
      scrollbar-width: none;
    }
    .products-grid::-webkit-scrollbar {
      display: none;
    }
    .bellavita-card {
      flex: 0 0 78%;
      max-width: 260px;
      scroll-snap-align: start;
    }
    .card-body {
      padding: 0.75rem 0.6rem;
    }
    .product-title {
      font-size: 0.78rem;
      height: 2.2rem;
      margin-bottom: 0.35rem;
    }
    .rating-row {
      font-size: 0.7rem;
      margin-bottom: 0.35rem;
    }
    .current-price {
      font-size: 0.85rem;
    }
    .old-price {
      font-size: 0.72rem;
    }
    .bellavita-cart-btn {
      padding: 0.6rem 0.3rem;
      font-size: 0.7rem;
    }
    .view-all-wrapper {
      margin-top: 1.5rem;
    }
    .bellavita-view-all-btn {
      padding: 0.6rem 2rem;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  import { addToCart } from '../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(target!)?.classList.add('active');
      });
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (id) addToCart(id, 1);
      });
    });
  });
</script>
