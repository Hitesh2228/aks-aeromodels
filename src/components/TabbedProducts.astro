---
import { PRODUCTS as staticProducts } from '../data/products';
import { getAllShopifyProducts } from '../lib/shopify';

const shopifyProducts = await getAllShopifyProducts();
const PRODUCTS = (shopifyProducts && shopifyProducts.length > 0)
  ? shopifyProducts.map((sp, idx) => ({
      id: sp.id,
      variantId: sp.variantId,
      name: sp.title,
      category: 'aeromodels',
      categoryLabel: sp.vendor || 'SKYNODES UAV',
      price: Math.round(sp.price),
      originalPrice: Math.round(sp.price * 1.2),
      discountBadge: 'SHOPIFY LIVE',
      rating: 4.9,
      reviewsCount: 35 + idx * 4,
      isBestseller: idx % 2 === 0,
      isNewArrival: idx % 2 === 1,
      image: sp.imageUrl,
      description: sp.description || 'Official SKYNODES UAV product synced live from Shopify Storefront.',
      specs: { Vendor: sp.vendor, Type: sp.productType, Status: sp.availableForSale ? 'In Stock' : 'Out of Stock' },
      inStock: sp.availableForSale
    }))
  : staticProducts;

const bestsellers = PRODUCTS.filter(p => p.isBestseller).slice(0, 8);
const newArrivals = PRODUCTS.filter(p => p.isNewArrival).slice(0, 8);
---

<section class="bellavita-tabbed-section">
  <div class="container">
    
    <!-- Tab Headers (Bellavita Style) -->
    <div class="tabs-header">
      <button class="tab-btn active" data-target="tab-bestsellers">BESTSELLERS</button>
      <span class="tab-divider">|</span>
      <button class="tab-btn" data-target="tab-newarrivals">NEW ARRIVALS</button>
    </div>

    <!-- Relative Products Container -->
    <div class="slider-wrapper-relative">
      
      <!-- Bestsellers Grid / Slider -->
      <div class="products-grid tab-content active" id="tab-bestsellers">
        {bestsellers.map(product => (
          <div class="bellavita-card">
            <div class="card-media">
              <span class="badge-bestseller">BESTSELLER</span>
              {product.discountBadge && <span class="bellavita-offer-badge">{product.discountBadge}</span>}
              <a href={`/product/${product.id}`}>
                <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
              </a>
            </div>

            <div class="card-body">
              <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title">
                <a href={`/product/${product.id}`}>{product.name}</a>
              </h3>

              <div class="rating-row">
                <span class="star-icon">★ {product.rating}</span>
                <span class="verified-check">✓</span>
                <span class="reviews-count">({product.reviewsCount} Reviews)</span>
              </div>

              <div class="price-row">
                <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>

              <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
                ADD TO CART
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- New Arrivals Grid / Slider -->
      <div class="products-grid tab-content" id="tab-newarrivals">
        {newArrivals.map(product => (
          <div class="bellavita-card">
            <div class="card-media">
              <span class="bellavita-offer-badge" style="background: #e0f2fe; color: #0284c7;">NEW ARRIVAL</span>
              <a href={`/product/${product.id}`}>
                <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
              </a>
            </div>

            <div class="card-body">
              <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title">
                <a href={`/product/${product.id}`}>{product.name}</a>
              </h3>

              <div class="rating-row">
                <span class="star-icon">★ {product.rating}</span>
                <span class="verified-check">✓</span>
                <span class="reviews-count">({product.reviewsCount} Reviews)</span>
              </div>

              <div class="price-row">
                <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>

              <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
                ADD TO CART
              </button>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- View All Button -->
    <div class="view-all-wrapper">
      <a href="/shop" class="bellavita-view-all-btn">VIEW ALL</a>
    </div>

  </div>
</section>

<style>
  .bellavita-tabbed-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tabs-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.75rem;
  }
  .tab-btn {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: #bbbbbb;
    letter-spacing: 0.06em;
    transition: var(--transition-fast);
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .tab-btn.active {
    color: #111111;
    font-weight: 700;
  }
  .tab-divider {
    font-size: 1.5rem;
    color: #e0e0e0;
    font-weight: 400;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  /* Desktop Grid Container (4 items per row) */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 0.5rem 0.25rem 1.25rem;
  }
  .tab-content {
    display: none !important;
  }
  .tab-content.active {
    display: grid !important;
  }

  /* Bellavita Luxury Card */
  .bellavita-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bellavita-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border-color: #d1d1d1;
  }

  /* Bellavita Soft Off-White Framed Image Box */
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f4f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    box-sizing: border-box;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.05));
    transition: transform 0.3s ease;
  }
  .bellavita-card:hover .product-img {
    transform: scale(1.04);
  }

  /* Bellavita Exact Muted Pastel Badges */
  .badge-bestseller {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #dfab85;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 3px;
    z-index: 2;
    text-transform: uppercase;
  }
  .bellavita-offer-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: #67c5a9;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
    z-index: 2;
    text-transform: uppercase;
  }

  .card-body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .subtitle-tag {
    font-size: 0.68rem;
    color: #888888;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }
  .product-title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
    height: 2.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-main);
  }
  .product-title a {
    color: inherit;
    text-decoration: none;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    margin-bottom: 0.65rem;
  }
  .star-icon { color: #f59e0b; font-weight: 700; }
  .verified-check { color: #2563eb; font-weight: 700; font-size: 0.75rem; }
  .reviews-count { color: #777777; font-weight: 400; }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
    margin-top: auto;
  }
  .current-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111111;
  }
  .old-price {
    font-size: 0.82rem;
    color: #999999;
    text-decoration: line-through;
  }

  .bellavita-cart-btn {
    width: 100%;
    background: #111111;
    color: #ffffff;
    border: none;
    padding: 0.75rem;
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .bellavita-cart-btn:hover {
    background: #333333;
  }

  .view-all-wrapper {
    text-align: center;
    margin-top: 2.5rem;
  }
  .bellavita-view-all-btn {
    display: inline-block;
    background: #ffffff;
    color: #1a1a1a;
    border: 1.5px solid #1a1a1a;
    padding: 0.75rem 3rem;
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .bellavita-view-all-btn:hover {
    background: #1a1a1a;
    color: #ffffff;
  }

  /* Mobile Only Touch Horizontal Slider (< 768px) */
  @media (max-width: 768px) {
    .bellavita-tabbed-section { padding: 2rem 0; }
    .tabs-header { gap: 0.85rem; margin-bottom: 1.5rem; }
    .tab-btn, .tab-divider { font-size: 1.15rem; }

    .products-grid.tab-content.active {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.85rem;
      padding: 0.25rem 0.85rem 1rem;
      margin: 0 -0.85rem;
      scrollbar-width: none;
    }
    .products-grid::-webkit-scrollbar {
      display: none;
    }
    .bellavita-card {
      flex: 0 0 78%;
      max-width: 250px;
      scroll-snap-align: start;
    }
    .card-body { padding: 0.75rem 0.6rem; }
    .product-title { font-size: 0.78rem; height: 2.2rem; margin-bottom: 0.35rem; }
    .rating-row { font-size: 0.7rem; margin-bottom: 0.35rem; }
    .current-price { font-size: 0.85rem; }
    .old-price { font-size: 0.72rem; }
    .bellavita-cart-btn { padding: 0.6rem 0.3rem; font-size: 0.7rem; }
    .view-all-wrapper { margin-top: 1.5rem; }
    .bellavita-view-all-btn { padding: 0.6rem 2rem; font-size: 0.75rem; }
  }
</style>

<script>
  import { addToCart } from '../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(target!)?.classList.add('active');
      });
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (id) addToCart(id, 1);
      });
    });
  });
</script>
