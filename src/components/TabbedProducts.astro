---
import { PRODUCTS } from '../data/products';

const bestsellers = PRODUCTS.filter(p => p.isBestseller).slice(0, 8);
const newArrivals = PRODUCTS.filter(p => p.isNewArrival).slice(0, 8);
---

<section class="bellavita-tabbed-section">
  <div class="container">
    
    <!-- Tab Headers (Bellavita Style) -->
    <div class="tabs-header">
      <button class="tab-btn active" data-target="tab-bestsellers">BESTSELLERS</button>
      <span class="tab-divider">|</span>
      <button class="tab-btn" data-target="tab-newarrivals">NEW ARRIVALS</button>
    </div>

    <!-- Relative Slider Container with Left/Right Navigation Arrows -->
    <div class="slider-wrapper-relative">
      <button class="slider-arrow prev-btn" id="prod-slider-prev" aria-label="Previous Slide">‹</button>
      
      <!-- Bestsellers Grid / Slider -->
      <div class="products-grid tab-content active" id="tab-bestsellers">
        {bestsellers.map(product => (
          <div class="bellavita-card">
            <div class="card-media">
              <span class="badge-bestseller">BESTSELLER</span>
              {product.discountBadge && <span class="bellavita-offer-badge">{product.discountBadge}</span>}
              <a href={`/product/${product.id}`}>
                <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
              </a>
            </div>

            <div class="card-body">
              <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title">
                <a href={`/product/${product.id}`}>{product.name}</a>
              </h3>

              <div class="rating-row">
                <span class="star-icon">★ {product.rating}</span>
                <span class="verified-check">✓</span>
                <span class="reviews-count">({product.reviewsCount} Reviews)</span>
              </div>

              <div class="price-row">
                <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>

              <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
                ADD TO CART
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- New Arrivals Grid / Slider -->
      <div class="products-grid tab-content" id="tab-newarrivals">
        {newArrivals.map(product => (
          <div class="bellavita-card">
            <div class="card-media">
              <span class="bellavita-offer-badge" style="background: #e0f2fe; color: #0284c7;">NEW ARRIVAL</span>
              <a href={`/product/${product.id}`}>
                <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
              </a>
            </div>

            <div class="card-body">
              <div class="subtitle-tag">{product.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title">
                <a href={`/product/${product.id}`}>{product.name}</a>
              </h3>

              <div class="rating-row">
                <span class="star-icon">★ {product.rating}</span>
                <span class="verified-check">✓</span>
                <span class="reviews-count">({product.reviewsCount} Reviews)</span>
              </div>

              <div class="price-row">
                <span class="current-price">₹{product.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>

              <button class="bellavita-cart-btn add-to-cart-btn" data-id={product.id}>
                ADD TO CART
              </button>
            </div>
          </div>
        ))}
      </div>

      <button class="slider-arrow next-btn" id="prod-slider-next" aria-label="Next Slide">›</button>
    </div>

    <!-- View All Button -->
    <div class="view-all-wrapper">
      <a href="/shop" class="bellavita-view-all-btn">VIEW ALL</a>
    </div>

  </div>
</section>

<style>
  .bellavita-tabbed-section {
    padding: 4rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tabs-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .tab-btn {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: #888888;
    letter-spacing: 0.08em;
    transition: var(--transition-fast);
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .tab-btn.active {
    color: #1a1a1a;
  }
  .tab-divider {
    font-size: 1.6rem;
    color: #cccccc;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  .slider-arrow {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid #1a1a1a;
    border-radius: 50%;
    color: #1a1a1a;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }
  .slider-arrow:hover {
    background: #1a1a1a;
    color: #ffffff;
  }
  .slider-arrow.prev-btn { left: -16px; }
  .slider-arrow.next-btn { right: -16px; }

  /* Grid / Slider Container */
  .products-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 1.25rem;
    padding: 0.5rem 0.25rem 1.25rem;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .products-grid::-webkit-scrollbar {
    display: none;
  }
  .tab-content {
    display: none !important;
  }
  .tab-content.active {
    display: flex !important;
  }

  /* Card */
  .bellavita-card {
    flex: 0 0 270px;
    scroll-snap-align: start;
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition-smooth);
  }
  .bellavita-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    border-color: #1a1a1a;
  }

  .card-media {
    position: relative;
    padding-top: 75%;
    background: #ffffff;
  }
  .product-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-bestseller {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #eab308;
    color: #000;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    z-index: 2;
  }
  .bellavita-offer-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: #c6f6d5;
    color: #22543d;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    z-index: 2;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .subtitle-tag {
    font-size: 0.65rem;
    color: #777777;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }
  .product-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 0.6rem;
    height: 2.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-title a {
    color: inherit;
    text-decoration: none;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .star-icon { color: #f59e0b; font-weight: 800; }
  .verified-check { color: #059669; font-weight: 800; }
  .reviews-count { color: #666; }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
    margin-top: auto;
  }
  .current-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #3b0811;
  }
  .old-price {
    font-size: 0.85rem;
    color: #888888;
    text-decoration: line-through;
  }

  .bellavita-cart-btn {
    width: 100%;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .bellavita-cart-btn:hover {
    background: #333333;
  }

  .view-all-wrapper {
    text-align: center;
    margin-top: 2.5rem;
  }
  .bellavita-view-all-btn {
    display: inline-block;
    background: #ffffff;
    color: #1a1a1a;
    border: 1.5px solid #1a1a1a;
    padding: 0.75rem 3rem;
    border-radius: var(--radius-sm);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    transition: var(--transition-fast);
    text-decoration: none;
  }
  .bellavita-view-all-btn:hover {
    background: #1a1a1a;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .bellavita-tabbed-section { padding: 2rem 0; }
    .tabs-header { gap: 0.85rem; margin-bottom: 1.5rem; }
    .tab-btn, .tab-divider { font-size: 1.15rem; }
    
    .slider-arrow.prev-btn { left: 2px; width: 34px; height: 34px; font-size: 1.2rem; }
    .slider-arrow.next-btn { right: 2px; width: 34px; height: 34px; font-size: 1.2rem; }

    .products-grid {
      padding: 0.25rem 0.5rem 1rem;
      gap: 0.85rem;
    }
    .bellavita-card {
      flex: 0 0 78%;
      max-width: 250px;
    }
    .card-body { padding: 0.75rem 0.6rem; }
    .product-title { font-size: 0.78rem; height: 2.2rem; margin-bottom: 0.35rem; }
    .rating-row { font-size: 0.7rem; margin-bottom: 0.35rem; }
    .current-price { font-size: 0.85rem; }
    .old-price { font-size: 0.72rem; }
    .bellavita-cart-btn { padding: 0.6rem 0.3rem; font-size: 0.7rem; }
    .view-all-wrapper { margin-top: 1.5rem; }
    .bellavita-view-all-btn { padding: 0.6rem 2rem; font-size: 0.75rem; }
  }
</style>

<script>
  import { addToCart } from '../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    const prevBtn = document.getElementById('prod-slider-prev');
    const nextBtn = document.getElementById('prod-slider-next');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(target!)?.classList.add('active');
      });
    });

    // Arrow Slider Navigation
    prevBtn?.addEventListener('click', () => {
      const activeGrid = document.querySelector('.products-grid.tab-content.active');
      activeGrid?.scrollBy({ left: -280, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const activeGrid = document.querySelector('.products-grid.tab-content.active');
      activeGrid?.scrollBy({ left: 280, behavior: 'smooth' });
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (id) addToCart(id, 1);
      });
    });
  });
</script>
