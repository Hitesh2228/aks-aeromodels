---
const FAQS = [
  {
    q: "How do I choose the right engine for my Seagull ARF model?",
    a: "Check your model's recommended displacement range in the product specifications table. For example, a .46 - .55 size airframe pairs perfectly with the O.S. Max 0.46 AX II or O.S. MAX-65AX 2-stroke engine."
  },
  {
    q: "Are Futaba radios pre-bound and ready to fly out of the box?",
    a: "Yes! All Futaba radio transmitter and receiver combos (such as the Futaba 6K and R3008SB) are pre-linked at the factory using 2.4GHz T-FHSS telemetry. Simply connect your servos and receiver battery to start."
  },
  {
    q: "What is the shipping time across India for Balsa Sheets & ARF Kits?",
    a: "We dispatch all orders within 24 hours from our Devlali Camp distribution hub. Standard express transit takes 2-4 business days to major metros and 3-5 days to other locations with 100% insured freight."
  },
  {
    q: "Do you provide GST Invoices for bulk institutional or lab purchases?",
    a: "Yes! We issue official B2B GST tax invoices with 18% input tax credit for schools, engineering colleges, aeromodelling clubs, and defense laboratories. Enter your GSTIN during checkout or contact us on WhatsApp."
  },
  {
    q: "What warranty is included on O.S. Engine & DLE Gas Engines?",
    a: "All O.S. Max Glow Engines and DLE Gas Engines purchased from SKYNODESUAV come with an official 1-year manufacturer defect warranty and factory inspection support."
  }
];
---

<section class="bellavita-faq-section reveal-on-scroll">
  <div class="container">
    <h2 class="bellavita-title">FREQUENTLY ASKED QUESTIONS</h2>
    <p class="bellavita-subtitle">Everything you need to know about flight compatibility, shipping, and warranty</p>

    <div class="faq-accordion-container">
      {FAQS.map((faq, i) => (
        <div class="faq-item" data-faq-index={i}>
          <button class="faq-question-btn" type="button" aria-expanded="false">
            <span class="faq-question-text">{faq.q}</span>
            <span class="faq-icon-plus">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="vertical-line"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </span>
          </button>
          <div class="faq-answer-panel">
            <p class="faq-answer-text">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bellavita-faq-section {
    padding: 4.5rem 0 5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    min-height: 540px;
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    color: #111111;
    font-weight: 600;
  }
  .bellavita-subtitle {
    text-align: center;
    color: #777777;
    font-size: 0.88rem;
    margin-bottom: 2.75rem;
  }

  .faq-accordion-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 320px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq-item:hover {
    border-color: #d1d1d1;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }
  .faq-item.is-open {
    border-color: #111111;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .faq-question-btn {
    width: 100%;
    padding: 1.2rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-main);
  }
  .faq-question-text {
    font-size: 0.92rem;
    font-weight: 600;
    color: #111111;
    line-height: 1.45;
  }
  .faq-icon-plus {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }
  .faq-item.is-open .vertical-line {
    opacity: 0;
  }
  .faq-item.is-open .faq-icon-plus {
    transform: rotate(90deg);
  }

  .faq-answer-panel {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease, padding 0.35s ease;
    padding: 0 1.4rem;
    background: #ffffff;
  }
  .faq-item.is-open .faq-answer-panel {
    max-height: 350px;
    opacity: 1;
    padding: 0 1.4rem 1.25rem;
  }
  .faq-answer-text {
    font-size: 0.88rem;
    color: #555555;
    line-height: 1.65;
    border-top: 1px solid #f4f4f6;
    padding-top: 0.85rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .bellavita-faq-section {
      padding: 2.5rem 0 3.5rem;
    }
    .bellavita-title {
      font-size: 1.2rem;
    }
    .bellavita-subtitle {
      font-size: 0.8rem;
      margin-bottom: 1.75rem;
    }
    .faq-question-btn {
      padding: 1rem;
    }
    .faq-question-text {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  function initFAQAccordion() {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-question-btn');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        faqItems.forEach(i => {
          i.classList.remove('is-open');
          i.querySelector('.faq-question-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQAccordion);
  } else {
    initFAQAccordion();
  }
  document.addEventListener('astro:page-load', initFAQAccordion);
</script>
