---

<section class="bellavita-notes-section">
  <div class="container">
    <h2 class="bellavita-title">SHOP BY SPECIFICATIONS</h2>

    <div class="slider-wrapper-relative">
      <div class="notes-icons-grid" id="notes-slider-container">
        {NOTES.map(note => (
          <a href="/shop" class="note-item">
            <div class="note-circle">
              <Fragment set:html={note.svg} />
            </div>
            <span class="note-label">{note.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-notes-section {
    padding: 3.5rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  /* Desktop Flex Row (Centered) */
  .notes-icons-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: var(--transition-smooth);
  }
  .note-item:hover {
    transform: translateY(-4px);
  }
  .note-item:hover .note-circle {
    border-color: #3b0811;
    background: #ffffff;
    box-shadow: 0 6px 15px rgba(59, 8, 17, 0.08);
  }
  .note-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #f3eee7;
    border: 1.5px solid #e6e0d5;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
  }
  .note-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    text-align: center;
  }

  /* Mobile Only Touch Horizontal Slider (< 768px) */
  @media (max-width: 768px) {
    .bellavita-notes-section { padding: 2rem 0; }
    .bellavita-title { font-size: 1.2rem; margin-bottom: 1.25rem; }

    .notes-icons-grid {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 1.25rem;
      padding: 0.25rem 0.85rem 0.75rem;
      margin: 0 -0.85rem;
      justify-content: flex-start;
      scrollbar-width: none;
    }
    .notes-icons-grid::-webkit-scrollbar {
      display: none;
    }
    .note-item {
      flex: 0 0 82px;
      scroll-snap-align: center;
    }
    .note-circle {
      width: 64px;
      height: 64px;
    }
    .note-label {
      font-size: 0.68rem;
    }
  }
</style>
