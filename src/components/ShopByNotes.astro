---

<section class="bellavita-notes-section">
  <div class="container">
    <h2 class="bellavita-title">SHOP BY SPECIFICATIONS</h2>

    <div class="slider-wrapper-relative">
      <div class="notes-icons-grid" id="notes-slider-container">
        {NOTES.map(note => (
          <a href={note.url} class="note-item">
            <div class="note-circle">
              <Fragment set:html={note.svg} />
            </div>
            <span class="note-label">{note.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-notes-section {
    padding: 3.5rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  /* Desktop Flex Row (Centered) */
  .notes-icons-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3.5rem;
    flex-wrap: wrap;
    width: 100%;
    margin: 0 auto;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: var(--transition-smooth);
    min-width: 90px;
  }
  .note-item:hover {
    transform: translateY(-4px);
  }
  .note-item:hover .note-circle {
    border-color: #3b0811;
    background: #ffffff;
    box-shadow: 0 6px 15px rgba(59, 8, 17, 0.08);
  }
  .note-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #f3eee7;
    border: 1.5px solid #e6e0d5;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
  }
  .note-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    text-align: center;
  }

  /* Mobile View - Balanced 4-Item Centered Symmetrical Grid */
  @media (max-width: 768px) {
    .bellavita-notes-section {
      padding: 2.25rem 0;
    }
    .bellavita-title {
      font-size: 1.15rem;
      letter-spacing: 0.08em;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .notes-icons-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 0.5rem !important;
      padding: 0 !important;
      margin: 0 auto !important;
      width: 100% !important;
      max-width: 100% !important;
      justify-content: center !important;
      align-items: flex-start !important;
      overflow-x: visible !important;
    }

    .note-item {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      text-align: center !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      gap: 0.45rem !important;
    }

    .note-circle {
      width: 56px !important;
      height: 56px !important;
      margin: 0 auto !important;
    }
    .note-circle svg {
      width: 22px !important;
      height: 22px !important;
    }

    .note-label {
      font-size: 0.65rem !important;
      font-weight: 700 !important;
      letter-spacing: 0.02em !important;
      text-align: center !important;
      white-space: normal !important;
      line-height: 1.2 !important;
      word-break: normal !important;
      color: #1a1a1a !important;
    }
  }

  @media (max-width: 380px) {
    .notes-icons-grid {
      gap: 0.25rem !important;
    }
    .note-circle {
      width: 48px !important;
      height: 48px !important;
    }
    .note-circle svg {
      width: 18px !important;
      height: 18px !important;
    }
    .note-label {
      font-size: 0.58rem !important;
    }
  }
</style>
