---
const NOTES = [
  { label: 'NITRO POWER', icon: '⚡', color: '#fee2e2' },
  { label: 'GASOLINE', icon: '⛽', color: '#fef3c7' },
  { label: '2-STROKE', icon: '🌀', color: '#e0e7ff' },
  { label: '4-STROKE', icon: '⚙️', color: '#e0f2fe' },
  { label: 'ARF SCALE', icon: '✈️', color: '#dcfce7' },
  { label: 'TRAINER', icon: '🎯', color: '#fae8ff' },
  { label: '3D FREESTYLE', icon: '🔥', color: '#ffedd5' },
];
---

<section class="bellavita-notes-section">
  <div class="container">
    <h2 class="bellavita-title">SHOP BY NOTES</h2>

    <div class="notes-icons-grid">
      {NOTES.map(note => (
        <a href="/shop" class="note-item">
          <div class="note-circle" style={`background-color: ${note.color};`}>
            <span class="note-icon">{note.icon}</span>
          </div>
          <span class="note-label">{note.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .bellavita-notes-section {
    padding: 3.5rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  .notes-icons-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .note-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition-smooth);
  }
  .note-item:hover {
    transform: translateY(-4px);
  }
  .note-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: var(--transition-fast);
  }
  .note-item:hover .note-circle {
    transform: scale(1.08);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }
  .note-icon {
    font-size: 2rem;
  }
  .note-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #333333;
    letter-spacing: 0.06em;
  }
</style>
