---
---

<!-- Bellavita Style Floating Mobile Bottom Navigation App Bar -->
<nav class="bellavita-mobile-bottom-nav" id="mobile-bottom-dock" aria-label="Mobile Navigation">
  <a href="/" class="nav-dock-item active" id="dock-home">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/shop" class="nav-dock-item" id="dock-shop">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"/>
      <rect x="14" y="3" width="7" height="7"/>
      <rect x="14" y="14" width="7" height="7"/>
      <rect x="3" y="14" width="7" height="7"/>
    </svg>
    <span>Shop All</span>
  </a>

  <a href="/profile#wishlist" class="nav-dock-item" id="dock-wishlist">
    <div class="wishlist-icon-dock-wrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span class="dock-wishlist-badge" id="dock-wishlist-badge">0</span>
    </div>
    <span>Wishlist</span>
  </a>

  <a href="/profile" class="nav-dock-item" id="dock-account">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
    <span>Account</span>
  </a>

  <button type="button" class="nav-dock-item" id="dock-cart-btn" aria-label="Open Cart">
    <div class="cart-icon-dock-wrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="dock-cart-badge" id="dock-cart-badge">0</span>
    </div>
    <span>Cart</span>
  </button>
</nav>

<style>
  .bellavita-mobile-bottom-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .bellavita-mobile-bottom-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: calc(60px + env(safe-area-inset-bottom, 0px));
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid #e6e0d5;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
      z-index: 999;
      justify-content: space-around;
      align-items: center;
      padding: 0 0.25rem env(safe-area-inset-bottom, 0px);
      box-sizing: border-box;
    }

    .nav-dock-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      color: #666666;
      text-decoration: none;
      font-size: 0.68rem;
      font-weight: 600;
      background: transparent;
      border: none;
      padding: 0.35rem 0.5rem;
      cursor: pointer;
      flex: 1;
      transition: color 0.2s ease;
    }

    .nav-dock-item:hover, .nav-dock-item.active {
      color: #3b0811;
      font-weight: 700;
    }

    .nav-dock-item svg {
      transition: transform 0.2s ease;
    }

    .nav-dock-item.active svg {
      stroke: #3b0811;
      transform: translateY(-1px);
    }

    .cart-icon-dock-wrap,
    .wishlist-icon-dock-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .dock-cart-badge,
    .dock-wishlist-badge {
      position: absolute;
      top: -4px;
      right: -8px;
      background: #3b0811;
      color: #ffffff;
      font-size: 0.62rem;
      font-weight: 800;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .dock-wishlist-badge {
      background: #991b1b;
    }
  }
</style>

<script>
  import { getCartCount } from '../lib/cartStore';
  import { getWishlistCount } from '../lib/wishlistStore';

  document.addEventListener('DOMContentLoaded', () => {
    const dockCartBtn = document.getElementById('dock-cart-btn');
    const dockBadge = document.getElementById('dock-cart-badge');
    const dockWishlistBadge = document.getElementById('dock-wishlist-badge');
    const path = window.location.pathname;
    const hash = window.location.hash;

    // Highlight active tab
    const dockItems = document.querySelectorAll('.nav-dock-item');
    dockItems.forEach(item => {
      const href = item.getAttribute('href');
      if (href) {
        if (href === '/' && path === '/') {
          item.classList.add('active');
        } else if (href === '/profile#wishlist') {
          if (path.startsWith('/profile') && hash === '#wishlist') {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        } else if (href === '/profile') {
          if (path.startsWith('/profile') && hash !== '#wishlist') {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        } else if (href !== '/' && path.startsWith(href)) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      }
    });

    function updateDockBadge() {
      const count = getCartCount();
      if (dockBadge) {
        dockBadge.textContent = count.toString();
        dockBadge.style.display = count > 0 ? 'flex' : 'none';
      }
    }

    function updateDockWishlistBadge() {
      const wCount = getWishlistCount();
      if (dockWishlistBadge) {
        dockWishlistBadge.textContent = wCount.toString();
        dockWishlistBadge.style.display = wCount > 0 ? 'flex' : 'none';
      }
    }

    dockCartBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cart-drawer'));
    });

    window.addEventListener('cart-updated', updateDockBadge);
    window.addEventListener('wishlist-updated', updateDockWishlistBadge);
    updateDockBadge();
    updateDockWishlistBadge();
  });
</script>
