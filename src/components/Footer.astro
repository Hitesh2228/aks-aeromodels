    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-links a {
    color: #bbbbbb;
    transition: var(--transition-fast);
  }
  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .contact-details p {
    margin-bottom: 0.75rem;
    line-height: 1.5;
    color: #bbbbbb;
  }
  .gold-link {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Newsletter */
