<style>
  /* Press Ticker */
  .press-ticker-section {
    background: #06070a;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
  }
  .press-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .press-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
  .press-logos {
    display: flex;
    align-items: center;
    gap: 2rem;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .press-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    opacity: 0.7;
    transition: var(--transition-fast);
  }
  .press-logo:hover {
    opacity: 1;
    color: var(--accent-gold);
  }

  /* Main Footer */
  .site-footer {
    background: #090b10;
    color: var(--text-secondary);
    padding: 4.5rem 0 2rem;
    font-size: 0.85rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .col-title {
    font-size: 0.95rem;
    color: #fff;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-links a:hover {
    color: var(--accent-gold);
  }

  .contact-details p {
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }
  .gold-link {
    color: var(--accent-gold);
  }

  /* Newsletter */
  .newsletter-col {
    grid-column: span 1;
  }
  .news-desc {
    margin-bottom: 1rem;
    line-height: 1.5;
    font-size: 0.8rem;
  }
  .newsletter-form {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--accent-gold);
    padding-bottom: 0.35rem;
    margin-bottom: 1.25rem;
  }
  .news-input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    width: 100%;
    font-size: 0.85rem;
  }
  .news-submit-btn {
    color: var(--accent-gold);
    font-size: 1.2rem;
    padding: 0 0.5rem;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    font-size: 1.2rem;
  }

  /* Scam Alert Box */
  .scam-alert-box {
    border: 1px solid rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.05);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  .alert-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-red);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .alert-body {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Keywords Cloud */
  .keywords-cloud {
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
    margin-bottom: 2rem;
  }
  .cloud-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .cloud-tags {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  /* Copyright */
  .copyright-bar {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* WhatsApp Floating Button */
  .whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 56px;
    height: 56px;
    background: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
    z-index: 999;
    transition: var(--transition-fast);
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }
</style>
