    border: 1px solid #ef4444;
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    background: rgba(0, 0, 0, 0.2);
  }
  .alert-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ef4444;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .alert-body {
    font-size: 0.8rem;
    color: #dddddd;
    margin-bottom: 0.75rem;
  }
  .alert-bullets {
    list-style: disc;
    padding-left: 1.25rem;
    font-size: 0.78rem;
    color: #cccccc;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    line-height: 1.5;
