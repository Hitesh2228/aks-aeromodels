<style>
  /* Media Logos */
  .bellavita-press-section {
    background: #ffffff;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.5rem 0;
  }
  .press-flex {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .press-logo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #888888;
    letter-spacing: 0.1em;
  }
  .press-logo.highlight {
    color: #e11d48;
  }

  /* Main Footer */
  .site-footer {
    background: #262626;
    color: #ffffff;
    padding: 4rem 0 2rem;
    font-size: 0.85rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .col-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-links a {
    color: #cccccc;
    transition: var(--transition-fast);
  }
  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .contact-details p {
    color: #cccccc;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .gold-link {
    color: #e6c875;
    font-weight: 700;
  }

  /* Newsletter */
  .newsletter-form {
    display: flex;
    margin-bottom: 1rem;
  }
  .news-input {
    background: #333333;
    border: 1px solid #444444;
    color: #ffffff;
    padding: 0.6rem 0.85rem;
    font-size: 0.8rem;
    border-radius: 4px 0 0 4px;
    width: 100%;
    outline: none;
  }
  .news-submit-btn {
    background: #ffffff;
    color: #262626;
    font-weight: 800;
    padding: 0.6rem 1rem;
    border-radius: 0 4px 4px 0;
  }
  .news-desc {
    color: #aaaaaa;
    font-size: 0.78rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  .social-icons {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 1.2rem;
  }

  /* Copyright Bar */
  .copyright-bar {
    border-top: 1px solid #333333;
    padding-top: 1.5rem;
    text-align: center;
    color: #888888;
    font-size: 0.8rem;
  }

  /* WhatsApp Float Button */
  .whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: #25d366;
    color: #ffffff;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
    z-index: 99;
    transition: var(--transition-fast);
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
  }

  @media (max-width: 990px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
