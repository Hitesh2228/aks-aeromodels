<style>
  /* Main Footer (Bellavita Dark Slate Tone) */
  .site-footer {
    background: #383838;
    color: #ffffff;
    padding: 3.5rem 0 2rem;
    font-size: 0.85rem;
    border-top: 1px solid #4a4a4a;
  }

  /* Exclusive Newsletter Top Block (Bellavita Exact Layout) */
  .footer-exclusive-block {
    max-width: 480px;
    margin-bottom: 2.5rem;
  }
  .exclusive-title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
  }
  .exclusive-newsletter-form {
    margin-bottom: 1.25rem;
  }
  .email-input-wrapper {
    position: relative;
    width: 100%;
    border-bottom: 1px solid #777777;
    display: flex;
    align-items: center;
    padding-bottom: 0.35rem;
  }
  .exclusive-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.95rem;
    font-family: var(--font-main);
  }
  .exclusive-input::placeholder {
    color: #aaaaaa;
  }
  .exclusive-submit-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.5rem;
  }
  .exclusive-desc {
    color: #cccccc;
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .exclusive-subdesc {
    color: #cccccc;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Desktop Grid (4 Columns) */
  .footer-accordion-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer-acc-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0;
    text-align: left;
    width: 100%;
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: default;
  }
  .acc-chevron {
    display: none; /* Hidden on desktop */
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
  }
  .footer-links a {
    color: #cccccc;
    text-decoration: none;
    font-size: 0.82rem;
    line-height: 1.4;
    transition: color 0.2s ease, padding 0.2s ease;
  }
  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .contact-details p {
    color: #cccccc;
    line-height: 1.6;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }
  .gold-link {
    color: #e6c875;
    font-weight: 700;
    text-decoration: none;
  }

  /* Social Icons Row */
  .footer-social-row {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .footer-social-row a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  .footer-social-row a:hover svg {
    stroke: #ffffff;
    transform: translateY(-2px);
  }

  /* Copyright Bar */
  .copyright-bar {
    border-top: 1px solid #4a4a4a;
    padding-top: 1.5rem;
    color: #aaaaaa;
    font-size: 0.78rem;
  }

  /* Compact Floating WhatsApp Icon */
  .whatsapp-float {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background: #25d366;
    color: #ffffff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
    z-index: 99;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
    background: #20ba5a;
  }

  /* Mobile Collapsible Accordion Styling (< 768px - Exact Bellavita Mobile Footer Match) */
  @media (max-width: 768px) {
    .site-footer {
      padding: 2.5rem 0 5.5rem; /* Leaves clearance for Mobile Bottom Nav bar */
    }
    .footer-exclusive-block {
      margin-bottom: 2rem;
      border-bottom: 1px solid #4a4a4a;
      padding-bottom: 1.75rem;
    }
    .footer-accordion-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 2rem;
    }
    .footer-acc-block {
      border-bottom: 1px solid #4a4a4a;
    }
    .footer-acc-btn {
      cursor: pointer;
      padding: 1.1rem 0;
      margin-bottom: 0;
      user-select: none;
    }
    .acc-chevron {
      display: inline-block;
      font-size: 0.85rem;
      transition: transform 0.3s ease;
      color: #aaaaaa;
    }
    .footer-acc-btn.is-open .acc-chevron {
      transform: rotate(180deg);
    }
    .footer-acc-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.35s ease;
    }
    .footer-acc-block.is-open .footer-acc-content {
      max-height: 400px;
      padding-bottom: 1.25rem;
    }
    .whatsapp-float {
      bottom: 74px !important;
      right: 1rem !important;
      width: 44px !important;
      height: 44px !important;
    }
  }
</style>

<script>
  function initFooterAccordions() {
    const accBlocks = document.querySelectorAll('.footer-acc-block');

    accBlocks.forEach(block => {
      const btn = block.querySelector('.footer-acc-btn');
      btn?.addEventListener('click', () => {
        // Toggle active class on mobile
        if (window.innerWidth <= 768) {
          const isOpen = block.classList.contains('is-open');
          
          // Close all other blocks for clean single accordion open
          accBlocks.forEach(b => {
            b.classList.remove('is-open');
            b.querySelector('.footer-acc-btn')?.classList.remove('is-open');
          });

          if (!isOpen) {
            block.classList.add('is-open');
            btn.classList.add('is-open');
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterAccordions);
  } else {
    initFooterAccordions();
  }
  document.addEventListener('astro:page-load', initFooterAccordions);
</script>
