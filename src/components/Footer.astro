    display: flex;
    align-items: center;
    border-bottom: 1px solid #777777;
    padding-bottom: 0.35rem;
    margin-bottom: 1rem;
  }
  .news-input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    width: 100%;
    font-size: 0.85rem;
  }
  .news-submit-btn {
    color: #ffffff;
    font-size: 1.1rem;
  }
  .news-desc {
    font-size: 0.78rem;
    color: #aaaaaa;
    line-height: 1.4;
    margin-bottom: 0.5rem;
