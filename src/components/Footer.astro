<style>
  /* Media Logos */
  .bellavita-press-section {
    background: #ffffff;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.5rem 0;
  }
  .press-flex {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .press-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    color: #1a1a1a;
    letter-spacing: 0.05em;
  }
  .press-logo.highlight {
    color: #ec4899;
  }

  /* Footer Main */
  .site-footer {
    background: #333333;
    color: #cccccc;
    padding: 4rem 0 2rem;
    font-size: 0.82rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .col-title {
    font-size: 0.9rem;
    color: #ffffff;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    font-weight: 800;
  }
