---
const BANNERS = [
  {
    id: 1,
    badgeTitle: "FLAT ₹800 OFF ENGINES",
    badgeSub: "SPECIAL PROMO • LIMITED TIME OFFER",
    img: "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=1200&auto=format&fit=crop",
    brandSub: "SKYNODESUAV • NITRO & GAS POWER",
    collName: "CONTEST GRADE POWERPLANTS",
    collSub: "GET EXTRA 5% PREPAID DISCOUNT ON CHECKOUT",
    wreathNum: "01",
    wreathText: "FEATURED DEAL",
    pill1Title: "BUY OS MAX",
    pill1Was: "₹15,999",
    pill1Now: "₹12,499",
    pill2Title: "BUY DLE 65",
    pill2Was: "₹48,999",
    pill2Now: "₹42,999",
    ctaLink: "/shop?category=engine",
    ctaText: "CLAIM OFFER NOW ➔"
  },
  {
    id: 2,
    badgeTitle: "UP TO 25% OFF RADIOS",
    badgeSub: "FUTABA & FRSKY 2.4GHz SYSTEMS",
    img: "https://images.unsplash.com/photo-1508614589041-895b88991e3e?q=80&w=1200&auto=format&fit=crop",
    brandSub: "PRECISION TELEMETRY & CONTROL",
    collName: "FUTABA 6K & 16IZ TRANSMITTERS",
    collSub: "FREE RECEIVER BUNDLE WITH SELECT RADIOS",
    wreathNum: "02",
    wreathText: "LIMITED DEAL",
    pill1Title: "FUTABA 6K",
    pill1Was: "₹24,999",
    pill1Now: "₹19,999",
    pill2Title: "R3006SB RCVR",
    pill2Was: "₹6,499",
    pill2Now: "₹4,999",
    ctaLink: "/shop?category=radio-receiver",
    ctaText: "GET RADIO OFFER ➔"
  },
  {
    id: 3,
    badgeTitle: "SAVE UP TO ₹12,500",
    badgeSub: "PREMIUM SEAGULL ARF KITS",
    img: "https://images.unsplash.com/photo-1519074069444-1ba4eff56024?q=80&w=1200&auto=format&fit=crop",
    brandSub: "SEAGULL MODELS OFFICIAL DISTRIBUTOR",
    collName: "DECATHLON 122\" & BOOMERANG V3",
    collSub: "100% FACTORY SEALED WITH FAST EXPRESS SHIPPING",
    wreathNum: "03",
    wreathText: "TOP ARF SALE",
    pill1Title: "BOOMERANG V3",
    pill1Was: "₹18,999",
    pill1Now: "₹15,999",
    pill2Title: "DECATHLON 122\"",
