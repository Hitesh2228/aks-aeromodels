---

<section class="bellavita-hero-section">
  <div class="hero-container">
    
    <!-- Hero Slider Track Wrapper -->
    <div class="hero-slider-stage">
      
      <!-- Slides Track -->
      <div class="hero-slides-track" id="hero-track">
        {BANNERS.map((banner, index) => (
          <div class={`hero-banner-card slide-item ${index === 0 ? 'active' : ''}`}>
            
            <!-- Left Offer Seal -->
            <div class="hero-left-offer">
              <div class="offer-seal">
                <span class="seal-price">{banner.badgeTitle}</span>
                <span class="seal-timer">{banner.badgeSub}</span>
              </div>
            </div>

            <!-- Center Product Showcase -->
            <div class="hero-center-products">
              <img src={banner.img} alt={banner.collName} class="hero-products-img" loading="eager" />
              <div class="collection-title-badge">
                <span class="brand-sub">{banner.brandSub}</span>
                <span class="coll-name">{banner.collName}</span>
                <span class="coll-sub">{banner.collSub}</span>
              </div>
            </div>

            <!-- Right Promo -->
            <div class="hero-right-promo">
              <div class="sale-wreath-badge">
                <span class="wreath-num">{banner.wreathNum}</span>
                <span class="wreath-text">{banner.wreathText}</span>
              </div>

              <div class="hero-pills-stack">
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill1Title}</span>
                  <span class="pill-was">{banner.pill1Was}</span>
                  <span class="pill-now">{banner.pill1Now}</span>
                </a>
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill2Title}</span>
                  <span class="pill-was">{banner.pill2Was}</span>
                  <span class="pill-now">{banner.pill2Now}</span>
                </a>
              </div>

              <a href={banner.ctaLink} class="btn-hero-cta">
                {banner.ctaText}
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .bellavita-hero-section {
    background: #3b0811;
    background: linear-gradient(135deg, #2b050d 0%, #4a0e17 50%, #31060e 100%);
    padding: 2.25rem 0;
    overflow: hidden;
    position: relative;
  }
  .hero-container {
    max-width: 1350px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .hero-slider-stage {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }
  .hero-nav-arrow, .hero-dots-pagination {
    display: none !important;
  }
  .hero-slides-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }
  .hero-banner-card {
    flex: 0 0 100%;
    min-width: 100%;
    display: grid;
    grid-template-columns: 260px 1fr 320px;
    align-items: center;
    gap: 2rem;
    padding: 2.25rem 2.25rem;
    min-height: 440px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 12px;
  }

  /* Left Offer Seal */
  .hero-left-offer {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .offer-seal {
    border: 2px solid #eab308;
    padding: 1.5rem 1.25rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.5);
    text-align: center;
    box-shadow: 0 0 30px rgba(234, 179, 8, 0.2);
  }
  .seal-price {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: #eab308;
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }
  .seal-timer {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Center Product Showcase */
  .hero-center-products {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .hero-products-img {
    width: 100%;
    height: 340px;
    max-height: 380px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .collection-title-badge {
    position: absolute;
    bottom: -15px;
    background: rgba(17, 17, 17, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.4);
    padding: 0.6rem 1.25rem;
    border-radius: 30px;
    text-align: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
  }
  .brand-sub {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #eab308;
    text-transform: uppercase;
  }
  .coll-name {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.05em;
  }
  .coll-sub {
    display: block;
    font-size: 0.65rem;
    color: #cbd5e1;
  }

  /* Right Promo Column */
  .hero-right-promo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
  }
  .sale-wreath-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid #eab308;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }
  .wreath-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: #eab308;
  }
  .wreath-text {
    font-size: 0.68rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
  }

  .hero-pills-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }
  .hero-pill-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--transition-fast);
  }
  .hero-pill-row:hover {
    border-color: #eab308;
    background: rgba(0, 0, 0, 0.7);
  }
  .pill-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }
  .pill-was {
    font-size: 0.7rem;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .pill-now {
    font-size: 0.8rem;
    font-weight: 800;
    color: #eab308;
  }

  .btn-hero-cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: #eab308;
    color: #111111;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(234, 179, 8, 0.3);
  }
  .btn-hero-cta:hover {
    background: #ffffff;
    color: #111111;
    transform: translateY(-2px);
  }

  /* Mobile Only Adjustments (< 768px) */
  @media (max-width: 768px) {
    .bellavita-hero-section {
      padding: 0.75rem 0.5rem;
    }
    .hero-banner-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 0.5rem;
      gap: 0.75rem;
    }
    .hero-left-offer, .hero-right-promo {
      align-items: center;
    }
    .hero-products-img {
      max-height: 160px;
    }
    .collection-title-badge {
      position: relative;
      bottom: 0;
      left: 0;
      transform: none;
      margin-top: 0.5rem;
      border-radius: 8px;
    }
    .hero-pills-stack {
      max-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('hero-track');
    let currentIndex = 0;
    const totalSlides = 4;
    let autoSlideInterval: any;

    function goToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
    }

    function startAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
      autoSlideInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4000);
    }

    startAutoSlide();
  });
</script>
