    pill1Now: bal1 ? `₹${bal1.price.toLocaleString('en-IN')}` : "₹199",
    pill2Title: "BALSA 3MM",
    pill2Was: bal2 ? `₹${bal2.originalPrice.toLocaleString('en-IN')}` : "₹399",
    pill2Now: bal2 ? `₹${bal2.price.toLocaleString('en-IN')}` : "₹249",
    ctaLink: bal1 ? `/product/${bal1.id}` : "/shop?category=balsa-wood",
    ctaText: "CLAIM BALSA DEAL ➔"
  }
];

// If client has tagged specific products with 'hero' or 'hero:1' in Shopify, dynamically convert them!
const BANNERS = heroTaggedProducts.length > 0
  ? heroTaggedProducts.map((p, idx) => {
      return {
        id: idx + 1,
        badgeTitle: p.heroBadge || p.discountBadge || "EXCLUSIVE DEAL",
        badgeSub: p.heroSub || `${p.categoryLabel.toUpperCase()} • LIMITED TIME`,
        img: p.image,
        imgMobile: p.image,
        brandSub: `SKYNODESUAV • ${p.categoryLabel.toUpperCase()}`,
        collName: p.name,
        collSub: p.specs?.['Wingspan'] || p.specs?.['Power Output'] || p.specs?.['Displacement'] || "100% FACTORY FRESH • EXPRESS SHIPPING",
        wreathNum: String(idx + 1).padStart(2, '0'),
        wreathText: "FEATURED",
        pill1Title: "BUY ONLINE",
        pill1Was: `₹${p.originalPrice.toLocaleString('en-IN')}`,
        pill1Now: `₹${p.price.toLocaleString('en-IN')}`,
        pill2Title: "GST INVOICE",
        pill2Was: "INCLUDED",
        pill2Now: "18% ITC",
        ctaLink: `/product/${p.id}`,
        ctaText: "CLAIM OFFER NOW ➔"
      };
    })
  : defaultBanners;
---

<section class="bellavita-hero-section">
  <div class="hero-container">
    
    <!-- Hero Slider Track Wrapper -->
    <div class="hero-slider-stage">
      
      <!-- Slides Track -->
      <div class="hero-slides-track" id="hero-track">
        {BANNERS.map((banner, index) => (
          <div class={`hero-banner-card slide-item ${index === 0 ? 'active' : ''}`}>
            
            <!-- Left Offer Seal -->
            <div class="hero-left-offer">
              <div class="offer-seal">
                <span class="seal-price">{banner.badgeTitle}</span>
                <span class="seal-timer">{banner.badgeSub}</span>
              </div>
            </div>

            <!-- Center Product Showcase -->
            <a href={banner.ctaLink} class="hero-center-products" aria-label={`View ${banner.collName}`}>
              <div class="hero-product-frame">
                <img
                  src={banner.img}
                  srcset={`${banner.imgMobile || banner.img} 500w, ${banner.img} 800w`}
                  sizes="(max-width: 768px) 100vw, 800px"
                  alt={banner.collName}
                  class="hero-products-img"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding={index === 0 ? "sync" : "async"}
                  fetchpriority={index === 0 ? "high" : "low"}
                  width="800"
                  height="500"
                />
              </div>
              <div class="collection-title-badge">
                <span class="brand-sub">{banner.brandSub}</span>
                <span class="coll-name">{banner.collName}</span>
                <span class="coll-sub">{banner.collSub}</span>
              </div>
            </a>

            <!-- Right Promo -->
            <div class="hero-right-promo">
              <div class="sale-wreath-badge">
                <span class="wreath-num">{banner.wreathNum}</span>
                <span class="wreath-text">{banner.wreathText}</span>
              </div>

              <div class="hero-pills-stack">
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill1Title}</span>
                  <span class="pill-was">{banner.pill1Was}</span>
                  <span class="pill-now">{banner.pill1Now}</span>
                </a>
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill2Title}</span>
                  <span class="pill-was">{banner.pill2Was}</span>
                  <span class="pill-now">{banner.pill2Now}</span>
                </a>
              </div>

              <a href={banner.ctaLink} class="btn-hero-cta">
                {banner.ctaText}
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .bellavita-hero-section {
    background: #3b0811;
    background: linear-gradient(135deg, #2b050d 0%, #4a0e17 50%, #31060e 100%);
    padding: 2.25rem 0;
    overflow: hidden;
    position: relative;
  }
  .hero-container {
    max-width: 1350px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .hero-slider-stage {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }
  .hero-nav-arrow, .hero-dots-pagination {
    display: none !important;
  }
  .hero-slides-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }
  .hero-banner-card {
    flex: 0 0 100%;
    min-width: 100%;
    display: grid;
    grid-template-columns: 260px 1fr 320px;
    align-items: center;
    gap: 2rem;
    padding: 2.25rem 2.25rem;
    min-height: 440px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 12px;
  }

  /* Left Offer Seal */
  .hero-left-offer {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .offer-seal {
    border: 2px solid #eab308;
    padding: 1.5rem 1.25rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.5);
    text-align: center;
    box-shadow: 0 0 30px rgba(234, 179, 8, 0.2);
  }
  .seal-price {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: #eab308;
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }
  .seal-timer {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Center Product Showcase */
  .hero-center-products {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 100%;
  }
  .hero-product-frame {
    width: 100%;
    height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, rgba(15, 2, 5, 0.55) 75%);
    border-radius: 14px;
    border: 1px solid rgba(245, 158, 11, 0.3);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), inset 0 0 35px rgba(0, 0, 0, 0.35);
    padding: 1.25rem 1.5rem 1.85rem;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-center-products:hover .hero-product-frame {
    transform: translateY(-3px);
    border-color: rgba(245, 158, 11, 0.6);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7), 0 0 25px rgba(234, 179, 8, 0.25);
  }
  .hero-products-img {
    width: 100%;
    height: 100%;
    max-height: 310px;
    object-fit: contain !important; /* CRITICAL: 100% full view, never cropped */
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.75));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-center-products:hover .hero-products-img {
    transform: scale(1.04);
  }
  .collection-title-badge {
    position: absolute;
    bottom: -15px;
    background: rgba(17, 17, 17, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.45);
    padding: 0.6rem 1.25rem;
    border-radius: 30px;
    text-align: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
    z-index: 2;
  }
  .brand-sub {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #eab308;
    text-transform: uppercase;
  }
  .coll-name {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.05em;
  }
  .coll-sub {
    display: block;
    font-size: 0.65rem;
    color: #cbd5e1;
  }

  /* Right Promo Column */
  .hero-right-promo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
  }
  .sale-wreath-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid #eab308;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }
  .wreath-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: #eab308;
  }
  .wreath-text {
    font-size: 0.68rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
  }

  .hero-pills-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }
  .hero-pill-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--transition-fast);
  }
  .hero-pill-row:hover {
    border-color: #eab308;
    background: rgba(0, 0, 0, 0.7);
  }
  .pill-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }
  .pill-was {
    font-size: 0.7rem;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .pill-now {
    font-size: 0.8rem;
    font-weight: 800;
    color: #eab308;
  }

  .btn-hero-cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: #eab308;
    color: #111111;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(234, 179, 8, 0.3);
  }
  .btn-hero-cta:hover {
    background: #ffffff;
    color: #111111;
    transform: translateY(-2px);
  }

  /* Mobile Only Adjustments (< 768px) */
  @media (max-width: 768px) {
    .bellavita-hero-section {
      padding: 0.75rem 0.5rem;
    }
    .hero-banner-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 0.75rem 0.5rem;
      gap: 1rem;
      min-height: auto;
    }
    .hero-left-offer, .hero-right-promo {
      align-items: center;
      width: 100%;
    }
    .hero-product-frame {
      height: 240px;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      background: radial-gradient(circle at center, rgba(255, 255, 255, 0.12) 0%, rgba(15, 2, 5, 0.6) 80%);
    }
    .hero-products-img {
      max-height: 210px;
      object-fit: contain !important;
    }
    .collection-title-badge {
      position: relative;
      bottom: 0;
      left: 0;
      transform: none;
      margin-top: 0.5rem;
      border-radius: 8px;
      width: 100%;
      box-sizing: border-box;
      padding: 0.45rem 0.75rem;
    }
    .hero-pills-stack {
      max-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('hero-track');
    if (!track) return;

    const slides = track.querySelectorAll('.slide-item');
    const totalSlides = slides.length;
    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let autoSlideInterval: any;

    function goToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function startAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
      autoSlideInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4500);
    }

    function stopAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
    }

    // Pause on hover
    track.addEventListener('mouseenter', stopAutoSlide);
    track.addEventListener('mouseleave', startAutoSlide);

    // Mobile Touch Swipe Support
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoSlide();
    }, { passive: true });

    track.addEventListener('touchend', (e: any) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      startAutoSlide();
    }, { passive: true });

    function handleSwipe() {
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goToSlide(currentIndex + 1); // Swipe Left -> Next
        } else {
          goToSlide(currentIndex - 1); // Swipe Right -> Prev
        }
      }
    }

    startAutoSlide();
  });
</script>
