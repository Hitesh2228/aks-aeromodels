---
---

<section class="bellavita-hero-section">
  <div class="hero-container">
    
    <!-- Hero Main Card (Bellavita Deep Wine Red Luxury Banner) -->
    <div class="hero-banner-card">
      <div class="hero-left-offer">
        <div class="offer-seal">
          <span class="seal-price">₹80 OFF</span>
          <span class="seal-sub">ON EVERY ENGINE</span>
          <span class="seal-timer">FOR 80 MINS ONLY • STARTS FROM 8PM</span>
        </div>
      </div>

      <div class="hero-center-products">
        <img 
          src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=1200&auto=format&fit=crop" 
          alt="BEAST MODE AEROMODEL COLLECTION" 
          class="hero-products-img"
        />
        <div class="collection-title-badge">
          <span class="brand-sub">AKS AEROMODELS</span>
          <span class="coll-name">BEAST MODE COLLECTION</span>
          <span class="coll-sub">FOR FLIGHT PILOTS</span>
        </div>
      </div>

      <div class="hero-right-promo">
        <div class="sale-wreath-badge">
          <span class="wreath-num">8th</span>
          <span class="wreath-text">ANNIVERSARY SALE</span>
          <span class="wreath-sub">LOWEST PRICE EVER</span>
        </div>

        <div class="combo-pill-box">
          <div class="combo-pill">
            <div class="pill-title">BUY ANY 2</div>
            <div class="pill-price"><strike>₹1,998</strike> <strong>₹799</strong></div>
          </div>
          <div class="combo-pill">
            <div class="pill-title">BUY ANY 4</div>
            <div class="pill-price"><strike>₹3,996</strike> <strong>₹1,399</strong></div>
          </div>
        </div>

        <a href="/shop?category=aeromodels" class="bellavita-shop-btn">
          SHOP NOW
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .bellavita-hero-section {
    background: #3b0811;
    background: linear-gradient(135deg, #2b050d 0%, #4a0e17 50%, #31060e 100%);
    padding: 1.75rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero-banner-card {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 2rem;
    position: relative;
  }

  /* Left Offer Seal */
  .hero-left-offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .offer-seal {
    border: 2px solid #eab308;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.4);
    text-align: center;
    color: #ffffff;
  }
  .seal-price {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: #eab308;
    display: block;
    line-height: 1.1;
  }
  .seal-sub {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .seal-timer {
    font-size: 0.65rem;
    color: #dddddd;
    display: block;
  }

  /* Center Products */
  .hero-center-products {
    position: relative;
    text-align: center;
  }
  .hero-products-img {
    max-height: 320px;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .collection-title-badge {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(234, 179, 8, 0.4);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-md);
    color: #fff;
    white-space: nowrap;
  }
  .brand-sub { font-size: 0.65rem; color: #eab308; display: block; letter-spacing: 0.1em; }
  .coll-name { font-size: 1rem; font-weight: 800; display: block; font-family: var(--font-display); }
  .coll-sub { font-size: 0.65rem; color: #ccc; display: block; }

  /* Right Promo */
  .hero-right-promo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sale-wreath-badge {
    border: 1.5px dashed #eab308;
    padding: 0.75rem 1.25rem;
    border-radius: 50%;
    width: 130px;
    height: 130px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: #fff;
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.3);
  }
  .wreath-num { font-size: 1.6rem; font-weight: 800; color: #eab308; font-family: var(--font-display); line-height: 1; }
  .wreath-text { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em; }
  .wreath-sub { font-size: 0.55rem; color: #ccc; }

  .combo-pill-box {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .combo-pill {
    background: #000000;
    border: 1px solid #eab308;
    color: #ffffff;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
  }
  .pill-title { font-size: 0.7rem; font-weight: 800; color: #eab308; letter-spacing: 0.05em; }
  .pill-price strike { font-size: 0.7rem; color: #888888; }
  .pill-price strong { font-size: 0.95rem; color: #ffffff; margin-left: 0.2rem; }

  .bellavita-shop-btn {
    background: #eab308;
    color: #000000;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.75rem 2.25rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.08em;
    transition: var(--transition-fast);
  }
  .bellavita-shop-btn:hover {
    background: #facc15;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(234, 179, 8, 0.4);
  }

  @media (max-width: 900px) {
    .hero-banner-card {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-left-offer {
      align-items: center;
    }
  }
</style>
