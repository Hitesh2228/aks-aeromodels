---

<section class="bellavita-hero-section">
  <div class="hero-container">
    
    <!-- Hero Slider Track Wrapper -->
    <div class="hero-slider-stage">
      
      <!-- Slides Track -->
      <div class="hero-slides-track" id="hero-track">
        {BANNERS.map((banner, index) => (
          <div class={`hero-banner-card slide-item ${index === 0 ? 'active' : ''}`}>
            
            <!-- Left Offer Seal -->
            <div class="hero-left-offer">
              <div class="offer-seal">
                <span class="seal-price">{banner.badgeTitle}</span>
                <span class="seal-timer">{banner.badgeSub}</span>
              </div>
            </div>

            <!-- Center Product Showcase -->
            <div class="hero-center-products">
              <img src={banner.img} alt={banner.collName} class="hero-products-img" loading="eager" />
              <div class="collection-title-badge">
                <span class="brand-sub">{banner.brandSub}</span>
                <span class="coll-name">{banner.collName}</span>
                <span class="coll-sub">{banner.collSub}</span>
              </div>
            </div>

            <!-- Right Promo -->
            <div class="hero-right-promo">
              <div class="sale-wreath-badge">
                <span class="wreath-num">{banner.wreathNum}</span>
                <span class="wreath-text">{banner.wreathText}</span>
              </div>

              <div class="hero-pills-stack">
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill1Title}</span>
                  <span class="pill-was">{banner.pill1Was}</span>
                  <span class="pill-now">{banner.pill1Now}</span>
                </a>
                <a href={banner.ctaLink} class="hero-pill-row">
                  <span class="pill-title">{banner.pill2Title}</span>
                  <span class="pill-was">{banner.pill2Was}</span>
                  <span class="pill-now">{banner.pill2Now}</span>
                </a>
              </div>

              <a href={banner.ctaLink} class="btn-hero-cta">
                {banner.ctaText}
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>

    <!-- Dots Pagination Indicator (Sleek Bellavita Style) -->
    <div class="hero-dots-pagination">
      <button class="dot-btn active" data-index="0" aria-label="Slide 1"></button>
      <button class="dot-btn" data-index="1" aria-label="Slide 2"></button>
      <button class="dot-btn" data-index="2" aria-label="Slide 3"></button>
      <button class="dot-btn" data-index="3" aria-label="Slide 4"></button>
    </div>

  </div>
</section>

<style>
  .bellavita-hero-section {
    background: #3b0811;
    background: linear-gradient(135deg, #2b050d 0%, #4a0e17 50%, #31060e 100%);
    padding: 1rem 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }
  .hero-container {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
  }

  .hero-slider-stage {
    position: relative;
    overflow: hidden;
  }

  .hero-slides-track {
    display: flex;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .hero-banner-card {
    min-width: 100%;
    display: grid;
    grid-template-columns: 0.8fr 1.4fr 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 0.5rem 1.5rem 1rem;
    box-sizing: border-box;
  }

  /* Left Offer Seal */
  .hero-left-offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .offer-seal {
    border: 2px solid #eab308;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.4);
    text-align: center;
    color: #ffffff;
  }
  .seal-price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: #eab308;
    display: block;
    line-height: 1.15;
    margin-bottom: 0.2rem;
  }
  .seal-timer {
    font-size: 0.62rem;
    color: #dddddd;
    display: block;
    letter-spacing: 0.05em;
  }

  /* Center Products Showcase */
  .hero-center-products {
    position: relative;
    text-align: center;
  }
  .hero-products-img {
    max-height: 220px;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
  }
  .collection-title-badge {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid #eab308;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand-sub { font-size: 0.58rem; color: #eab308; font-weight: 700; letter-spacing: 0.08em; }
  .coll-name { font-size: 0.9rem; font-weight: 800; color: #ffffff; font-family: var(--font-display); }
  .coll-sub { font-size: 0.62rem; color: #ccc; }

  /* Right Promo */
  .hero-right-promo {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: flex-end;
  }
  .sale-wreath-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .wreath-num { font-size: 0.85rem; font-weight: 800; color: #eab308; }
  .wreath-text { font-size: 0.62rem; font-weight: 700; color: #fff; letter-spacing: 0.06em; }

  .hero-pills-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    max-width: 260px;
  }
  .hero-pill-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.75rem;
    transition: var(--transition-fast);
  }
  .hero-pill-row:hover {
    background: rgba(234, 179, 8, 0.2);
    border-color: #eab308;
  }
  .pill-title { font-weight: 700; }
  .pill-was { font-size: 0.68rem; color: #aaa; text-decoration: line-through; }
  .pill-now { font-weight: 800; color: #eab308; }

  .btn-hero-cta {
    background: #eab308;
    color: #000000;
    font-weight: 800;
    font-size: 0.78rem;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(234, 179, 8, 0.3);
  }
  .btn-hero-cta:hover {
    background: #ffffff;
    color: #3b0811;
  }

  /* Dots Pagination Indicator */
  .hero-dots-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .dot-btn {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid #eab308;
    background: transparent;
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .dot-btn.active {
    background: #eab308;
    width: 22px;
    border-radius: 10px;
  }

  @media (max-width: 900px) {
    .bellavita-hero-section {
      padding: 0.75rem 0.5rem;
    }
    .hero-banner-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 0.5rem;
      gap: 0.75rem;
    }
    .hero-left-offer, .hero-right-promo {
      align-items: center;
    }
    .hero-products-img {
      max-height: 150px;
    }
    .collection-title-badge {
      position: relative;
      bottom: 0;
      left: 0;
      transform: none;
      margin-top: 0.5rem;
      border-radius: 8px;
    }
    .hero-pills-stack {
      max-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('hero-track');
    const dots = document.querySelectorAll('.hero-dots-pagination .dot-btn');

    let currentIndex = 0;
    const totalSlides = 4;
    let autoSlideInterval: any;

    function goToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      dots.forEach((d, i) => {
        if (i === currentIndex) d.classList.add('active');
        else d.classList.remove('active');
      });
    }

    function startAutoSlide() {
      stopAutoSlide();
      autoSlideInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4000);
    }

    function stopAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        startAutoSlide();
      });
    });

    startAutoSlide();
  });
</script>
