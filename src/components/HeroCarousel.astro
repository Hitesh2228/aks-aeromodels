---
import { getCombinedProducts } from '../lib/shopify';

const allProducts = await getCombinedProducts();

// 1. Check for products explicitly tagged with 'hero', 'hero-slider', or 'hero:1', 'hero:2', etc. in Shopify Admin
const heroTaggedProducts = allProducts
  .filter(p => p.isHero)
  .sort((a, b) => (a.heroOrder ?? 99) - (b.heroOrder ?? 99));

// Helper to find real product by handle or ID
function findProd(idOrHandle: string) {
  return allProducts.find(p => p.id === idOrHandle || p.handle === idOrHandle);
}

const eng1 = findProd('eng-1');
const eng4 = findProd('eng-4');
const rad1 = findProd('rad-1');
const rad3 = findProd('rad-3');
const sea1 = findProd('sea-1');
const sea4 = findProd('sea-4');
const bal1 = findProd('bal-1');
const bal2 = findProd('bal-2');

// Curated default banners using REAL products and REAL Shopify CDN images
const defaultBanners = [
  {
    id: 1,
    badgeTitle: eng1?.discountBadge || "FLAT ₹800 OFF ENGINES",
    badgeSub: "SPECIAL PROMO • LIMITED TIME OFFER",
    img: eng1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/eng-1-1.jpg?v=1791020055",
    imgMobile: eng1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/eng-1-1.jpg?v=1791020055",
    brandSub: "SKYNODESUAV • NITRO & GAS POWER",
    collName: eng1?.name || "CONTEST GRADE POWERPLANTS",
    collSub: "100% FACTORY FRESH • EXPRESS PAN-INDIA SHIPPING",
    wreathNum: "01",
    wreathText: "FEATURED DEAL",
    pill1Title: "BUY OS MAX",
    pill1Was: eng1 ? `₹${eng1.originalPrice.toLocaleString('en-IN')}` : "₹15,999",
    pill1Now: eng1 ? `₹${eng1.price.toLocaleString('en-IN')}` : "₹12,499",
    pill2Title: "BUY DLE 65",
    pill2Was: eng4 ? `₹${eng4.originalPrice.toLocaleString('en-IN')}` : "₹48,999",
    pill2Now: eng4 ? `₹${eng4.price.toLocaleString('en-IN')}` : "₹42,999",
    ctaLink: eng1 ? `/product/${eng1.id}` : "/shop?category=engine",
    ctaText: "CLAIM OFFER NOW ➔"
  },
  {
    id: 2,
    badgeTitle: rad1?.discountBadge || "UP TO 25% OFF RADIOS",
    badgeSub: "FUTABA & FRSKY 2.4GHz SYSTEMS",
    img: rad1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/rad-1-1.jpg?v=1791020058",
    imgMobile: rad1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/rad-1-1.jpg?v=1791020058",
    brandSub: "PRECISION TELEMETRY & CONTROL",
    collName: rad1?.name || "FUTABA 6K TRANSMITTER",
    collSub: "FAST DISPATCH & 100% FACTORY FRESH SYSTEMS",
    wreathNum: "02",
    wreathText: "LIMITED DEAL",
    pill1Title: "FUTABA 6K",
    pill1Was: rad1 ? `₹${rad1.originalPrice.toLocaleString('en-IN')}` : "₹24,999",
    pill1Now: rad1 ? `₹${rad1.price.toLocaleString('en-IN')}` : "₹19,999",
    pill2Title: "R3008SB RCVR",
    pill2Was: rad3 ? `₹${rad3.originalPrice.toLocaleString('en-IN')}` : "₹6,499",
    pill2Now: rad3 ? `₹${rad3.price.toLocaleString('en-IN')}` : "₹4,999",
    ctaLink: rad1 ? `/product/${rad1.id}` : "/shop?category=radio-receiver",
    ctaText: "GET RADIO OFFER ➔"
  },
  {
    id: 3,
    badgeTitle: sea1?.discountBadge || "SAVE UP TO ₹12,500",
    badgeSub: "PREMIUM SEAGULL ARF KITS",
    img: sea1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/sea-1-1.jpg?v=1791020060",
    imgMobile: sea1?.image || "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/sea-1-1.jpg?v=1791020060",
    brandSub: "SEAGULL MODELS OFFICIAL DISTRIBUTOR",
    collName: sea1?.name || "DECATHLON 122\" V2 ARF",
    collSub: "100% FACTORY SEALED WITH EXPRESS SHIPPING",
    wreathNum: "03",
    wreathText: "TOP ARF SALE",
    pill1Title: "BOOMERANG V3",
    pill1Was: sea4 ? `₹${sea4.originalPrice.toLocaleString('en-IN')}` : "₹18,999",
    pill1Now: sea4 ? `₹${sea4.price.toLocaleString('en-IN')}` : "₹15,999",
    pill2Title: "DECATHLON 122\"",
    pill2Was: sea1 ? `₹${sea1.originalPrice.toLocaleString('en-IN')}` : "₹85,000",
