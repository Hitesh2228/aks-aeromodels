---
---

<!-- Bellavita 2-Column Luxury Login/Signup/Forgot Password Modal -->
<div class="login-modal-overlay" id="bellavita-login-modal" aria-hidden="true">
  <div class="login-modal-box">
    
    <!-- Close Button -->
    <button type="button" class="modal-close-btn" id="close-login-modal" aria-label="Close modal">✕</button>

    <div class="login-modal-grid">
      
      <!-- Left Column: Dark Brand & Feature Cards -->
      <div class="modal-left-col">
        <div class="brand-header-wrap">
          <span class="brand-title-lbl">SKYNODESUAV</span>
          <span class="powered-tag">Official Pilot Portal</span>
        </div>

        <h2 class="modal-left-headline" id="left-col-headline">Join SKYNODES UAV Pilot Club!</h2>

        <div class="modal-feature-cards">
          <div class="modal-feat-card">
            <div class="star-icon">⚡</div>
            <div class="feat-title">Fast Express Shipping</div>
            <div class="feat-desc">24h dispatch across India</div>
          </div>

          <div class="modal-feat-card">
            <div class="star-icon">🔒</div>
            <div class="feat-title">Shopify Secure Gateway</div>
            <div class="feat-desc">Direct 100% encrypted checkout</div>
          </div>

          <div class="modal-feat-card">
            <div class="star-icon">🏅</div>
            <div class="feat-title">Official Pilot Rewards</div>
            <div class="feat-desc">Earn points on every order</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Auth Modes (Login / Sign Up / Forgot Password) -->
      <div class="modal-right-col">
        
        <!-- Auth Mode Tabs Header -->
        <div class="auth-tabs-header">
          <button type="button" class="auth-tab-btn active" id="tab-login-btn">LOGIN</button>
          <button type="button" class="auth-tab-btn" id="tab-signup-btn">SIGN UP</button>
        </div>

        <!-- Mode 1: LOGIN FORM -->
        <form id="modal-login-form" class="modal-form auth-mode-panel active">
          <div class="form-input-group">
            <label class="form-label">Email or Phone Number</label>
            <input type="text" id="login-identifier" class="form-input-field" placeholder="Enter Email or 10-digit Phone" required />
          </div>

          <div class="form-input-group">
            <div class="label-row">
              <label class="form-label">Password</label>
              <button type="button" class="link-btn" id="trigger-forgot-btn">Forgot Password?</button>
            </div>
            <input type="password" id="login-password" class="form-input-field" placeholder="Enter Password" required />
          </div>

          <!-- Google 1-Click Option -->
          <button type="button" class="google-fast-btn" id="modal-google-login-btn">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Or Continue with Google</span>
          </button>

          <button type="submit" class="modal-submit-btn">LOGIN TO ACCOUNT</button>
        </form>

        <!-- Mode 2: SIGN UP FORM -->
        <form id="modal-signup-form" class="modal-form auth-mode-panel">
          <div class="form-input-group">
            <label class="form-label">Full Name</label>
            <input type="text" id="signup-fullname" class="form-input-field" placeholder="Enter Full Name" required />
          </div>

          <div class="form-input-group">
            <label class="form-label">Email Address</label>
            <input type="email" id="signup-email" class="form-input-field" placeholder="pilot@skynodesuav.com" required />
          </div>

          <div class="form-input-group">
            <label class="form-label">Phone Number (+91)</label>
            <input type="tel" id="signup-phone" class="form-input-field" placeholder="9876543210" pattern="[0-9]{10}" required />
          </div>

          <div class="form-input-group">
            <label class="form-label">Create Password</label>
            <input type="password" id="signup-password" class="form-input-field" placeholder="At least 6 characters" minlength="6" required />
          </div>

          <button type="submit" class="modal-submit-btn">CREATE PILOT ACCOUNT</button>
        </form>

        <!-- Mode 3: FORGOT PASSWORD FORM -->
        <form id="modal-forgot-form" class="modal-form auth-mode-panel">
          <p class="forgot-instructions">Enter your registered email address or phone number below. We will send you an instant Password Reset OTP link.</p>
          
          <div class="form-input-group">
            <label class="form-label">Registered Email or Phone</label>
            <input type="text" id="forgot-identifier" class="form-input-field" placeholder="Enter your email or phone" required />
          </div>

          <button type="submit" class="modal-submit-btn">SEND RESET OTP LINK</button>

          <div id="forgot-success-msg" class="success-alert-box" style="display: none;">
            ✅ Reset OTP sent successfully! Check your email inbox or SMS.
          </div>

          <button type="button" class="back-to-login-btn" id="back-from-forgot">← Back to Login</button>
        </form>

        <p class="modal-terms-footnote">
          By continuing, you agree to SKYNODES UAV's <a href="/privacy">Privacy Policy</a> & <a href="/terms">Terms of Service</a>.
        </p>

      </div>

    </div>
  </div>
</div>

<style>
  .login-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .login-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .login-modal-box {
    position: relative;
    background: #000000;
    border-radius: 14px;
    width: 840px;
    max-width: 95vw;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transform: translateY(20px) scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .login-modal-overlay.is-active .login-modal-box {
    transform: translateY(0) scale(1);
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    z-index: 10;
    background: transparent;
    border: none;
    color: #888888;
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
  }
  .modal-close-btn:hover { color: #ffffff; }

  .login-modal-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
  }

  .modal-left-col {
    background: #000000;
    color: #ffffff;
    padding: 3rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid #1f1f1f;
  }

  .brand-header-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .brand-title-lbl {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }
  .powered-tag {
    font-size: 0.65rem;
    background: rgba(255, 255, 255, 0.15);
    color: #eab308;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .modal-left-headline {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 2.5rem;
    color: #ffffff;
  }

  .modal-feature-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .modal-feat-card {
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    padding: 0.85rem 1.15rem;
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
  }
  .star-icon { font-size: 1.1rem; margin-bottom: 0.2rem; }
  .feat-title { font-size: 0.85rem; font-weight: 800; color: #ffffff; }
  .feat-desc { font-size: 0.72rem; color: #888888; margin-top: 0.1rem; }

  /* Right Column (White #ffffff) */
  .modal-right-col {
    background: #ffffff;
    color: #1a1a1a;
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Auth Mode Tabs Header */
  .auth-tabs-header {
    display: flex;
    gap: 1rem;
    border-bottom: 2px solid #f0f0f0;
    margin-bottom: 1.75rem;
  }
  .auth-tab-btn {
    background: none;
    border: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: #888888;
    padding-bottom: 0.5rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    position: relative;
  }
  .auth-tab-btn.active {
    color: #000000;
  }
  .auth-tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 3px;
    background: #000000;
    border-radius: 2px;
  }

  .auth-mode-panel {
    display: none;
    flex-direction: column;
    gap: 1rem;
  }
  .auth-mode-panel.active {
    display: flex;
  }

  .form-input-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .form-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #333333;
  }
  .link-btn {
    background: none;
    border: none;
    font-size: 0.72rem;
    color: #2563eb;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
  }
  .link-btn:hover { text-decoration: underline; }

  .form-input-field {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .form-input-field:focus {
    border-color: #000000;
  }

  .google-fast-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 0.75rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #374151;
    cursor: pointer;
    transition: background 0.2s;
  }
  .google-fast-btn:hover { background: #f3f4f6; }

  .modal-submit-btn {
    width: 100%;
    background: #000000;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    padding: 0.85rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .modal-submit-btn:hover {
    background: #222222;
  }

  .forgot-instructions {
    font-size: 0.82rem;
    color: #555555;
    line-height: 1.5;
  }
  .success-alert-box {
    background: #ecfdf5;
    border: 1px solid #10b981;
    color: #065f46;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.75rem;
    border-radius: 6px;
    margin-top: 0.5rem;
  }
  .back-to-login-btn {
    background: none;
    border: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: #111111;
    cursor: pointer;
    text-align: center;
    margin-top: 0.5rem;
  }

  .modal-terms-footnote {
    font-size: 0.72rem;
    color: #9ca3af;
    text-align: center;
    margin-top: 1.5rem;
    line-height: 1.4;
  }
  .modal-terms-footnote a {
    color: #6b7280;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .login-modal-grid {
      grid-template-columns: 1fr;
    }
    .modal-left-col {
      padding: 1.75rem 1.25rem 1.25rem;
      border-right: none;
      border-bottom: 1px solid #222222;
    }
    .modal-left-headline {
      font-size: 1.15rem;
      margin-bottom: 1.25rem;
    }
    .modal-feat-card {
      padding: 0.6rem 0.85rem;
    }
    .modal-right-col {
      padding: 1.75rem 1.25rem;
    }
  }
</style>

<script>
  function initLoginModal() {
    const modal = document.getElementById('bellavita-login-modal');
    const closeBtn = document.getElementById('close-login-modal');
    const tabLogin = document.getElementById('tab-login-btn');
    const tabSignup = document.getElementById('tab-signup-btn');

    const loginForm = document.getElementById('modal-login-form');
    const signupForm = document.getElementById('modal-signup-form');
    const forgotForm = document.getElementById('modal-forgot-form');

    const triggerForgot = document.getElementById('trigger-forgot-btn');
    const backFromForgot = document.getElementById('back-from-forgot');
    const googleLoginBtn = document.getElementById('modal-google-login-btn');
    const forgotSuccessMsg = document.getElementById('forgot-success-msg');

    function openModal() {
      if (modal) {
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    function switchMode(mode: 'login' | 'signup' | 'forgot') {
      loginForm?.classList.remove('active');
      signupForm?.classList.remove('active');
      forgotForm?.classList.remove('active');

      tabLogin?.classList.remove('active');
      tabSignup?.classList.remove('active');

      if (mode === 'login') {
        loginForm?.classList.add('active');
        tabLogin?.classList.add('active');
      } else if (mode === 'signup') {
        signupForm?.classList.add('active');
        tabSignup?.classList.add('active');
      } else if (mode === 'forgot') {
        forgotForm?.classList.add('active');
      }
    }

    window.removeEventListener('open-login-modal', openModal);
    window.addEventListener('open-login-modal', openModal);

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    tabLogin?.addEventListener('click', () => switchMode('login'));
    tabSignup?.addEventListener('click', () => switchMode('signup'));
    triggerForgot?.addEventListener('click', () => switchMode('forgot'));
    backFromForgot?.addEventListener('click', () => switchMode('login'));

    // Handle Login Submit
    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const identifier = (document.getElementById('login-identifier') as HTMLInputElement)?.value;
      if (identifier) {
        localStorage.setItem('google_auth_logged_in', 'true');
        localStorage.setItem('skynodes_pilot_user', identifier);
        closeModal();
        window.location.href = '/profile';
      }
    });

    // Handle Sign Up Submit
    signupForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('signup-fullname') as HTMLInputElement)?.value;
      const email = (document.getElementById('signup-email') as HTMLInputElement)?.value;
      const phone = (document.getElementById('signup-phone') as HTMLInputElement)?.value;

      if (name && email) {
        localStorage.setItem('google_auth_logged_in', 'true');
        localStorage.setItem('skynodes_pilot_name', name);
        localStorage.setItem('skynodes_pilot_email', email);
        localStorage.setItem('skynodes_pilot_phone', phone);
        closeModal();
        window.location.href = '/profile';
      }
    });

    // Handle Forgot Password Submit
    forgotForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (forgotSuccessMsg) {
        forgotSuccessMsg.style.display = 'block';
      }
    });

    // Handle Google 1-Click
    googleLoginBtn?.addEventListener('click', () => {
      localStorage.setItem('google_auth_logged_in', 'true');
      localStorage.setItem('skynodes_pilot_name', 'Verified Google Pilot');
      closeModal();
      window.location.href = '/profile';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoginModal);
  } else {
    initLoginModal();
  }
  document.addEventListener('astro:page-load', initLoginModal);
</script>
