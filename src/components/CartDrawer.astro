---
---

<div id="cart-drawer-overlay" class="cart-drawer-overlay">
  <div class="cart-drawer glass-panel">
    
    <!-- Drawer Header -->
    <div class="drawer-header">
      <div class="header-title">
        <span>🛒 YOUR FLIGHT CART</span>
        <span class="items-count" id="drawer-item-count">(0 items)</span>
      </div>
      <button id="close-cart-btn" class="close-btn" aria-label="Close Cart">✕</button>
    </div>

    <!-- Free Shipping Bar -->
    <div class="shipping-bar-wrapper">
      <div class="shipping-text" id="shipping-status-text">Add ₹1,500 more for FREE Express Freight!</div>
      <div class="progress-track">
        <div class="progress-fill" id="shipping-progress-fill" style="width: 60%;"></div>
      </div>
    </div>

    <!-- Cart Items Container -->
    <div class="drawer-body" id="drawer-items-list">
      <!-- Dynamically hydrated via JS -->
      <div class="empty-cart-state">
        <span class="empty-icon">🪹</span>
        <p>Your cart is empty!</p>
        <a href="/shop" class="btn-primary" style="margin-top: 1rem;">BROWSE CATALOG</a>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <div class="subtotal-row">
        <span>Subtotal Amount:</span>
        <span class="subtotal-amount" id="drawer-subtotal">₹0</span>
      </div>
      <p class="tax-note">Taxes & Pan-India Insured Freight calculated at checkout.</p>
      
      <div class="checkout-actions">
        <a href="/invoice" id="generate-invoice-btn" class="btn-invoice-link">
          📄 VIEW TAX BILL / INVOICE
        </a>
        <a href="#" id="shopify-checkout-btn" class="btn-primary checkout-btn">
          PROCEED TO SECURE CHECKOUT <span>🔒</span>
        </a>
      </div>
    </div>

  </div>
</div>

<style>
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .cart-drawer-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: #11141e;
    border-left: 1px solid #2d3748;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.8);
  }
  .cart-drawer-overlay.active .cart-drawer {
    transform: translateX(0);
  }

  .drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #2d3748;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #181c2b;
  }
  .header-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .items-count {
    color: #eab308;
    font-size: 0.85rem;
    font-weight: 800;
  }
  .close-btn {
    font-size: 1.25rem;
    color: #a0aec0;
    transition: var(--transition-fast);
  }
  .close-btn:hover {
    color: #ffffff;
  }

  /* Shipping Progress */
  .shipping-bar-wrapper {
    background: rgba(234, 179, 8, 0.1);
    border-bottom: 1px solid #2d3748;
    padding: 0.75rem 1.5rem;
  }
  .shipping-text {
    font-size: 0.78rem;
    font-weight: 800;
    color: #eab308;
    margin-bottom: 0.4rem;
    text-align: center;
  }
  .progress-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #eab308);
    border-radius: 3px;
    transition: width 0.3s ease;
  }

  /* Body */
  .drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #0d0f17;
  }
  .empty-cart-state {
    text-align: center;
    margin: auto 0;
    padding: 2rem 0;
    color: #a0aec0;
  }
  .empty-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  /* Drawer Item (High-Contrast White Text & Crisp Badges) */
  :global(.cart-item-card) {
    display: flex;
    gap: 1rem;
    background: #181c2b;
    border: 1px solid #2d3748;
    border-radius: var(--radius-md);
    padding: 0.85rem;
    align-items: center;
  }
  :global(.item-thumb) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: #ffffff;
  }
  :global(.item-details) {
    flex-grow: 1;
  }
  :global(.item-title) {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff !important;
    margin-bottom: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.item-price) {
    font-size: 0.85rem;
    font-weight: 800;
    color: #eab308 !important;
    margin-bottom: 0.4rem;
  }
  :global(.qty-controls) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  :global(.qty-btn) {
    background: #2d3748;
    color: #ffffff !important;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #4a5568;
    cursor: pointer;
  }
  :global(.qty-btn:hover) {
    background: #3b0811;
    border-color: #eab308;
  }
  :global(.qty-val) {
    font-size: 0.9rem;
    font-weight: 800;
    color: #ffffff !important;
    background: #3b0811;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #eab308;
    min-width: 24px;
    text-align: center;
  }
  :global(.remove-item-btn) {
    color: #ef4444;
    font-size: 1.1rem;
    padding: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  /* Footer */
  .drawer-footer {
    padding: 1.5rem;
    background: #181c2b;
    border-top: 1px solid #2d3748;
  }
  .subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }
  .subtotal-amount {
    color: #eab308;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
  }
  .tax-note {
    font-size: 0.75rem;
    color: #a0aec0;
    margin-bottom: 1rem;
  }
  .checkout-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .btn-invoice-link {
    display: block;
    text-align: center;
    background: #2d3748;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid #4a5568;
    transition: var(--transition-fast);
  }
  .btn-invoice-link:hover {
    background: #3b0811;
    border-color: #eab308;
  }
  .checkout-btn {
    width: 100%;
  }
</style>

<script>
  import { getCartHydrated, updateCartQuantity } from '../lib/cartStore';
  import { buildShopifyCheckoutUrl } from '../lib/shopify';

  function renderDrawer() {
    const overlay = document.getElementById('cart-drawer-overlay');
    const itemsList = document.getElementById('drawer-items-list');
    const countEl = document.getElementById('drawer-item-count');
    const subtotalEl = document.getElementById('drawer-subtotal');
    const checkoutLink = document.getElementById('shopify-checkout-btn') as HTMLAnchorElement;
    const progressFill = document.getElementById('shipping-progress-fill');
    const shippingText = document.getElementById('shipping-status-text');

    if (!itemsList) return;

    const hydrated = getCartHydrated();
    const totalCount = hydrated.reduce((acc, cur) => acc + cur.quantity, 0);
    const subtotal = hydrated.reduce((acc, cur) => acc + (cur.product.price * cur.quantity), 0);

    if (countEl) countEl.textContent = `(${totalCount} items)`;
    if (subtotalEl) subtotalEl.textContent = `₹${subtotal.toLocaleString('en-IN')}`;

    const threshold = 5000;
    if (subtotal >= threshold) {
      if (progressFill) progressFill.style.width = '100%';
      if (shippingText) shippingText.textContent = '🎉 Congratulations! You unlocked FREE Express Freight!';
    } else {
      const remaining = threshold - subtotal;
      const pct = Math.min(100, Math.max(10, (subtotal / threshold) * 100));
      if (progressFill) progressFill.style.width = `${pct}%`;
      if (shippingText) shippingText.textContent = `Add ₹${remaining.toLocaleString('en-IN')} more for FREE Express Freight!`;
    }

    if (checkoutLink) {
      checkoutLink.href = buildShopifyCheckoutUrl(hydrated);
    }

    if (hydrated.length === 0) {
      itemsList.innerHTML = `
        <div class="empty-cart-state">
          <span class="empty-icon">🪹</span>
          <p>Your flight cart is empty!</p>
          <a href="/shop" class="btn-primary" style="margin-top: 1rem;">BROWSE CATALOG</a>
        </div>
      `;
      return;
    }

    itemsList.innerHTML = hydrated.map(item => `
      <div class="cart-item-card">
        <img src="${item.product.image}" alt="${item.product.name}" class="item-thumb" />
        <div class="item-details">
          <div class="item-title">${item.product.name}</div>
          <div class="item-price">₹${(item.product.price * item.quantity).toLocaleString('en-IN')}</div>
          <div class="qty-controls">
            <button class="qty-btn dec-btn" data-id="${item.product.id}" data-qty="${item.quantity - 1}">-</button>
            <span class="qty-val">${item.quantity}</span>
            <button class="qty-btn inc-btn" data-id="${item.product.id}" data-qty="${item.quantity + 1}">+</button>
          </div>
        </div>
        <button class="remove-item-btn" data-id="${item.product.id}" data-qty="0" title="Remove item">🗑️</button>
      </div>
    `).join('');

    itemsList.querySelectorAll('.qty-btn, .remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        const qty = parseInt((e.currentTarget as HTMLElement).getAttribute('data-qty') || '0', 10);
        if (id !== null) {
          updateCartQuantity(id, qty);
          renderDrawer();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('cart-drawer-overlay');
    const closeBtn = document.getElementById('close-cart-btn');

    window.addEventListener('open-cart-drawer', () => {
      renderDrawer();
      overlay?.classList.add('active');
    });

    window.addEventListener('cart-updated', renderDrawer);

    closeBtn?.addEventListener('click', () => {
      overlay?.classList.remove('active');
    });

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.remove('active');
      }
    });
  });
</script>
