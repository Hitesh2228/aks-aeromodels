---
import LoginModal from './LoginModal.astro';
---

<!-- Announcement Bar (Bellavita Top Strip) -->
<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="promo-ticker">
      <span class="ticker-text">
        <svg class="line-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <strong>Lowest Prices of the Year</strong> — Limited Time Only
      </span>
    </div>
  </div>
</div>

<!-- Main Header Bar -->
<header class="main-header sticky-top">
  <div class="container header-grid">
    
    <!-- Left: Search Bar & Mobile Hamburger -->
    <div class="header-search">
      <button id="mobile-menu-trigger" class="mobile-hamburger-btn" aria-label="Open Navigation Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <form action="/shop" method="GET" class="search-form desktop-search-only">
        <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input 
          type="text" 
          name="search" 
          placeholder="Search for engines, radios, balsa..." 
          class="search-input"
          aria-label="Search products"
        />
      </form>
    </div>

    <!-- Center: Brand Logo -->
    <a href="/" class="brand-logo">
      <span class="brand-name">SKYNODESUAV</span>
    </a>

    <!-- Right: User Account & Cart (Line Art Icons) -->
    <div class="header-actions">
      <a href="/profile" class="account-btn-link" id="header-account-btn" title="User Account & Google Sign In">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="account-label" id="header-account-label">ACCOUNT / LOGIN</span>
      </a>
      <button id="cart-drawer-trigger" class="cart-icon-btn" aria-label="Open Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-badge" id="cart-count-badge">0</span>
      </button>
    </div>
  </div>

  <!-- Category Nav Strip (Clean Luxury Navigation Links) -->
  <nav class="nav-strip">
    <div class="container nav-links">
      <a href="/shop?category=all" class="nav-item">SHOP ALL</a>
      <a href="/shop?category=all" class="nav-item highlight">CRAZY DEALS</a>
      <a href="/shop?category=all" class="nav-item">BESTSELLERS</a>
      <a href="/shop?category=engine" class="nav-item">ENGINES</a>
      <a href="/shop?category=aeromodels" class="nav-item">AEROMODELS</a>
      <a href="/shop?category=radio-receiver" class="nav-item">RADIOS & RECEIVERS</a>
      <a href="/shop?category=balsa-wood" class="nav-item">BALSA WOOD</a>
      <a href="/shop?category=accessories" class="nav-item">ACCESSORIES</a>
      <a href="/aircrafts" class="nav-item showcase-link">3D SHOWCASE ✈️</a>
    </div>
  </nav>

  <!-- Sub-ticker (Bellavita Countdown Strip) -->
  <div class="sub-ticker-strip">
    <div class="container sub-ticker-flex">
      <div class="ticker-message">
        <span class="yellow-dot">●</span> <strong>Buzz Offer Ends</strong> Extra ₹80 off — Hurry!
      </div>
      <div class="countdown-widget">
        <span class="time-box" id="hours">00</span> <small>Days</small>
        <span class="time-box" id="mins">08</span> <small>Hrs</small>
        <span class="time-box" id="secs">42</span> <small>Min</small>
        <span class="time-box" id="sec-ticks">19</span> <small>Sec</small>
      </div>
</header>

<!-- Mobile Slide-In Navigation Drawer -->
<div class="mobile-nav-drawer-overlay" id="mobile-nav-drawer" aria-hidden="true">
  <div class="mobile-drawer-content">
    <div class="drawer-top-head">
      <span class="drawer-brand">SKYNODESUAV</span>
      <button id="close-mobile-drawer" class="drawer-close-btn" aria-label="Close menu">✕</button>
    </div>

    <div class="drawer-search-box">
      <form action="/shop" method="GET">
        <input type="text" name="search" placeholder="Search engines, radios, balsa..." class="search-input" />
      </form>
    </div>

    <div class="drawer-nav-list">
      <a href="/shop?category=all" class="drawer-nav-item">🛒 SHOP ALL PRODUCTS</a>
      <a href="/shop?category=all" class="drawer-nav-item highlight">🔥 CRAZY DEALS</a>
      <a href="/shop?category=engine" class="drawer-nav-item">⚡ ENGINES & POWERPLANTS</a>
      <a href="/shop?category=aeromodels" class="drawer-nav-item">✈️ SEAGULL AEROMODELS</a>
      <a href="/shop?category=radio-receiver" class="drawer-nav-item">📡 RADIOS & RECEIVERS</a>
      <a href="/shop?category=balsa-wood" class="drawer-nav-item">🪵 BALSA WOOD SHEETS</a>
      <a href="/shop?category=accessories" class="drawer-nav-item">🛠️ FLIGHT ACCESSORIES</a>
      <a href="/aircrafts" class="drawer-nav-item">🎮 3D FLIGHT SHOWCASE</a>
      <a href="/blog" class="drawer-nav-item">📰 RC FLIGHT BLOG</a>
      <a href="/about" class="drawer-nav-item">ℹ️ ABOUT SKYNODESUAV</a>
      <a href="/contact" class="drawer-nav-item">📞 CONTACT US & FAQ</a>
      <a href="/profile" class="drawer-nav-item">👤 MY PILOT PROFILE</a>
    </div>

    <div class="drawer-bottom-contact">
      <a href="https://wa.me/917722009120" target="_blank" class="drawer-wa-btn">
        💬 WhatsApp Support (+91-7722009120)
      </a>
    </div>
  </div>
</div>

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: #111111;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0;
  }
  .announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ticker-left, .ticker-right {
    color: #888888;
    font-size: 1rem;
    cursor: pointer;
  }
  .ticker-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .line-icon {
    display: inline-block;
    vertical-align: middle;
  }

  /* Main Header */
  .main-header {
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .main-header.nav-hidden {
    transform: translateY(-100%);
  }
  .sticky-top {
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .header-grid {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    align-items: center;
    padding: 1rem 1.25rem;
  }

  /* Search */
  .header-search {
    position: relative;
  }
  .search-form {
    display: flex;
    align-items: center;
    position: relative;
  }
  .search-svg {
    position: absolute;
    left: 0;
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid #cccccc;
    padding: 0.4rem 0.5rem 0.4rem 1.75rem;
    font-size: 0.85rem;
    background: transparent;
    outline: none;
    transition: var(--transition-fast);
  }
  .search-input:focus {
    border-bottom-color: #3b0811;
  }

  /* Logo */
  .brand-logo {
    text-align: center;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #1a1a1a;
  }

  /* Actions */
  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }
  .account-btn-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: 0.05em;
    padding: 0.45rem 0.85rem;
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }
  .account-btn-link:hover {
    background: #3b0811;
    color: #ffffff;
    border-color: #3b0811;
  }
  .account-btn-link:hover svg {
    stroke: #ffffff;
  }
  .cart-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #3b0811;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Nav Strip */
  .nav-strip {
    background: #fbf9f5;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.65rem 0;
  }
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .nav-item {
    font-family: var(--font-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #333333;
    transition: var(--transition-fast);
  }
  .nav-item:hover {
    color: #3b0811;
  }
  .nav-item.highlight {
    color: #e11d48;
  }
  .showcase-link {
    color: #06b6d4 !important;
  }

  /* Sub Ticker */
  .sub-ticker-strip {
    background: #3b0811;
    color: #ffffff;
    font-size: 0.78rem;
    padding: 0.3rem 0;
  }
  .sub-ticker-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .yellow-dot {
    color: #f59e0b;
    margin-right: 0.3rem;
  }
  .countdown-widget {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }
  .time-box {
    background: rgba(255, 255, 255, 0.15);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  /* Active Nav Link Styling */
  .nav-item.is-active-link {
    color: #3b0811 !important;
    font-weight: 800 !important;
    border-bottom: 2px solid #3b0811;
    padding-bottom: 2px;
  }

  .main-header {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .main-header.nav-hidden {
    transform: translateY(-100%);
  }

  .announcement-bar {
    transition: opacity 0.3s ease;
  }
  .announcement-bar.hide-ticker {
    display: none !important;
  }

  /* Mobile Hamburger Button */
  .mobile-hamburger-btn {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    align-items: center;
    justify-content: center;
  }

  /* Slide-In Mobile Navigation Drawer */
  .mobile-nav-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .mobile-nav-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-content {
    width: 310px;
    max-width: 85vw;
    height: 100%;
    background: #000000;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    box-sizing: border-box;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }
  .mobile-nav-drawer-overlay.is-open .mobile-drawer-content {
    transform: translateX(0);
  }

  .drawer-top-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #222222;
  }
  .drawer-brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #eab308;
  }
  .drawer-close-btn {
    background: transparent;
    border: none;
    color: #aaaaaa;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .drawer-search-box {
    margin-bottom: 1.25rem;
  }
  .drawer-search-box .search-input {
    width: 100%;
    background: #181818;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    color: #ffffff;
    font-size: 0.85rem;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }
  .drawer-nav-item {
    padding: 0.75rem 0.85rem;
    color: #dddddd;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .drawer-nav-item:hover, .drawer-nav-item.highlight {
    background: #1a1a1a;
    color: #eab308;
  }

  .drawer-bottom-contact {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #222222;
  }
  .drawer-wa-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.75rem;
    border-radius: 6px;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .mobile-hamburger-btn { display: flex; }
    .desktop-search-only { display: none; }
    .nav-strip { display: none; }
    .account-label { display: none; }
    .header-grid {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 1rem;
      width: 100%;
      box-sizing: border-box;
    }
    .announcement-bar, .sub-ticker-strip, .main-header {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
      box-sizing: border-box;
    }
    .sub-ticker-flex {
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
      padding: 0.25rem 0.5rem;
    }
    .countdown-widget {
      font-size: 0.72rem;
    }
    .ticker-left, .ticker-right {
      display: none;
    }
  }
</style>

<script>
  import { getCartCount } from '../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const cartTrigger = document.getElementById('cart-drawer-trigger');
    const badge = document.getElementById('cart-count-badge');
    const mainHeader = document.querySelector('.main-header');
    const announcementBar = document.querySelector('.announcement-bar');

    function updateBadge() {
      const count = getCartCount();
      if (badge) {
        badge.textContent = count.toString();
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
    }

    cartTrigger?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cart-drawer'));
    });

    window.addEventListener('cart-updated', updateBadge);
    updateBadge();

    // Active Nav Highlight
    const fullUrl = window.location.pathname + window.location.search;
    const navItems = document.querySelectorAll('.nav-strip .nav-item');

    navItems.forEach(item => {
      const href = item.getAttribute('href');
      if (href && (href === fullUrl || (href !== '/' && fullUrl.startsWith(href)))) {
        item.classList.add('is-active-link');
      }
    });

    // Smart Header Scroll Auto-Hide (Scroll Down) & Instant Reveal (Scroll Up)
    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;

          // Top announcement ticker hiding on scroll
          if (announcementBar) {
            if (currentScrollY > 40) {
              announcementBar.classList.add('hide-ticker');
            } else {
              announcementBar.classList.remove('hide-ticker');
            }
          }

          // Desktop & Mobile Smart Header Slide Hide (Down) / Reveal (Up)
          if (currentScrollY > 80) {
            if (currentScrollY > lastScrollY + 4) {
              // User scrolling DOWN -> Slide Header UP (Hide)
              mainHeader?.classList.add('nav-hidden');
              document.body.classList.add('header-hidden');
            } else if (currentScrollY < lastScrollY - 4) {
              // User scrolling UP -> Slide Header DOWN (Reveal)
              mainHeader?.classList.remove('nav-hidden');
              document.body.classList.remove('header-hidden');
            }
          } else {
            // At top -> Always visible
            mainHeader?.classList.remove('nav-hidden');
            document.body.classList.remove('header-hidden');
          }

          lastScrollY = currentScrollY;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Global Scroll Reveal Observer (Kinetic Motion)
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px 0px 0px',
      threshold: 0.05
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, observerOptions);

    const revealSelectors = '.reveal-on-scroll, .reveal-left, .reveal-right, .reveal-zoom';
    document.querySelectorAll(revealSelectors).forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('is-visible');
      }
      observer.observe(el);
    });

    // Mobile Drawer Open & Close Event Listeners
    const mobileTrigger = document.getElementById('mobile-menu-trigger');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const closeDrawerBtn = document.getElementById('close-mobile-drawer');

    function openMobileDrawer() {
      if (mobileDrawer) {
        mobileDrawer.classList.add('is-open');
        mobileDrawer.setAttribute('aria-hidden', 'false');
      }
    }

    function closeMobileDrawer() {
      if (mobileDrawer) {
        mobileDrawer.classList.remove('is-open');
        mobileDrawer.setAttribute('aria-hidden', 'true');
      }
    }

    mobileTrigger?.addEventListener('click', openMobileDrawer);
    closeDrawerBtn?.addEventListener('click', closeMobileDrawer);

    mobileDrawer?.addEventListener('click', (e) => {
      if (e.target === mobileDrawer) closeMobileDrawer();
    });

    document.querySelectorAll('.drawer-nav-item').forEach(item => {
      item.addEventListener('click', closeMobileDrawer);
    });

    // Account / Login Trigger Modal
    const accountBtn = document.getElementById('header-account-btn');
    const accountLabel = document.getElementById('header-account-label');

    const isLoggedIn = localStorage.getItem('skynodes_pilot_logged_in') === 'true' || localStorage.getItem('aks_pilot_logged_in') === 'true';
    const pilotName = localStorage.getItem('skynodes_pilot_name') || localStorage.getItem('aks_pilot_name');

    if (isLoggedIn && pilotName && accountLabel) {
      accountLabel.textContent = pilotName.split(' ')[0].toUpperCase();
    }

    accountBtn?.addEventListener('click', (e) => {
      const loggedIn = localStorage.getItem('skynodes_pilot_logged_in') === 'true' || localStorage.getItem('aks_pilot_logged_in') === 'true';
      if (!loggedIn) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-login-modal'));
      }
    });

    // Global Image Failsafe (replaces any broken external image with an HD active photo)
    document.addEventListener('error', (e) => {
      const target = e.target as HTMLImageElement;
      if (target && target.tagName === 'IMG') {
        const fallback = 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=800&auto=format&fit=crop';
        if (target.src !== fallback) {
          target.src = fallback;
        }
      }
    }, true);
  });
</script>

<LoginModal />
