---
import LoginModal from './LoginModal.astro';
import { getStoreNavigation } from '../lib/shopifyAdmin';

const navItems = await getStoreNavigation();
---

<!-- Announcement Bar (Bellavita Top Strip) -->
<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="promo-ticker">
      <span class="ticker-text">
        <svg class="line-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <strong>Lowest Prices of the Year</strong> — Limited Time Only
      </span>
    </div>
  </div>
</div>

<!-- Main Header Bar (Sticky Dynamic Hide/Reveal + Transparent Banner State) -->
<header class="main-header sticky-top">
  <div class="container header-grid">
    
    <!-- Left: Search Bar & Mobile Hamburger -->
    <div class="header-search">
      <button id="mobile-menu-trigger" class="mobile-hamburger-btn" aria-label="Open Navigation Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <form action="/shop" method="GET" class="search-form desktop-search-only">
        <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input 
          type="text" 
          name="search" 
          placeholder="Search for engines, radios, balsa..." 
          class="search-input"
          aria-label="Search products"
        />
      </form>
    </div>

    <!-- Center: Brand Logo -->
    <a href="/" class="brand-logo">
      <span class="brand-name">SKYNODESUAV</span>
    </a>

    <!-- Right: User Account & Cart (Clean Clearance from Desktop Screen Edge) -->
    <div class="header-actions">
      <a href="/profile" class="account-btn-link" id="header-account-btn" title="User Account & Google Sign In">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="account-label" id="header-account-label">ACCOUNT / LOGIN</span>
      </a>

      <a href="/profile#wishlist" class="wishlist-btn-link" id="header-wishlist-btn" title="Saved Wishlist Items">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="wishlist-label">WISHLIST (<span id="header-wishlist-badge">0</span>)</span>
      </a>
      <button id="cart-drawer-trigger" class="cart-icon-btn" aria-label="Open Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-badge" id="cart-count-badge">0</span>
      </button>
    </div>
  </div>

  <!-- Category Nav Strip (Clean Luxury Navigation Links) -->
  <nav class="nav-strip">
    <div class="container nav-links">
      {navItems.map((item) => (
        item.subItems && item.subItems.length > 0 ? (
          <div class="nav-dropdown-wrapper">
            <a href={item.href} class={`nav-item ${item.highlight ? 'highlight' : ''}`}>
              {item.label}
              <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="nav-dropdown-menu">
              {item.subItems.map((sub: any) => (
                <a href={sub.href} class="dropdown-sub-item">{sub.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class={`nav-item ${item.highlight ? 'highlight' : ''}`}>
            {item.label}
          </a>
        )
      ))}
    </div>
  </nav>

  <!-- Sub-ticker (Bellavita Countdown Strip) -->
  <div class="sub-ticker-strip">
    <div class="container sub-ticker-flex">
      <div class="ticker-message">
        <span class="yellow-dot">●</span> <strong>Buzz Offer Ends</strong> — Extra ₹80 OFF on all orders!
      </div>
      <div class="countdown-widget" id="header-countdown-widget">
        <span class="time-box" id="countdown-days">02</span> <small>Days</small>
        <span class="time-box" id="countdown-hours">14</span> <small>Hrs</small>
        <span class="time-box" id="countdown-mins">35</span> <small>Min</small>
        <span class="time-box" id="countdown-secs">19</span> <small>Sec</small>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Slide-In Navigation Drawer (Bellavita Luxury White Theme + Line-Art Icons) -->
<div class="mobile-nav-drawer-overlay" id="mobile-nav-drawer" aria-hidden="true">
  <div class="mobile-drawer-content">
    
    <div class="drawer-top-head">
      <span class="drawer-brand">SKYNODESUAV</span>
      <button id="close-mobile-drawer" class="drawer-close-btn" aria-label="Close menu">✕</button>
    </div>

    <div class="drawer-search-box">
      <form action="/shop" method="GET" class="drawer-search-form">
        <svg class="search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" name="search" placeholder="Search engines, radios, balsa..." class="drawer-search-input" />
      </form>
    </div>

    <!-- Dynamic Line-Art SVG Nav Items -->
    <div class="drawer-nav-list">
      {navItems.map((item) => (
        item.subItems && item.subItems.length > 0 ? (
          <div class="drawer-accordion-group">
            <div class="drawer-accordion-header">
              <a href={item.href} class={`drawer-nav-item ${item.highlight ? 'highlight' : ''}`}>
                <span>{item.label}</span>
              </a>
              <button type="button" class="drawer-sub-toggle-btn" aria-label={`Toggle ${item.label} sub-items`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
            <div class="drawer-sub-items-list">
              {item.subItems.map((sub: any) => (
                <a href={sub.href} class="drawer-sub-item">↳ {sub.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class={`drawer-nav-item ${item.highlight ? 'highlight' : ''}`}>
            <span>{item.label}</span>
          </a>
        )
      ))}

      <hr style="border:none; border-top:1px solid #f1f5f9; margin: 0.65rem 0;" />
      <a href="/blog" class="drawer-nav-item"><span>RC FLIGHT BLOG</span></a>
      <a href="/about" class="drawer-nav-item"><span>ABOUT SKYNODESUAV</span></a>
      <a href="/contact" class="drawer-nav-item"><span>CONTACT US & FAQ</span></a>
      <a href="/profile" class="drawer-nav-item"><span>MY PILOT PROFILE</span></a>
    </div>

    <div class="drawer-bottom-contact">
      <a href="https://wa.me/917722009120" target="_blank" class="drawer-wa-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-.981z"/></svg>
        <span>WhatsApp Support</span>
      </a>
    </div>

  </div>
</div>

<LoginModal />

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: #111111;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0;
  }
  .announcement-content {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ticker-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Main Header - Bellavita Transparent Hero State + Scrolled Solid White Cover */
  .main-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.3s ease;
  }
  :global(body.header-hidden) .main-header {
    transform: translateY(-100%);
  }
  .main-header.is-scrolled {
    background: #ffffff !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }
  .main-header:hover {
    background: #ffffff !important;
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.85rem 0;
  }

  .header-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mobile-hamburger-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .search-form {
    position: relative;
    width: 260px;
  }
  .search-svg {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.3rem;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 0.82rem;
    outline: none;
    transition: var(--transition-fast);
    background: #fcfcfc;
  }
  .search-input:focus {
    border-color: #111111;
    background: #ffffff;
  }

  /* Brand Logo */
  .brand-logo {
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #111111;
  }

  /* Header Actions Right (Clearance from Desktop Edge) */
  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
    padding-right: 0.85rem; /* Prevents cart count badge cut-off on desktop screen edge */
  }
  .account-btn-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: #111111;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    transition: background 0.2s ease;
  }
  .account-btn-link:hover {
    background: #f5f5f5;
  }
  .wishlist-btn-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: #111111;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    transition: background 0.2s ease;
  }
  .wishlist-btn-link:hover {
    background: #f5f5f5;
  }
  @media (max-width: 900px) {
    .wishlist-label { display: none; }
  }
  .cart-icon-btn {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem 0.6rem;
    margin-right: 0.35rem; /* Safe clearance from right window edge */
  }
  .cart-badge {
    position: absolute;
    top: -4px;
    right: -2px;
    background: #111111;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Nav Strip Desktop */
  .nav-strip {
    border-top: 1px solid #f0f0f0 !important;
    border-bottom: none !important;
    box-shadow: none !important;
    padding: 0.6rem 0;
    position: relative;
    z-index: 50;
    overflow: visible !important;
  }
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    overflow: visible !important;
    flex-wrap: wrap;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-item {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #333333;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .nav-item.active {
    color: #000000 !important;
    font-weight: 800 !important;
    position: relative;
  }
  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 3px;
    background: #000000;
    border-radius: 2px;
  }
  .nav-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0;
  }
  /* Invisible hover bridge to prevent menu from closing when moving mouse from link to menu */
  .nav-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 14px;
    background: transparent;
    z-index: 9999;
  }
  .nav-dropdown-wrapper .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dropdown-chevron {
    transition: transform 0.2s ease;
  }
  .nav-dropdown-wrapper:hover .dropdown-chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
    padding: 0.5rem;
    min-width: 210px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    z-index: 10000;
  }
  .nav-dropdown-wrapper:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  /* For items on the far right (like TOY or end links) align dropdown to right edge so it never overflows screen */
  .nav-dropdown-wrapper:last-child .nav-dropdown-menu,
  .nav-dropdown-wrapper:nth-last-child(2) .nav-dropdown-menu {
    left: auto;
    right: 0;
    transform: translateY(6px);
  }
  .nav-dropdown-wrapper:last-child:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:nth-last-child(2):hover .nav-dropdown-menu {
    transform: translateY(0);
  }
  .dropdown-sub-item {
    display: block;
    padding: 0.55rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
    white-space: nowrap;
    text-align: left;
  }
  .dropdown-sub-item:hover {
    background: #f1f5f9;
    color: #000000;
    padding-left: 1.05rem;
  }

  .drawer-nav-item.active {
    background: #f4f4f6 !important;
    font-weight: 800 !important;
    color: #000000 !important;
    border-left: 3px solid #000000 !important;
    padding-left: 12px !important;
  }

  /* Sub Ticker Bar */
  .sub-ticker-strip {
    background: #3b0811;
    color: #ffffff;
    font-size: 0.75rem;
    padding: 0.35rem 0;
  }
  .sub-ticker-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .yellow-dot { color: #f59e0b; }
  .countdown-widget {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
  }
  .countdown-widget small {
    font-size: 0.68rem;
    color: #e2e8f0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .time-box {
    background: rgba(234, 179, 8, 0.2);
    border: 1px solid rgba(234, 179, 8, 0.45);
    color: #fef08a;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-weight: 800;
    font-family: monospace, var(--font-sans);
    min-width: 22px;
    text-align: center;
    display: inline-block;
  }

  /* Mobile Drawer Overlay & Content (Bellavita Luxury White Theme) */
  .mobile-nav-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .mobile-nav-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-content {
    width: 320px;
    max-width: 85vw;
    height: 100%;
    background: #ffffff;
    color: #111111;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    box-sizing: border-box;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.15);
  }
  .mobile-nav-drawer-overlay.is-open .mobile-drawer-content {
    transform: translateX(0);
  }

  .drawer-top-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eaeaea;
  }
  .drawer-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #111111;
  }
  .drawer-close-btn {
    background: transparent;
    border: none;
    color: #555555;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .drawer-search-box {
    margin-bottom: 1.25rem;
  }
  .drawer-search-form {
    position: relative;
    width: 100%;
  }
  .drawer-search-form .search-svg {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .drawer-search-input {
    width: 100%;
    background: #f4f4f6;
    border: 1px solid #e5e5e7;
    border-radius: 6px;
    padding: 0.65rem 0.85rem 0.65rem 2.2rem;
    color: #111111;
    font-size: 0.85rem;
    outline: none;
    box-sizing: border-box;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }
  .drawer-nav-item {
    padding: 0.85rem 0;
    color: #111111;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #f4f4f6;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: color 0.2s ease;
  }
  .drawer-nav-item svg {
    color: #555555;
    flex-shrink: 0;
  }
  .drawer-nav-item.highlight {
    color: #e11d48;
  }
  .drawer-nav-item.highlight svg {
    color: #e11d48;
  }
  .drawer-nav-item:hover {
    color: #000000;
    padding-left: 4px;
  }

  /* Drawer Dropdown Accordion for Sub-Items */
  .drawer-nav-group {
    border-bottom: 1px solid #f4f4f6;
  }
  .drawer-nav-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .drawer-nav-group-header .drawer-nav-item {
    border-bottom: none;
    flex: 1;
  }
  .drawer-sub-toggle-btn {
    background: none;
    border: none;
    padding: 0.75rem 0.5rem;
    cursor: pointer;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, color 0.2s ease;
  }
  .drawer-sub-toggle-btn:hover {
    color: #0f172a;
  }
  .drawer-nav-group.open .drawer-sub-toggle-btn {
    transform: rotate(180deg);
    color: #0f172a;
  }
  .drawer-sub-items-list {
    display: none;
    flex-direction: column;
    padding: 0.25rem 0 0.5rem 1rem;
    background: #f8fafc;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .drawer-nav-group.open .drawer-sub-items-list {
    display: flex;
  }
  .drawer-sub-item {
    padding: 0.45rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .drawer-sub-item:hover {
    color: #0f172a;
  }

  .drawer-bottom-contact {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #eaeaea;
  }
  .drawer-wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
