---
---

<!-- Announcement Bar -->
<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="promo-ticker">
      <span class="pulse-dot"></span>
      <strong>LIMITED TIME OFFER:</strong> GET EXTRA 10% OFF ON ALL FUTABA RADIOS & SEAGULL ARF KITS — USE CODE: <code>AKSFLY10</code>
    </div>
    <div class="countdown-widget">
      <span class="label">Buzz Offer Ends:</span>
      <div class="timer" id="top-timer">
        <span id="hours">08</span>h :
        <span id="mins">42</span>m :
        <span id="secs">19</span>s
      </div>
    </div>
  </div>
</div>

<!-- Main Navigation Header -->
<header class="main-header glass-nav sticky-top">
  <div class="container header-grid">
    
    <!-- Brand Logo -->
    <a href="/" class="brand-logo">
      <div class="logo-icon">✈️</div>
      <div class="logo-text">
        <span class="brand-name">AKS <span class="gold-text">AEROMODELS</span></span>
        <span class="brand-tagline">RC AVIATION SUPERSTORE</span>
      </div>
    </a>

    <!-- Live Search Bar -->
    <div class="header-search">
      <form action="/shop" method="GET" class="search-form">
        <input 
          type="text" 
          name="q" 
          placeholder="Search engines, Seagull planes, Futaba radios, balsa..." 
          class="search-input" 
          id="global-search-input"
        />
        <button type="submit" class="search-btn" aria-label="Search">
          🔍
        </button>
      </form>
    </div>

    <!-- User Actions (Auth & Cart) -->
    <div class="header-actions">
      <a href="/shop" class="action-btn" title="Shop All Catalog">
        <span class="icon">📦</span>
        <span class="text">Catalog</span>
      </a>
      <a href="/contact" class="action-btn" title="Contact Expert Support">
        <span class="icon">💬</span>
        <span class="text">Support</span>
      </a>
      <button id="cart-drawer-trigger" class="cart-btn" aria-label="Open Shopping Cart">
        <span class="cart-icon">🛒</span>
        <span class="cart-label">Cart</span>
        <span class="cart-badge" id="cart-count-badge">0</span>
      </button>
    </div>
  </div>

  <!-- Category Nav Strip -->
  <nav class="nav-strip">
    <div class="container nav-links">
      <a href="/shop?category=all" class="nav-item highlight">CRAZY DEALS 🔥</a>
      <a href="/shop?category=engine" class="nav-item">ENGINES</a>
      <a href="/shop?category=radio-receiver" class="nav-item">RADIO & RECEIVER</a>
      <a href="/shop?category=aeromodels" class="nav-item">SEAGULL AEROMODELS</a>
      <a href="/shop?category=balsa-wood" class="nav-item">BALSA WOOD</a>
      <a href="/shop?category=accessories" class="nav-item">ACCESSORIES</a>
      <a href="/blog" class="nav-item">RC BLOG & GUIDES</a>
    </div>
  </nav>
</header>

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: linear-gradient(90deg, #090a0f, #1c1809, #090a0f);
    border-bottom: 1px solid rgba(230, 200, 117, 0.2);
    font-size: 0.8rem;
    padding: 0.4rem 0;
    color: var(--text-primary);
  }
  .announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .promo-ticker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-gold);
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  .promo-ticker code {
    background: rgba(230, 200, 117, 0.2);
    color: var(--accent-gold);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 700;
  }
  .countdown-widget {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .timer {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-gold);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  /* Header Main */
  .sticky-top {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    gap: 1.5rem;
  }
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo-icon {
    font-size: 2.2rem;
    filter: drop-shadow(0 0 10px rgba(230, 200, 117, 0.4));
  }
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #fff;
  }
  .gold-text {
    color: var(--accent-gold);
  }
  .brand-tagline {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  /* Search Bar */
  .header-search {
    flex: 1;
    max-width: 480px;
  }
  .search-form {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.5rem 0.25rem 1rem;
    transition: var(--transition-fast);
  }
  .search-form:focus-within {
    border-color: var(--accent-gold);
    box-shadow: 0 0 15px rgba(230, 200, 117, 0.15);
    background: rgba(255, 255, 255, 0.08);
  }
  .search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.85rem;
  }
  .search-btn {
    font-size: 1rem;
    padding: 0.35rem 0.75rem;
    color: var(--accent-gold);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition: var(--transition-fast);
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  .action-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }
  .cart-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--accent-gold), #b89740);
    color: #08090c;
    font-weight: 700;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-full);
    transition: var(--transition-fast);
  }
  .cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(230, 200, 117, 0.3);
  }
  .cart-badge {
    background: #08090c;
    color: var(--accent-gold);
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
  }

  /* Nav Strip */
  .nav-strip {
    background: rgba(12, 14, 20, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    overflow-x: auto;
    white-space: nowrap;
    padding: 0.6rem 1.25rem;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-item {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    transition: var(--transition-fast);
  }
  .nav-item:hover {
    color: var(--accent-gold);
  }
  .nav-item.highlight {
    color: var(--accent-amber);
  }

  @media (max-width: 900px) {
    .header-grid {
      flex-wrap: wrap;
    }
    .header-search {
      order: 3;
      max-width: 100%;
      width: 100%;
    }
  }
</style>

<script>
  import { getCartFromStorage, openCartDrawer } from '../lib/cartStore';

  function updateBadge() {
    const items = getCartFromStorage();
    const count = items.reduce((acc, cur) => acc + cur.quantity, 0);
    const badge = document.getElementById('cart-count-badge');
    if (badge) badge.textContent = count.toString();
  }

  // Live timer tick
  function startTimer() {
    let seconds = 31339; // ~8h 42m 19s
    setInterval(() => {
      seconds--;
      if (seconds <= 0) seconds = 86400;
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      const hEl = document.getElementById('hours');
      const mEl = document.getElementById('mins');
      const sEl = document.getElementById('secs');
      if (hEl) hEl.textContent = h.toString().padStart(2, '0');
      if (mEl) mEl.textContent = m.toString().padStart(2, '0');
      if (sEl) sEl.textContent = s.toString().padStart(2, '0');
    }, 1000);
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateBadge();
    startTimer();
    
    window.addEventListener('cart-updated', updateBadge);
    
    document.getElementById('cart-drawer-trigger')?.addEventListener('click', () => {
      openCartDrawer();
    });
  });
</script>
