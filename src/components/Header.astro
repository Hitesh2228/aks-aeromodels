---
import LoginModal from './LoginModal.astro';
---

<!-- Announcement Bar (Bellavita Top Strip) -->
<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="promo-ticker">
      <span class="ticker-text">
        <svg class="line-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <strong>Lowest Prices of the Year</strong> — Limited Time Only
      </span>
    </div>
  </div>
</div>

<!-- Main Header Bar -->
<header class="main-header sticky-top">
  <div class="container header-grid">
    
    <!-- Left: Search Bar & Mobile Hamburger -->
    <div class="header-search">
      <button id="mobile-menu-trigger" class="mobile-hamburger-btn" aria-label="Open Navigation Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <form action="/shop" method="GET" class="search-form desktop-search-only">
        <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input 
          type="text" 
          name="search" 
          placeholder="Search for engines, radios, balsa..." 
          class="search-input"
          aria-label="Search products"
        />
      </form>
    </div>

    <!-- Center: Brand Logo -->
    <a href="/" class="brand-logo">
      <span class="brand-name">SKYNODESUAV</span>
    </a>

    <!-- Right: User Account & Cart (Line Art Icons) -->
    <div class="header-actions">
      <a href="/profile" class="account-btn-link" id="header-account-btn" title="User Account & Google Sign In">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="account-label" id="header-account-label">ACCOUNT / LOGIN</span>
      </a>
      <button id="cart-drawer-trigger" class="cart-icon-btn" aria-label="Open Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-badge" id="cart-count-badge">0</span>
      </button>
    </div>
  </div>

  <!-- Category Nav Strip (Clean Luxury Navigation Links) -->
  <nav class="nav-strip">
    <div class="container nav-links">
      <a href="/shop?category=all" class="nav-item">SHOP ALL</a>
      <a href="/shop?category=all" class="nav-item highlight">CRAZY DEALS</a>
      <a href="/shop?category=all" class="nav-item">BESTSELLERS</a>
      <a href="/shop?category=engine" class="nav-item">ENGINES</a>
      <a href="/shop?category=aeromodels" class="nav-item">AEROMODELS</a>
      <a href="/shop?category=radio-receiver" class="nav-item">RADIOS & RECEIVERS</a>
      <a href="/shop?category=balsa-wood" class="nav-item">BALSA WOOD</a>
      <a href="/shop?category=accessories" class="nav-item">ACCESSORIES</a>
      <a href="/aircrafts" class="nav-item showcase-link">3D SHOWCASE ✈️</a>
    </div>
  </nav>

  <!-- Sub-ticker (Bellavita Countdown Strip) -->
  <div class="sub-ticker-strip">
    <div class="container sub-ticker-flex">
      <div class="ticker-message">
        <span class="yellow-dot">●</span> <strong>Buzz Offer Ends</strong> Extra ₹80 off — Hurry!
      </div>
      <div class="countdown-widget">
        <span class="time-box" id="hours">00</span> <small>Days</small>
        <span class="time-box" id="mins">08</span> <small>Hrs</small>
        <span class="time-box" id="secs">42</span> <small>Min</small>
        <span class="time-box" id="sec-ticks">19</span> <small>Sec</small>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Slide-In Navigation Drawer (Bellavita Luxury White Theme + Line-Art Icons) -->
<div class="mobile-nav-drawer-overlay" id="mobile-nav-drawer" aria-hidden="true">
  <div class="mobile-drawer-content">
    
    <div class="drawer-top-head">
      <span class="drawer-brand">SKYNODESUAV</span>
      <button id="close-mobile-drawer" class="drawer-close-btn" aria-label="Close menu">✕</button>
    </div>

    <div class="drawer-search-box">
      <form action="/shop" method="GET" class="drawer-search-form">
        <svg class="search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" name="search" placeholder="Search engines, radios, balsa..." class="drawer-search-input" />
      </form>
    </div>

    <!-- Line-Art SVG Nav Items -->
    <div class="drawer-nav-list">
      <a href="/shop?category=all" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <span>SHOP ALL PRODUCTS</span>
      </a>

      <a href="/shop?category=all" class="drawer-nav-item highlight">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <span>CRAZY DEALS</span>
      </a>

      <a href="/shop?category=engine" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>ENGINES & POWERPLANTS</span>
      </a>

      <a href="/shop?category=aeromodels" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.7 5.2c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>
        <span>SEAGULL AEROMODELS</span>
      </a>

      <a href="/shop?category=radio-receiver" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9c3.9 3.9 3.9 10.3 0 14.2"/></svg>
        <span>RADIOS & RECEIVERS</span>
      </a>

      <a href="/shop?category=balsa-wood" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span>BALSA WOOD SHEETS</span>
      </a>

      <a href="/shop?category=accessories" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <span>FLIGHT ACCESSORIES</span>
      </a>

      <a href="/aircrafts" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>3D FLIGHT SHOWCASE</span>
      </a>

      <a href="/blog" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>RC FLIGHT BLOG</span>
      </a>

      <a href="/about" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>ABOUT SKYNODESUAV</span>
      </a>

      <a href="/contact" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>CONTACT US & FAQ</span>
      </a>

      <a href="/profile" class="drawer-nav-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>MY PILOT PROFILE</span>
      </a>
    </div>

    <div class="drawer-bottom-contact">
      <a href="https://wa.me/917722009120" target="_blank" class="drawer-wa-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-.981z"/></svg>
        <span>WhatsApp Support</span>
      </a>
    </div>

  </div>
</div>

<LoginModal />

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: #111111;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0;
  }
  .announcement-content {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ticker-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Main Header */
  .main-header {
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(body.header-hidden) .main-header {
    transform: translateY(-100%);
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.85rem 0;
  }

  .header-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mobile-hamburger-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .search-form {
    position: relative;
    width: 260px;
  }
  .search-svg {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .search-input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.3rem;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 0.82rem;
    outline: none;
    transition: var(--transition-fast);
    background: #fcfcfc;
  }
  .search-input:focus {
    border-color: #111111;
    background: #ffffff;
  }

  /* Brand Logo */
  .brand-logo {
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #111111;
  }

  /* Header Actions Right */
  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }
  .account-btn-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: #111111;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .cart-icon-btn {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }
  .cart-badge {
    position: absolute;
    top: -4px;
    right: -6px;
    background: #111111;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Nav Strip Desktop */
  .nav-strip {
    border-top: 1px solid #f0f0f0;
    padding: 0.6rem 0;
  }
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    overflow-x: auto;
  }
  .nav-item {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #333333;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .nav-item:hover {
    color: #111111;
  }
  .nav-item.highlight {
    color: #e11d48;
    font-weight: 700;
  }
  .showcase-link {
    color: #2563eb;
    font-weight: 700;
  }

  /* Sub Ticker */
  .sub-ticker-strip {
    background: #3b0811;
    color: #ffffff;
    font-size: 0.75rem;
    padding: 0.35rem 0;
  }
  .sub-ticker-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .yellow-dot { color: #f59e0b; }
  .countdown-widget {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
  }
  .time-box {
    background: rgba(255, 255, 255, 0.15);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
  }

  /* Mobile Drawer Overlay & Content (Bellavita Luxury White Theme) */
  .mobile-nav-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .mobile-nav-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-content {
    width: 320px;
    max-width: 85vw;
    height: 100%;
    background: #ffffff;
    color: #111111;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    box-sizing: border-box;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.15);
  }
  .mobile-nav-drawer-overlay.is-open .mobile-drawer-content {
    transform: translateX(0);
  }

  .drawer-top-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #eaeaea;
  }
  .drawer-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #111111;
  }
  .drawer-close-btn {
    background: transparent;
    border: none;
    color: #555555;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .drawer-search-box {
    margin-bottom: 1.25rem;
  }
  .drawer-search-form {
    position: relative;
    width: 100%;
  }
  .drawer-search-form .search-svg {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .drawer-search-input {
    width: 100%;
    background: #f4f4f6;
    border: 1px solid #e5e5e7;
    border-radius: 6px;
    padding: 0.65rem 0.85rem 0.65rem 2.2rem;
    color: #111111;
    font-size: 0.85rem;
    outline: none;
    box-sizing: border-box;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }
  .drawer-nav-item {
    padding: 0.85rem 0;
    color: #111111;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #f4f4f6;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: color 0.2s ease;
  }
  .drawer-nav-item svg {
    color: #555555;
    flex-shrink: 0;
  }
  .drawer-nav-item.highlight {
    color: #e11d48;
  }
  .drawer-nav-item.highlight svg {
    color: #e11d48;
  }
  .drawer-nav-item:hover {
    color: #000000;
    padding-left: 4px;
  }

  .drawer-bottom-contact {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #eaeaea;
  }
  .drawer-wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.75rem;
    border-radius: 6px;
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .mobile-hamburger-btn {
      display: block;
    }
    .desktop-search-only {
      display: none;
    }
    .account-label {
      display: none;
    }
    .nav-strip {
      display: none;
    }
    .brand-name {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  function initHeaderControls() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('close-mobile-drawer');

    trigger?.addEventListener('click', () => {
      drawer?.classList.add('is-open');
    });

    closeBtn?.addEventListener('click', () => {
      drawer?.classList.remove('is-open');
    });

    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) {
        drawer.classList.remove('is-open');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderControls);
  } else {
    initHeaderControls();
  }
  document.addEventListener('astro:page-load', initHeaderControls);
</script>
