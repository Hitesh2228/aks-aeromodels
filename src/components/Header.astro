---
---

<!-- Announcement Bar (Bellavita Top Strip) -->
<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="ticker-left">‹</div>
    <div class="promo-ticker">
      <span class="ticker-text">
        <svg class="line-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <strong>Lowest Prices of the Year</strong> — Limited Time Only
      </span>
    </div>
    <div class="ticker-right">›</div>
  </div>
</div>

<!-- Main Header Bar -->
<header class="main-header sticky-top">
  <div class="container header-grid">
    
    <!-- Left: Search Bar with Line Art SVG Icon -->
    <div class="header-search">
      <form action="/shop" method="GET" class="search-form">
        <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input 
          type="text" 
          name="q" 
          placeholder="Search for..." 
          class="search-input" 
          id="global-search-input"
        />
      </form>
    </div>

    <!-- Center: Brand Logo -->
    <a href="/" class="brand-logo">
      <span class="brand-name">AKS AEROMODELS</span>
    </a>

    <!-- Right: User Account & Cart (Line Art Icons) -->
    <div class="header-actions">
      <a href="/profile" class="account-btn-link" title="User Account & Google Sign In">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="account-label">ACCOUNT / LOGIN</span>
      </a>
      <button id="cart-drawer-trigger" class="cart-icon-btn" aria-label="Open Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-badge" id="cart-count-badge">0</span>
      </button>
    </div>
  </div>

  <!-- Category Nav Strip (Clean Luxury Navigation Links) -->
  <nav class="nav-strip">
    <div class="container nav-links">
      <a href="/shop?category=all" class="nav-item">SHOP ALL</a>
      <a href="/shop?category=all" class="nav-item highlight">CRAZY DEALS</a>
      <a href="/shop?category=all" class="nav-item">BESTSELLERS</a>
      <a href="/shop?category=engine" class="nav-item">ENGINES</a>
      <a href="/shop?category=aeromodels" class="nav-item">AEROMODELS</a>
      <a href="/shop?category=radio-receiver" class="nav-item">RADIOS & RECEIVERS</a>
      <a href="/shop?category=balsa-wood" class="nav-item">BALSA WOOD</a>
      <a href="/shop?category=accessories" class="nav-item">ACCESSORIES</a>
      <a href="/aircrafts" class="nav-item showcase-link">3D SHOWCASE ✈️</a>
    </div>
  </nav>

  <!-- Sub-ticker (Bellavita Countdown Strip) -->
  <div class="sub-ticker-strip">
    <div class="container sub-ticker-flex">
      <div class="ticker-message">
        <span class="yellow-dot">●</span> <strong>Buzz Offer Ends</strong> Extra ₹80 off — Hurry!
      </div>
      <div class="countdown-widget">
        <span class="time-box" id="hours">00</span> <small>Days</small>
        <span class="time-box" id="mins">08</span> <small>Hrs</small>
        <span class="time-box" id="secs">42</span> <small>Min</small>
        <span class="time-box" id="sec-ticks">19</span> <small>Sec</small>
      </div>
    </div>
  </div>
</header>

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: #111111;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.35rem 0;
  }
  .announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ticker-left, .ticker-right {
    color: #888888;
    font-size: 1rem;
    cursor: pointer;
  }
  .ticker-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .line-icon {
    display: inline-block;
    vertical-align: middle;
  }

  /* Main Header */
  .main-header {
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .sticky-top {
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .header-grid {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    align-items: center;
    padding: 1rem 1.25rem;
  }

  /* Search */
  .header-search {
    position: relative;
  }
  .search-form {
    display: flex;
    align-items: center;
    position: relative;
  }
  .search-svg {
    position: absolute;
    left: 0;
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid #cccccc;
    padding: 0.4rem 0.5rem 0.4rem 1.75rem;
    font-size: 0.85rem;
    background: transparent;
    outline: none;
    transition: var(--transition-fast);
  }
  .search-input:focus {
    border-bottom-color: #3b0811;
  }

  /* Logo */
  .brand-logo {
    text-align: center;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #1a1a1a;
  }

  /* Actions */
  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }
  .account-btn-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: 0.05em;
    padding: 0.45rem 0.85rem;
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }
  .account-btn-link:hover {
    background: #3b0811;
    color: #ffffff;
    border-color: #3b0811;
  }
  .account-btn-link:hover svg {
    stroke: #ffffff;
  }
  .cart-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #3b0811;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Nav Strip */
  .nav-strip {
    background: #fbf9f5;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.65rem 0;
  }
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .nav-item {
    font-family: var(--font-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #333333;
    transition: var(--transition-fast);
  }
  .nav-item:hover {
    color: #3b0811;
  }
  .nav-item.highlight {
    color: #e11d48;
  }
  .showcase-link {
    color: #06b6d4 !important;
  }

  /* Sub Ticker */
  .sub-ticker-strip {
    background: #3b0811;
    color: #ffffff;
    font-size: 0.78rem;
    padding: 0.3rem 0;
  }
  .sub-ticker-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .yellow-dot {
    color: #f59e0b;
    margin-right: 0.3rem;
  }
  .countdown-widget {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }
  .time-box {
    background: rgba(255, 255, 255, 0.15);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  /* Active Nav Link Styling */
  .nav-item.is-active-link {
    color: #3b0811 !important;
    font-weight: 800 !important;
    border-bottom: 2px solid #3b0811;
    padding-bottom: 2px;
  }

  .main-header {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .main-header.nav-hidden {
    transform: translateY(-100%);
  }

  .announcement-bar {
    transition: opacity 0.3s ease;
  }
  .announcement-bar.hide-ticker {
    display: none !important;
  }

  @media (max-width: 900px) {
    .header-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .header-search {
      grid-column: 1 / -1;
      order: 3;
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  import { getCartCount } from '../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const cartTrigger = document.getElementById('cart-drawer-trigger');
    const badge = document.getElementById('cart-count-badge');
    const mainHeader = document.querySelector('.main-header');
    const announcementBar = document.querySelector('.announcement-bar');

    function updateBadge() {
      const count = getCartCount();
      if (badge) {
        badge.textContent = count.toString();
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
    }

    cartTrigger?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cart-drawer'));
    });

    window.addEventListener('cart-updated', updateBadge);
    updateBadge();

    // Active Nav Highlight
    const fullUrl = window.location.pathname + window.location.search;
    const navItems = document.querySelectorAll('.nav-strip .nav-item');

    navItems.forEach(item => {
      const href = item.getAttribute('href');
      if (href && (href === fullUrl || (href !== '/' && fullUrl.startsWith(href)))) {
        item.classList.add('is-active-link');
      }
    });

    // Smart Header Scroll Auto-Hide & Reveal + Top Ticker Visibility
    let lastScrollY = window.scrollY;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;

      // Announcement ticker only visible at the very top
      if (announcementBar) {
        if (currentScrollY > 30) {
          announcementBar.classList.add('hide-ticker');
        } else {
          announcementBar.classList.remove('hide-ticker');
        }
      }

      // Hide header on scroll down, reveal immediately on scroll up
      if (currentScrollY > 120) {
        if (currentScrollY > lastScrollY + 6) {
          mainHeader?.classList.add('nav-hidden');
        } else if (currentScrollY < lastScrollY - 6) {
          mainHeader?.classList.remove('nav-hidden');
        }
      } else {
        mainHeader?.classList.remove('nav-hidden');
      }

      lastScrollY = currentScrollY;
    }, { passive: true });

    // Global Scroll Reveal Observer
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  });
</script>
