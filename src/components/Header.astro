</style>

<script>
  import { getCartCount } from '../lib/cartStore';
  import { getWishlistCount } from '../lib/wishlistStore';

  function initHeaderControls() {
    // Cart Drawer Open Trigger
    const cartTrigger = document.getElementById('cart-drawer-trigger');
    cartTrigger?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cart-drawer'));
    });

    // Account / Login Modal Trigger
    const accountBtn = document.getElementById('header-account-btn');
    accountBtn?.addEventListener('click', (e) => {
      const isLoggedIn = localStorage.getItem('google_auth_logged_in') === 'true';
      if (!isLoggedIn) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-login-modal'));
      }
    });

    function updateHeaderAccountState() {
      const accountLabel = document.getElementById('header-account-label');
      const accountBtn = document.getElementById('header-account-btn') as HTMLAnchorElement;
      const isLoggedIn = localStorage.getItem('google_auth_logged_in') === 'true';

      if (accountLabel) {
        if (isLoggedIn) {
          const name = localStorage.getItem('skynodes_pilot_name') || localStorage.getItem('skynodes_pilot_user') || 'PILOT';
          const firstName = name.split(' ')[0].toUpperCase();
          accountLabel.textContent = `🟢 HI, ${firstName}`;
          if (accountBtn) accountBtn.href = '/profile';
        } else {
          accountLabel.textContent = 'ACCOUNT / LOGIN';
          if (accountBtn) accountBtn.href = '/profile';
        }
      }
    }
    updateHeaderAccountState();
    window.addEventListener('storage', updateHeaderAccountState);
    window.addEventListener('user-logged-in', updateHeaderAccountState);

    function updateWishlistBadge() {
    const badge = document.getElementById('header-wishlist-badge');
    if (badge) {
      badge.textContent = String(getWishlistCount());
    }
  }
  updateWishlistBadge();
  window.addEventListener('wishlist-updated', updateWishlistBadge);

  function updateCartBadge() {
    const badge = document.getElementById('cart-count-badge');
    if (badge) {
      badge.textContent = String(getCartCount());
    }
  }
  window.addEventListener('cart-updated', updateCartBadge);
  updateCartBadge();

    // Mobile Drawer Controls
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('close-mobile-drawer');

    trigger?.addEventListener('click', () => drawer?.classList.add('is-open'));
    closeBtn?.addEventListener('click', () => drawer?.classList.remove('is-open'));
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.remove('is-open');
    });

    // Mobile Drawer Sub-Menu Accordion Toggles
    drawer?.querySelectorAll('.drawer-sub-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const group = btn.closest('.drawer-nav-group');
        if (group) group.classList.toggle('open');
      });
    });

    // Dynamic Scroll Hide on Down / Reveal on Up & Scrolled White Cover
    let lastScrollY = window.scrollY;
    const header = document.querySelector('.main-header');

    function updateHeaderDimensions() {
      if ('requestAnimationFrame' in window) {
        requestAnimationFrame(() => {
          if (header) {
            const height = (header as HTMLElement).offsetHeight;
            if (height > 0) {
              document.documentElement.style.setProperty('--main-header-height', `${height}px`);
            }
          }
        });
      }
    }
    updateHeaderDimensions();
    window.addEventListener('resize', updateHeaderDimensions, { passive: true });

    function handleScroll() {
      const currentScrollY = window.scrollY;

      if (currentScrollY > 60) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }

      if (currentScrollY > 120 && currentScrollY > lastScrollY) {
        document.body.classList.add('header-hidden');
      } else {
        document.body.classList.remove('header-hidden');
      }

      lastScrollY = currentScrollY;
    }

    // Active Link Highlight Handler
    function highlightActiveNav() {
      const currentPath = window.location.pathname;
      const currentSearch = window.location.search;
      const fullUrl = currentPath + currentSearch;

      const navItems = document.querySelectorAll('.nav-strip .nav-item, .drawer-nav-item');
      navItems.forEach(item => {
        const href = item.getAttribute('href');
        if (!href) return;

        item.classList.remove('active');

        if (currentPath === '/shop') {
          if (href.includes('filter=')) {
            if (currentSearch && currentSearch.includes(href.split('?')[1])) {
              item.classList.add('active');
            }
          } else if (href.includes('category=')) {
            if ((!currentSearch || currentSearch === '?category=all') && href === '/shop?category=all') {
              item.classList.add('active');
            } else if (currentSearch && currentSearch !== '?category=all' && href.endsWith(currentSearch)) {
              item.classList.add('active');
            }
          }
        } else if (href === currentPath || href === fullUrl) {
          item.classList.add('active');
        }
      });
    }
    highlightActiveNav();

    // Auto-Repeating Buzz Offer Countdown Timer (Days - Hrs - Min - Sec)
    function initBuzzCountdown() {
      const daysEl = document.getElementById('countdown-days');
      const hoursEl = document.getElementById('countdown-hours');
      const minsEl = document.getElementById('countdown-mins');
      const secsEl = document.getElementById('countdown-secs');

      if (!daysEl && !hoursEl && !minsEl && !secsEl) return;

      const STORAGE_KEY = 'skynode_buzz_countdown_target_v1';
      // 2 Days, 14 Hours, 35 Minutes, 19 Seconds cycle in milliseconds
      const CYCLE_MS = (2 * 24 * 3600 + 14 * 3600 + 35 * 60 + 19) * 1000;

      function getValidTarget(): number {
        const now = Date.now();
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          const parsed = parseInt(stored, 10);
          if (!isNaN(parsed) && parsed > now) {
            return parsed;
          }
        }
        // When zero reached or expired, auto-repeat with fresh cycle
        const newTarget = now + CYCLE_MS;
        try {
          localStorage.setItem(STORAGE_KEY, String(newTarget));
        } catch (e) {}
        return newTarget;
      }

      let targetTime = getValidTarget();

      function updateTimerDisplay() {
        const now = Date.now();
        let remaining = targetTime - now;

        // Auto-repeat when counter reaches zero
        if (remaining <= 0) {
          targetTime = now + CYCLE_MS;
          try {
            localStorage.setItem(STORAGE_KEY, String(targetTime));
          } catch (e) {}
          remaining = targetTime - now;
        }

        const d = Math.floor(remaining / (1000 * 60 * 60 * 24));
        const h = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((remaining % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(d).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(h).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(m).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(s).padStart(2, '0');
      }

      updateTimerDisplay();

      if ((window as any).__skynodeCountdownTimer) {
        clearInterval((window as any).__skynodeCountdownTimer);
      }
      (window as any).__skynodeCountdownTimer = setInterval(updateTimerDisplay, 1000);
    }
    initBuzzCountdown();

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderControls);
  } else {
    initHeaderControls();
  }
  document.addEventListener('astro:page-load', initHeaderControls);
</script>
