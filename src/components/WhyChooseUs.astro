<section class="bellavita-why-section">
  <div class="container">
    <h2 class="bellavita-title">WHY SKYNODESUAV?</h2>

    <div class="why-grid">
      
      <!-- Item 1: Authenticity & Genuine Guarantee -->
      <div class="why-item">
        <div class="why-icon-wrap">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <h3 class="why-item-title">100% GENUINE & AUTHORIZED</h3>
        <p class="why-item-desc">Authorized Indian distributor for Futaba, O.S. Engines, DLE, Seagull Aeromodels & DU-BRO USA.</p>
      </div>

      <!-- Item 2: Precision Engineering -->
      <div class="why-item">
        <div class="why-icon-wrap">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <h3 class="why-item-title">PRECISION BALANCED</h3>
        <p class="why-item-desc">Every balsa sheet, engine carb, and telemetry transmitter passes strict quality protocols.</p>
      </div>

      <!-- Item 3: Direct Value Pricing -->
      <div class="why-item">
        <div class="why-icon-wrap">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg>
        </div>
        <h3 class="why-item-title">FACTORY DIRECT VALUE</h3>
        <p class="why-item-desc">Offering Premium Contest Quality and Flight Performance at Transparent Prices.</p>
      </div>

      <!-- Item 4: AMA & Aeromodel Compatibility -->
      <div class="why-item">
        <div class="why-icon-wrap">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.7 5.2c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>
        </div>
        <h3 class="why-item-title">UNIVERSAL COMPATIBILITY</h3>
        <p class="why-item-desc">Flight gear designed for beginner trainer models up to giant scale 3D competition aircraft.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .bellavita-why-section {
    padding: 4rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 3rem;
    color: #1a1a1a;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .why-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .why-icon-wrap {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #f3eee7;
    border: 1.5px solid #e6e0d5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: var(--transition-fast);
  }
  .why-item:hover .why-icon-wrap {
    background: #ffffff;
    border-color: #3b0811;
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(59, 8, 17, 0.08);
  }
  .why-item-title {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }
  .why-item-desc {
    font-size: 0.8rem;
    color: #666666;
    line-height: 1.6;
    max-width: 250px;
  }

  /* Mobile Only Touch/Grid Adjustments (< 768px) */
  @media (max-width: 768px) {
    .bellavita-why-section {
      padding: 2.25rem 0;
    }
    .bellavita-title {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
    }
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .why-icon-wrap {
      width: 56px;
      height: 56px;
      margin-bottom: 0.75rem;
    }
    .why-icon-wrap svg {
      width: 26px;
      height: 26px;
    }
    .why-item-title {
      font-size: 0.75rem;
    }
    .why-item-desc {
      font-size: 0.72rem;
    }
  }
</style>
