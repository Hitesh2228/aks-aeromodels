<section class="bellavita-deals-section">
  <div class="container">
    <h2 class="bellavita-title">CRAZY DEALS</h2>

    <div class="slider-wrapper-relative">
      <div class="crazy-deals-grid" id="deals-slider-container">
        
        <!-- Deal 1 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-card-inner">
            <div class="deal-badge-header">
              <span class="deal-tag-sub">BUY ANY</span>
              <span class="deal-tag-main">6 FOR ₹1298</span>
              <span class="deal-tag-only">ONLY</span>
            </div>
            
            <div class="deal-media">
              <img src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop" alt="SELF LOVE KIT" />
            </div>
            
            <div class="deal-label">SELF LOVE KIT</div>
          </div>
        </a>

        <!-- Deal 2 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-card-inner">
            <div class="deal-badge-header">
              <span class="deal-tag-sub">BUY ANY</span>
              <span class="deal-tag-main">3 FOR ₹1298</span>
              <span class="deal-tag-only">ONLY</span>
            </div>
            
            <div class="deal-media">
              <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=600&auto=format&fit=crop" alt="ULTIMATE FLIGHT BOX" />
            </div>
            
            <div class="deal-label">ULTIMATE FLIGHT BOX</div>
          </div>
        </a>

        <!-- Deal 3 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-card-inner">
            <div class="deal-badge-header">
              <span class="deal-tag-sub">BUY ANY</span>
              <span class="deal-tag-main">2 FOR ₹649</span>
              <span class="deal-tag-only">ONLY</span>
            </div>
            
            <div class="deal-media">
              <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop" alt="BADE MIYA CHHOTE MIYA" />
            </div>
            
            <div class="deal-label">BADE MIYA CHHOTE MIYA</div>
          </div>
        </a>

      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-deals-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 2.75rem;
    color: #111111;
    font-weight: 600;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  /* Desktop Grid Container (3 items per row) */
  .crazy-deals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    padding: 0.5rem 0.25rem 1.25rem;
  }

  .crazy-deal-card {
    width: 100%;
    text-decoration: none;
    display: flex;
  }

  /* Bellavita Clean Card Inner Box - Zero Overlap */
  .deal-card-inner {
    width: 100%;
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    padding: 1.25rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .crazy-deal-card:hover .deal-card-inner {
    transform: translateY(-4px);
    border-color: #d1d1d1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  /* Top Badge Header (Positioned Cleanly Above Image - ZERO OVERLAP) */
  .deal-badge-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fdf8f4;
    border: 1px solid #dfab85;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    box-sizing: border-box;
  }
  .deal-tag-sub {
    font-size: 0.65rem;
    color: #777777;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .deal-tag-main {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111111;
    font-family: var(--font-display);
    line-height: 1.2;
    margin: 0.15rem 0;
  }
  .deal-tag-only {
    font-size: 0.62rem;
    color: #777777;
    font-weight: 600;
  }

  /* Bellavita Soft Off-White Image Stage */
  .deal-media {
    width: 100%;
    height: 220px;
    background: #f4f4f6;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  .deal-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.05));
    transition: transform 0.3s ease;
  }
  .crazy-deal-card:hover .deal-media img {
    transform: scale(1.04);
  }

  .deal-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #111111;
    letter-spacing: 0.08em;
    text-align: center;
  }

  /* Mobile Only Touch Horizontal Slider (< 768px) */
  @media (max-width: 768px) {
    .bellavita-deals-section { padding: 2.5rem 0; }
    .bellavita-title { font-size: 1.2rem; margin-bottom: 1.75rem; }

    .crazy-deals-grid {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.85rem;
      padding: 0.25rem 0.85rem 1rem;
      margin: 0 -0.85rem;
      scrollbar-width: none;
    }
    .crazy-deals-grid::-webkit-scrollbar {
      display: none;
    }
    .crazy-deal-card {
      flex: 0 0 82%;
      max-width: 270px;
      scroll-snap-align: start;
    }
    .deal-media { height: 180px; }
    .deal-label { font-size: 0.78rem; }
  }
</style>
