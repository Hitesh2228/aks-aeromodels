---
import { CRAZY_DEALS } from '../data/deals';

// Homepage displays EXACTLY top 3 Crazy Deals as requested
const homepageDeals = CRAZY_DEALS.slice(0, 3);
---

<section class="bellavita-deals-section">
  <div class="container">
    <div class="deals-section-header flex-between">
      <h2 class="bellavita-title">🔥 CRAZY DEALS</h2>
      <a href="/shop?filter=crazy-deals" class="view-all-deals-link">VIEW ALL CRAZY DEALS ({CRAZY_DEALS.length}) →</a>
    </div>

    <div class="slider-wrapper-relative">
      <div class="crazy-deals-grid" id="deals-slider-container">
        
        {homepageDeals.map(deal => (
          <a href={deal.linkUrl} class="crazy-deal-card">
            <div class="deal-card-inner">
              <div class="deal-badge-header">
                <span class="deal-tag-sub">{deal.tagSub}</span>
                <span class="deal-tag-main">{deal.tagMain}</span>
                <span class="deal-tag-only">{deal.tagOnly}</span>
              </div>
              
              <div class="deal-media">
                <img src={deal.image} alt={deal.name} />
              </div>
              
              <div class="deal-content-footer">
                <div class="deal-label">{deal.name}</div>
                <div class="deal-price-line">
                  <span class="deal-now-price">₹{deal.price.toLocaleString('en-IN')}</span>
                  <span class="deal-was-price">₹{deal.originalPrice.toLocaleString('en-IN')}</span>
                  <span class="deal-save-pill">{deal.savingsBadge}</span>
                </div>
              </div>
            </div>
          </a>
        ))}

      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-deals-section {
    padding: 4rem 0;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
  }

  .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .bellavita-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111111;
    margin: 0;
    text-transform: uppercase;
  }

  .view-all-deals-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: #111111;
    text-decoration: none;
    letter-spacing: 0.05em;
    padding: 0.5rem 1.2rem;
    border: 1.5px solid #111111;
    border-radius: 50px;
    transition: all 0.25s ease;
  }
  .view-all-deals-link:hover {
    background: #111111;
    color: #ffffff;
  }

  .crazy-deals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .crazy-deal-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .deal-card-inner {
    background: #111111;
    border-radius: 16px;
    padding: 1.5rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .crazy-deal-card:hover .deal-card-inner {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
  }

  .deal-badge-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }

  .deal-tag-sub {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #ffd700;
  }

  .deal-tag-main {
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .deal-tag-only {
    font-size: 0.65rem;
    font-weight: 800;
    background: rgba(255,255,255,0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  .deal-media {
    width: 100%;
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    background: #1e1e1e;
  }

  .deal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .crazy-deal-card:hover .deal-media img {
    transform: scale(1.06);
  }

  .deal-content-footer {
    margin-top: auto;
  }

  .deal-label {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .deal-price-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .deal-now-price {
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffd700;
  }

  .deal-was-price {
    font-size: 0.9rem;
    text-decoration: line-through;
    color: #888888;
  }

  .deal-save-pill {
    font-size: 0.7rem;
    font-weight: 800;
    background: #e63946;
    color: #ffffff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-left: auto;
  }

  @media (max-width: 992px) {
    .crazy-deals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .flex-between {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .crazy-deals-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .deal-media {
      height: 180px;
    }
  }
</style>
