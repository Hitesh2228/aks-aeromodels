<section class="bellavita-deals-section">
  <div class="container">
    <h2 class="bellavita-title">CRAZY DEALS</h2>

    <div class="slider-wrapper-relative">
      <div class="crazy-deals-grid" id="deals-slider-container">
        
        <!-- Deal 1 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-media">
            <div class="deal-badge-strip">
              <span class="deal-tag-sub">Buy Any</span>
              <span class="deal-tag-main">6 for ₹1298</span>
              <span class="deal-tag-only">Only</span>
            </div>
            <img src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop" alt="SELF LOVE KIT" />
          </div>
          <div class="deal-label">SELF LOVE KIT</div>
        </a>

        <!-- Deal 2 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-media">
            <div class="deal-badge-strip">
              <span class="deal-tag-sub">Buy Any</span>
              <span class="deal-tag-main">3 for ₹1298</span>
              <span class="deal-tag-only">Only</span>
            </div>
            <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=600&auto=format&fit=crop" alt="ULTIMATE FLIGHT BOX" />
          </div>
          <div class="deal-label">ULTIMATE FLIGHT BOX</div>
        </a>

        <!-- Deal 3 -->
        <a href="/shop" class="crazy-deal-card">
          <div class="deal-media">
            <div class="deal-badge-strip">
              <span class="deal-tag-sub">Buy Any</span>
              <span class="deal-tag-main">2 for ₹649</span>
              <span class="deal-tag-only">Only</span>
            </div>
            <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop" alt="BADE MIYA CHHOTE MIYA" />
          </div>
          <div class="deal-label">BADE MIYA CHHOTE MIYA</div>
        </a>

      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-deals-section {
    padding: 3.5rem 0;
    background: #fbf9f5;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bellavita-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-align: center;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #1a1a1a;
  }

  .slider-wrapper-relative {
    position: relative;
    width: 100%;
  }

  .slider-arrow {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid #1a1a1a;
    border-radius: 50%;
    color: #1a1a1a;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }
  .slider-arrow:hover {
    background: #1a1a1a;
    color: #ffffff;
  }
  .slider-arrow.prev-btn { left: -16px; }
  .slider-arrow.next-btn { right: -16px; }

  .crazy-deals-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 1.5rem;
    padding: 0.5rem 0.25rem 1.25rem;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .crazy-deals-grid::-webkit-scrollbar {
    display: none;
  }

  .crazy-deal-card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: var(--transition-smooth);
  }
  .crazy-deal-card:hover {
    transform: translateY(-5px);
  }

  .deal-media {
    position: relative;
    width: 100%;
    height: 280px;
    background: #f3eee7;
    border: 1px solid #e6e0d5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .deal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .deal-badge-strip {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid #1a1a1a;
  }
  .deal-tag-sub { font-size: 0.65rem; color: #555; font-weight: 700; text-transform: uppercase; }
  .deal-tag-main { font-size: 1.25rem; font-weight: 800; color: #1a1a1a; font-family: var(--font-display); line-height: 1.1; }
  .deal-tag-only { font-size: 0.65rem; color: #555; text-align: right; }

  .deal-label {
    font-size: 0.85rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .bellavita-deals-section { padding: 2rem 0; }
    .bellavita-title { font-size: 1.2rem; margin-bottom: 1.25rem; }

    .slider-arrow.prev-btn { left: 2px; width: 34px; height: 34px; font-size: 1.2rem; }
    .slider-arrow.next-btn { right: 2px; width: 34px; height: 34px; font-size: 1.2rem; }

    .crazy-deals-grid {
      padding: 0.25rem 0.5rem 1rem;
      gap: 0.85rem;
    }
    .crazy-deal-card {
      flex: 0 0 82%;
      max-width: 270px;
    }
    .deal-media { height: 230px; }
    .deal-label { font-size: 0.78rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prevBtn = document.getElementById('deals-slider-prev');
    const nextBtn = document.getElementById('deals-slider-next');
    const container = document.getElementById('deals-slider-container');

    prevBtn?.addEventListener('click', () => {
      container?.scrollBy({ left: -300, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      container?.scrollBy({ left: 300, behavior: 'smooth' });
    });
  });
</script>
