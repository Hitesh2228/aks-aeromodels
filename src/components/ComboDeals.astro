---
import { getCombinedProducts } from '../lib/shopify';

const PRODUCTS = await getCombinedProducts();

// Filter products marked with isCrazyDeal
const crazyDealProducts = PRODUCTS.filter(p => p.isCrazyDeal);

// Homepage displays top Crazy Deals
const homepageDeals = crazyDealProducts.length > 0 ? crazyDealProducts.slice(0, 3) : PRODUCTS.slice(0, 3);
---

<section class="bellavita-deals-section">
  <div class="container">
    <div class="deals-header-row flex-between">
      <h2 class="bellavita-title">CRAZY DEALS</h2>
      <a href="/shop?filter=crazy-deals" class="view-all-link">VIEW ALL CRAZY DEALS (10) →</a>
    </div>

    <div class="slider-wrapper-relative">
      <div class="crazy-deals-grid" id="deals-slider-container">
        
        {homepageDeals.map(deal => (
          <a href={`/product/${deal.id}`} class="crazy-deal-card">
            <div class="deal-card-inner">
              <div class="deal-badge-header">
                <span class="deal-tag-sub">EXCLUSIVE DEAL</span>
                <span class="deal-tag-main">{deal.discountBadge || 'SPECIAL OFFER'}</span>
                <span class="deal-tag-only">LIMITED TIME</span>
              </div>
              
              <div class="deal-media" style="position: relative;">
                <button type="button" class="btn-share-product" data-url={`/product/${deal.id}`} data-title={deal.name} data-text={`Check out ${deal.name} on SKYNODES UAV!`} aria-label="Share Product" title="Share Product">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                  </svg>
                </button>
                <img src={deal.image} alt={deal.name} />
              </div>
              
              <div class="deal-label">{deal.name}</div>
              <div class="deal-price-sub">
                <span class="p-now">₹{deal.price.toLocaleString('en-IN')}.00</span>
                <span class="p-was">₹{deal.originalPrice.toLocaleString('en-IN')}.00</span>
                <span class="badge-save">{deal.discountBadge || 'DEAL'}</span>
              </div>
            </div>
          </a>
        ))}

      </div>
    </div>
  </div>
</section>

<style>
  .bellavita-deals-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
  }

  .deals-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .bellavita-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111111;
    margin: 0;
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .view-all-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #111111;
    text-decoration: none;
    letter-spacing: 0.05em;
    border-bottom: 2px solid #111111;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }
  .view-all-link:hover {
    opacity: 0.7;
  }

  .crazy-deals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .crazy-deal-card {
    width: 100%;
    text-decoration: none;
    display: flex;
  }

  /* Bellavita Clean Card Inner Box */
  .deal-card-inner {
    width: 100%;
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    padding: 1.25rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .crazy-deal-card:hover .deal-card-inner {
    transform: translateY(-4px);
    border-color: #dfab85;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  /* Top Badge Header (Positioned Cleanly Above Image - ZERO OVERLAP) */
  .deal-badge-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fdf8f4;
    border: 1px solid #dfab85;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    box-sizing: border-box;
  }
  .deal-tag-sub {
    font-size: 0.65rem;
    color: #777777;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .deal-tag-main {
    font-size: 1.1rem;
    font-weight: 800;
    color: #111111;
    font-family: var(--font-display);
    line-height: 1.2;
    margin: 0.15rem 0;
    text-align: center;
  }
  .deal-tag-only {
    font-size: 0.62rem;
    color: #777777;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* Bellavita Soft Off-White Image Stage */
  .deal-media {
    position: relative;
    width: 100%;
    height: 220px;
    background: #f4f4f6;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  .deal-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  .crazy-deal-card:hover .deal-media img {
    transform: scale(1.05);
  }

  .btn-share-product {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .btn-share-product:hover {
    transform: scale(1.1);
    background: #ffffff;
    border-color: #3b0811;
  }

  .deal-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #111111;
    letter-spacing: 0.05em;
    text-align: center;
    margin-bottom: 0.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  .deal-price-sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .p-now {
    font-size: 1.05rem;
    font-weight: 800;
    color: #111111;
  }
  .p-was {
    font-size: 0.82rem;
    text-decoration: line-through;
    color: #888888;
  }
  .badge-save {
    font-size: 0.68rem;
    font-weight: 700;
    background: #e63946;
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  /* Mobile Only Touch Horizontal Slider (< 768px) */
  @media (max-width: 768px) {
    .crazy-deals-grid {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.85rem;
      padding: 0.25rem 0.85rem 1rem;
      margin: 0 -0.85rem;
      scrollbar-width: none;
    }
    .crazy-deals-grid::-webkit-scrollbar {
      display: none;
    }
    .crazy-deal-card {
      flex: 0 0 82%;
      max-width: 270px;
      scroll-snap-align: start;
    }
    .deal-media { height: 180px; }
    .deal-label { font-size: 0.78rem; }
  }
</style>

<script>
  import { initShareButtons } from '../lib/shareHelper';
  import { fetchLiveShopifyProducts } from '../lib/clientShopifySync';

  async function syncDealsLive() {
    initShareButtons();
    try {
      const liveProducts = await fetchLiveShopifyProducts();
      if (!liveProducts || liveProducts.length === 0) return;

      const crazyDeals = liveProducts.filter(p => p.isCrazyDeal);
      if (crazyDeals.length === 0) return;

      const container = document.getElementById('deals-slider-container');
      if (!container) return;

      const dealsToDisplay = crazyDeals.slice(0, 3);
      container.innerHTML = dealsToDisplay.map(deal => `
        <a href="/product/${deal.id}" class="crazy-deal-card">
          <div class="deal-card-inner">
            <div class="deal-badge-header">
              <span class="deal-tag-sub">EXCLUSIVE DEAL</span>
              <span class="deal-tag-main">${deal.discountBadge || 'SPECIAL OFFER'}</span>
              <span class="deal-tag-only">LIMITED TIME</span>
            </div>
            
            <div class="deal-media" style="position: relative;">
              <button type="button" class="btn-share-product" data-url="/product/${deal.id}" data-title="${deal.title.replace(/"/g, '&quot;')}" data-text="Check out ${deal.title.replace(/"/g, '&quot;')} on SKYNODES UAV!" aria-label="Share Product" title="Share Product">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
              </button>
              <img src="${deal.imageUrl}" alt="${deal.title.replace(/"/g, '&quot;')}" />
            </div>
            
            <div class="deal-label">${deal.title}</div>
            <div class="deal-price-sub">
              <span class="p-now">₹${deal.price.toLocaleString('en-IN')}.00</span>
              <span class="p-was">₹${deal.originalPrice.toLocaleString('en-IN')}.00</span>
              <span class="badge-save">${deal.discountBadge || 'DEAL'}</span>
            </div>
          </div>
        </a>
      `).join('');

      initShareButtons();
    } catch (err) {
      console.error('[Deals Sync Error]', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncDealsLive);
  } else {
    syncDealsLive();
  }
  document.addEventListener('astro:page-load', syncDealsLive);
</script>
