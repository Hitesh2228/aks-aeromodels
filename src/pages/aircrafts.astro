---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Advanced 3D Flight Showcase | SKYNODESUAV</title>
  <meta name="description" content="Next-generation interactive 3D aeromodelling inspection featuring HUD flight telemetry, real-time particle effects, and 360-degree GSAP scroll dynamics." />
</head>
<body class="dark-showcase-theme">

  <Header />

  <!-- Fixed 3D WebGL Canvas Background -->
  <div id="canvas-container">
    <canvas id="webgl-canvas"></canvas>
  </div>

  <!-- Cyberpunk / Sci-Fi HUD Overlay (Heads-Up Display) -->
  <div class="hud-overlay">
    
    <!-- HUD Top Left Telemetry Bar -->
    <div class="hud-widget hud-top-left glass-hud">
      <div class="hud-header">
        <span class="hud-dot pulsing"></span>
        <span class="hud-title">SYSTEM TELEMETRY</span>
      </div>
      <div class="hud-metrics">
        <div class="metric"><span class="m-label">PITCH</span><span class="m-val" id="hud-pitch">0.0°</span></div>
        <div class="metric"><span class="m-label">ROLL</span><span class="m-val" id="hud-roll">0.0°</span></div>
        <div class="metric"><span class="m-label">AIRSPEED</span><span class="m-val" id="hud-speed">140 KM/H</span></div>
        <div class="metric"><span class="m-label">THRUST</span><span class="m-val" id="hud-thrust">98%</span></div>
      </div>
    </div>

    <!-- HUD Top Right System Status & Sound Toggle -->
    <div class="hud-widget hud-top-right glass-hud">
      <div class="hud-flex">
        <button id="sound-toggle-btn" class="hud-audio-btn">
          <span id="sound-icon">🔊</span> SFX: <span id="sound-status">ON</span>
        </button>
        <div class="hud-status">
          <span class="status-badge">GPS LOCKED (14 SAT)</span>
        </div>
      </div>
    </div>

    <!-- HUD Center Target Reticle -->
    <div class="hud-reticle">
      <div class="reticle-ring"></div>
      <div class="reticle-crosshair"></div>
    </div>

    <!-- HUD Right Scroll Progress Navigation -->
    <div class="hud-nav-dots">
      <div class="nav-dot active" data-sec="1"><span class="tooltip">01 AIRFRAME</span></div>
      <div class="nav-dot" data-sec="2"><span class="tooltip">02 PROPULSION</span></div>
      <div class="nav-dot" data-sec="3"><span class="tooltip">03 DYNAMICS</span></div>
      <div class="nav-dot" data-sec="4"><span class="tooltip">04 AVIONICS</span></div>
    </div>

  </div>

  <!-- Scrollable Storytelling Sections -->
  <main class="showcase-wrapper">
    
    <!-- Hero Section -->
    <section class="hero-section" id="hero">
      <div class="hero-content">
        <div class="tech-badge">
          <span class="pulse-dot"></span> MILITARY-GRADE AERODYNAMICS
        </div>
        <h1 class="hero-title">
          BEYOND THE <span class="cyan-gradient">HORIZON</span>
        </h1>
        <p class="hero-desc">
          Experience ultra-responsive 3D flight telemetry, carbon-reinforced spars, and 2.5kg static thrust in motion.
        </p>

        <div class="scroll-hint">
          <div class="mouse-scroll-indicator">
            <div class="scroll-wheel"></div>
          </div>
          <span class="hint-text">SCROLL TO UNLOCK SPECS</span>
        </div>
      </div>
    </section>

    <!-- Scroll Section 1: Airframe Architecture -->
    <section class="spec-section" id="spec-section-1">
      <div class="spec-card cyber-card left-card">
        <div class="corner-bracket top-left"></div>
        <div class="corner-bracket bottom-right"></div>
        
        <div class="card-tag">SECTION 01 / AIRFRAME MATRIX</div>
        <h2 class="card-title">COMPOSITE BALSA AIRFRAME</h2>
        
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Wingspan</span>
            <span class="spec-value">1200 mm (47.2 in)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Airfoil Section</span>
            <span class="spec-value">Semi-Symmetrical High-Lift</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Wing Area</span>
            <span class="spec-value">32.5 dm²</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Structural Material</span>
            <span class="spec-value">Laser-Cut AAA Balsa & Carbon Tubes</span>
          </div>
        </div>

        <div class="progress-bar-container">
          <div class="bar-label"><span>Airframe Rigidity Score</span><strong>98%</strong></div>
          <div class="bar-track"><div class="bar-fill" style="width: 98%;"></div></div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 2: Propulsion System -->
    <section class="spec-section" id="spec-section-2">
      <div class="spec-card cyber-card right-card">
        <div class="corner-bracket top-left"></div>
        <div class="corner-bracket bottom-right"></div>

        <div class="card-tag">SECTION 02 / PROPULSION</div>
        <h2 class="card-title">BRUSHLESS OUTRUNNER</h2>
        
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Motor Type</span>
            <span class="spec-value">2212 1400KV Brushless</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">ESC Unit</span>
            <span class="spec-value">40A Opto BEC (2-4S)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Propeller</span>
            <span class="spec-value">9x6 2-Blade Carbon Composite</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Peak Static Thrust</span>
            <span class="spec-value">2,500 grams (25 N)</span>
          </div>
        </div>

        <div class="progress-bar-container">
          <div class="bar-label"><span>Power Efficiency Ratio</span><strong>95%</strong></div>
          <div class="bar-track"><div class="bar-fill" style="width: 95%;"></div></div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 3: Aerodynamic Dynamics -->
    <section class="spec-section" id="spec-section-3">
      <div class="spec-card cyber-card center-bottom-card">
        <div class="corner-bracket top-left"></div>
        <div class="corner-bracket bottom-right"></div>

        <div class="card-tag">SECTION 03 / DYNAMICS & SPEED</div>
        <h2 class="card-title">FLIGHT PERFORMANCE METRICS</h2>
        
        <div class="spec-grid-4x">
          <div class="stat-box">
            <span class="stat-val">140<small>KM/H</small></span>
            <span class="stat-lbl">Top Velocity</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">2.5 : 1</span>
            <span class="stat-lbl">Thrust Ratio</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">22<small>KM/H</small></span>
            <span class="stat-lbl">Stall Velocity</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">+8G / -4G</span>
            <span class="stat-lbl">Load Factor</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 4: Avionics & Flight Control -->
    <section class="spec-section" id="spec-section-4">
      <div class="spec-card cyber-card left-card">
        <div class="corner-bracket top-left"></div>
        <div class="corner-bracket bottom-right"></div>

        <div class="card-tag">SECTION 04 / AVIONICS TELEMETRY</div>
        <h2 class="card-title">FUTABA 2.4GHz TELEMETRY</h2>
        
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Transmitter Link</span>
            <span class="spec-value">Futaba T-FHSS 2.4GHz</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Control Range</span>
            <span class="spec-value">2,000 Meters (2.0 km)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Battery Configuration</span>
            <span class="spec-value">4S 2200mAh 45C LiPo</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Flight Endurance</span>
            <span class="spec-value">12 - 15 Minutes</span>
          </div>
        </div>

        <div class="progress-bar-container">
          <div class="bar-label"><span>Signal Reliability</span><strong>99.9%</strong></div>
          <div class="bar-track"><div class="bar-fill" style="width: 99.9%;"></div></div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="cta-section" id="cta">
      <div class="cta-box cyber-card">
        <div class="corner-bracket top-left"></div>
        <div class="corner-bracket bottom-right"></div>

        <h2 class="cta-title">TAKEOFF APPROVED</h2>
        <p class="cta-desc">
          Configure your complete ARF aerobatic kit with factory-tested brushless motor, carbon spars, and pan-India insured express freight.
        </p>

        <div class="cta-buttons">
          <a href="/shop?category=aeromodels" class="btn-cyber-primary">
            <span>BUY NOW / SHOP STORE</span> ➔
          </a>
          <a href="/product/sea-1" class="btn-cyber-secondary">
            FULL SPECIFICATIONS
          </a>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <MobileBottomNav />
  <Footer />

  <!-- Three.js + GSAP + Sound Engine Script -->
  <script>
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Audio SFX Synthesizer via Web Audio API
    class SFXEngine {
      ctx: AudioContext | null = null;
      enabled: boolean = true;

      init() {
        if (!this.ctx) {
          const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          this.ctx = new AudioContextClass();
        }
      }

      playBeep(freq = 880, type: OscillatorType = 'sine', duration = 0.08) {
        if (!this.enabled) return;
        try {
          this.init();
          if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
          
          const osc = this.ctx!.createOscillator();
          const gain = this.ctx!.createGain();
          
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx!.currentTime);
          
          gain.gain.setValueAtTime(0.05, this.ctx!.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx!.currentTime + duration);
          
          osc.connect(gain);
          gain.connect(this.ctx!.destination);
          
          osc.start();
          osc.stop(this.ctx!.currentTime + duration);
        } catch {}
      }
    }

    const sfx = new SFXEngine();

    // Sound toggle UI handler
    document.getElementById('sound-toggle-btn')?.addEventListener('click', () => {
      sfx.enabled = !sfx.enabled;
      const status = document.getElementById('sound-status');
      const icon = document.getElementById('sound-icon');
      if (status) status.textContent = sfx.enabled ? 'ON' : 'OFF';
      if (icon) icon.textContent = sfx.enabled ? '🔊' : '🔇';
      if (sfx.enabled) sfx.playBeep(1200, 'sine', 0.1);
    });

    // 3D Scene Initialization
    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
    if (canvas) {
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x060810, 0.04);

      const camera = new THREE.PerspectiveCamera(
        45,
        window.innerWidth / window.innerHeight,
        0.1,
        1000
      );
      camera.position.set(0, 0, 9);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.3;

      // Lights
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);

      const cyanDirLight = new THREE.DirectionalLight(0x00f2fe, 3.0);
      cyanDirLight.position.set(6, 8, 6);
      scene.add(cyanDirLight);

      const magentaDirLight = new THREE.DirectionalLight(0xff007f, 1.8);
      magentaDirLight.position.set(-6, -4, -4);
      scene.add(magentaDirLight);

      const laserScanLight = new THREE.SpotLight(0x00f2fe, 5, 20, Math.PI / 6, 0.5);
      laserScanLight.position.set(0, 5, 0);
      scene.add(laserScanLight);

      // Starfield Dust Particles
      const particleCount = 1500;
      const particleGeo = new THREE.BufferGeometry();
      const particlePositions = new Float32Array(particleCount * 3);

      for (let i = 0; i < particleCount * 3; i += 3) {
        particlePositions[i] = (Math.random() - 0.5) * 40;
        particlePositions[i + 1] = (Math.random() - 0.5) * 40;
        particlePositions[i + 2] = (Math.random() - 0.5) * 40;
      }

      particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
      const particleMat = new THREE.PointsMaterial({
        color: 0x00f2fe,
        size: 0.05,
        transparent: true,
        opacity: 0.6,
        blending: THREE.AdditiveBlending
      });
      const starfield = new THREE.Points(particleGeo, particleMat);
      scene.add(starfield);

      // Wireframe Radar Grid Ground
      const gridHelper = new THREE.GridHelper(30, 30, 0x00f2fe, 0x1e293b);
      gridHelper.position.y = -3.5;
      gridHelper.material.transparent = true;
      gridHelper.material.opacity = 0.25;
      scene.add(gridHelper);

      // Aircraft Group Pivot
      const aircraftGroup = new THREE.Group();
      scene.add(aircraftGroup);

      // Procedural Cyberpunk Jet Fighter Generator (Fallback if GLB unavailable)
      function createAdvancedAircraft(): any {
        const group = new THREE.Group();

        // Fuselage Body
        const fuseGeo = new THREE.ConeGeometry(0.55, 4.5, 32);
        const fuseMat = new THREE.MeshStandardMaterial({
          color: 0x0a101d,
          metalness: 0.9,
          roughness: 0.15,
        });
        const fuselage = new THREE.Mesh(fuseGeo, fuseMat);
        fuselage.rotation.x = Math.PI / 2;
        group.add(fuselage);

        // Cockpit Glass
        const glassGeo = new THREE.SphereGeometry(0.38, 32, 32);
        const glassMat = new THREE.MeshPhysicalMaterial({
          color: 0x00f2fe,
          transmission: 0.9,
          opacity: 1,
          transparent: true,
          roughness: 0.05,
          ior: 1.6
        });
        const canopy = new THREE.Mesh(glassGeo, glassMat);
        canopy.scale.set(0.75, 0.45, 1.9);
        canopy.position.set(0, 0.28, 0.3);
        group.add(canopy);

        // Delta Swept Wings
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, 0);
        wingShape.lineTo(3.8, -1.2);
        wingShape.lineTo(3.4, -1.8);
        wingShape.lineTo(0, -1.2);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.06, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: 0.03, bevelThickness: 0.03 };
        const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
        const wingMat = new THREE.MeshStandardMaterial({
          color: 0x111927,
          metalness: 0.8,
          roughness: 0.2
        });

        const leftWing = new THREE.Mesh(wingGeo, wingMat);
        leftWing.rotation.x = Math.PI / 2;
        leftWing.position.set(0, 0, 0.5);
        group.add(leftWing);

        const rightWing = leftWing.clone();
        rightWing.scale.x = -1;
        group.add(rightWing);

        // Twin Tail Fins
        const tailGeo = new THREE.BoxGeometry(0.04, 1.1, 0.9);
        const leftTail = new THREE.Mesh(tailGeo, wingMat);
        leftTail.position.set(-0.35, 0.6, -1.7);
        leftTail.rotation.z = -0.25;
        leftTail.rotation.x = -0.2;
        group.add(leftTail);

        const rightTail = leftTail.clone();
        rightTail.position.x = 0.35;
        rightTail.rotation.z = 0.25;
        group.add(rightTail);

        // Jet Engine Exhaust Nozzle with Glow
        const nozzleGeo = new THREE.CylinderGeometry(0.3, 0.35, 0.6, 32);
        const nozzleMat = new THREE.MeshStandardMaterial({ color: 0x222222, metalness: 1 });
        const nozzle = new THREE.Mesh(nozzleGeo, nozzleMat);
        nozzle.rotation.x = Math.PI / 2;
        nozzle.position.set(0, 0, -2.1);
        group.add(nozzle);

        // Engine Thruster Glow Ring
        const ringGeo = new THREE.RingGeometry(0.1, 0.3, 32);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x00f2fe, side: THREE.DoubleSide });
        const glowRing = new THREE.Mesh(ringGeo, ringMat);
        glowRing.position.set(0, 0, -2.4);
        group.add(glowRing);

        // Wingtip LED Beacons
        const ledGeo = new THREE.SphereGeometry(0.07, 16, 16);
        const redLed = new THREE.Mesh(ledGeo, new THREE.MeshBasicMaterial({ color: 0xff0055 }));
        redLed.position.set(-3.8, 0, -0.7);
        group.add(redLed);

        const greenLed = new THREE.Mesh(ledGeo, new THREE.MeshBasicMaterial({ color: 0x00ff88 }));
        greenLed.position.set(3.8, 0, -0.7);
        group.add(greenLed);

        return group;
      }

      // Try loading /airplane.glb or load procedural model
      const loader = new GLTFLoader();
      loader.load(
        '/airplane.glb',
        (gltf: any) => {
          const loadedModel = gltf.scene;
          const box = new THREE.Box3().setFromObject(loadedModel);
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const scale = 5.5 / maxDim;
          loadedModel.scale.set(scale, scale, scale);

          const center = box.getCenter(new THREE.Vector3());
          loadedModel.position.sub(center.multiplyScalar(scale));
          aircraftGroup.add(loadedModel);
        },
        undefined,
        () => {
          const fallback = createAdvancedAircraft();
          aircraftGroup.add(fallback);
        }
      );

      // Mouse Parallax Interaction
      let mouseX = 0;
      let mouseY = 0;
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 0.4;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 0.4;
      });

      // Animation Loop
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        // Parallax smooth interpolation
        aircraftGroup.rotation.z += (mouseX - aircraftGroup.rotation.z) * 0.05;
        aircraftGroup.rotation.x += (mouseY - aircraftGroup.rotation.x) * 0.05;

        // Starfield gentle rotation
        starfield.rotation.y = elapsedTime * 0.02;
        gridHelper.position.z = (elapsedTime * 0.5) % 1;

        // Laser scan movement
        laserScanLight.position.x = Math.sin(elapsedTime * 2) * 3;

        renderer.render(scene, camera);
      }
      animate();

      // GSAP ScrollTrigger 3D Storyboarding
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.showcase-wrapper',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.2,
          onUpdate: (self) => {
            // Update HUD values dynamically based on scroll progress
            const progress = self.progress;
            const pitchEl = document.getElementById('hud-pitch');
            const rollEl = document.getElementById('hud-roll');
            const thrustEl = document.getElementById('hud-thrust');
            
            if (pitchEl) pitchEl.textContent = `${(Math.sin(progress * Math.PI * 4) * 25).toFixed(1)}°`;
            if (rollEl) rollEl.textContent = `${(progress * 360).toFixed(1)}°`;
            if (thrustEl) thrustEl.textContent = `${Math.floor(80 + Math.sin(progress * 10) * 18)}%`;

            // Active dot update
            const dots = document.querySelectorAll('.nav-dot');
            const currentSection = Math.min(3, Math.floor(progress * 4));
            dots.forEach((dot, idx) => {
              dot.classList.toggle('active', idx === currentSection);
            });

            // Play subtle UI tick sound on scroll threshold
            const prevVal = (self as any).previous || 0;
            if (Math.floor(progress * 10) !== Math.floor(prevVal * 10)) {
              sfx.playBeep(900 + progress * 400, 'sine', 0.04);
            }
          }
        }
      });

      // GSAP 3D Motion Stages
      tl.to(aircraftGroup.rotation, { y: Math.PI * 0.7, z: 0.35, x: 0.15, duration: 1 }, 0)
        .to(camera.position, { z: 7.5, duration: 1 }, 0)
        .to(aircraftGroup.rotation, { y: Math.PI * 1.35, z: -0.4, x: -0.25, duration: 1 }, 1)
        .to(camera.position, { z: 6.2, duration: 1 }, 1)
        .to(aircraftGroup.rotation, { y: Math.PI * 1.85, z: 0.15, x: 0.5, duration: 1 }, 2)
        .to(camera.position, { z: 5.8, duration: 1 }, 2)
        .to(aircraftGroup.rotation, { y: Math.PI * 2, z: 0, x: -0.1, duration: 1 }, 3)
        .to(camera.position, { z: 8.5, duration: 1 }, 3);

      // Hide HUD & Canvas when reaching CTA / Footer to prevent overlap
      ScrollTrigger.create({
        trigger: '#cta',
        start: 'top 75%',
        onEnter: () => {
          document.querySelector('.hud-overlay')?.classList.add('hud-hidden');
          document.getElementById('canvas-container')?.classList.add('canvas-hidden');
        },
        onLeaveBack: () => {
          document.querySelector('.hud-overlay')?.classList.remove('hud-hidden');
          document.getElementById('canvas-container')?.classList.remove('canvas-hidden');
        }
      });

      // Window Resize Listener
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  </script>

  <style>
    :global(body.dark-showcase-theme) {
      background-color: #060810 !important;
      color: #f8fafc !important;
      overflow-x: hidden;
      font-family: var(--font-main);
    }

    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
      transition: opacity 0.5s ease;
    }
    #canvas-container.canvas-hidden {
      opacity: 0;
      pointer-events: none;
    }

    #webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* HUD Overlay */
    .hud-overlay {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      transition: opacity 0.5s ease;
    }
    .hud-overlay.hud-hidden {
      opacity: 0;
      pointer-events: none;
    }

    .glass-hud {
      background: rgba(6, 8, 16, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 242, 254, 0.2);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      pointer-events: auto;
    }

    .hud-top-left {
      position: absolute;
      top: 10.5rem;
      left: 2rem;
      min-width: 220px;
    }

    .hud-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 0.4rem;
      margin-bottom: 0.6rem;
    }
    .hud-dot {
      width: 8px;
      height: 8px;
      background: #00f2fe;
      border-radius: 50%;
      box-shadow: 0 0 8px #00f2fe;
    }
    .hud-title {
      font-size: 0.7rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.12em;
    }

    .hud-metrics {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .metric {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
    }
    .m-label { color: #64748b; font-weight: 600; }
    .m-val { color: #ffffff; font-weight: 800; font-family: var(--font-display); }

    .hud-top-right {
      position: absolute;
      top: 10.5rem;
      right: 2rem;
    }
    .hud-flex {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .hud-audio-btn {
      background: rgba(0, 242, 254, 0.1);
      border: 1px solid rgba(0, 242, 254, 0.3);
      color: #00f2fe;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      transition: var(--transition-fast);
    }
    .hud-audio-btn:hover {
      background: rgba(0, 242, 254, 0.25);
    }
    .status-badge {
      font-size: 0.7rem;
      font-weight: 800;
      color: #10b981;
      letter-spacing: 0.08em;
    }

    /* Reticle */
    .hud-reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 260px;
      height: 260px;
      border: 1px dashed rgba(0, 242, 254, 0.15);
      border-radius: 50%;
    }
    .reticle-crosshair {
      position: absolute;
      inset: 50%;
      width: 12px;
      height: 12px;
      transform: translate(-50%, -50%);
      border: 1px solid rgba(0, 242, 254, 0.4);
    }

    /* HUD Dots Nav */
    .hud-nav-dots {
      position: absolute;
      right: 2rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      pointer-events: auto;
    }
    .nav-dot {
      position: relative;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(0, 242, 254, 0.4);
      transition: var(--transition-fast);
      cursor: pointer;
    }
    .nav-dot.active {
      background: #00f2fe;
      box-shadow: 0 0 12px #00f2fe;
      transform: scale(1.4);
    }
    .nav-dot .tooltip {
      position: absolute;
      right: 1.75rem;
      top: 50%;
      transform: translateY(-50%);
      background: #060810;
      border: 1px solid #00f2fe;
      color: #00f2fe;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .nav-dot:hover .tooltip { opacity: 1; }

    /* Scrollable Wrapper */
    .showcase-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    /* Hero Section */
    .hero-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 1.5rem;
    }
    .hero-content { max-width: 840px; }

    .tech-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 242, 254, 0.1);
      border: 1px solid rgba(0, 242, 254, 0.3);
      color: #00f2fe;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.4rem 1.1rem;
      border-radius: 9999px;
      margin-bottom: 1.5rem;
      letter-spacing: 0.12em;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #00f2fe;
      border-radius: 50%;
      box-shadow: 0 0 10px #00f2fe;
      animation: pulse 1.5s infinite;
    }

    .hero-title {
      font-size: 4rem;
      line-height: 1.05;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
    }
    .cyan-gradient {
      background: linear-gradient(135deg, #ffffff 0%, #00f2fe 50%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: 1.15rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 3.5rem;
    }

    .scroll-hint {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      color: #00f2fe;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.12em;
    }
    .mouse-scroll-indicator {
      width: 24px;
      height: 38px;
      border: 2px solid #00f2fe;
      border-radius: 12px;
      position: relative;
    }
    .scroll-wheel {
      width: 4px;
      height: 8px;
      background: #00f2fe;
      border-radius: 2px;
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      animation: scrollAnim 1.5s infinite;
    }
    @keyframes scrollAnim {
      0% { opacity: 1; transform: translate(-50%, 0); }
      100% { opacity: 0; transform: translate(-50%, 14px); }
    }

    /* Spec Sections */
    .spec-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 2rem 1.5rem;
      position: relative;
    }

    /* Cyberpunk Cards */
    .cyber-card {
      position: relative;
      background: rgba(10, 16, 29, 0.75);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(0, 242, 254, 0.3);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 242, 254, 0.08);
      border-radius: 16px;
      padding: 2.25rem 2.5rem;
      max-width: 460px;
      width: 100%;
    }
    .corner-bracket {
      position: absolute;
      width: 12px;
      height: 12px;
      border: 2px solid #00f2fe;
    }
    .top-left { top: -2px; left: -2px; border-right: none; border-bottom: none; }
    .bottom-right { bottom: -2px; right: -2px; border-left: none; border-top: none; }

    .left-card { margin-left: 6%; }
    .right-card { margin-left: auto; margin-right: 6%; }
    .center-bottom-card { margin: 0 auto; max-width: 620px; }

    .card-tag {
      font-size: 0.72rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.15em;
      margin-bottom: 0.5rem;
    }
    .card-title {
      font-size: 1.4rem;
      color: #ffffff;
      margin-bottom: 1.5rem;
      font-weight: 800;
    }

    .spec-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }
    .spec-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 0.6rem;
    }
    .spec-label { font-size: 0.85rem; color: #94a3b8; }
    .spec-value { font-size: 0.9rem; font-weight: 800; color: #ffffff; }

    .progress-bar-container {
      margin-top: 1rem;
    }
    .bar-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: #94a3b8;
      margin-bottom: 0.35rem;
    }
    .bar-label strong { color: #00f2fe; }
    .bar-track {
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #06b6d4, #00f2fe);
      border-radius: 3px;
    }

    .spec-grid-4x {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .stat-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(0, 242, 254, 0.2);
      padding: 1.25rem;
      border-radius: 12px;
      text-align: center;
    }
    .stat-val {
      font-size: 1.75rem;
      font-weight: 800;
      color: #00f2fe;
      display: block;
      font-family: var(--font-display);
      margin-bottom: 0.25rem;
    }
    .stat-val small { font-size: 0.8rem; margin-left: 0.2rem; }
    .stat-lbl { font-size: 0.75rem; color: #94a3b8; }

    /* CTA Section */
    .cta-section {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .cta-box { max-width: 700px; padding: 4rem 3rem; }
    .cta-title { font-size: 2.8rem; color: #ffffff; margin-bottom: 1rem; font-weight: 800; }
    .cta-desc { font-size: 1.05rem; color: #94a3b8; line-height: 1.6; margin-bottom: 2.5rem; }
    .cta-buttons { display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; }

    .btn-cyber-primary {
      background: linear-gradient(135deg, #00f2fe, #06b6d4);
      color: #060810;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 1rem 2.5rem;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      letter-spacing: 0.05em;
      transition: var(--transition-fast);
    }
    .btn-cyber-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(0, 242, 254, 0.45);
    }

    .btn-cyber-secondary {
      background: rgba(255, 255, 255, 0.05);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 1rem 2.25rem;
      border-radius: 10px;
      letter-spacing: 0.05em;
      transition: var(--transition-fast);
    }
    .btn-cyber-secondary:hover {
      background: rgba(0, 242, 254, 0.15);
      border-color: #00f2fe;
    }

    @media (max-width: 900px) {
      .hud-top-left { display: none; }
      .hero-title { font-size: 2.6rem; }
      .left-card, .right-card { margin: 0 auto; }
      .spec-grid-4x { grid-template-columns: 1fr; }
    }
  </style>

</body>
