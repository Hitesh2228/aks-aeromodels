---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Aircraft Showcase | AKS Aeromodels</title>
  <meta name="description" content="Explore engineered RC aircraft with interactive 360-degree scroll-driven 3D inspection and performance specs." />
</head>
<body class="dark-showcase-theme">

  <Header />

  <!-- Fixed 3D Canvas Background -->
  <div id="canvas-container">
    <canvas id="webgl-canvas"></canvas>
  </div>

  <!-- Scrollable Content Overlay -->
  <main class="showcase-wrapper">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="tech-badge">
          <span class="pulse-dot"></span> NEXT-GEN RC AVIATION
        </div>
        <h1 class="hero-title">
          ENGINEERED FOR <span class="cyan-gradient">THE SKIES</span>
        </h1>
        <p class="hero-desc">
          Precision aerodynamics meets high-thrust brushless performance. Scroll down to inspect 360° airframe specifications.
        </p>

        <div class="scroll-hint">
          <span class="mouse-icon">🖱️</span>
          <span class="hint-text">SCROLL TO INSPECT</span>
          <span class="chevron-down">↓</span>
        </div>
      </div>
    </section>

    <!-- Scroll Section 1: Airframe & Wingspan -->
    <section class="spec-section" id="spec-section-1">
      <div class="spec-card glassmorphism-card left-card">
        <div class="card-tag">01 / AERODYNAMICS</div>
        <h2 class="card-title">CONTEST-GRADE AIRFRAME</h2>
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Wingspan</span>
            <span class="spec-value">1200 mm (47.2 in)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Airfoil Type</span>
            <span class="spec-value">Semi-Symmetrical Low-Drag</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Flying Weight</span>
            <span class="spec-value">850g (Ultra Light)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Construction</span>
            <span class="spec-value">Laser-Cut Balsa & Carbon Spars</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 2: Propulsion & Motor -->
    <section class="spec-section" id="spec-section-2">
      <div class="spec-card glassmorphism-card right-card">
        <div class="card-tag">02 / POWER PLANT</div>
        <h2 class="card-title">BRUSHLESS PROPULSION</h2>
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Motor</span>
            <span class="spec-value">2212 1400KV Outrunner</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">ESC Controller</span>
            <span class="spec-value">40A BEC Telemetry Ready</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Propeller</span>
            <span class="spec-value">9060 2-Blade Carbon Composite</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Static Thrust</span>
            <span class="spec-value">2.5 kg (25 N)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 3: Performance & Speed -->
    <section class="spec-section" id="spec-section-3">
      <div class="spec-card glassmorphism-card center-bottom-card">
        <div class="card-tag">03 / FLIGHT DYNAMICS</div>
        <h2 class="card-title">MAXIMUM PERFORMANCE</h2>
        <div class="spec-grid-2x2">
          <div class="stat-box">
            <span class="stat-val">140 km/h</span>
            <span class="stat-lbl">Top Speed</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">2.5 : 1</span>
            <span class="stat-lbl">Thrust-to-Weight</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">22 km/h</span>
            <span class="stat-lbl">Stall Speed</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">60°/s</span>
            <span class="stat-lbl">Roll Rate</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Scroll Section 4: Avionics & Range -->
    <section class="spec-section" id="spec-section-4">
      <div class="spec-card glassmorphism-card left-card">
        <div class="card-tag">04 / AVIONICS & BATTERY</div>
        <h2 class="card-title">TELEMETRY & RANGE</h2>
        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Radio System</span>
            <span class="spec-value">Futaba T-FHSS 2.4GHz</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Control Range</span>
            <span class="spec-value">2.0 km (Full Telemetry)</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Battery Pack</span>
            <span class="spec-value">4S 2200mAh 45C LiPo</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Flight Time</span>
            <span class="spec-value">12 - 15 Minutes</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="cta-section">
      <div class="cta-box glassmorphism-card">
        <h2 class="cta-title">READY FOR TAKE-OFF?</h2>
        <p class="cta-desc">
          Get the ultimate ARF aerobatic kit with factory-tested brushless motor, carbon spars, and pan-India express freight.
        </p>

        <div class="cta-buttons">
          <a href="/shop?category=aeromodels" class="btn-cyan">
            BUY NOW <span>🛒</span>
          </a>
          <a href="/product/sea-1" class="btn-outline">
            VIEW PRODUCT DETAILS
          </a>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <Footer />

  <!-- 3D & GSAP Client Script -->
  <script>
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Canvas & Scene setup
    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
    if (canvas) {
      const scene = new THREE.Scene();
      
      // Camera
      const camera = new THREE.PerspectiveCamera(
        45,
        window.innerWidth / window.innerHeight,
        0.1,
        1000
      );
      camera.position.set(0, 0, 10);

      // Renderer
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.2;

      // Lights
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0x00f2fe, 2.5);
      mainLight.position.set(5, 8, 5);
      scene.add(mainLight);

      const rimLight = new THREE.DirectionalLight(0xff007f, 1.5);
      rimLight.position.set(-5, -5, -5);
      scene.add(rimLight);

      const pointGlow = new THREE.PointLight(0x06b6d4, 3, 20);
      pointGlow.position.set(0, -2, 2);
      scene.add(pointGlow);

      // Pivot Group for smooth GSAP rotation
      const aircraftGroup = new THREE.Group();
      scene.add(aircraftGroup);

      // Function to create procedural fallback airplane if GLB is loading/absent
      function createFallbackAirplane(): THREE.Group {
        const group = new THREE.Group();

        // Fuselage
        const fuseGeo = new THREE.ConeGeometry(0.5, 4, 32);
        const fuseMat = new THREE.MeshStandardMaterial({
          color: 0x0e1726,
          metalness: 0.8,
          roughness: 0.2,
        });
        const fuselage = new THREE.Mesh(fuseGeo, fuseMat);
        fuselage.rotation.x = Math.PI / 2;
        group.add(fuselage);

        // Canopy
        const canopyGeo = new THREE.SphereGeometry(0.35, 16, 16);
        const canopyMat = new THREE.MeshPhysicalMaterial({
          color: 0x00f2fe,
          transmission: 0.8,
          opacity: 1,
          transparent: true,
          roughness: 0.1,
          ior: 1.5
        });
        const canopy = new THREE.Mesh(canopyGeo, canopyMat);
        canopy.scale.set(0.8, 0.5, 1.8);
        canopy.position.set(0, 0.25, 0.2);
        group.add(canopy);

        // Wings
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, 0);
        wingShape.lineTo(3.5, -0.8);
        wingShape.lineTo(3.2, -1.4);
        wingShape.lineTo(0, -1.0);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.05, bevelEnabled: true, bevelSegments: 2, steps: 1, bevelSize: 0.02, bevelThickness: 0.02 };
        const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
        const wingMat = new THREE.MeshStandardMaterial({
          color: 0x1e293b,
          metalness: 0.5,
          roughness: 0.3,
        });
        const leftWing = new THREE.Mesh(wingGeo, wingMat);
        leftWing.rotation.x = Math.PI / 2;
        leftWing.position.set(0, 0, 0.4);
        group.add(leftWing);

        const rightWing = leftWing.clone();
        rightWing.scale.x = -1;
        group.add(rightWing);

        // Tail Fin
        const tailGeo = new THREE.BoxGeometry(0.05, 0.9, 0.8);
        const tailMesh = new THREE.Mesh(tailGeo, wingMat);
        tailMesh.position.set(0, 0.5, -1.6);
        tailMesh.rotation.x = -0.3;
        group.add(tailMesh);

        // Propeller
        const propGeo = new THREE.BoxGeometry(1.2, 0.1, 0.02);
        const propMat = new THREE.MeshBasicMaterial({ color: 0x00f2fe });
        const prop = new THREE.Mesh(propGeo, propMat);
        prop.position.set(0, 0, 2.05);
        prop.name = 'propeller';
        group.add(prop);

        // Wingtip LED Lights
        const ledGeo = new THREE.SphereGeometry(0.06, 8, 8);
        const redLed = new THREE.Mesh(ledGeo, new THREE.MeshBasicMaterial({ color: 0xff0055 }));
        redLed.position.set(-3.5, 0, -0.4);
        group.add(redLed);

        const greenLed = new THREE.Mesh(ledGeo, new THREE.MeshBasicMaterial({ color: 0x00ff88 }));
        greenLed.position.set(3.5, 0, -0.4);
        group.add(greenLed);

        return group;
      }

      // Load GLTF Model or fallback
      let modelLoaded = false;
      const loader = new GLTFLoader();
      
      loader.load(
        '/airplane.glb',
        (gltf) => {
          const loadedModel = gltf.scene;
          
          // Auto center and scale model
          const box = new THREE.Box3().setFromObject(loadedModel);
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const scale = 5 / maxDim;
          loadedModel.scale.set(scale, scale, scale);

          const center = box.getCenter(new THREE.Vector3());
          loadedModel.position.sub(center.multiplyScalar(scale));

          // Enhance materials for glowing dark theme
          loadedModel.traverse((child) => {
            if ((child as THREE.Mesh).isMesh) {
              const mesh = child as THREE.Mesh;
              mesh.castShadow = true;
              mesh.receiveShadow = true;
            }
          });

          aircraftGroup.add(loadedModel);
          modelLoaded = true;
        },
        undefined,
        (error) => {
          console.log('Loading /airplane.glb fallback geometric model:', error);
          const fallback = createFallbackAirplane();
          aircraftGroup.add(fallback);
        }
      );

      // Render Loop
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        
        const elapsedTime = clock.getElapsedTime();
        
        // Idle propeller rotation
        const prop = aircraftGroup.getObjectByName('propeller');
        if (prop) {
          prop.rotation.z = elapsedTime * 25;
        }

        // Gentle floating hover idle when not scrolling
        aircraftGroup.position.y = Math.sin(elapsedTime * 1.5) * 0.15;
        
        renderer.render(scene, camera);
      }
      animate();

      // GSAP ScrollTrigger 3D Timeline Sync
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.showcase-wrapper',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
        }
      });

      // 3D Aircraft Scroll Animation Steps:
      // Step 1: Rotate Y-axis, Roll Wing Z-axis, move slightly closer
      tl.to(aircraftGroup.rotation, {
        y: Math.PI * 0.6,
        z: 0.2,
        x: 0.1,
        duration: 1
      }, 0)
      .to(camera.position, {
        z: 8.5,
        duration: 1
      }, 0);

      // Step 2: Pitch & 360 degree continuation
      tl.to(aircraftGroup.rotation, {
        y: Math.PI * 1.25,
        z: -0.3,
        x: -0.2,
        duration: 1
      }, 1)
      .to(camera.position, {
        z: 7,
        duration: 1
      }, 1);

      // Step 3: Top-down view tilt
      tl.to(aircraftGroup.rotation, {
        y: Math.PI * 1.8,
        z: 0.1,
        x: 0.4,
        duration: 1
      }, 2)
      .to(camera.position, {
        z: 6.5,
        duration: 1
      }, 2);

      // Step 4: Final 360 completion facing user
      tl.to(aircraftGroup.rotation, {
        y: Math.PI * 2,
        z: 0,
        x: 0,
        duration: 1
      }, 3)
      .to(camera.position, {
        z: 9,
        duration: 1
      }, 3);

      // Animate floating spec cards on scroll
      const specCards = document.querySelectorAll('.spec-card');
      specCards.forEach((card, index) => {
        gsap.fromTo(card, 
          { opacity: 0, y: 50, scale: 0.9 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.8,
            scrollTrigger: {
              trigger: `#spec-section-${index + 1}`,
              start: 'top 75%',
              end: 'top 30%',
              scrub: 0.5,
            }
          }
        );
      });

      // Window Resize Handler
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  </script>

  <style>
    :global(body.dark-showcase-theme) {
      background-color: #060810 !important;
      color: #f8fafc !important;
      overflow-x: hidden;
    }

    /* Fixed Canvas Background */
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    #webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Scrollable Wrapper */
    .showcase-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    /* Hero Section */
    .hero-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 1.5rem;
    }
    .hero-content {
      max-width: 800px;
    }
    .tech-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(6, 182, 212, 0.12);
      border: 1px solid rgba(6, 182, 212, 0.3);
      color: #00f2fe;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      margin-bottom: 1.5rem;
      letter-spacing: 0.1em;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #00f2fe;
      border-radius: 50%;
      box-shadow: 0 0 10px #00f2fe;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    .hero-title {
      font-size: 3.5rem;
      line-height: 1.1;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1.25rem;
      letter-spacing: 0.02em;
    }
    .cyan-gradient {
      background: linear-gradient(135deg, #ffffff 0%, #00f2fe 50%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: 1.1rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 3rem;
    }

    .scroll-hint {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      color: #00f2fe;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
    }
    .chevron-down {
      font-size: 1.2rem;
      animation: bounce 1.5s infinite;
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    /* Spec Sections */
    .spec-section {
      min-height: 90vh;
      display: flex;
      align-items: center;
      padding: 2rem 1.5rem;
      position: relative;
    }

    /* Glassmorphism Cards */
    .glassmorphism-card {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(6, 182, 212, 0.25);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(6, 182, 212, 0.05);
      border-radius: 18px;
      padding: 2rem 2.25rem;
      max-width: 440px;
      width: 100%;
    }

    .left-card {
      margin-left: 5%;
    }
    .right-card {
      margin-left: auto;
      margin-right: 5%;
    }
    .center-bottom-card {
      margin: 0 auto;
      max-width: 580px;
    }

    .card-tag {
      font-size: 0.72rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.15em;
      margin-bottom: 0.5rem;
    }
    .card-title {
      font-size: 1.35rem;
      color: #ffffff;
      margin-bottom: 1.5rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .spec-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .spec-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 0.6rem;
    }
    .spec-label {
      font-size: 0.85rem;
      color: #94a3b8;
    }
    .spec-value {
      font-size: 0.9rem;
      font-weight: 700;
      color: #ffffff;
    }

    /* 2x2 Stat Grid */
    .spec-grid-2x2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .stat-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1.25rem;
      border-radius: 12px;
      text-align: center;
    }
    .stat-val {
      font-size: 1.6rem;
      font-weight: 800;
      color: #00f2fe;
      display: block;
      font-family: var(--font-display);
      margin-bottom: 0.25rem;
    }
    .stat-lbl {
      font-size: 0.75rem;
      color: #94a3b8;
    }

    /* CTA Section */
    .cta-section {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .cta-box {
      max-width: 680px;
      padding: 3.5rem 2.5rem;
    }
    .cta-title {
      font-size: 2.5rem;
      color: #ffffff;
      margin-bottom: 1rem;
      font-weight: 800;
    }
    .cta-desc {
      font-size: 1rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }
    .cta-buttons {
      display: flex;
      gap: 1.25rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-cyan {
      background: linear-gradient(135deg, #00f2fe, #06b6d4);
      color: #060810;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 0.9rem 2.25rem;
      border-radius: 10px;
      transition: var(--transition-fast);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-cyan:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 242, 254, 0.4);
    }
    .btn-outline {
      background: rgba(255, 255, 255, 0.05);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.9rem 2rem;
      border-radius: 10px;
      transition: var(--transition-fast);
    }
    .btn-outline:hover {
      background: rgba(0, 242, 254, 0.15);
      border-color: #00f2fe;
    }

    @media (max-width: 768px) {
      .hero-title { font-size: 2.4rem; }
      .left-card, .right-card { margin: 0 auto; }
      .spec-grid-2x2 { grid-template-columns: 1fr; }
    }
  </style>

</body>
</html>
