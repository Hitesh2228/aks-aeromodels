  <script>
    // Bulletproof Indian Currency Formatter (Fixed 2 decimals: ₹6,405.93, ₹7,559.00)
    function formatINR(val: number): string {
      if (isNaN(val)) return '₹0.00';
      return '₹' + Number(val).toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    // Amount in Words Generator (Indian English: Lakhs, Thousands)
    function numberToWordsINR(num: number): string {
      const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
      const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
      
      function inWords(n: number): string {
        if (n === 0) return '';
        if (n < 20) return a[n] + ' ';
        if (n < 100) return b[Math.floor(n / 10)] + ' ' + (n % 10 !== 0 ? a[n % 10] + ' ' : '');
        if (n < 1000) return a[Math.floor(n / 100)] + ' Hundred ' + inWords(n % 100);
        if (n < 100000) return inWords(Math.floor(n / 1000)) + 'Thousand ' + inWords(n % 1000);
        if (n < 10000000) return inWords(Math.floor(n / 100000)) + 'Lakh ' + inWords(n % 100000);
        return inWords(Math.floor(n / 10000000)) + 'Crore ' + inWords(n % 10000000);
      }

      const rounded = Math.round(num);
      if (rounded === 0) return 'Zero Rupees Only';
      return inWords(rounded).trim().replace(/\s+/g, ' ') + ' Rupees Only';
    }

    function hydrateInvoiceData() {
      const rawOrder = localStorage.getItem('skynodes_last_order');
      if (!rawOrder) return;

      try {
        const order = JSON.parse(rawOrder);

        const invNoEl = document.getElementById('inv-no-val');
        const invDateEl = document.getElementById('inv-date-val');
        const invStatusEl = document.getElementById('inv-status-val');
        const invPosEl = document.getElementById('inv-pos-val');

        if (invNoEl) invNoEl.textContent = order.orderId;
        if (invDateEl) invDateEl.textContent = order.date;
        if (invStatusEl) {
          invStatusEl.textContent = order.status || order.paymentMethod;
          invStatusEl.className = order.paymentMethod?.includes('COD') ? 'val status-pending' : 'val status-paid';
        }

        const buyerState = order.customer?.state || 'Maharashtra';
        const isInterState = !buyerState.toLowerCase().includes('maharashtra');
        
        if (invPosEl) {
          invPosEl.textContent = `${buyerState} ${isInterState ? '' : '(27)'}`;
        }

        const invSupplyType = document.getElementById('inv-supply-type');
        if (invSupplyType) {
          invSupplyType.textContent = isInterState ? 'Inter-State (IGST 18%)' : 'Intra-State (CGST 9% + SGST 9%)';
        }

        const invTxnRow = document.getElementById('inv-txn-row');
        const invTxnVal = document.getElementById('inv-txn-val');
        const invMerchantRow = document.getElementById('inv-merchant-row');
        const invMerchantVal = document.getElementById('inv-merchant-val');
        const invSettlementNote = document.getElementById('inv-settlement-note');

        if (order.paymentId) {
          if (invTxnRow) invTxnRow.style.display = 'block';
          if (invTxnVal) invTxnVal.textContent = order.paymentId;
        }
        if (order.merchant) {
          if (invMerchantRow) invMerchantRow.style.display = 'block';
          if (invMerchantVal) invMerchantVal.textContent = order.merchant;
          if (invSettlementNote) invSettlementNote.style.display = 'list-item';
        }

        const custNameEl = document.getElementById('inv-cust-name');
        const custAddrEl = document.getElementById('inv-cust-address');
        const custPhoneEl = document.getElementById('inv-cust-phone');
        const custEmailEl = document.getElementById('inv-cust-email');

        if (custNameEl) custNameEl.textContent = order.customer.name;
        if (custAddrEl) custAddrEl.textContent = `${order.customer.address}, ${order.customer.city}, ${buyerState} - ${order.customer.pincode}`;
        if (custPhoneEl) custPhoneEl.textContent = `Phone: ${order.customer.phone}`;
        if (custEmailEl && order.customer.email) custEmailEl.textContent = `Email: ${order.customer.email}`;

        // B2B Details
        const b2bBadge = document.getElementById('b2b-itc-badge');
        const b2bCompRow = document.getElementById('inv-b2b-company-row');
        const b2bCompVal = document.getElementById('inv-cust-company-val');
        const b2bGstinRow = document.getElementById('inv-b2b-gstin-row');
        const b2bGstinVal = document.getElementById('inv-cust-gstin-val');
        const docTitle = document.getElementById('inv-doc-title');

        const isB2B = order.customer.isB2B || !!order.customer.gstin;

        if (isB2B) {
          if (b2bBadge) b2bBadge.style.display = 'block';
          if (docTitle) docTitle.textContent = 'B2B TAX INVOICE';
          if (b2bCompRow && order.customer.companyName) {
            b2bCompRow.style.display = 'block';
            if (b2bCompVal) b2bCompVal.textContent = order.customer.companyName;
          }
          if (b2bGstinRow && order.customer.gstin) {
            b2bGstinRow.style.display = 'block';
            if (b2bGstinVal) b2bGstinVal.textContent = order.customer.gstin;
          }
        }

        const awbEl = document.getElementById('inv-awb-val');
        if (awbEl) awbEl.textContent = order.awb || '#AWB-987270066';

        // Itemized Table with Base Price and GST Rate Breakdown
        const tbody = document.getElementById('inv-tbody-list');
        const hsnMap: Record<string, { hsn: string; taxable: number; gstRate: number; taxAmt: number }> = {};

        if (tbody && order.items && order.items.length > 0) {
          tbody.innerHTML = order.items.map((item: any, idx: number) => {
            const gstRate = item.product.gstRate ?? 18;
            const hsnCode = item.product.hsnCode ?? '9503';
            const lineTotal = item.product.price * item.quantity;
            const lineBase = Math.round((lineTotal / (1 + gstRate / 100)) * 100) / 100;
            const lineTax = Math.round((lineTotal - lineBase) * 100) / 100;

            if (!hsnMap[hsnCode]) {
              hsnMap[hsnCode] = { hsn: hsnCode, taxable: 0, gstRate, taxAmt: 0 };
            }
            hsnMap[hsnCode].taxable += lineBase;
            hsnMap[hsnCode].taxAmt += lineTax;

            return `
              <tr>
                <td style="text-align: center;">${idx + 1}</td>
                <td>
                  <strong>${item.product.name}</strong>
                  <small class="item-cat-sub">Category: ${item.product.categoryLabel || 'SKYNODES UAV'}</small>
                </td>
                <td style="text-align: center; font-family: monospace; font-weight: 600;">${hsnCode}</td>
                <td style="text-align: center; font-weight: 700;">${item.quantity}</td>
                <td style="text-align: right;">${formatINR(lineBase)}</td>
                <td style="text-align: center; font-weight: 700; color: #059669;">${gstRate}%</td>
                <td style="text-align: right;">${formatINR(lineTax)}</td>
                <td style="text-align: right; font-weight: 700;">${formatINR(lineTotal)}</td>
              </tr>
            `;
          }).join('');
        }

        // HSN Summary Table Hydration
        const hsnTbody = document.getElementById('hsn-summary-tbody');
        const thCgst = document.getElementById('th-cgst');
        const thSgst = document.getElementById('th-sgst');

        if (isInterState) {
          if (thCgst) thCgst.textContent = 'IGST Rate';
          if (thSgst) thSgst.textContent = 'IGST Amount (₹)';
        } else {
          if (thCgst) thCgst.textContent = 'CGST (Rate / Amt)';
          if (thSgst) thSgst.textContent = 'SGST (Rate / Amt)';
        }

        if (hsnTbody) {
          hsnTbody.innerHTML = Object.values(hsnMap).map(h => {
            if (isInterState) {
              return `
                <tr>
                  <td style="font-weight: 700; font-family: monospace;">${h.hsn}</td>
                  <td style="text-align: right;">${formatINR(h.taxable)}</td>
                  <td style="text-align: center;">${h.gstRate}% IGST</td>
                  <td style="text-align: right; font-weight: 700;">${formatINR(h.taxAmt)}</td>
                  <td style="text-align: right; font-weight: 800; color: #3b0811;">${formatINR(h.taxAmt)}</td>
                </tr>
              `;
            } else {
              const halfRate = h.gstRate / 2;
              const halfTax = Math.round((h.taxAmt / 2) * 100) / 100;
              return `
                <tr>
                  <td style="font-weight: 700; font-family: monospace;">${h.hsn}</td>
                  <td style="text-align: right;">${formatINR(h.taxable)}</td>
                  <td style="text-align: center;">${halfRate}% (${formatINR(halfTax)})</td>
                  <td style="text-align: center;">${halfRate}% (${formatINR(halfTax)})</td>
                  <td style="text-align: right; font-weight: 800; color: #3b0811;">${formatINR(h.taxAmt)}</td>
                </tr>
              `;
            }
          }).join('');
        }

        // Totals Calculation & Display
        const finalTotal = order.total || grandTotal;
        const finalTax = order.gst || gstTax;
        const taxableSubtotal = Math.max(0, finalTotal - finalTax);

        const subtotalEl = document.getElementById('inv-subtotal-val');
        const gstEl = document.getElementById('inv-gst-val');
        const totalEl = document.getElementById('inv-total-val');
        const wordsEl = document.getElementById('inv-words-val');

        if (subtotalEl) subtotalEl.textContent = formatINR(taxableSubtotal);
        if (gstEl) gstEl.textContent = formatINR(finalTax);
        if (totalEl) totalEl.textContent = formatINR(finalTotal);
        if (wordsEl) wordsEl.textContent = numberToWordsINR(finalTotal);

        // Coupon Discount Row (if applicable)
        const couponRow = document.getElementById('inv-coupon-discount-row');
        const couponLabel = document.getElementById('inv-coupon-label');
        const discountValEl = document.getElementById('inv-discount-val');
        if (order.appliedDiscountAmount && order.appliedDiscountAmount > 0) {
          if (couponRow) couponRow.style.display = 'flex';
          if (couponLabel) couponLabel.textContent = `Coupon Discount (${order.appliedCouponCode || 'PROMO'}):`;
          if (discountValEl) discountValEl.textContent = `-${formatINR(order.appliedDiscountAmount)}`;
        }

        // WhatsApp Share Link
        const waBtn = document.getElementById('inv-wa-share-btn') as HTMLAnchorElement;
        if (waBtn) {
          const b2bText = isB2B ? ` [B2B Tax Invoice - GSTIN: ${order.customer.gstin}]` : '';
          const txnText = order.paymentId ? ` [Txn ID: ${order.paymentId}]` : '';
          const msg = encodeURIComponent(`Hi SKYNODES UAV Support, I have placed Order ${order.orderId}${b2bText}${txnText} for ₹${Number(order.total).toLocaleString('en-IN')} via ${order.paymentMethod}. Customer: ${order.customer.name}, Phone: ${order.customer.phone}. Please confirm dispatch.`);
          waBtn.href = `https://wa.me/917722009120?text=${msg}`;
        }
      } catch (e) {
        console.error('Invoice hydration failed:', e);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrateInvoiceData);
    } else {
      hydrateInvoiceData();
    }
    document.addEventListener('astro:page-load', hydrateInvoiceData);
  </script>

