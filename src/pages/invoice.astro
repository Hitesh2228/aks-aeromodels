---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../data/products';

// Fallback sample product for static preview if no order in localStorage
const sampleProducts = [PRODUCTS[0]];
const subtotal = sampleProducts[0].price;
const gstTax = Math.round(subtotal - (subtotal / 1.18));
const grandTotal = subtotal;
---

<BaseLayout
  title="Official Tax Invoice Bill | SKYNODESUAV"
  description="Official GST Tax Invoice Bill for SKYNODESUAV flight order."
  bodyClass="invoice-body-clean"
>
  <main class="invoice-page-viewport">
    <div class="invoice-wrapper">
      
      <!-- Top Action Bar (Print & WhatsApp Share & Store Return) -->
      <div class="invoice-action-bar no-print">
        <a href="/shop" class="btn-return-store">
          ← Return to Store
        </a>
        <div class="action-buttons-group">
          <button onclick="window.print()" class="btn-print-invoice">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            PRINT / DOWNLOAD PDF
          </button>
          <a href="https://wa.me/917722009120" id="inv-wa-share-btn" target="_blank" class="btn-whatsapp-share">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.769.839 2.796.839 3.18 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm3.385 8.163c-.149.42-.767.808-1.077.859-.288.047-.655.068-2.095-.532-1.841-.767-3.037-2.645-3.13-2.768-.093-.124-.746-.991-.746-1.891 0-.9.467-1.343.633-1.528.166-.186.363-.232.484-.232.121 0 .243.002.348.007.112.005.263-.042.411.314.155.372.528 1.287.575 1.38.047.093.078.202.016.326-.062.124-.093.202-.186.31-.093.109-.196.243-.28.326-.093.093-.19.194-.082.38.109.186.484.798 1.037 1.291.712.634 1.312.83 1.498.923.186.093.295.078.404-.047.109-.124.466-.543.59-.73.124-.186.248-.155.419-.093.171.062 1.086.512 1.272.605.186.093.31.14.357.217.047.078.047.45-.102.87z"/>
            </svg>
            WhatsApp Copy
          </a>
        </div>
      </div>

      <!-- Printable Tax Invoice Document (A4 Ratio Optimized) -->
      <div class="invoice-paper" id="printable-invoice">
        
        <!-- Official Watermark Security Background -->
        <div class="inv-watermark-overlay" aria-hidden="true">
          <div class="inv-watermark-inner">
            <svg class="inv-watermark-emblem" width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span class="inv-watermark-brand">SKYNODESUAV</span>
            <span class="inv-watermark-tag">ORIGINAL TAX INVOICE • VERIFIED & AUTHENTIC</span>
          </div>
        </div>

        <!-- Header / Letterhead -->
        <div class="inv-header">
          <div class="inv-brand-col">
            <div class="inv-brand-lockup">
              <span class="inv-company-name">SKYNODESUAV</span>
              <span class="inv-legal-tag">GOVT. GST REGISTERED</span>
            </div>
            <p class="inv-legal-entity">AKS AEROMODELS INDIA • DEFENSE & UAV SYSTEMS DIVISION</p>
            <p class="inv-subtitle">Authorized Distributor: O.S. Engines, Futaba, DLE Engines & Seagull Models</p>
            <div class="inv-address-block">
              <span><strong>Central Hub:</strong> Devlali Camp, Near HP Petrol Pump, Nashik, Maharashtra – 422401</span>
              <span><strong>GSTIN:</strong> 27AAECK8821F1Z8 • <strong>State Code:</strong> 27 (Maharashtra)</span>
              <span><strong>Support:</strong> +91 7722009120 • <strong>Email:</strong> support@skynodesuav.in</span>
            </div>
          </div>

          <div class="inv-meta-box">
            <div class="inv-title-badge-wrap">
              <h2 class="inv-title" id="inv-doc-title">TAX INVOICE</h2>
              <span class="inv-copy-badge">ORIGINAL FOR RECIPIENT</span>
            </div>
            <div id="b2b-itc-badge" style="display: none;" class="b2b-itc-badge-pill">
              🏢 B2B TAX INVOICE — ELIGIBLE FOR INPUT TAX CREDIT (ITC)
            </div>
            <div class="inv-meta-table">
              <div class="inv-meta-row"><span>Invoice No:</span> <strong class="val" id="inv-no-val">#SKY-INV-2026-9842</strong></div>
              <div class="inv-meta-row"><span>Invoice Date:</span> <strong class="val" id="inv-date-val">06 Oct 2026</strong></div>
              <div class="inv-meta-row"><span>Payment Status:</span> <strong class="val status-paid" id="inv-status-val">PAID (ONLINE)</strong></div>
              <div class="inv-meta-row"><span>Place of Supply:</span> <strong class="val" id="inv-pos-val">Maharashtra (27)</strong></div>
              <div class="inv-meta-row" id="inv-txn-row" style="display: none;"><span>Payment Ref:</span> <strong class="val" id="inv-txn-val"></strong></div>
              <div class="inv-meta-row" id="inv-merchant-row" style="display: none;"><span>Settlement Rail:</span> <strong class="val" id="inv-merchant-val">WAY POINT</strong></div>
            </div>
          </div>
        </div>

        <div class="inv-divider"></div>

        <!-- Billed To & Dispatched From Cards -->
        <div class="inv-parties-grid">
          <div class="party-box billed-to">
            <div class="party-header-title">BILLED TO (CUSTOMER):</div>
            <div class="party-body">
              <p class="party-name" id="inv-cust-name">Customer</p>
              <div id="inv-b2b-company-row" style="display: none;" class="b2b-company-line">
                Company: <span id="inv-cust-company-val"></span>
              </div>
              <div id="inv-b2b-gstin-row" style="display: none;" class="b2b-gstin-pill">
                Buyer GSTIN: <strong id="inv-cust-gstin-val"></strong>
              </div>
              <p class="party-address" id="inv-cust-address">Devlali Camp, Near HP Petrol Pump, Nashik, Maharashtra 422502</p>
              <p class="party-contact" id="inv-cust-phone">Phone: +91 8888502568</p>
              <p class="party-contact" id="inv-cust-email"></p>
            </div>
          </div>

          <div class="party-box dispatched-from">
            <div class="party-header-title">SUPPLIER / DISPATCH LOCATION:</div>
            <div class="party-body">
              <p class="party-name">SKYNODESUAV Central Hub</p>
              <p class="party-address">Devlali Camp, Near HP Petrol Pump, Nashik, Maharashtra, India 422401</p>
              <p class="party-courier"><strong>Dispatch Rail:</strong> Insured Priority Air Freight Express</p>
              <p class="party-courier"><strong>Tracking AWB:</strong> <span id="inv-awb-val" class="awb-badge">#AWB-987270066</span></p>
              <p class="party-courier"><strong>Supply Type:</strong> <span id="inv-supply-type">Intra-State (CGST + SGST)</span></p>
            </div>
          </div>
        </div>

        <!-- Itemized Products Table with Multi-Tier GST -->
        <div class="table-responsive-wrapper">
          <table class="inv-items-table">
            <thead>
              <tr>
                <th style="width: 4%;">#</th>
                <th style="width: 36%;">PRODUCT DESCRIPTION</th>
                <th style="width: 13%; text-align: center;">HSN CODE</th>
                <th style="width: 7%; text-align: center;">QTY</th>
                <th style="width: 13%; text-align: right;">TAXABLE (₹)</th>
                <th style="width: 8%; text-align: center;">GST %</th>
                <th style="width: 11%; text-align: right;">TAX (₹)</th>
                <th style="width: 14%; text-align: right;">TOTAL (₹)</th>
              </tr>
            </thead>
            <tbody id="inv-tbody-list">
              {sampleProducts.map((p, idx) => {
                const baseVal = Math.round((p.price / 1.18) * 100) / 100;
                const taxVal = Math.round((p.price - baseVal) * 100) / 100;
                return (
                  <tr>
                    <td>{idx + 1}</td>
                    <td>
                      <strong>{p.name}</strong>
                      <small class="item-cat-sub">Category: {p.categoryLabel}</small>
                    </td>
                    <td style="text-align: center; font-family: monospace;">{p.hsnCode || '9503'}</td>
                    <td style="text-align: center; font-weight: 700;">1</td>
                    <td style="text-align: right;">₹{baseVal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td style="text-align: center; color: #059669; font-weight: 700;">{p.gstRate || 18}%</td>
                    <td style="text-align: right;">₹{taxVal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td style="text-align: right; font-weight: 700;">₹{p.price.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Statutory HSN/SAC Tax Breakdown Block (Rule 46) -->
        <div id="hsn-tax-summary-box" class="hsn-summary-card">
          <div class="hsn-card-header">
            <span>📊 STATUTORY GST BREAKDOWN (HSN / SAC SUMMARY - RULE 46)</span>
          </div>
          <table class="hsn-summary-table">
            <thead>
              <tr>
                <th style="width: 18%;">HSN/SAC</th>
                <th style="width: 22%; text-align: right;">Taxable Value (₹)</th>
                <th style="width: 20%; text-align: center;" id="th-cgst">CGST (Rate / Amt)</th>
                <th style="width: 20%; text-align: center;" id="th-sgst">SGST (Rate / Amt)</th>
                <th style="width: 20%; text-align: right;">Total Tax (₹)</th>
              </tr>
            </thead>
            <tbody id="hsn-summary-tbody">
              <!-- Dynamically hydrated with exact fractional formatting -->
            </tbody>
          </table>
        </div>

        <!-- Summary Totals & Guarantee Section -->
        <div class="inv-summary-flex">
          
          <!-- Left Side: Amount In Words, QR Code & Warranty Terms -->
          <div class="inv-left-terms-box">
            
            <div class="inv-amount-words-card">
              <span class="words-label">AMOUNT IN WORDS:</span>
              <strong class="words-val" id="inv-words-val">Seven Thousand Five Hundred Fifty-Nine Rupees Only</strong>
            </div>

            <div class="inv-terms-notes">
              <strong>Terms & Statutory Notes:</strong>
              <ul>
                <li>All engines, radios & ARF models carry 1-Year Official Manufacturer Warranty.</li>
                <li>100% Transit Damage & Loss Coverage provided by SKYNODESUAV India.</li>
                <li>Input Tax Credit (ITC) valid and claimable under GSTR-2B statutory filing.</li>
                <li id="inv-settlement-note" style="display: none;">Payment Collection & Settlement Rail: <strong>WAY POINT</strong> (via Razorpay).</li>
              </ul>
            </div>

            <!-- Digital Verification QR Code Card -->
            <div class="inv-qr-card">
              <div class="qr-svg-wrap">
                <svg width="64" height="64" viewBox="0 0 100 100" fill="none">
                  <rect width="100" height="100" fill="#ffffff" rx="4" />
                  <rect x="8" y="8" width="28" height="28" stroke="#1a1a1a" stroke-width="6" fill="none" />
                  <rect x="16" y="16" width="12" height="12" fill="#1a1a1a" />
                  <rect x="64" y="8" width="28" height="28" stroke="#1a1a1a" stroke-width="6" fill="none" />
                  <rect x="72" y="16" width="12" height="12" fill="#1a1a1a" />
                  <rect x="8" y="64" width="28" height="28" stroke="#1a1a1a" stroke-width="6" fill="none" />
                  <rect x="16" y="72" width="12" height="12" fill="#1a1a1a" />
                  <rect x="44" y="12" width="8" height="8" fill="#1a1a1a" />
                  <rect x="44" y="28" width="8" height="18" fill="#1a1a1a" />
                  <rect x="64" y="44" width="16" height="8" fill="#1a1a1a" />
                  <rect x="44" y="54" width="8" height="16" fill="#1a1a1a" />
                  <rect x="72" y="64" width="16" height="8" fill="#1a1a1a" />
                  <rect x="64" y="80" width="8" height="12" fill="#1a1a1a" />
                  <rect x="80" y="80" width="12" height="12" fill="#1a1a1a" />
                </svg>
              </div>
              <div class="qr-info-wrap">
                <span class="qr-status-pill">✓ DIGITAL VERIFIED</span>
                <p class="qr-desc">Scan to verify digital dispatch, AWB tracking, and GST e-invoice registry authenticity.</p>
              </div>
            </div>

          </div>

          <!-- Right Side: Totals Card & Official Signatory Stamp -->
          <div class="inv-right-totals-box">
            
            <div class="inv-totals-box">
              <div class="t-row">
                <span>Taxable Value (Base):</span>
                <strong id="inv-subtotal-val">₹0.00</strong>
              </div>
              <div class="t-row" id="inv-coupon-discount-row" style="display: none; color: #059669;">
                <span id="inv-coupon-label">Coupon Discount:</span>
                <strong id="inv-discount-val">-₹0.00</strong>
              </div>
              <div class="t-row">
                <span>Total Output GST Tax:</span>
                <strong id="inv-gst-val">₹0.00</strong>
              </div>
              <div class="t-row">
                <span>Insured Freight Courier:</span>
                <strong style="color: #059669;">FREE</strong>
              </div>
              <hr class="totals-divider" />
              <div class="t-row grand-total">
                <span>FINAL BILL TOTAL:</span>
                <strong id="inv-total-val" class="grand-total-val">₹0.00</strong>
              </div>
            </div>

            <!-- Official Seal & Authorised Signatory Stamp -->
            <div class="inv-auth-stamp-card">
              <div class="stamp-circular-crest">
                <div class="stamp-inner-circle">
                  <span class="stamp-star-top">★ ★ ★</span>
                  <span class="stamp-core-title">SKYNODESUAV</span>
                  <span class="stamp-core-sub">AUTHENTIC & VERIFIED</span>
                  <span class="stamp-core-state">NASHIK • MH</span>
                </div>
              </div>
              <div class="stamp-sign-wrap">
                <div class="stamp-signature-line">Authorised Signatory</div>
                <div class="stamp-sign-role">For SKYNODESUAV (AKS Aeromodels)</div>
                <small class="stamp-rule-text">Computer-generated tax invoice issued under Rule 46 of CGST Rules, 2017</small>
              </div>
            </div>

          </div>

        </div>

        <!-- Footer Strip -->
        <div class="inv-bottom-footer-note">
          <p>Thank you for choosing SKYNODESUAV India! For flight support, contact support@skynodesuav.in or WhatsApp +91 7722009120.</p>
        </div>

      </div>

    </div>
  </main>

  <style>
    /* Clean Page Background for Web Viewing */
    :global(body.invoice-body-clean) {
      background-color: #f5f2eb !important;
      color: #1a1a1a !important;
      margin: 0 !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .invoice-page-viewport {
      padding: 2rem 1rem 4rem;
    }

    .invoice-wrapper {
      max-width: 900px;
      margin: 0 auto;
    }

    /* Top Action Bar (Hidden in Print) */
    .invoice-action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      gap: 1rem;
    }
    .btn-return-store {
      color: #3b0811;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      background: #ffffff;
      border: 1px solid #dcd3c5;
      transition: all 0.2s ease;
    }
    .btn-return-store:hover {
      background: #eee4d5;
    }
    .action-buttons-group {
      display: flex;
      gap: 0.75rem;
    }
    .btn-print-invoice {
      background: #3b0811;
      color: #ffffff;
      border: none;
      padding: 0.65rem 1.25rem;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 12px rgba(59, 8, 17, 0.2);
      transition: all 0.2s ease;
    }
    .btn-print-invoice:hover {
      background: #000000;
      transform: translateY(-1px);
    }
    .btn-whatsapp-share {
      background: #25d366;
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 800;
      padding: 0.65rem 1.15rem;
      border-radius: 6px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
      transition: all 0.2s ease;
    }
    .btn-whatsapp-share:hover {
      background: #1da851;
      transform: translateY(-1px);
    }

    /* Printable Invoice Paper Sheet */
    .invoice-paper {
      position: relative;
      background: #ffffff;
      border: 1px solid #d8cfc0;
      border-radius: 8px;
      padding: 2.25rem 2.25rem 2rem;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
      color: #1a1a1a;
      overflow: hidden;
    }

    /* Luxury Security Watermark */
    .inv-watermark-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-28deg);
      pointer-events: none;
      user-select: none;
      z-index: 0;
      opacity: 0.045;
      text-align: center;
      width: 650px;
    }
    .inv-watermark-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .inv-watermark-emblem {
      color: #3b0811;
      margin-bottom: 0.5rem;
    }
    .inv-watermark-brand {
      font-family: var(--font-display, Georgia, serif);
      font-size: 4.8rem;
      font-weight: 900;
      letter-spacing: 0.22em;
      color: #3b0811;
      line-height: 1;
      text-transform: uppercase;
    }
    .inv-watermark-tag {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.35em;
      color: #1a1a1a;
      margin-top: 0.75rem;
      text-transform: uppercase;
    }

    /* Letterhead / Header */
    .inv-header {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
    }
    .inv-brand-col {
      flex: 1;
    }
    .inv-brand-lockup {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.25rem;
    }
    .inv-company-name {
      font-family: var(--font-display, Georgia, serif);
      font-size: 1.85rem;
      font-weight: 900;
      color: #3b0811;
      margin: 0;
      letter-spacing: 0.04em;
    }
    .inv-legal-tag {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      letter-spacing: 0.05em;
    }
    .inv-legal-entity {
      font-size: 0.75rem;
      font-weight: 800;
      color: #1a1a1a;
      margin: 0 0 0.2rem;
      letter-spacing: 0.05em;
    }
    .inv-subtitle {
      font-size: 0.76rem;
      font-weight: 600;
      color: #4b5563;
      margin: 0 0 0.4rem;
    }
    .inv-address-block {
      font-size: 0.74rem;
      color: #4b5563;
      line-height: 1.45;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    /* Invoice Meta Box (Right Side) */
    .inv-meta-box {
      text-align: right;
      min-width: 250px;
    }
    .inv-title-badge-wrap {
      margin-bottom: 0.4rem;
    }
    .inv-title {
      font-family: var(--font-display, Georgia, serif);
      font-size: 1.6rem;
      font-weight: 900;
      color: #1a1a1a;
      margin: 0 0 0.15rem;
      letter-spacing: 0.08em;
    }
    .inv-copy-badge {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 700;
      color: #6b7280;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      letter-spacing: 0.05em;
    }
    .b2b-itc-badge-pill {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      margin: 0.4rem 0;
      text-align: center;
    }
    .inv-meta-table {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      margin-top: 0.35rem;
    }
    .inv-meta-row {
      font-size: 0.78rem;
      color: #4b5563;
    }
    .inv-meta-row span {
      margin-right: 0.4rem;
    }
    .inv-meta-row .val {
      color: #111827;
      font-weight: 700;
    }
    .status-paid {
      color: #059669 !important;
    }
    .status-pending {
      color: #d97706 !important;
    }

    .inv-divider {
      border: none;
      border-top: 1px solid #e5dfd4;
      margin: 1.25rem 0;
      position: relative;
      z-index: 1;
    }

    /* Parties Grid (Billed To vs Dispatched From) */
    .inv-parties-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .party-box {
      background: #fdfbf7;
      border: 1px solid #ebdccb;
      border-radius: 6px;
      padding: 0.85rem 1rem;
    }
    .party-header-title {
      font-size: 0.72rem;
      font-weight: 800;
      color: #6b7280;
      letter-spacing: 0.06em;
      margin-bottom: 0.45rem;
      text-transform: uppercase;
      border-bottom: 1px dashed #e2d7c7;
      padding-bottom: 0.3rem;
    }
    .party-body p {
      margin: 0.2rem 0;
      line-height: 1.35;
    }
