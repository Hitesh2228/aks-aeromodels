---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import { PRODUCTS } from '../data/products';
import '../styles/global.css';

const sampleProducts = [PRODUCTS[0], PRODUCTS[5], PRODUCTS[10]];
const subtotal = sampleProducts.reduce((acc, p) => acc + p.price, 0);
const gstTax = Math.round(subtotal * 0.18);
const grandTotal = subtotal + gstTax;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Official Tax Invoice Bill | SKYNODESUAV</title>
  <meta name="description" content="View and print your official tax invoice bill for your SKYNODESUAV flight order." />
</head>
<body class="bellavita-page-body">

  <Header />

  <main class="container page-padding reveal-on-scroll">
    <div class="invoice-wrapper">
      
      <!-- Top Action Bar (Print & WhatsApp Share) -->
      <div class="invoice-action-bar no-print">
        <button onclick="window.print()" class="btn-primary print-btn">
          🖨️ PRINT / DOWNLOAD INVOICE PDF
        </button>
        <a href="https://wa.me/917722009120" id="inv-wa-share-btn" target="_blank" class="btn-whatsapp-share">
          💬 Send Invoice Copy to WhatsApp Support
        </a>
        <a id="inv-shopify-record-btn" href="#" target="_blank" class="btn-primary" style="background: #059669; display: none; text-decoration: none;">
          🛍️ RECORD ORDER IN SHOPIFY ADMIN ➔
        </a>
      </div>

      <!-- Printable Tax Invoice Document -->
      <div class="invoice-paper" id="printable-invoice">
        
        <!-- Header -->
        <div class="inv-header">
          <div>
            <h1 class="inv-company-name">SKYNODESUAV INDIA</h1>
            <p class="inv-subtitle">Authorized Distributor of O.S. Engines, Futaba, DLE & Seagull Models</p>
            <p class="inv-address">Plot No. 417, Udyog Vihar Phase III, Gurgaon, Haryana 122016 • GSTIN: 07AAAAA0000A1Z5</p>
          </div>
          <div class="inv-meta-box">
            <h2 class="inv-title">TAX INVOICE</h2>
            <p class="inv-meta-row"><span>Invoice No:</span> <strong class="val" id="inv-no-val">#SKY-INV-2026-9842</strong></p>
            <p class="inv-meta-row"><span>Date:</span> <strong class="val" id="inv-date-val">09 Aug 2026</strong></p>
            <p class="inv-meta-row"><span>Payment Status:</span> <strong class="val status-paid" id="inv-status-val">PAID (ONLINE)</strong></p>
          </div>
        </div>

        <hr class="inv-divider" />

        <!-- Bill To & Ship To -->
        <div class="inv-parties-grid">
          <div class="party-box">
            <h3>Billed To (Customer):</h3>
            <p><strong id="inv-cust-name">Capt. Hitesh Aeromodel Pilot</strong></p>
            <p id="inv-cust-address">Devlali Camp, Near HP Petrol Pump, Nashik, Maharashtra 422502</p>
            <p id="inv-cust-phone">Phone: +91-7722009120</p>
            <p id="inv-cust-email" style="font-size: 0.78rem; color: #555;"></p>
          </div>
          <div class="party-box">
            <h3>Supplier / Dispatch Location:</h3>
            <p><strong>SKYNODESUAV Central Hub</strong></p>
            <p>Devlali camp, near HP petrol pump, Maharashtra, India 422 502</p>
            <p><strong>Courier:</strong> Insured Air Freight Express</p>
            <p><strong>Tracking AWB:</strong> <span id="inv-awb-val">#AWB-9871029412</span></p>
          </div>
        </div>

        <!-- Itemized Products Table -->
        <div class="table-responsive-wrapper">
          <table class="inv-items-table">
            <thead>
              <tr>
                <th>#</th>
                <th>PRODUCT DESCRIPTION</th>
                <th>HSN / SAC</th>
                <th>QTY</th>
                <th>UNIT PRICE (₹)</th>
                <th>TOTAL (₹)</th>
              </tr>
            </thead>
            <tbody id="inv-tbody-list">
              {sampleProducts.map((p, idx) => (
                <tr>
                  <td>{idx + 1}</td>
                  <td>
                    <strong>{p.name}</strong>
                    <small style="display: block; color: #666; font-size: 0.72rem;">Category: {p.categoryLabel}</small>
                  </td>
                  <td>88033000</td>
                  <td>1</td>
                  <td>₹{p.price.toLocaleString('en-IN')}.00</td>
                  <td>₹{p.price.toLocaleString('en-IN')}.00</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Summary Totals -->
        <div class="inv-summary-flex">
          <div class="inv-terms-notes">
            <strong>Terms & Guarantee:</strong>
            <ul>
              <li>All engines include 1-Year Official Manufacturer Defect Warranty.</li>
              <li>Includes 100% Transit Damage Coverage by SKYNODESUAV.</li>
              <li>Official 1-Year Manufacturer Warranty included.</li>
            </ul>
          </div>

          <div class="inv-totals-box">
            <div class="t-row"><span>Item Subtotal:</span> <strong id="inv-subtotal-val">₹{subtotal.toLocaleString('en-IN')}.00</strong></div>
            <div class="t-row"><span>GST (18% Output Tax):</span> <strong id="inv-gst-val">₹{gstTax.toLocaleString('en-IN')}.00</strong></div>
            <div class="t-row"><span>Insured Freight Shipping:</span> <strong style="color: #059669;">FREE</strong></div>
            <hr />
            <div class="t-row grand-total">
              <span>FINAL BILL TOTAL:</span>
              <strong id="inv-total-val">₹{grandTotal.toLocaleString('en-IN')}.00</strong>
            </div>
          </div>
        </div>

        <!-- Footer Stamp -->
        <div class="inv-footer-stamp">
          <div class="stamp-badge">STAMP VERIFIED</div>
          <p>Thank you for flying with SKYNODESUAV India!</p>
        </div>

      </div>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 3rem 1.25rem 5rem;
    }
    .invoice-wrapper {
      max-width: 860px;
      margin: 0 auto;
    }

    .invoice-action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .print-btn {
      background: #1a1a1a;
      color: #ffffff;
      padding: 0.75rem 1.5rem;
    }
    .btn-whatsapp-share {
      background: #25d366;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-sm);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Paper styling */
    .invoice-paper {
      background: #ffffff;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-md);
      padding: 3rem;
      box-shadow: var(--shadow-hover);
      color: #1a1a1a;
    }

    .inv-header {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: flex-start;
    }
    .inv-company-name {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 800;
      color: #3b0811;
      margin-bottom: 0.2rem;
    }
    .inv-company-sub {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    .inv-company-addr, .inv-company-gst {
      font-size: 0.8rem;
      color: #555555;
      margin-top: 0.2rem;
    }

    .inv-meta-right {
      text-align: right;
    }
    .inv-badge {
      background: #3b0811;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.75rem;
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      letter-spacing: 0.08em;
      display: inline-block;
      margin-bottom: 0.75rem;
    }
    .inv-num-box {
      font-size: 0.82rem;
      margin-bottom: 0.2rem;
    }
    .inv-num-box .lbl { color: #666666; margin-right: 0.4rem; }
    .inv-num-box .val { color: #1a1a1a; font-weight: 700; }

    .inv-divider {
      border: none;
      border-top: 1.5px solid #e6e0d5;
      margin: 1.75rem 0;
    }

    .inv-addresses-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 2rem;
    }
    .inv-address-box {
      background: #fbf9f5;
      border: 1px solid #e6e0d5;
      padding: 1.25rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
    }
    .box-title {
      font-size: 0.75rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.06em;
      margin-bottom: 0.5rem;
    }
    .inv-address-box p { color: #555555; margin-top: 0.25rem; }

    /* Table */
    .inv-items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      margin-bottom: 2rem;
    }
    .inv-items-table th {
      background: #f3eee7;
      color: #1a1a1a;
      font-weight: 800;
      text-align: left;
      padding: 0.75rem 1rem;
      border-bottom: 2px solid #d6cfc2;
      font-size: 0.78rem;
    }
    .inv-items-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid #e6e0d5;
    }

    .inv-summary-flex {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 2rem;
    }
    .inv-terms-notes {
      font-size: 0.78rem;
      color: #666666;
      line-height: 1.6;
    }
    .inv-terms-notes ul {
      padding-left: 1.2rem;
      margin-top: 0.3rem;
    }

    .inv-totals-box {
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      padding: 1.25rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
    }
    .t-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      color: #555555;
    }
    .t-row.grand-total {
      font-size: 1.05rem;
      font-weight: 800;
      color: #3b0811;
      margin-top: 0.5rem;
      margin-bottom: 0;
    }

    .inv-footer-stamp {
      border-top: 1.5px solid #e6e0d5;
      padding-top: 1.5rem;
      text-align: center;
      font-size: 0.82rem;
      color: #666666;
    }
    .stamp-badge {
      display: inline-block;
      border: 1.5px solid #059669;
      color: #059669;
      font-weight: 800;
      font-size: 0.7rem;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      margin-bottom: 0.4rem;
    }

    .table-responsive-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-bottom: 1.5rem;
      border-radius: var(--radius-sm);
    }

    @media print {
      :global(header), :global(footer), :global(.main-header), :global(.announcement-bar), :global(.nav-strip), :global(.sub-ticker-strip), :global(.whatsapp-float), .no-print {
        display: none !important;
      }
      :global(body) {
        background: #ffffff !important;
      }
      .page-padding {
        padding: 0 !important;
      }
      .invoice-paper {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        width: 100% !important;
      }
    }

    @media (max-width: 700px) {
      .page-padding { padding: 1rem 0.5rem 4rem !important; }
      .invoice-paper { padding: 1.25rem 0.85rem !important; width: 100% !important; box-sizing: border-box !important; }
      .inv-header { flex-direction: column; gap: 1rem; }
      .inv-meta-right { text-align: left; margin-top: 0.5rem; }
      .inv-parties-grid, .inv-addresses-grid { grid-template-columns: 1fr; gap: 1rem; }
      .inv-summary-flex { grid-template-columns: 1fr; gap: 1.5rem; }
      .inv-items-table { font-size: 0.72rem; min-width: 520px; }
      .inv-items-table th, .inv-items-table td { padding: 0.5rem 0.6rem; }
      .invoice-action-bar { flex-direction: column; align-items: stretch; gap: 0.75rem; }
      .print-btn, .btn-whatsapp-share { width: 100%; text-align: center; justify-content: center; }
      .inv-company-name { font-size: 1.3rem; }
      .inv-title { font-size: 1.2rem; }
    }
  </style>

  <script>
    function hydrateInvoiceData() {
      const rawOrder = localStorage.getItem('skynodes_last_order');
      if (!rawOrder) return;

      try {
        const order = JSON.parse(rawOrder);

        const invNoEl = document.getElementById('inv-no-val');
        const invDateEl = document.getElementById('inv-date-val');
        const invStatusEl = document.getElementById('inv-status-val');

        if (invNoEl) invNoEl.textContent = order.orderId;
        if (invDateEl) invDateEl.textContent = order.date;
        if (invStatusEl) {
          invStatusEl.textContent = order.status || order.paymentMethod;
          invStatusEl.className = order.paymentMethod?.includes('COD') ? 'val status-pending' : 'val status-paid';
        }

        const custNameEl = document.getElementById('inv-cust-name');
        const custAddrEl = document.getElementById('inv-cust-address');
        const custPhoneEl = document.getElementById('inv-cust-phone');
        const custEmailEl = document.getElementById('inv-cust-email');

        if (custNameEl) custNameEl.textContent = order.customer.name;
        if (custAddrEl) custAddrEl.textContent = `${order.customer.address}, ${order.customer.city}, ${order.customer.state || ''} - ${order.customer.pincode}`;
        if (custPhoneEl) custPhoneEl.textContent = `Phone: ${order.customer.phone}`;
        if (custEmailEl && order.customer.email) custEmailEl.textContent = `Email: ${order.customer.email}`;

        const awbEl = document.getElementById('inv-awb-val');
        if (awbEl) awbEl.textContent = order.awb || '#AWB-9871029412';

        const tbody = document.getElementById('inv-tbody-list');
        if (tbody && order.items && order.items.length > 0) {
          tbody.innerHTML = order.items.map((item: any, idx: number) => `
            <tr>
              <td>${idx + 1}</td>
              <td>
                <strong>${item.product.name}</strong>
                <small style="display: block; color: #666; font-size: 0.72rem;">Category: ${item.product.categoryLabel || 'SKYNODES UAV'}</small>
              </td>
              <td>88033000</td>
              <td>${item.quantity}</td>
              <td>₹${item.product.price.toLocaleString('en-IN')}.00</td>
              <td>₹${(item.product.price * item.quantity).toLocaleString('en-IN')}.00</td>
            </tr>
          `).join('');
        }

        const subtotalEl = document.getElementById('inv-subtotal-val');
        const gstEl = document.getElementById('inv-gst-val');
        const totalEl = document.getElementById('inv-total-val');

        if (subtotalEl) subtotalEl.textContent = `₹${order.subtotal.toLocaleString('en-IN')}.00`;
        if (gstEl) gstEl.textContent = `₹${order.gst.toLocaleString('en-IN')}.00`;
        if (totalEl) totalEl.textContent = `₹${order.total.toLocaleString('en-IN')}.00`;

        const waBtn = document.getElementById('inv-wa-share-btn') as HTMLAnchorElement;
        if (waBtn) {
          const msg = encodeURIComponent(`Hi SKYNODES UAV Support, I have placed Order ${order.orderId} for ₹${order.total.toLocaleString('en-IN')} via ${order.paymentMethod}. Name: ${order.customer.name}, Phone: ${order.customer.phone}. Please confirm dispatch.`);
          waBtn.href = `https://wa.me/917722009120?text=${msg}`;
        }

        const shopifyBtn = document.getElementById('inv-shopify-record-btn') as HTMLAnchorElement;
        if (shopifyBtn && order.shopifyCheckoutUrl) {
          shopifyBtn.href = order.shopifyCheckoutUrl;
          shopifyBtn.style.display = 'inline-flex';
        }
      } catch (e) {
        console.error('Invoice hydration failed:', e);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrateInvoiceData);
    } else {
      hydrateInvoiceData();
    }
    document.addEventListener('astro:page-load', hydrateInvoiceData);
  </script>

</body>
</html>
