    /* More Guides Grid at Bottom */
    .more-guides-section {
      max-width: 1200px;
      margin: 5rem auto 0;
    }
    .more-header-wrap {
      text-align: center;
      margin-bottom: 2rem;
    }
    .more-sub {
      font-size: 0.72rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.08em;
