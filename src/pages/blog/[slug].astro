    }
    .more-guides-title {
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 800;
      color: #1a1a1a;
      letter-spacing: 0.03em;
    }
    .more-guides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
