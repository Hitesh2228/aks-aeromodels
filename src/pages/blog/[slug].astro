---
import Header from '../../components/Header.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import Footer from '../../components/Footer.astro';
import GoogleTagManagerHead from '../../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../../components/GoogleTagManagerBody.astro';
import { getBlogPostBySlug, getAllBlogPosts } from '../../lib/shopifyBlog';
import { getCombinedProducts } from '../../lib/shopify';
import '../../styles/global.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const post = await getBlogPostBySlug(slug);
if (!post) {
  return Astro.redirect('/blog');
}

// Fetch all posts for Next / Prev and Recommendations
const allPosts = await getAllBlogPosts();
const currentIndex = allPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const morePosts = allPosts.filter(p => p.slug !== post.slug).slice(0, 3);

// Fetch a related product matching this article category
const allProducts = await getCombinedProducts();
let relatedProduct = allProducts.find(p => {
  if (post.relatedProductId && (p.id === post.relatedProductId || p.handle === post.relatedProductId)) return true;
  if (post.relatedCategory) return p.category === post.relatedCategory;
  const titleLower = post.title.toLowerCase();
  if (titleLower.includes('engine') || titleLower.includes('nitro') || titleLower.includes('o.s.')) return p.category === 'engine';
  if (titleLower.includes('seagull') || titleLower.includes('trainer') || titleLower.includes('arf')) return p.category === 'aeromodels';
  if (titleLower.includes('balsa') || titleLower.includes('wood')) return p.category === 'balsa-wood';
  if (titleLower.includes('radio') || titleLower.includes('futaba') || titleLower.includes('telemetry')) return p.category === 'radio-receiver';
  return false;
});

// JSON-LD Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": [post.image],
  "datePublished": post.publishedAt || "2026-08-01",
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": post.authorRole || "Flight Instructor"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SKYNODES UAV India",
    "logo": {
      "@type": "ImageObject",
      "url": "https://skynodesuav.in/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://skynodesuav.in/blog/${post.slug}`
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.title} | SKYNODES UAV Blog</title>
  <meta name="description" content={post.excerpt} />
  <link rel="canonical" href={`https://skynodesuav.in/blog/${post.slug}`} />

  <!-- OpenGraph Social Tags -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={post.title} />
  <meta property="og:description" content={post.excerpt} />
  <meta property="og:image" content={post.image} />
  <meta property="og:url" content={`https://skynodesuav.in/blog/${post.slug}`} />
  <meta property="article:published_time" content={post.publishedAt || "2026-08-01"} />
  <meta property="article:author" content={post.author} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={post.title} />
  <meta name="twitter:description" content={post.excerpt} />
  <meta name="twitter:image" content={post.image} />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />

  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="reading-progress-bar"></div>

  <Header />

  <main class="container page-padding reveal-on-scroll">
    
    <!-- Breadcrumb Navigation -->
    <nav class="article-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="crumb-sep">/</span>
      <a href="/blog">Flight Academy Blog</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-cat">{post.category}</span>
    </nav>

    <!-- Reading Layout: Main Column + Sidebar -->
    <div class="reading-layout">
      
      <!-- Main Editorial Column -->
      <article class="article-card glass-panel" id="main-article-card">
        
        <!-- Article Header -->
        <header class="article-header">
          <div class="header-badges-row">
            <span class="header-cat-badge">{post.category}</span>
            <span class="verified-badge">✓ Verified Flight Guide</span>
          </div>
          
          <h1 class="article-title">{post.title}</h1>
          
          <div class="blog-meta-bar">
            <div class="author-meta-item">
              <span class="author-icon">👨‍✈️</span>
              <div>
                <strong class="author-title">{post.author}</strong>
                <span class="author-sub">{post.authorRole || 'SKYNODES Technical Flight Specialist'}</span>
              </div>
            </div>
            
            <div class="stats-meta-item">
              <span>📅 {post.date}</span>
              <span class="meta-dot">•</span>
              <span>⏱️ {post.readTime}</span>
              <span class="meta-dot">•</span>
              <div class="reader-control-group">
                <button type="button" id="btn-font-smaller" class="font-size-btn" title="Smaller text">A-</button>
                <button type="button" id="btn-font-larger" class="font-size-btn" title="Larger text">A+</button>
              </div>
            </div>
          </div>
        </header>

        <!-- Featured Image -->
        <div class="img-wrapper">
          <img src={post.image} alt={post.title} class="article-featured-img" />
          <div class="img-caption">SKYNODES UAV Flight Academy Technical Documentation</div>
        </div>

        <!-- Key Takeaways / Pilot Briefing Box -->
        {post.keyTakeaways && post.keyTakeaways.length > 0 && (
          <div class="key-takeaways-box">
            <div class="kt-header">
              <span class="kt-icon">⚡</span>
              <h4>QUICK PILOT BRIEFING (KEY TAKEAWAYS)</h4>
            </div>
            <ul class="kt-list">
              {post.keyTakeaways.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Mobile Table of Contents Dropdown -->
        <div class="mobile-toc-box">
          <details class="mobile-toc-details">
            <summary class="mobile-toc-summary">📑 Jump to Section (Table of Contents)</summary>
            <div id="mobile-toc-links" class="mobile-toc-content"></div>
          </details>
        </div>

        <!-- Article Rich Content Body -->
        <div class="article-body" id="article-content-body">
          <div class="article-html-content" set:html={post.contentHtml} />
        </div>

        <!-- Related Equipment Widget (Bridge Content to Commerce) -->
        {relatedProduct && (
          <div class="related-product-widget">
            <div class="rp-badge">🛠️ RECOMMENDED GEAR DISCUSSED IN THIS GUIDE</div>
            <div class="rp-card">
              <a href={`/product/${relatedProduct.id}`} class="rp-thumb-link">
                <img src={relatedProduct.image} alt={relatedProduct.name} class="rp-img" />
              </a>
              <div class="rp-info">
                <span class="rp-cat">{relatedProduct.categoryLabel}</span>
                <h4 class="rp-title">
                  <a href={`/product/${relatedProduct.id}`}>{relatedProduct.name}</a>
                </h4>
                <div class="rp-price-row">
                  <span class="rp-price">₹{relatedProduct.price.toLocaleString('en-IN')}</span>
                  <span class="rp-badge-save">{relatedProduct.discountBadge || 'OFFICIAL DISTRIBUTOR'}</span>
                </div>
              </div>
              <a href={`/product/${relatedProduct.id}`} class="btn-buy-related">
                ORDER EQUIPMENT ➔
              </a>
            </div>
          </div>
        )}

        <!-- Social Sharing Bar -->
        <div class="social-share-strip">
          <span class="share-title">SHARE THIS GUIDE WITH YOUR FLYING CLUB:</span>
          <div class="share-buttons">
            <a 
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' - https://skynodesuav.in/blog/' + post.slug)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="share-btn wa-btn"
              title="Share on WhatsApp"
            >
              💬 WhatsApp
            </a>
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent('https://skynodesuav.in/blog/' + post.slug)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="share-btn tw-btn"
              title="Share on Twitter / X"
            >
              🐦 X (Twitter)
            </a>
            <button 
              type="button" 
              id="copy-link-btn" 
              class="share-btn copy-btn"
              data-url={`https://skynodesuav.in/blog/${post.slug}`}
            >
              🔗 Copy Link
            </button>
          </div>
        </div>

        <!-- Author Bio Card -->
        <div class="author-bio-card">
          <div class="author-avatar">👨‍✈️</div>
          <div class="author-details">
            <div class="author-badge-row">
              <h4>{post.author}</h4>
              <span class="verified-pill">Certified Master Builder</span>
            </div>
            <p class="author-desc">{post.authorRole || 'Technical Flight Specialist'} at <strong>SKYNODES UAV India</strong>. Specializing in high-performance glow/gas engine break-in, telemetry link validation, and contest-grade balsa airframe architecture for Indian aeromodelling pilots.</p>
          </div>
        </div>

        <!-- Next / Previous Guide Navigation -->
        <div class="prev-next-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="nav-tile prev-tile">
              <span class="nav-dir">← PREVIOUS GUIDE</span>
              <span class="nav-title">{prevPost.title}</span>
            </a>
          ) : <div class="nav-tile placeholder"></div>}

          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="nav-tile next-tile">
              <span class="nav-dir">NEXT GUIDE →</span>
              <span class="nav-title">{nextPost.title}</span>
            </a>
          ) : <div class="nav-tile placeholder"></div>}
        </div>

      </article>

      <!-- Sticky Sidebar (Table of Contents & Quick Action) -->
      <aside class="article-sidebar">
        
        <div class="sticky-sidebar-inner">
          
          <!-- Table of Contents Widget -->
          <div class="sidebar-widget toc-widget">
            <h4 class="widget-title">📑 TABLE OF CONTENTS</h4>
            <nav id="desktop-toc-links" class="desktop-toc-nav">
              <!-- Dynamically populated via JS -->
            </nav>
          </div>

          <!-- Quick Help / Technical Support Box -->
          <div class="sidebar-widget support-widget">
            <span class="support-icon">📞</span>
            <h4>Need Build or Tuning Advice?</h4>
            <p>Our senior pilots and engine builders are available via phone and WhatsApp to guide your model setup.</p>
            <a href="/contact" class="btn-sidebar-contact">CONTACT FLIGHT TEAM ➔</a>
          </div>

          <!-- Category Shortcut Badges -->
          <div class="sidebar-widget tags-widget">
            <h4 class="widget-title">CATEGORIES</h4>
            <div class="sidebar-tags">
              <a href="/blog" class="sidebar-tag-pill">All Guides</a>
              <a href="/shop?category=engine" class="sidebar-tag-pill">Nitro & Gas Engines</a>
              <a href="/shop?category=aeromodels" class="sidebar-tag-pill">Seagull ARF Kits</a>
              <a href="/shop?category=balsa-wood" class="sidebar-tag-pill">Balsa Wood Sheets</a>
              <a href="/shop?category=radio-receiver" class="sidebar-tag-pill">Futaba Radios</a>
            </div>
          </div>

        </div>

      </aside>

    </div>

    <!-- More Recommended Articles Grid -->
    {morePosts.length > 0 && (
      <section class="more-guides-section">
        <div class="more-header-wrap">
          <span class="more-sub">CONTINUE LEARNING</span>
          <h3 class="more-guides-title">RECOMMENDED FLIGHT ACADEMY GUIDES</h3>
        </div>
        <div class="more-guides-grid">
          {morePosts.map(mp => (
            <a href={`/blog/${mp.slug}`} class="more-guide-card">
              <div class="more-img-wrap">
                <img src={mp.image} alt={mp.title} class="more-guide-img" loading="lazy" />
                <span class="more-cat-tag">{mp.category}</span>
              </div>
              <div class="more-guide-content">
                <h4 class="more-guide-h">{mp.title}</h4>
                <p class="more-guide-excerpt">{mp.excerpt}</p>
                <div class="more-guide-footer">
                  <span class="more-guide-date">📅 {mp.date}</span>
                  <span class="more-read-link">READ ➔</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    /* Reading Progress Bar */
    .reading-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 4px;
      background: linear-gradient(90deg, #3b0811, #eab308);
      width: 0%;
      z-index: 999999;
      transition: width 0.1s ease-out;
    }

    .page-padding { padding: 2.5rem 1.25rem 6rem; }

    /* Breadcrumbs */
    .article-breadcrumbs {
      max-width: 1200px;
      margin: 0 auto 1.5rem;
      font-size: 0.82rem;
      color: #777777;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .article-breadcrumbs a { color: #555555; text-decoration: none; }
    .article-breadcrumbs a:hover { color: #3b0811; text-decoration: underline; }
    .crumb-sep { opacity: 0.4; }
    .crumb-cat { color: #3b0811; font-weight: 700; }

    /* Reading Layout Grid */
    .reading-layout {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2.5rem;
      align-items: flex-start;
    }

    /* Article Card Main Column */
    .article-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: 14px;
      padding: 3.5rem 3.5rem;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      min-width: 0;
    }

    /* Header */
    .header-badges-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .header-cat-badge {
      font-size: 0.72rem;
      font-weight: 800;
      color: #3b0811;
      background: #fae8eb;
      border: 1px solid #f2c7ce;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      letter-spacing: 0.06em;
    }
    .verified-badge {
      font-size: 0.72rem;
      font-weight: 700;
      color: #065f46;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
    }
    .article-title {
      font-family: var(--font-display);
      font-size: 2.35rem;
      font-weight: 800;
      line-height: 1.25;
      color: #1a1a1a;
      letter-spacing: 0.02em;
      margin-bottom: 1.5rem;
    }

    /* Author & Meta Bar */
    .blog-meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #f0eae1;
      border-bottom: 1px solid #f0eae1;
      padding: 1.15rem 0;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .author-meta-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .author-icon {
      font-size: 1.5rem;
      background: #faf7f2;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #ebdccb;
    }
    .author-title {
      display: block;
      font-size: 0.95rem;
      color: #1a1a1a;
      font-weight: 800;
    }
    .author-sub {
      display: block;
      font-size: 0.75rem;
      color: #666666;
    }
    .stats-meta-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.8rem;
      color: #777777;
      font-weight: 600;
    }
    .meta-dot { opacity: 0.4; }

    .reader-control-group {
      display: flex;
      gap: 0.25rem;
      background: #f4ede3;
      padding: 0.2rem;
      border-radius: 4px;
      margin-left: 0.5rem;
    }
    .font-size-btn {
      background: none;
      border: none;
      font-size: 0.75rem;
      font-weight: 800;
      color: #3b0811;
      padding: 0.2rem 0.45rem;
      cursor: pointer;
      border-radius: 3px;
    }
    .font-size-btn:hover { background: #ffffff; }

    /* Featured Image */
    .img-wrapper {
      margin-bottom: 2.5rem;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e6e0d5;
      background: #111111;
    }
    .article-featured-img {
      width: 100%;
      height: 100%;
      max-height: 460px;
      object-fit: cover;
      display: block;
    }
    .img-caption {
      background: #f8f5ee;
      padding: 0.5rem 1rem;
      font-size: 0.72rem;
      color: #777777;
      text-align: center;
      font-style: italic;
      border-top: 1px solid #e6e0d5;
    }

    /* Key Takeaways Box */
    .key-takeaways-box {
      background: #faf7f2;
      border: 1px solid #ebdccb;
      border-left: 5px solid #eab308;
      border-radius: 8px;
      padding: 1.5rem 1.75rem;
      margin-bottom: 2.75rem;
    }
    .kt-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }
    .kt-header h4 {
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.08em;
      margin: 0;
    }
    .kt-list {
      margin: 0;
      padding-left: 1.25rem;
      font-size: 0.95rem;
      color: #333333;
      line-height: 1.7;
    }
    .kt-list li { margin-bottom: 0.45rem; }

    /* Mobile TOC */
    .mobile-toc-box { display: none; margin-bottom: 2rem; }
    .mobile-toc-details {
      background: #fdfbf7;
      border: 1px solid #ebdccb;
      border-radius: 8px;
      padding: 0.85rem 1.25rem;
    }
    .mobile-toc-summary {
      font-weight: 800;
      font-size: 0.85rem;
      color: #3b0811;
      cursor: pointer;
    }
    .mobile-toc-content {
      padding-top: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    :global(.mobile-toc-content a) {
      font-size: 0.85rem;
      color: #444444;
      text-decoration: none;
      padding: 0.25rem 0;
    }

    /* Article Rich Typography */
    .article-body {
      font-size: 1.1rem;
      line-height: 1.85;
      color: #2b2b2b;
      margin-bottom: 3.5rem;
    }
    :global(.article-html-content p) {
      margin-bottom: 1.6rem;
    }
    :global(.article-html-content h2) {
      font-family: var(--font-display);
      font-size: 1.65rem;
      font-weight: 800;
      color: #1a1a1a;
      margin-top: 3rem;
      margin-bottom: 1.15rem;
      padding-bottom: 0.65rem;
      border-bottom: 2px solid #f0eae1;
      scroll-margin-top: 80px;
    }
    :global(.article-html-content h3) {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      color: #3b0811;
      margin-top: 2rem;
      margin-bottom: 0.85rem;
    }
    :global(.article-html-content ul),
    :global(.article-html-content ol) {
      margin-bottom: 1.75rem;
      padding-left: 1.75rem;
    }
    :global(.article-html-content li) {
      margin-bottom: 0.65rem;
    }
    :global(.article-html-content strong) {
      color: #111111;
      font-weight: 700;
    }

    /* Natural Inline Blog Link Styling */
    :global(.inline-blog-link) {
      color: #3b0811 !important;
      font-weight: 700 !important;
      text-decoration: none !important;
      background: #fae8eb;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border-bottom: 1.5px solid #3b0811;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    :global(.inline-blog-link:hover) {
      background: #3b0811;
      color: #ffffff !important;
      border-color: #3b0811;
    }

    /* Pilot Callout Blocks */
    :global(.pilot-briefing) {
      background: #fdfbf7;
      border: 1px solid #ebdccb;
      border-left: 4px solid #3b0811;
      padding: 1.25rem 1.5rem;
      border-radius: 0 8px 8px 0;
      margin: 1.75rem 0 2.25rem;
      font-size: 1.05rem;
    }
    :global(.briefing-title) {
      font-size: 0.78rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.08em;
      margin-bottom: 0.5rem;
    }
    :global(.pilot-callout) {
      display: flex;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
      border-radius: 8px;
      margin: 2rem 0;
      font-size: 0.95rem;
      line-height: 1.65;
    }
    :global(.pilot-callout .callout-icon) {
      font-size: 1.4rem;
      flex-shrink: 0;
      line-height: 1;
    }
    :global(.pilot-callout.tip) {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #14532d;
    }
    :global(.pilot-callout.warning) {
      background: #fffbeb;
      border: 1px solid #fde68a;
      color: #78350f;
    }

    /* Related Equipment Widget */
    .related-product-widget {
      background: #faf7f2;
      border: 1px solid #ebdccb;
      border-radius: 12px;
      padding: 1.75rem;
      margin-bottom: 3rem;
    }
    .rp-badge {
      font-size: 0.75rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.08em;
      margin-bottom: 1.15rem;
    }
    .rp-card {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .rp-thumb-link {
      flex-shrink: 0;
      width: 85px;
      height: 85px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e6e0d5;
      background: #ffffff;
    }
