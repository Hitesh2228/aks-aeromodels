      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .more-guide-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      border-color: #3b0811;
    }
    .more-img-wrap {
      position: relative;
      height: 180px;
      background: #111111;
    }
    .more-guide-img { width: 100%; height: 100%; object-fit: cover; }
    .more-cat-tag {
      position: absolute;
      top: 0.85rem;
      left: 0.85rem;
      background: #3b0811;
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      letter-spacing: 0.06em;
    }
    .more-guide-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
    .more-guide-h {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 800;
      color: #1a1a1a;
      line-height: 1.35;
      margin-bottom: 0.5rem;
    }
    .more-guide-excerpt {
      font-size: 0.85rem;
      color: #666666;
      line-height: 1.5;
      margin-bottom: 1.25rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .more-guide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #f0eae1;
      padding-top: 0.85rem;
      margin-top: auto;
    }
    .more-guide-date { font-size: 0.75rem; color: #888888; font-weight: 600; }
    .more-read-link { font-size: 0.78rem; font-weight: 800; color: #3b0811; letter-spacing: 0.04em; }

    /* Responsive adjustments */
    @media (max-width: 1024px) {
      .reading-layout { grid-template-columns: 1fr; }
      .article-sidebar { display: none; }
      .mobile-toc-box { display: block; }
      .article-card { padding: 2.25rem 1.5rem; }
      .article-title { font-size: 1.85rem; }
    }
    @media (max-width: 640px) {
      .prev-next-nav { grid-template-columns: 1fr; }
      .rp-card { flex-direction: column; text-align: center; }
      .rp-price-row { justify-content: center; }
      .author-bio-card { flex-direction: column; text-align: center; }
      .social-share-strip { justify-content: center; }
    }
  </style>

  <!-- Interactive Scripts: Progress Bar, Auto TOC, Font Size Adjuster -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('reading-progress-bar');
      const articleCard = document.getElementById('main-article-card');

      window.addEventListener('scroll', () => {
        if (!progressBar || !articleCard) return;
        const totalHeight = articleCard.clientHeight;
        const offsetTop = articleCard.offsetTop;
        const scrollPosition = window.scrollY - offsetTop;
        const percent = Math.min(100, Math.max(0, (scrollPosition / (totalHeight - window.innerHeight + 200)) * 100));
        progressBar.style.width = `${percent}%`;
      }, { passive: true });

      // 2. Auto Generate Table of Contents (TOC) from H2s in content
      const content = document.getElementById('article-content-body');
      const desktopToc = document.getElementById('desktop-toc-links');
      const mobileToc = document.getElementById('mobile-toc-links');

      if (content) {
        const headings = content.querySelectorAll('h2');
        if (headings.length > 0) {
          headings.forEach((h, idx) => {
            if (!h.id) {
              h.id = `section-${idx + 1}`;
            }
            const cleanTitle = h.textContent || `Section ${idx + 1}`;
            
            // Desktop TOC item
            if (desktopToc) {
              const a = document.createElement('a');
              a.href = `#${h.id}`;
              a.className = 'toc-link';
              a.textContent = cleanTitle;
              desktopToc.appendChild(a);
            }

            // Mobile TOC item
            if (mobileToc) {
              const a = document.createElement('a');
              a.href = `#${h.id}`;
              a.textContent = `➔ ${cleanTitle}`;
              mobileToc.appendChild(a);
            }
          });

          // Highlight Active Section on Scroll
          const tocLinks = document.querySelectorAll('.toc-link');
          window.addEventListener('scroll', () => {
            let activeId = '';
            headings.forEach(h => {
              const rect = h.getBoundingClientRect();
              if (rect.top <= 140) {
                activeId = h.id;
              }
            });
            tocLinks.forEach(link => {
              if (link.getAttribute('href') === `#${activeId}`) {
                link.classList.add('active');
              } else {
                link.classList.remove('active');
              }
            });
          }, { passive: true });
        } else if (desktopToc) {
          const parentWidget = desktopToc.closest('.toc-widget');
          if (parentWidget) (parentWidget as HTMLElement).style.display = 'none';
        }
      }

      // 3. Reader Font Size Adjuster
      const btnSmaller = document.getElementById('btn-font-smaller');
      const btnLarger = document.getElementById('btn-font-larger');
      let currentSize = 1.1; // rem

      btnSmaller?.addEventListener('click', () => {
        if (currentSize > 0.95 && content) {
          currentSize -= 0.08;
          content.style.fontSize = `${currentSize}rem`;
        }
      });

      btnLarger?.addEventListener('click', () => {
        if (currentSize < 1.45 && content) {
          currentSize += 0.08;
          content.style.fontSize = `${currentSize}rem`;
        }
      });

      // 4. Copy Link Button with Toast
      const copyBtn = document.getElementById('copy-link-btn');
      copyBtn?.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.textContent = '✅ Copied!';
          setTimeout(() => {
            copyBtn.textContent = '🔗 Copy Link';
          }, 2500);
        } catch (e) {
          alert('Link: ' + url);
        }
      });
    });
  </script>

