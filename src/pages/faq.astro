---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import LoginModal from '../components/LoginModal.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import FaviconAndSeoHead from '../components/FaviconAndSeoHead.astro';

Astro.response.headers.set('X-Robots-Tag', 'all');

const faqCategories = [
  {
    id: 'aircraft',
    title: 'ARF Aircraft & Giant Scale Airframes',
    badge: 'AIRFRAMES',
    description: 'Seagull Models ARF kits, laser-cut balsa structures & genuine replacement spares.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3.5c-.5-.5-2.5 0-4 1.5L13.5 8.5 5.3 6.7c-.7-.1-1.3.3-1.5 1l-.4 1.5c-.2.7.1 1.4.7 1.8l4.9 3.5-2.5 2.5-2.8-.7c-.3-.1-.7 0-.9.3l-.8.8c-.3.3-.3.8 0 1.1l2.5 2.5 2.5 2.5c.3.3.8.3 1.1 0l.8-.8c.3-.2.4-.6.3-.9l-.7-2.8 2.5-2.5 3.5 4.9c.4.6 1.1.9 1.8.7l1.5-.4c.7-.2 1.1-.8 1-1.5z"/></svg>`,
    items: [
      {
        q: "What does 'ARF' mean in Seagull Models aircraft?",
        takeaway: "ARF means 90% factory pre-built with genuine German Oracover film.",
        a: "ARF stands for 'Almost Ready to Fly'. The aircraft airframe comes 90% pre-constructed at the factory using precision laser-cut contest balsa wood and aviation-grade plywood. All main components (wings, fuselage, tail surfaces) are professionally covered in authentic German Oracover polyester film. You only need to install your preferred engine or electric motor, servos, fuel system or flight battery, and receiver before flight."
      },
      {
        q: "Are genuine replacement parts (cowls, canopies, landing gears) available?",
        takeaway: "Yes, 100% factory original spares are stocked for Seagull Models in India.",
        a: "Yes. As the authorized distributor for Seagull Models in India, SKYNODES UAV stocks and provides genuine factory replacement parts. This includes fiberglass engine cowls, molded tinted canopies, heavy-duty oleo spring landing struts, aluminum wing joiner tubes, and factory decal sheets."
      },
      {
        q: "How does laser-cut balsa wood airframe compare to foam models?",
        takeaway: "Superior torsional rigidity, true high-speed flight tracking, and lasting durability.",
        a: "Unlike foam models which flex, warp in high heat, or deform at high airspeed, laser-cut balsa/ply airframes provide unmatched structural stiffness, precise aerobatic tracking, and high power-to-weight ratios. In the event of a hard landing, balsa airframes are easily repairable using standard CA glue and balsa strips."
      }
    ]
  },
  {
    id: 'engines',
    title: 'Nitro & Gas Engines, CDI & Props',
    badge: 'POWERPLANTS',
    description: 'Factory-sealed O.S. Max & DLE powerplants, break-in protocols & carb tuning.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    items: [
      {
        q: "Are your O.S. Max and DLE engines 100% factory fresh and authentic?",
        takeaway: "Every engine is 100% factory sealed with original manufacturer serial certificates.",
        a: "Yes, without exception. Every single O.S. Max Nitro engine and DLE Petrol engine sold on SKYNODES UAV is brand new, factory sealed in original packaging, and sourced through official channels. Each powerplant includes the factory silencer/muffler, CDI electronic ignition system (for gas engines), spark plug or glow plug, and official test certificate."
      },
      {
        q: "Do you offer technical guidance for engine break-in and tuning?",
        takeaway: "Our Chief Flight Engineers provide break-in needle settings and WhatsApp support.",
        a: "Yes! Correct bench break-in is essential for engine longevity and compression. We provide step-by-step fuel oil mixture charts (30:1 for DLE gas engines, 15%-20% synthetic/castor for O.S. nitro), needle settings, and recommended break-in prop sizes in our Flight Journal and directly via 1-on-1 WhatsApp technical support."
      },
      {
        q: "How do electronic CDI ignitions function on DLE engines?",
        takeaway: "Microprocessor-controlled auto-advance timing powered by 4.8V-8.4V receiver batteries.",
        a: "DLE engines utilize modern microprocessor-controlled Capacitive Discharge Ignition (CDI) units. The Hall sensor on the crankcase detects magnet timing, and the CDI automatically advances timing with RPM. These units operate on a wide voltage range (4.8V to 8.4V), allowing direct connection to a 2S LiPo or LiFe battery without a voltage regulator."
      }
    ]
  },
  {
    id: 'radios',
    title: 'Futaba Transmitters & Telemetry',
    badge: 'AVIONICS',
    description: 'Legal 2.4GHz FHSS spread spectrum transmitters, S.Bus servos & receivers.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>`,
    items: [
      {
        q: "Which frequency protocol do Futaba transmitters operate on in India?",
        takeaway: "100% DGCA & WPC compliant 2.4GHz T-FHSS / S-FHSS frequency-hopping protocols.",
        a: "All Futaba systems sold on SKYNODES UAV (including the Futaba 6K and 18-channel flagship systems) operate on legal 2.4GHz T-FHSS, S-FHSS, and FASSTest frequency-hopping spread spectrum protocols. This continuously hops across frequencies thousands of times per second, guaranteeing zero RF interference even at busy flying club airfields."
      },
      {
        q: "What is the operational range of Futaba 2.4GHz systems?",
        takeaway: "Full-range line-of-sight system exceeding 1.5 km for giant-scale and UAV platforms.",
        a: "Futaba 2.4GHz systems are full-range telemetry systems. Standard ground-to-air operational range exceeds 1.5 to 2 kilometers line-of-sight, which is well beyond visual flight limits for giant scale models and commercial UAV airframes."
      },
      {
        q: "What is Futaba S.Bus technology and why is it beneficial?",
        takeaway: "Single serial cable connection for all servos, eliminating heavy wiring clutter.",
        a: "Futaba S.Bus allows multiple digital servos to be connected to a single serial cable running down the fuselage or wing. Each servo is digitally addressed, eliminating messy multi-cable wire bundles, reducing airframe weight, and simplifying installation in complex giant-scale twins and scale warbirds."
      }
    ]
  },
  {
    id: 'balsa',
    title: 'Contest Grade Balsa Wood & Materials',
    badge: 'RAW MATERIALS',
    description: 'AAA contest density balsa planks, laser-cut sheets & rigid armor packaging.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    items: [
      {
        q: "How are AAA Contest Grade Balsa Sheets packaged to prevent snapping?",
        takeaway: "Triple-layer armor: wooden support boards, bubble armor, and heavy export cartons.",
        a: "Delicate 100x1000mm balsa sheets are vulnerable during logistics. To protect them completely, we sandwich every balsa order between reinforced corrugated wooden support boards and wrap them in heavy-gauge bubble armor inside rigid export cartons. This prevents all warping, bending, and edge-crushing during transit."
      },
      {
        q: "Why is there a minimum 5-sheet order requirement for balsa sheets?",
        takeaway: "Structural integrity: a stack of 5+ sheets provides rigid strength against bending.",
        a: "Shipping 1 or 2 individual balsa sheets risks snapping in transit due to lack of pack thickness. A bundle of 5 or more sheets creates structural rigidity that travels safely across India. You can mix and match any thicknesses (e.g. 1.5mm, 2mm, 3mm, 5mm) to reach the 5-sheet minimum."
      },
      {
        q: "What density grading do you supply for contest balsa wood?",
        takeaway: "Lightweight contest density (6 to 9 lbs/cu.ft) and medium contest density.",
        a: "We stock AAA Grade contest balsa wood carefully sorted by grain and density. Standard stock ranges between 6 to 9 lbs/cu.ft (lightweight A-grain for ribs and skins) and 10 to 14 lbs/cu.ft (B/C-grain for structural spars and firewall reinforcements)."
      }
    ]
  },
  {
    id: 'shipping',
    title: 'Pan-India Insured Express Shipping',
    badge: 'LOGISTICS',
    description: '24-hour priority dispatch from Maharashtra with 100% transit guarantee.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    items: [
      {
        q: "How long does delivery take across India?",
        takeaway: "Orders dispatch in 24 hours. Metro: 2-4 business days. Regional: 4-6 business days.",
        a: "All in-stock orders are packed and dispatched within 24 hours from our facility in Maharashtra. Metro cities (Mumbai, Pune, Delhi NCR, Bengaluru, Hyderabad, Chennai) typically receive delivery within 2 to 4 business days. Regional flying clubs and remote airstrip locations receive delivery in 4 to 6 business days via Blue Dart, DTDC, and Delhivery Air Express."
      },
      {
        q: "What is your 100% Transit Replacement Guarantee?",
        takeaway: "If any aircraft or engine arrives damaged in transit, we replace it immediately.",
        a: "Every high-value RC shipment is insured. If your package arrives damaged, simply take a short unboxing video and send it to our WhatsApp helpline (+91-7722009120) within 24 hours. We arrange an immediate replacement or free replacement parts without prolonged claims."
      },
      {
        q: "Will I receive real-time tracking updates?",
        takeaway: "Automated live tracking links sent to your WhatsApp and Email upon dispatch.",
        a: "Yes. As soon as your aircraft or hardware is dispatched, you receive an automated message with your AWB tracking number and direct tracking URL to monitor your consignment step-by-step until safe touchdown."
      }
    ]
  },
  {
    id: 'b2b',
    title: 'Commercial, Defense & GST Invoicing',
    badge: 'ENTERPRISE',
    description: 'Official 18% & 28% GST tax invoices, corporate POs & flying club supplies.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    items: [
      {
        q: "Can I receive an official GST Tax Invoice with Input Tax Credit (ITC)?",
        takeaway: "Yes, select 'Buying for Business / Flying Club' at checkout to input your GSTIN.",
        a: "Yes. During checkout, enable the 'Buying for Business / Flying Club? (Add GSTIN for Tax Credit)' toggle. Enter your Registered Company Name and 15-digit GSTIN. An official GST Tax Invoice with HSN/SAC codes will be generated automatically for 100% Input Tax Credit (ITC) claiming."
      },
      {
        q: "Do you supply engineering colleges, aeronautical labs, and defense projects?",
        takeaway: "Yes, we handle institutional quotations, bulk balsa orders, and official POs.",
        a: "Yes. SKYNODES UAV regularly supplies universities (IITs, NITs, Aeronautical Engineering departments), commercial UAV developers, and defense contractors with bulk balsa planks, telemetry gear, and high-thrust gas engines. Contact our B2B commercial desk on WhatsApp or email for institutional proforma invoices."
      },
      {
        q: "What online payment methods are accepted?",
        takeaway: "100% secure instant UPI, QR Code, Net Banking, and Credit/Debit Cards via Razorpay.",
        a: "We accept all major secure digital payment methods powered by Razorpay: Instant UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking across 50+ Indian banks, and all Visa, MasterCard, and RuPay Credit/Debit cards."
      }
    ]
  }
];

const totalFaqCount = faqCategories.reduce((acc, cat) => acc + cat.items.length, 0);

// Google Structured Data for FAQPage Schema
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqCategories.flatMap(cat => 
    cat.items.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${item.takeaway} ${item.a}`
      }
    }))
  )
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pilot Help Center & Technical FAQs | SKYNODES UAV</title>
  <meta name="description" content="Explore expert technical FAQs for SKYNODES UAV: Seagull Models ARF aircraft kits, O.S. Max nitro & DLE petrol engine tuning, Futaba 2.4GHz telemetry, balsa wood packaging, and pan-India insured shipping." />
  <link rel="canonical" href="https://www.skynodesuav.in/faq" />
  <FaviconAndSeoHead />
  <GoogleTagManagerHead />

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</head>

<body class="faq-page-body">
  <GoogleTagManagerBody />
  <Header />
  <CartDrawer />
  <LoginModal />
  <MobileBottomNav />

  <main class="faq-command-hub">
    
    <!-- 1. Executive Hero Header (Unicorn Aerospace Theme) -->
    <section class="faq-hero-banner">
      <div class="faq-hero-container">
        <div class="faq-status-pill">
          <span class="pulse-green-dot"></span>
          <span>PILOT COMMAND & TECHNICAL KNOWLEDGE BASE</span>
        </div>

        <h1 class="faq-hero-title">
          How Can We Assist Your Flight?
        </h1>
        <p class="faq-hero-subtitle">
          Official engineering guides, ARF assembly protocols, engine break-in tuning, and insured Pan-India dispatch answers.
        </p>

        <!-- Command Search Console -->
        <div class="faq-search-wrapper">
          <div class="faq-search-box">
            <span class="faq-search-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <input 
              type="text" 
              id="faq-search-input" 
              placeholder="Search across all technical questions, engines, balsa, shipping..." 
              autocomplete="off"
            />
            <button type="button" id="faq-clear-btn" class="faq-clear-search" style="display: none;" aria-label="Clear Search">✕</button>
            <span class="search-kbd-hint">/</span>
          </div>

          <!-- Quick Topic Pills -->
          <div class="faq-quick-tags">
            <span class="quick-tags-label">Popular Topics:</span>
            <button type="button" class="quick-tag-chip" data-query="ARF">✈️ ARF Assembly</button>
            <button type="button" class="quick-tag-chip" data-query="DLE">⚡ DLE & Nitro Tuning</button>
            <button type="button" class="quick-tag-chip" data-query="Futaba">📻 Futaba 2.4GHz</button>
            <button type="button" class="quick-tag-chip" data-query="balsa">🪵 Balsa Packaging</button>
            <button type="button" class="quick-tag-chip" data-query="shipping">🚚 Express Shipping</button>
            <button type="button" class="quick-tag-chip" data-query="GSTIN">🏢 GST Tax Credit</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Category Navigation Bar & Overview Grid -->
    <section class="faq-content-section">
      <div class="container">
        
        <!-- Live Category Filter Bar -->
        <div class="faq-category-nav-wrap">
          <div class="faq-category-nav" id="faq-cat-nav">
            <button type="button" class="cat-nav-pill active" data-category="all">
              <span>All Questions</span>
              <span class="cat-pill-count">{totalFaqCount}</span>
            </button>
            {faqCategories.map(cat => (
              <button type="button" class="cat-nav-pill" data-category={cat.id}>
                <span>{cat.badge}</span>
                <span class="cat-pill-count">{cat.items.length}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Search Status Bar -->
        <div id="faq-search-status-bar" class="faq-search-status" style="display: none;">
          <span>Showing results for "<strong id="faq-search-query-text"></strong>"</span>
          <button type="button" id="btn-reset-search" class="btn-reset-link">Clear Filter</button>
        </div>

        <!-- 3. Accordion Categories List -->
        <div class="faq-categories-container" id="faq-categories-container">
          {faqCategories.map(cat => (
            <div class="faq-category-group" data-cat-id={cat.id}>
              
              <!-- Category Header Card -->
              <div class="faq-group-header">
                <div class="group-header-left">
                  <div class="group-icon-badge" set:html={cat.icon} />
                  <div>
                    <div class="group-badge-tag">{cat.badge}</div>
                    <h2 class="group-title">{cat.title}</h2>
                    <p class="group-desc">{cat.description}</p>
                  </div>
                </div>
                <div class="group-counter-pill">
                  {cat.items.length} Articles
                </div>
              </div>

              <!-- Accordion Items List -->
              <div class="faq-accordion-stack">
                {cat.items.map((item, itemIdx) => (
                  <div class="faq-item-card" data-question={item.q.toLowerCase()} data-answer={item.a.toLowerCase()} data-takeaway={item.takeaway.toLowerCase()}>
                    <button type="button" class="faq-item-trigger" aria-expanded={itemIdx === 0 ? "true" : "false"}>
                      <span class="faq-item-question">
                        {item.q}
                      </span>
                      <span class="faq-item-chevron">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                      </span>
                    </button>
                    <div class="faq-item-panel" style={itemIdx === 0 ? "max-height: 500px;" : "max-height: 0px;"}>
                      <div class="faq-item-content">
                        <!-- Key Takeaway Callout Box -->
                        <div class="takeaway-callout">
                          <span class="takeaway-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                          </span>
                          <span class="takeaway-text">
                            <strong>Key Takeaway:</strong> {item.takeaway}
                          </span>
                        </div>

                        <!-- Full Explanation Text -->
                        <p class="faq-item-body">
                          {item.a}
                        </p>

                        <!-- Micro Feedback Row -->
                        <div class="faq-feedback-row">
                          <span class="feedback-prompt">Was this technical answer helpful?</span>
                          <div class="feedback-actions">
                            <button type="button" class="btn-feedback" data-vote="yes" title="Helpful">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                              <span>Yes</span>
                            </button>
                            <button type="button" class="btn-feedback" data-vote="no" title="Needs improvement">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"/></svg>
                              <span>No</span>
                            </button>
                          </div>
                        </div>

                      </div>
                    </div>
                  </div>
                ))}
              </div>

            </div>
          ))}

          <!-- No Results Fallback Card -->
          <div id="faq-no-results" class="faq-no-results-card" style="display: none;">
            <div class="no-results-radar-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3>No Technical Records Found</h3>
            <p>We couldn't find any questions matching your query. Our Chief Flight Engineers are on standby on WhatsApp to assist with your specific model or technical setup.</p>
            <div class="no-results-buttons">
              <button type="button" id="btn-reset-search-2" class="btn-reset-filter-action">Clear Search Query</button>
              <a href="https://wa.me/917722009120?text=Hi%20SKYNODES%20UAV,%20I%20have%20a%20technical%20question%20regarding:" target="_blank" rel="noopener noreferrer" class="btn-ask-engineer">
                Ask Chief Flight Engineer
              </a>
            </div>
          </div>

        </div>

        <!-- 4. Direct VIP Flight Hotline Banner -->
        <div class="faq-vip-hotline-card">
          <div class="hotline-left">
            <div class="hotline-badge">
              <span class="pulse-green-dot"></span>
              <span>1-ON-1 TECHNICAL ESCALATION</span>
            </div>
            <h3 class="hotline-title">Need Custom Airframe Specs or Engine Break-in Support?</h3>
            <p class="hotline-desc">
              Speak directly with our Chief Flight Engineers in Maharashtra for setup advice, CG balancing, break-in prop selection, and club bulk orders.
            </p>
          </div>
          <div class="hotline-right">
            <a href="https://wa.me/917722009120?text=Hi%20SKYNODES%20UAV%20Flight%20Engineer,%20I%20need%20technical%20assistance%20with%20my%20aircraft:" target="_blank" rel="noopener noreferrer" class="btn-hotline-whatsapp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>WhatsApp Flight Engineer</span>
            </a>
            <a href="/contact" class="btn-hotline-contact">
              <span>Hangar Support Desk →</span>
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />

  <style>
    /* ========================================================
       FAQ COMMAND HUB - WORLD-CLASS AEROSPACE STYLING
       ======================================================== */
    .faq-page-body {
      background: #060911;
      color: #f1f5f9;
      font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    .faq-command-hub {
      min-height: 80vh;
      background: linear-gradient(180deg, #070b14 0%, #0a0f1d 40%, #060911 100%);
    }

    /* 1. Hero Header Banner */
    .faq-hero-banner {
      position: relative;
      padding: 4.5rem 1.5rem 3.5rem;
      background: radial-gradient(circle at 50% 0%, rgba(30, 41, 59, 0.7) 0%, rgba(7, 11, 20, 0.95) 70%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      text-align: center;
      overflow: hidden;
    }

    .faq-hero-banner::before {
      content: '';
      position: absolute;
      top: -100px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 300px;
      background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.12) 0%, rgba(0, 0, 0, 0) 70%);
      pointer-events: none;
    }

    .faq-hero-container {
      max-width: 820px;
