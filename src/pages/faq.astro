  </style>

  <script is:inline>
    (function () {
      function setupFaqEngine() {
        const triggers = document.querySelectorAll('.faq-item-trigger');
        triggers.forEach(trig => {
          trig.addEventListener('click', () => {
            const isExpanded = trig.getAttribute('aria-expanded') === 'true';
            const panel = trig.nextElementSibling;
            if (!panel) return;

            if (isExpanded) {
              trig.setAttribute('aria-expanded', 'false');
              panel.style.maxHeight = '0px';
            } else {
              trig.setAttribute('aria-expanded', 'true');
              panel.style.maxHeight = `${panel.scrollHeight + 80}px`;
            }
          });
        });

        // Category Navigation Filter
        const catPills = document.querySelectorAll('.cat-nav-pill');
        const catGroups = document.querySelectorAll('.faq-category-group');
        const searchInput = document.getElementById('faq-search-input');
        const clearBtn = document.getElementById('faq-clear-btn');
        const statusBar = document.getElementById('faq-search-status-bar');
        const queryText = document.getElementById('faq-search-query-text');
        const resetBtn = document.getElementById('btn-reset-search');
        const resetBtn2 = document.getElementById('btn-reset-search-2');
        const noResults = document.getElementById('faq-no-results');

        let currentCat = 'all';

        function applyFilters() {
          const query = (searchInput?.value || '').toLowerCase().trim();
          if (clearBtn) clearBtn.style.display = query ? 'flex' : 'none';

          if (query) {
            if (statusBar && queryText) {
              statusBar.style.display = 'flex';
              queryText.textContent = query;
            }
          } else {
            if (statusBar) statusBar.style.display = 'none';
          }

          let totalVisibleItems = 0;

          catGroups.forEach(group => {
            const groupCatId = group.getAttribute('data-cat-id');
            const matchesCat = currentCat === 'all' || groupCatId === currentCat;

            if (!matchesCat) {
              group.style.display = 'none';
              return;
            }

            const items = group.querySelectorAll('.faq-item-card');
            let groupVisibleItems = 0;

            items.forEach(item => {
              const q = item.getAttribute('data-question') || '';
              const a = item.getAttribute('data-answer') || '';
              const t = item.getAttribute('data-takeaway') || '';

              if (!query || q.includes(query) || a.includes(query) || t.includes(query)) {
                item.style.display = 'block';
                groupVisibleItems++;
                totalVisibleItems++;
              } else {
                item.style.display = 'none';
              }
            });

            group.style.display = groupVisibleItems > 0 ? 'block' : 'none';
          });

          if (noResults) {
            noResults.style.display = totalVisibleItems === 0 ? 'block' : 'none';
          }
        }

        catPills.forEach(pill => {
          pill.addEventListener('click', () => {
            catPills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            currentCat = pill.getAttribute('data-category') || 'all';
            applyFilters();
          });
        });

        searchInput?.addEventListener('input', applyFilters);

        // Quick topic chip click
        document.querySelectorAll('.quick-tag-chip').forEach(chip => {
          chip.addEventListener('click', () => {
            const query = chip.getAttribute('data-query') || '';
            if (searchInput) {
              searchInput.value = query;
              applyFilters();
              searchInput.focus();
            }
          });
        });

        // Slash shortcut to focus search
        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput?.focus();
            searchInput?.select();
          }
        });

        function clearSearch() {
          if (searchInput) searchInput.value = '';
          applyFilters();
        }

        clearBtn?.addEventListener('click', clearSearch);
        resetBtn?.addEventListener('click', clearSearch);
        resetBtn2?.addEventListener('click', clearSearch);

        // Feedback buttons
        document.querySelectorAll('.btn-feedback').forEach(btn => {
          btn.addEventListener('click', () => {
            const parent = btn.closest('.feedback-actions');
            if (parent) {
              parent.querySelectorAll('.btn-feedback').forEach(b => b.classList.remove('voted'));
              btn.classList.add('voted');
              btn.innerHTML = `<span>✓ Recorded</span>`;
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupFaqEngine);
      } else {
        setupFaqEngine();
      }
      document.addEventListener('astro:page-load', setupFaqEngine);
    })();
  </script>
</body>
