---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import LoginModal from '../components/LoginModal.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import FaviconAndSeoHead from '../components/FaviconAndSeoHead.astro';

Astro.response.headers.set('X-Robots-Tag', 'all');

const faqCategories = [
  {
    id: 'aircraft',
    title: 'ARF Aircraft & Balsa Airframes',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3.5c-.5-.5-2.5 0-4 1.5L13.5 8.5 5.3 6.7c-.7-.1-1.3.3-1.5 1l-.4 1.5c-.2.7.1 1.4.7 1.8l4.9 3.5-2.5 2.5-2.8-.7c-.3-.1-.7 0-.9.3l-.8.8c-.3.3-.3.8 0 1.1l2.5 2.5 2.5 2.5c.3.3.8.3 1.1 0l.8-.8c.3-.2.4-.6.3-.9l-.7-2.8 2.5-2.5 3.5 4.9c.4.6 1.1.9 1.8.7l1.5-.4c.7-.2 1.1-.8 1-1.5z"/></svg>`,
    items: [
      {
        q: "What does 'ARF' mean in Seagull Aeromodels?",
        a: "ARF stands for 'Almost Ready to Fly'. The airframe comes 90% pre-built at the factory using precision laser-cut contest balsa wood and aviation-grade plywood, fully covered in authentic German Oracover polyester film. You only need to install your preferred engine/motor, radio system, servos, and fuel tank/battery before taking off."
      },
      {
        q: "Are replacement parts (cowls, canopies, landing gear) available?",
        a: "Yes. As the authorized distributor for Seagull Models in India, we provide genuine replacement parts including fiberglass cowls, clear molded canopies, anodized aluminum wing joiner tubes, and heavy-duty spring landing gears."
      },
      {
        q: "How are AAA Contest Grade Balsa Sheets packaged?",
        a: "Balsa sheets (100x1000mm) are highly delicate. We sandwich them between reinforced corrugated wooden support boards and wrap them in heavy-gauge bubble armor inside rigid export cartons to ensure zero warping, snapping, or edge crushing during transit."
      }
    ]
  },
  {
    id: 'powerplants',
    title: 'Engines, CDI & Futaba Radios',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    items: [
      {
        q: "Are your O.S. Max and DLE engines 100% genuine?",
        a: "Absolutely. Every O.S. Max Nitro and DLE Petrol engine sold on SKYNODES UAV is 100% factory-sealed, imported directly through verified channels, and accompanied by manufacturer test certificates, genuine silencers/mufflers, CDI electronic ignitions, and serial numbers."
      },
      {
        q: "Do you offer technical guidance for engine break-in and carb tuning?",
        a: "Yes! Our Chief Flight Engineers provide step-by-step break-in charts (nitro oil ratios, needle settings, break-in prop sizes) in our Flight Journal blog and direct 1-on-1 WhatsApp technical support."
      },
      {
        q: "Which frequency systems do your Futaba transmitters operate on?",
        a: "All Futaba transmitters (such as the Futaba 6K and TM 18-R9001SB) operate on legal 2.4GHz T-FHSS / S-FHSS telemetry protocols with frequency-hopping spread spectrum (FHSS) to prevent RF interference during flight."
      }
    ]
  },
  {
    id: 'shipping',
    title: 'Pan-India Insured Express Shipping',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    items: [
      {
        q: "How long does delivery take across India?",
        a: "Orders are safely packed and dispatched within 24 hours from our facility in Maharashtra. Metro cities (Mumbai, Pune, Delhi NCR, Bengaluru, Hyderabad, Chennai) receive deliveries within 2 to 4 business days. Regional and remote airstrip locations receive deliveries within 4 to 6 business days."
      },
      {
        q: "Are shipments insured against transit loss or damage?",
        a: "Yes. All high-value RC planes, engines, and avionics shipments are covered under our comprehensive transit guarantee. If your shipment incurs any damage during transit, we replace or rectify it immediately upon video verification."
      },
      {
        q: "Will I receive tracking information on WhatsApp and SMS?",
        a: "Yes! As soon as your order is dispatched, our automated dispatch system sends you the airway bill (AWB) tracking number and live tracking link directly on WhatsApp and email."
      }
    ]
  },
  {
    id: 'billing',
    title: 'GST Tax Invoices & Payment Security',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    items: [
      {
        q: "Can I get a GST Tax Invoice with Input Tax Credit (ITC) for my business?",
        a: "Yes. We supply aerospace institutes, defense contractors, drone labs, universities, and registered businesses with official GST invoices containing your registered Company Name, GSTIN, and correct HSN codes (e.g. HSN 9503, 8407, 8526). Simply check 'Business / GST Invoice' during checkout."
      },
      {
        q: "What payment methods are supported?",
        a: "We support 100% encrypted online payments via Razorpay Gateway: UPI (Google Pay, PhonePe, Paytm, BHIM), all major Credit/Debit Cards (Visa, Mastercard, RuPay, Amex), NetBanking across 50+ Indian banks, and low-cost EMI options."
      },
      {
        q: "Is there any extra benefit for prepaid online payments?",
        a: "Yes! All prepaid orders enjoy an instant 5% prepaid pilot discount applied automatically at checkout, plus priority 24h express dispatch."
      }
    ]
  }
];

// Generate JSON-LD FAQPage Schema for Google SEO & AI Overviews
const allFaqItems = faqCategories.flatMap(c => c.items);
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <FaviconAndSeoHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Frequently Asked Questions (FAQ) | SKYNODES UAV</title>
  <meta name="description" content="Find answers to common questions about Seagull RC aeromodels, O.S. & DLE engines, Futaba transmitters, shipping, GST tax invoices, and technical flight support." />
  <link rel="canonical" href="https://www.skynodesuav.in/faq" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />

  <Header />

  <main class="faq-main-wrapper">
    <div class="container">
      
      <!-- Top Hero Header -->
      <header class="faq-hero-header">
        <div class="faq-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>PILOT KNOWLEDGE BASE</span>
        </div>
        <h1 class="faq-main-title">Frequently Asked Questions</h1>
        <p class="faq-subtitle">Everything you need to know about our aeromodels, powerplants, radios, pan-India logistics, and GST tax billing.</p>

        <!-- Live FAQ Search Bar -->
        <div class="faq-search-bar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="faq-search-input" placeholder="Search questions (e.g. ARF, DLE 65, break-in, shipping, GST)..." aria-label="Search FAQs" />
          <button type="button" id="faq-clear-btn" style="display: none;" aria-label="Clear Search">✕</button>
        </div>
      </header>

      <!-- Category Navigation Pills -->
      <div class="faq-cat-nav" id="faq-cat-nav">
        <button type="button" class="cat-pill active" data-category="all">All Topics ({allFaqItems.length})</button>
        {faqCategories.map(cat => (
          <button type="button" class="cat-pill" data-category={cat.id}>
            <span class="cat-icon" set:html={cat.icon} />
            <span>{cat.title}</span>
          </button>
        ))}
      </div>

      <!-- FAQ Accordion Container -->
      <div class="faq-sections-list" id="faq-sections-list">
        {faqCategories.map(cat => (
          <section class="faq-category-card" data-cat-id={cat.id}>
            <div class="cat-card-header">
              <span class="cat-card-icon" set:html={cat.icon} />
              <h2 class="cat-card-title">{cat.title}</h2>
            </div>
            <div class="cat-accordion-group">
              {cat.items.map((item, idx) => (
                <div class="faq-acc-item" data-question={item.q.toLowerCase()} data-answer={item.a.toLowerCase()}>
                  <button type="button" class="faq-acc-trigger" aria-expanded={idx === 0 ? "true" : "false"}>
                    <span class="faq-q-text">{item.q}</span>
                    <span class="faq-chevron">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </span>
                  </button>
                  <div class="faq-acc-panel" style={idx === 0 ? "max-height: 500px;" : "max-height: 0;"}>
                    <div class="faq-a-content">
                      <p>{item.a}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- No Results Notice -->
      <div id="faq-no-results" class="faq-no-results" style="display: none;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        <h3>No matching questions found</h3>
        <p>Try searching with another keyword or connect directly with our flight operations engineers.</p>
        <button type="button" class="btn-reset-search" id="btn-reset-faq-search">View All Questions</button>
      </div>

      <!-- Still Have Questions Contact Card -->
      <div class="faq-contact-box">
        <div class="contact-box-left">
          <div class="contact-pilot-badge">OFFICIAL FLIGHT OPERATIONS</div>
          <h3>Still have questions or need custom technical guidance?</h3>
          <p>Our chief pilots and engine specialists are available 10:00 AM - 7:00 PM (Mon-Sun) to assist with model selection, radio binding, and spare parts.</p>
        </div>
        <div class="contact-box-actions">
          <a href="https://wa.me/917722009120?text=Hi%20SKYNODES%20UAV,%20I%20have%20a%20technical%20question%20about%20your%20products." target="_blank" rel="noopener noreferrer" class="btn-faq-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Chat on WhatsApp</span>
          </a>
          <a href="/contact" class="btn-faq-contact">
            <span>Contact Support Desk →</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <CartDrawer />
  <LoginModal />
  <MobileBottomNav />

  <style>
    .faq-main-wrapper {
      padding: 3rem 0 5rem;
      min-height: 80vh;
      background: #08090c;
      color: #f8fafc;
    }

    .faq-hero-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 2.5rem;
    }

    .faq-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #fbbf24;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      margin-bottom: 1rem;
    }

    .faq-main-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #ffffff;
      line-height: 1.15;
      margin-bottom: 0.85rem;
    }

    .faq-subtitle {
      font-size: 1rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }

    /* Search Bar */
    .faq-search-bar {
      position: relative;
      max-width: 620px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      background: #11141f;
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 0.65rem 1.15rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      transition: all 0.2s;
    }

    .faq-search-bar:focus-within {
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .faq-search-bar svg {
      color: #94a3b8;
      flex-shrink: 0;
      margin-right: 0.75rem;
    }

    .faq-search-bar input {
      width: 100%;
      background: transparent;
      border: none;
      outline: none;
      color: #ffffff;
      font-size: 0.95rem;
      font-family: inherit;
    }

    .faq-search-bar input::placeholder {
      color: #64748b;
    }

    #faq-clear-btn {
      background: none;
      border: none;
      color: #94a3b8;
      cursor: pointer;
      font-size: 1rem;
      padding: 0 0.4rem;
    }

    /* Category Navigation */
    .faq-cat-nav {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .cat-pill {
      background: #11141f;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #94a3b8;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.55rem 1.15rem;
      border-radius: 9999px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s;
    }

    .cat-pill:hover {
      background: #181d2e;
      color: #f8fafc;
      border-color: rgba(255, 255, 255, 0.2);
    }

    .cat-pill.active {
      background: #f59e0b;
      color: #0b0d13;
      border-color: #f59e0b;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }

    /* Sections List */
    .faq-sections-list {
      max-width: 860px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .faq-category-card {
      background: #10131d;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 14px;
      padding: 1.5rem 1.75rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .cat-card-header {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .cat-card-icon {
      color: #f59e0b;
      display: flex;
      align-items: center;
    }

    .cat-card-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .cat-accordion-group {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .faq-acc-item {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 10px;
      overflow: hidden;
      transition: all 0.2s;
    }

    .faq-acc-item:hover {
      border-color: rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.035);
    }

    .faq-acc-trigger {
      width: 100%;
      text-align: left;
      padding: 1.1rem 1.25rem;
      background: none;
      border: none;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      color: #f8fafc;
      font-family: inherit;
    }

    .faq-q-text {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.4;
      color: #ffffff;
    }

    .faq-chevron {
      color: #94a3b8;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .faq-acc-trigger[aria-expanded="true"] .faq-chevron {
      transform: rotate(180deg);
      color: #f59e0b;
    }

    .faq-acc-panel {
      overflow: hidden;
      transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .faq-a-content {
      padding: 0 1.25rem 1.25rem 1.25rem;
      color: #cbd5e1;
      font-size: 0.88rem;
      line-height: 1.65;
    }

    /* No Results Notice */
    .faq-no-results {
      text-align: center;
      padding: 4rem 1.5rem;
      background: #10131d;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      max-width: 600px;
      margin: 2rem auto;
    }

    .faq-no-results h3 {
      font-size: 1.25rem;
      color: #ffffff;
      margin: 1rem 0 0.5rem;
    }

    .faq-no-results p {
      color: #94a3b8;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .btn-reset-search {
      background: #f59e0b;
      color: #0b0d13;
      border: none;
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.65rem 1.45rem;
      border-radius: 8px;
      cursor: pointer;
    }

    /* Contact Card */
    .faq-contact-box {
      max-width: 860px;
      margin: 3.5rem auto 0;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(17, 20, 31, 0.9) 100%);
      border: 1.5px solid rgba(245, 158, 11, 0.3);
      border-radius: 16px;
      padding: 2.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .contact-box-left {
      max-width: 520px;
    }

    .contact-pilot-badge {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #f59e0b;
      margin-bottom: 0.5rem;
    }

    .contact-box-left h3 {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .contact-box-left p {
      color: #94a3b8;
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .contact-box-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .btn-faq-whatsapp {
      background: #10b981;
      color: #ffffff;
      padding: 0.75rem 1.35rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 800;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s;
    }

    .btn-faq-whatsapp:hover {
      background: #059669;
      transform: translateY(-1px);
    }

    .btn-faq-contact {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #ffffff;
      padding: 0.75rem 1.35rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      transition: all 0.2s;
    }

    .btn-faq-contact:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    @media (max-width: 768px) {
      .faq-main-wrapper {
        padding: 2rem 0 4rem;
      }
      .faq-category-card {
        padding: 1.25rem 1rem;
      }
      .faq-contact-box {
        flex-direction: column;
        align-items: flex-start;
        padding: 1.5rem;
      }
      .contact-box-actions {
        width: 100%;
      }
      .btn-faq-whatsapp, .btn-faq-contact {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script>
    function initFaqPage() {
      const triggers = document.querySelectorAll('.faq-acc-trigger');
      triggers.forEach(trig => {
        trig.addEventListener('click', () => {
          const isExpanded = trig.getAttribute('aria-expanded') === 'true';
          const panel = trig.nextElementSibling as HTMLElement;
          if (!panel) return;

          if (isExpanded) {
            trig.setAttribute('aria-expanded', 'false');
            panel.style.maxHeight = '0';
          } else {
            trig.setAttribute('aria-expanded', 'true');
            panel.style.maxHeight = `${panel.scrollHeight + 50}px`;
          }
        });
      });

      // Category filter pills
      const catPills = document.querySelectorAll('.cat-pill');
      const catCards = document.querySelectorAll('.faq-category-card');
      const noResults = document.getElementById('faq-no-results');

      catPills.forEach(pill => {
        pill.addEventListener('click', () => {
          catPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          const targetCat = pill.getAttribute('data-category') || 'all';

          catCards.forEach(card => {
            const cardCat = card.getAttribute('data-cat-id');
            if (targetCat === 'all' || cardCat === targetCat) {
              (card as HTMLElement).style.display = 'block';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // Search filtering
      const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('faq-clear-btn');
      const resetBtn = document.getElementById('btn-reset-faq-search');

      function filterFaqs() {
        const query = (searchInput?.value || '').toLowerCase().trim();
        if (clearBtn) clearBtn.style.display = query ? 'inline-block' : 'none';

        let totalVisible = 0;

        catCards.forEach(card => {
          const items = card.querySelectorAll('.faq-acc-item');
          let cardVisibleCount = 0;

          items.forEach(item => {
            const qText = item.getAttribute('data-question') || '';
            const aText = item.getAttribute('data-answer') || '';
            if (!query || qText.includes(query) || aText.includes(query)) {
              (item as HTMLElement).style.display = 'block';
              cardVisibleCount++;
              totalVisible++;
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });

          (card as HTMLElement).style.display = cardVisibleCount > 0 ? 'block' : 'none';
        });

        if (noResults) noResults.style.display = totalVisible === 0 ? 'block' : 'none';
      }

      searchInput?.addEventListener('input', filterFaqs);
      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        filterFaqs();
        searchInput?.focus();
      });
      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        filterFaqs();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaqPage);
    } else {
      initFaqPage();
    }
    document.addEventListener('astro:page-load', initFaqPage);
  </script>
</body>
</html>