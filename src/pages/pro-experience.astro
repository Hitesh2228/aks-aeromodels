---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aircraft Pro Experience | Apple-Grade 3D Showcase</title>
  <meta name="description" content="Experience Apple-grade 3D product design with real-time material customizer, 3D hotspot callouts, and assembly sequence control." />
</head>
<body class="apple-pro-theme">

  <Header />

  <!-- Fixed 3D Studio Canvas -->
  <div id="canvas-container">
    <canvas id="webgl-canvas"></canvas>
  </div>

  <!-- Apple-Style Interactive Controls Floating Dock -->
  <div class="apple-pro-dock glass-dock">
    
    <!-- Color Swatch Customizer -->
    <div class="dock-group">
      <span class="dock-label">FINISH</span>
      <div class="color-swatches">
        <button class="swatch active" data-color="#0e1726" data-name="Stealth Carbon" style="background: #0e1726;" title="Stealth Carbon"></button>
        <button class="swatch" data-color="#d4af37" data-name="Titanium Gold" style="background: #d4af37;" title="Titanium Gold"></button>
        <button class="swatch" data-color="#00f2fe" data-name="Neon Cyan" style="background: #00f2fe;" title="Neon Cyan"></button>
        <button class="swatch" data-color="#e11d48" data-name="Crimson Red" style="background: #e11d48;" title="Crimson Red"></button>
      </div>
      <span class="swatch-name-display" id="active-swatch-name">Stealth Carbon</span>
    </div>

    <div class="dock-divider"></div>

    <!-- Assembly Step Slider -->
    <div class="dock-group assembly-group">
      <span class="dock-label">ASSEMBLY STATE</span>
      <input type="range" id="assembly-slider" min="0" max="100" value="100" class="apple-range-input" />
      <span class="assembly-percent" id="assembly-pct">100% (Assembled)</span>
    </div>

    <div class="dock-divider"></div>

    <!-- X-Ray Wireframe Toggle -->
    <button id="apple-wireframe-toggle" class="dock-action-btn">
      <span class="action-icon">🌐</span> Wireframe
    </button>
  </div>

  <!-- Dynamic 3D Hotspot Callout Cards (Pinned in 3D Space) -->
  <div id="hotspot-callout-1" class="hotspot-callout glass-callout hidden">
    <div class="callout-line"></div>
    <div class="callout-content">
      <span class="callout-tag">PROPULSION CORE</span>
      <h3 class="callout-title">2212 1400KV Outrunner</h3>
      <p class="callout-desc">CNC precision spinner mated with 9x6 carbon prop generating 2.5kg static thrust.</p>
    </div>
  </div>

  <div id="hotspot-callout-2" class="hotspot-callout glass-callout hidden">
    <div class="callout-line"></div>
    <div class="callout-content">
      <span class="callout-tag">AIRFRAME SPARS</span>
      <h3 class="callout-title">Carbon Spar Matrix</h3>
      <p class="callout-desc">Interlocking laser-cut balsa ribs reinforced with dual 8mm carbon fiber tubes.</p>
    </div>
  </div>

  <div id="hotspot-callout-3" class="hotspot-callout glass-callout hidden">
    <div class="callout-line"></div>
    <div class="callout-content">
      <span class="callout-tag">AVIONICS BAY</span>
      <h3 class="callout-title">Futaba T-FHSS Receiver</h3>
      <p class="callout-desc">8-channel telemetry radio unit protected inside clear polycarbonate canopy.</p>
    </div>
  </div>

  <!-- Apple-Style Scroll Storytelling Container -->
  <main class="pro-story-wrapper">
    
    <!-- Hero Title -->
    <section class="pro-section hero-pro">
      <div class="hero-pro-text">
        <span class="pro-headline-tag">ENGINEERING ELEVATED</span>
        <h1 class="pro-hero-title">AERODYNAMICS.<br/><span class="shimmer-text">REIMAGINED.</span></h1>
        <p class="pro-hero-sub">
          Crafted with surgical precision. Every spar, contour, and brushless winding engineered for perfection.
        </p>

        <div class="hero-stat-row">
          <div class="hero-stat">
            <span class="h-val">140 <small>KM/H</small></span>
            <span class="h-lbl">Max Velocity</span>
          </div>
          <div class="hero-stat">
            <span class="h-val">2.5 <small>KG</small></span>
            <span class="h-lbl">Static Thrust</span>
          </div>
          <div class="hero-stat">
            <span class="h-val">850 <small>G</small></span>
            <span class="h-lbl">Flying Weight</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Step 1: The Airframe -->
    <section class="pro-section" id="story-1">
      <div class="pro-story-card glass-callout">
        <span class="story-num">01</span>
        <h2 class="story-heading">FEATHERWEIGHT RIGIDITY.</h2>
        <p class="story-body">
          The balsa-wood core provides unmatched strength-to-weight ratio. Reinforced with high-modulus carbon spars to withstand high-G aerobatic loads without wing flex.
        </p>
      </div>
    </section>

    <!-- Story Step 2: The Motor -->
    <section class="pro-section" id="story-2">
      <div class="pro-story-card glass-callout right-aligned">
        <span class="story-num">02</span>
        <h2 class="story-heading">RELENTLESS POWER.</h2>
        <p class="story-body">
          Hand-wound 1400KV brushless motor mated to a 40A BEC controller. Instantaneous throttle response delivers vertical climb performance from hand launch.
        </p>
      </div>
    </section>

    <!-- Story Step 3: Precision Control -->
    <section class="pro-section" id="story-3">
      <div class="pro-story-card glass-callout">
        <span class="story-num">03</span>
        <h2 class="story-heading">SUB-MILLISECOND RESPONSE.</h2>
        <p class="story-body">
          High-torque digital S.BUS servos drive dual ailerons, elevator, and rudder with zero backlash. Experience razor-sharp knife-edge and inverted flight.
        </p>
      </div>
    </section>

    <!-- Apple-Grade CTA Section -->
    <section class="pro-cta-section">
      <div class="pro-cta-card glass-callout">
        <h2 class="pro-cta-title">YOUR SKIES AWAIT.</h2>
        <p class="pro-cta-sub">
          Order the complete ARF Aircraft Kit today with factory-tuned brushless motor and pan-India express freight.
        </p>

        <div class="pro-cta-actions">
          <a href="/shop?category=aeromodels" class="btn-apple-primary">
            ORDER NOW — ₹42,999 ➔
          </a>
          <a href="/aircrafts" class="btn-apple-ghost">
            EXPLORE 3D SHOWCASE
          </a>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <Footer />

  <!-- Apple-Grade Three.js & GSAP Engine -->
  <script>
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
    if (canvas) {
      const scene = new THREE.Scene();
      
      const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0.5, 9);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.35;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      // Studio Lighting (Key, Fill, Rim & Ground Reflection)
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
      scene.add(ambientLight);

      const keyLight = new THREE.DirectionalLight(0xffffff, 3.5);
      keyLight.position.set(7, 10, 7);
      keyLight.castShadow = true;
      scene.add(keyLight);

      const blueFillLight = new THREE.DirectionalLight(0x00f2fe, 1.8);
      blueFillLight.position.set(-8, 2, -4);
      scene.add(blueFillLight);

      const goldRimLight = new THREE.DirectionalLight(0xd4af37, 2.2);
      goldRimLight.position.set(0, -6, -6);
      scene.add(goldRimLight);

      // Radial Soft Shadow Floor Plane
      const shadowPlaneGeo = new THREE.PlaneGeometry(20, 20);
      const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.35 });
      const shadowFloor = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);
      shadowFloor.rotation.x = -Math.PI / 2;
      shadowFloor.position.y = -2.8;
      shadowFloor.receiveShadow = true;
      scene.add(shadowFloor);

      // Starfield Ambient Particles
      const pGeo = new THREE.BufferGeometry();
      const pCount = 800;
      const pPos = new Float32Array(pCount * 3);
      for (let i = 0; i < pCount * 3; i += 3) {
        pPos[i] = (Math.random() - 0.5) * 30;
        pPos[i + 1] = (Math.random() - 0.5) * 30;
        pPos[i + 2] = (Math.random() - 0.5) * 30;
      }
      pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
      const starfield = new THREE.Points(pGeo, new THREE.PointsMaterial({
        color: 0xffffff, size: 0.04, transparent: true, opacity: 0.4
      }));
      scene.add(starfield);

      // Main Model Assembly Root Group
      const mainGroup = new THREE.Group();
      scene.add(mainGroup);

      // Individual Parts for Dynamic Color & Assembly Animation
      let fuselageMat: any;
      let propMesh: any;
      let engineMesh: any;
      let canopyMesh: any;
      let leftWingMesh: any;
      let rightWingMesh: any;
      let tailMesh: any;

      function buildProAirplane(): any {
        const root = new THREE.Group();

        // PBR Fuselage Material
        fuselageMat = new THREE.MeshStandardMaterial({
          color: 0x0e1726,
          metalness: 0.85,
          roughness: 0.18,
        });

        const fuseGeo = new THREE.ConeGeometry(0.55, 4.5, 32);
        const fuselage = new THREE.Mesh(fuseGeo, fuselageMat);
        fuselage.rotation.x = Math.PI / 2;
        fuselage.castShadow = true;
        root.add(fuselage);

        // Cockpit
        const canopyGeo = new THREE.SphereGeometry(0.38, 32, 32);
        const canopyMat = new THREE.MeshPhysicalMaterial({
          color: 0x00f2fe,
          transmission: 0.9,
          transparent: true,
          roughness: 0.05,
          ior: 1.5
        });
        canopyMesh = new THREE.Mesh(canopyGeo, canopyMat);
        canopyMesh.scale.set(0.75, 0.45, 1.9);
        canopyMesh.position.set(0, 0.28, 0.2);
        canopyMesh.castShadow = true;
        root.add(canopyMesh);

        // Wings
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, 0);
        wingShape.lineTo(3.8, -1.2);
        wingShape.lineTo(3.4, -1.8);
        wingShape.lineTo(0, -1.2);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.06, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: 0.03, bevelThickness: 0.03 };
        const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);

        leftWingMesh = new THREE.Mesh(wingGeo, fuselageMat);
        leftWingMesh.rotation.x = Math.PI / 2;
        leftWingMesh.position.set(0, 0, 0.5);
        leftWingMesh.castShadow = true;
        root.add(leftWingMesh);

        rightWingMesh = leftWingMesh.clone();
        rightWingMesh.scale.x = -1;
        rightWingMesh.castShadow = true;
        root.add(rightWingMesh);

        // Engine Motor
        const motorGeo = new THREE.CylinderGeometry(0.4, 0.45, 0.8, 32);
        const motorMat = new THREE.MeshStandardMaterial({ color: 0xd4af37, metalness: 0.95, roughness: 0.1 });
        engineMesh = new THREE.Mesh(motorGeo, motorMat);
        engineMesh.rotation.x = Math.PI / 2;
        engineMesh.position.set(0, 0, 1.7);
        engineMesh.castShadow = true;
        root.add(engineMesh);

        // Propeller & Spinner Cone
        const propGroup = new THREE.Group();
        const bladeGeo = new THREE.BoxGeometry(1.4, 0.12, 0.03);
        const bladeMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.8 });
        const blades = new THREE.Mesh(bladeGeo, bladeMat);
        propGroup.add(blades);

        const spinnerGeo = new THREE.ConeGeometry(0.22, 0.5, 16);
        const spinner = new THREE.Mesh(spinnerGeo, motorMat);
        spinner.rotation.x = Math.PI / 2;
        spinner.position.z = 0.2;
        propGroup.add(spinner);

        propGroup.position.set(0, 0, 2.2);
        propMesh = propGroup;
        root.add(propGroup);

        // Tail Fin
        const tailGeo = new THREE.BoxGeometry(0.05, 1.1, 0.9);
        tailMesh = new THREE.Mesh(tailGeo, fuselageMat);
        tailMesh.position.set(0, 0.5, -1.7);
        tailMesh.rotation.x = -0.2;
        tailMesh.castShadow = true;
        root.add(tailMesh);

        return root;
      }

      // Load GLB or build pro model
      const loader = new GLTFLoader();
      loader.load('/airplane.glb', (gltf: any) => {
        const loadedModel = gltf.scene;
        const box = new THREE.Box3().setFromObject(loadedModel);
        const size = box.getSize(new THREE.Vector3());
        const scale = 5.5 / Math.max(size.x, size.y, size.z);
        loadedModel.scale.set(scale, scale, scale);
        mainGroup.add(loadedModel);
      }, undefined, () => {
        const proModel = buildProAirplane();
        mainGroup.add(proModel);
      });

      // Color Swatch Swapping Animation
      const swatches = document.querySelectorAll('.swatch');
      const swatchNameEl = document.getElementById('active-swatch-name');

      swatches.forEach(swatch => {
        swatch.addEventListener('click', () => {
          swatches.forEach(s => s.classList.remove('active'));
          swatch.classList.add('active');

          const colorHex = swatch.getAttribute('data-color') || '#0e1726';
          const name = swatch.getAttribute('data-name') || '';

          if (swatchNameEl) swatchNameEl.textContent = name;

          if (fuselageMat) {
            gsap.to(fuselageMat.color, {
              r: new THREE.Color(colorHex).r,
              g: new THREE.Color(colorHex).g,
              b: new THREE.Color(colorHex).b,
              duration: 0.8,
              ease: 'power2.out'
            });
          }
        });
      });

      // Assembly Slider Handler
      const assemblySlider = document.getElementById('assembly-slider') as HTMLInputElement;
      const assemblyPctEl = document.getElementById('assembly-pct');

      function updateAssembly(valuePct: number) {
        const factor = (100 - valuePct) / 100;
        if (assemblyPctEl) {
          assemblyPctEl.textContent = valuePct === 100 ? '100% (Assembled)' : `${valuePct}% (Exploded)`;
        }

        if (propMesh) gsap.to(propMesh.position, { z: 2.2 + factor * 2.5, duration: 0.4 });
        if (engineMesh) gsap.to(engineMesh.position, { z: 1.7 + factor * 1.5, duration: 0.4 });
        if (canopyMesh) gsap.to(canopyMesh.position, { y: 0.28 + factor * 1.2, duration: 0.4 });
        if (leftWingMesh) gsap.to(leftWingMesh.position, { x: factor * 1.8, duration: 0.4 });
        if (rightWingMesh) gsap.to(rightWingMesh.position, { x: -factor * 1.8, duration: 0.4 });
        if (tailMesh) gsap.to(tailMesh.position, { z: -1.7 - factor * 1.8, duration: 0.4 });
      }

      assemblySlider?.addEventListener('input', () => {
        updateAssembly(parseInt(assemblySlider.value, 10));
      });

      // Wireframe Toggle
      let isWireframe = false;
      document.getElementById('apple-wireframe-toggle')?.addEventListener('click', () => {
        isWireframe = !isWireframe;
        mainGroup.traverse((child: any) => {
          if (child.isMesh && child.material) {
            child.material.wireframe = isWireframe;
          }
        });
      });

      // Mouse Inertia Parallax
      let mouseX = 0;
      let mouseY = 0;
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 0.3;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 0.3;
      });

      // Render Loop
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        if (propMesh) propMesh.rotation.z = elapsedTime * 20;

        mainGroup.rotation.z += (mouseX - mainGroup.rotation.z) * 0.04;
        mainGroup.rotation.x += (mouseY - mainGroup.rotation.x) * 0.04;

        starfield.rotation.y = elapsedTime * 0.01;

        renderer.render(scene, camera);
      }
      animate();

      // GSAP ScrollTrigger Cinematic Camera Spline
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.pro-story-wrapper',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.2,
        }
      });

      // Step 1: Camera Orbit to Airframe
      tl.to(mainGroup.rotation, { y: Math.PI * 0.5, z: 0.25, x: 0.1, duration: 1 }, 0)
        .to(camera.position, { z: 7.5, y: 0.8, duration: 1 }, 0);

      // Step 2: Camera Focus on Engine Motor
      tl.to(mainGroup.rotation, { y: Math.PI * 1.1, z: -0.3, x: -0.2, duration: 1 }, 1)
        .to(camera.position, { z: 6.2, y: 0.2, duration: 1 }, 1);

      // Step 3: Top Down Panoramic Orbit
      tl.to(mainGroup.rotation, { y: Math.PI * 1.7, z: 0.1, x: 0.45, duration: 1 }, 2)
        .to(camera.position, { z: 5.5, y: 1.5, duration: 1 }, 2);

      // Step 4: Final Hero Stance
      tl.to(mainGroup.rotation, { y: Math.PI * 2, z: 0, x: 0, duration: 1 }, 3)
        .to(camera.position, { z: 8.5, y: 0.5, duration: 1 }, 3);

      // Resize
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  </script>

  <style>
    :global(body.apple-pro-theme) {
      background-color: #060810 !important;
      color: #f8fafc !important;
      overflow-x: hidden;
      font-family: var(--font-main);
    }

    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    #webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Apple-Style Floating Dock */
    .glass-dock {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
      border-radius: 9999px;
    }

    .apple-pro-dock {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0.75rem 1.75rem;
    }

    .dock-group {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .dock-label {
      font-size: 0.68rem;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 0.12em;
    }

    .color-swatches {
      display: flex;
      gap: 0.4rem;
    }
    .swatch {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    .swatch:hover, .swatch.active {
      transform: scale(1.25);
      border-color: #ffffff;
    }

    .swatch-name-display {
      font-size: 0.75rem;
      font-weight: 700;
      color: #ffffff;
      min-width: 90px;
    }

    .dock-divider {
      width: 1px;
      height: 24px;
      background: rgba(255, 255, 255, 0.15);
    }

    .apple-range-input {
      accent-color: #00f2fe;
      cursor: pointer;
      width: 100px;
    }
    .assembly-percent {
      font-size: 0.75rem;
      color: #00f2fe;
      font-weight: 700;
      min-width: 110px;
    }

    .dock-action-btn {
      font-size: 0.75rem;
      font-weight: 700;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      transition: var(--transition-fast);
    }
    .dock-action-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* Scrollable Wrapper */
    .pro-story-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    .pro-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 2rem 5%;
    }

    .hero-pro {
      justify-content: center;
      text-align: center;
    }
    .hero-pro-text {
      max-width: 860px;
    }
    .pro-headline-tag {
      font-size: 0.8rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.2em;
      margin-bottom: 1rem;
      display: block;
    }
    .pro-hero-title {
      font-size: 4.5rem;
      line-height: 1.02;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }
    .shimmer-text {
      background: linear-gradient(135deg, #ffffff 0%, #00f2fe 50%, #d4af37 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .pro-hero-sub {
      font-size: 1.2rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 3.5rem;
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-stat-row {
      display: flex;
      justify-content: center;
      gap: 3.5rem;
    }
    .hero-stat {
      display: flex;
      flex-direction: column;
    }
    .h-val {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ffffff;
      font-family: var(--font-display);
    }
    .h-val small { font-size: 0.9rem; color: #00f2fe; }
    .h-lbl {
      font-size: 0.78rem;
      color: #94a3b8;
      letter-spacing: 0.08em;
    }

    /* Story Cards (Apple Minimal Glass Cards) */
    .glass-callout {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
      border-radius: 24px;
      padding: 3rem;
      max-width: 480px;
      width: 100%;
    }

    .right-aligned {
      margin-left: auto;
    }

    .story-num {
      font-size: 0.8rem;
      font-weight: 900;
      color: #00f2fe;
      letter-spacing: 0.15em;
      margin-bottom: 0.75rem;
      display: block;
    }
    .story-heading {
      font-size: 1.8rem;
      color: #ffffff;
      margin-bottom: 1rem;
      font-weight: 800;
      line-height: 1.2;
    }
    .story-body {
      font-size: 1rem;
      color: #94a3b8;
      line-height: 1.7;
