---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../data/products';
---

<BaseLayout 
  title="Checkout & Payment | SKYNODESUAV" 
  description="Complete your order with 100% SSL payment security. Support UPI, Credit/Debit Cards, NetBanking, and Cash on Delivery."
  bodyClass="bellavita-page-body"
>
  <main class="container page-padding reveal-on-scroll">
    <h1 class="checkout-page-title">SECURE CHECKOUT</h1>
    <p class="checkout-page-sub">Fast 1-Step Checkout • 100% Insured Delivery across India</p>

    <div class="checkout-layout">

      <!-- Left Column: Address & Payment Options -->
      <div class="checkout-main">
        
        <!-- Step 1: Shipping Address & B2B GST Info -->
        <section class="checkout-card glass-panel">
          <h2 class="card-step-heading">
            <span class="step-num">1</span> SHIPPING ADDRESS & BILLING INFO
          </h2>

          <form id="checkout-address-form" class="checkout-form">
            <!-- Saved Addresses Quick Pick -->
            <div id="saved-addresses-checkout-wrap" style="display: none; margin-bottom: 1.5rem; padding: 0.85rem; background: #faf8f5; border: 1px solid #e2d9cc; border-radius: 8px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 800; color: #1a1a1a; letter-spacing: 0.04em;">📁 SELECT SAVED ADDRESS:</span>
                <a href="/profile" style="font-size: 0.72rem; color: #3b0811; font-weight: 700; text-decoration: underline;">Manage Addresses</a>
              </div>
              <div id="saved-addresses-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem;"></div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label>Full Name *</label>
                <input type="text" id="cust-name" placeholder="Capt. Rahul Sharma" required class="form-input" />
              </div>
              <div class="form-group">
                <label>Phone Number (for Courier SMS Alerts) *</label>
                <input type="tel" id="cust-phone" placeholder="+91 98100 12345" required class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label>Email Address (For Tax Invoice & Order Updates) *</label>
              <input type="email" id="cust-email" placeholder="pilot@skynodesuav.com" required class="form-input" />
            </div>

            <div class="form-group">
              <label>Street Address / House No. / Flying Field *</label>
              <input type="text" id="cust-address" placeholder="Flat 402, Aerohaven Apts, Main Road" required class="form-input" />
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>City / District *</label>
                <input type="text" id="cust-city" placeholder="Nashik / Mumbai" required class="form-input" />
              </div>
              <div class="form-group">
                <label>State *</label>
                <select id="cust-state" required class="form-input" style="background: #fff;">
                  <option value="Maharashtra" selected>Maharashtra</option>
                  <option value="Delhi">Delhi</option>
                  <option value="Karnataka">Karnataka</option>
                  <option value="Gujarat">Gujarat</option>
                  <option value="Tamil Nadu">Tamil Nadu</option>
                  <option value="Telangana">Telangana</option>
                  <option value="Uttar Pradesh">Uttar Pradesh</option>
                  <option value="West Bengal">West Bengal</option>
                  <option value="Haryana">Haryana</option>
                  <option value="Punjab">Punjab</option>
                  <option value="Rajasthan">Rajasthan</option>
                  <option value="Madhya Pradesh">Madhya Pradesh</option>
                  <option value="Kerala">Kerala</option>
                  <option value="Andhra Pradesh">Andhra Pradesh</option>
                  <option value="Other">Other State</option>
                </select>
              </div>
              <div class="form-group">
                <label>PIN Code *</label>
                <input type="text" id="cust-pincode" placeholder="422 502" required class="form-input" />
              </div>
            </div>

            <!-- B2B / B2C GST Optional Card (360° Indian Market Standard) -->
            <div class="b2b-gst-box" style="margin-top: 1.25rem; padding: 1.1rem; background: #faf8f5; border: 1px dashed #d6cfc2; border-radius: 6px;">
              <label style="display: flex; align-items: center; gap: 0.65rem; font-size: 0.88rem; font-weight: 700; color: #1a1a1a; cursor: pointer; user-select: none;">
                <input type="checkbox" id="b2b-gst-toggle" style="width: 18px; height: 18px; accent-color: #3b0811; cursor: pointer;" />
                <span>🏢 Buying for Business / Flying Club? (Add GSTIN for Input Tax Credit)</span>
              </label>
              
              <div id="b2b-fields-container" style="display: none; margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed #e2d9cc;">
                <div class="form-row-2">
                  <div class="form-group">
                    <label>Company / Business Name *</label>
                    <input type="text" id="cust-company" placeholder="e.g. Vayu Aero Flying Club Pvt Ltd" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label>15-Digit GSTIN Number *</label>
                    <input type="text" id="cust-gstin" placeholder="e.g. 27AAAAA0000A1Z5" maxlength="15" style="text-transform: uppercase;" class="form-input" />
                  </div>
                </div>
                <small style="display: block; margin-top: 0.35rem; font-size: 0.73rem; color: #666666;">
                  💡 B2B Tax Invoice with statutory HSN breakdown will be generated for Input Tax Credit (ITC) claiming in GSTR-3B.
                </small>
              </div>
            </div>
          </form>
        </section>

        <!-- Step 2: Payment Options -->
        <section class="checkout-card glass-panel" style="margin-top: 2rem;">
          <h2 class="card-step-heading">
            <span class="step-num">2</span> SELECT PAYMENT METHOD
          </h2>

          <div class="payment-options-grid">
            <label class="pay-option-card active">
              <input type="radio" name="pay-method" value="upi" checked />
              <div class="pay-content">
                <strong>⚡ Instant UPI / QR Code (GPay, PhonePe, Paytm)</strong>
                <small>0% Payment Fee — Instant Dispatch Confirmation</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="card" />
              <div class="pay-content">
                <strong>💳 Credit / Debit Cards (Visa, Mastercard, RuPay)</strong>
                <small>Secured 256-bit SSL Payment Gateway</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="netbanking" />
              <div class="pay-content">
                <strong>🏦 NetBanking (HDFC, SBI, ICICI, Axis)</strong>
                <small>Direct Bank Transfer</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="cod" />
              <div class="pay-content">
                <strong>💵 Cash on Delivery (COD)</strong>
                <small>Pay cash upon delivery at your doorstep</small>
              </div>
            </label>
          </div>

          <button id="place-order-btn" class="btn-primary btn-place-order" style="margin-top: 2rem; width: 100%;">
            CONFIRM ORDER & GENERATE INVOICE BILL ➔
          </button>
        </section>

      </div>

      <!-- Right Column: Order Summary & Coupon Promo Box -->
      <aside class="checkout-sidebar">
        <div class="checkout-card glass-panel sticky-summary">
          <h2 class="card-step-heading">ORDER SUMMARY</h2>

          <div class="summary-items-list" id="summary-items-list">
            <!-- Hydrated by JS -->
          </div>

          <!-- Promo Coupon Code Box -->
          <div class="promo-coupon-box">
            <div class="promo-title-line">🏷️ HAVE A PROMO CODE / COUPON?</div>
            <div class="promo-input-group">
              <input type="text" id="coupon-code-input" placeholder="e.g. SKY80 or PILOT10" class="promo-code-input" />
              <button type="button" id="apply-coupon-btn" class="btn-apply-coupon">APPLY</button>
            </div>
            
            <div class="suggested-coupons-wrap" style="margin-top: 0.6rem;">
              <span style="font-size: 0.68rem; color: #666; font-weight: 600;">Click to apply:</span>
              <div class="suggested-coupon-pills">
                <button type="button" class="coupon-chip-btn" data-code="SKY80">SKY80 (₹80 OFF)</button>
                <button type="button" class="coupon-chip-btn" data-code="PILOT10">PILOT10 (10% OFF)</button>
              </div>
            </div>

            <div id="coupon-discount-notice" class="coupon-notice-badge" style="display: none;"></div>
          </div>

          <hr class="summary-divider" />

          <div class="summary-totals">
            <div class="total-row">
              <span>Items Total (Incl. GST):</span>
              <strong id="chk-subtotal">₹0.00</strong>
            </div>

            <div class="total-row" id="coupon-discount-row" style="display: none; color: #059669;">
              <span>Promo Coupon Discount:</span>
              <strong id="chk-coupon-discount">-₹0.00</strong>
            </div>

            <div class="total-row">
              <span id="chk-gst-label">Est. Included GST (5%/12%/18%):</span>
              <strong id="chk-gst">₹0.00</strong>
            </div>

            <div class="total-row">
              <span>Insured Flight Shipping:</span>
              <strong style="color: #059669;">FREE</strong>
            </div>

            <hr class="summary-divider" />

            <div class="total-row grand-total-row">
              <span>TOTAL PAYABLE:</span>
              <strong class="grand-price" id="chk-total">₹0.00</strong>
            </div>
          </div>

          <div class="guarantee-box" style="margin-top: 1.5rem; font-size: 0.75rem; color: #666; background: #fdf8f4; padding: 0.75rem; border-radius: 4px; border: 1px solid #f3e5d8;">
            🛡️ <strong>100% Transit Protection:</strong> If any part arrives damaged, we replace it instantly for free.
          </div>
        </div>
      </aside>

    </div>
  </main>

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 3rem 1.25rem 5rem;
    }
    .checkout-page-title {
      font-family: var(--font-display);
      font-size: 2rem;
      color: #1a1a1a;
      text-align: center;
      margin-bottom: 0.3rem;
    }
    .checkout-page-sub {
      text-align: center;
      color: #666666;
      font-size: 0.95rem;
      margin-bottom: 3rem;
    }

    .checkout-layout {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
      align-items: flex-start;
    }

    .checkout-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 2rem;
    }
    .card-step-heading {
      font-family: var(--font-display);
      font-size: 1.15rem;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-bottom: 1.5px solid #e6e0d5;
      padding-bottom: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .step-num {
      background: #3b0811;
      color: #ffffff;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
    }

    .checkout-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-group label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #333333;
    }
    .form-input {
      background: #faf8f5;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      color: #1a1a1a;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .form-input:focus {
      border-color: #3b0811;
      background: #ffffff;
    }
    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.25rem;
    }

    /* Payment Options */
    .payment-options-grid {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .pay-option-card {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.1rem;
      background: #faf8f5;
      border: 1.5px solid #e6e0d5;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .pay-option-card:hover, .pay-option-card.active {
      border-color: #3b0811;
      background: #ffffff;
    }
    .pay-option-card input[type="radio"] {
      margin-top: 0.2rem;
      accent-color: #3b0811;
    }
    .pay-content strong {
      display: block;
      font-size: 0.92rem;
      color: #1a1a1a;
      margin-bottom: 0.15rem;
    }
    .pay-content small {
      color: #666666;
      font-size: 0.78rem;
    }

    .btn-place-order {
      padding: 1.1rem;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.05em;
    }

    /* Sidebar Summary */
    .sticky-summary {
      position: sticky;
      top: 2rem;
    }
    .summary-items-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 1.25rem;
      max-height: 260px;
      overflow-y: auto;
    }
    :global(.chk-item-row) {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      font-size: 0.82rem;
    }
    :global(.chk-item-img) {
      width: 48px;
      height: 48px;
      object-fit: cover;
      border-radius: 4px;
      border: 1px solid #e6e0d5;
    }
    :global(.chk-item-info) {
      flex: 1;
    }
    :global(.chk-item-name) {
      font-weight: 700;
      color: #1a1a1a;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    :global(.chk-item-qty) {
      color: #666666;
      font-size: 0.75rem;
    }

    .summary-totals {
      font-size: 0.85rem;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      color: #555555;
    }
    .summary-divider {
      border: none;
      border-top: 1px solid #e6e0d5;
      margin: 0.85rem 0;
    }
    .grand-total-row {
      font-size: 1.05rem;
      color: #1a1a1a;
      font-weight: 800;
    }
    .grand-price {
      color: #3b0811;
      font-family: var(--font-display);
      font-size: 1.25rem;
    }

    /* Promo Coupon Code Box */
    .promo-coupon-box {
      margin: 1.25rem 0;
      padding: 1rem;
      background: #faf8f5;
      border: 1px dashed #d6cfc2;
      border-radius: var(--radius-sm);
    }
    .promo-title-line {
      font-size: 0.76rem;
      font-weight: 800;
      color: #1a1a1a;
      letter-spacing: 0.04em;
      margin-bottom: 0.5rem;
    }
    .promo-input-group {
      display: flex;
      gap: 0.4rem;
    }
    .promo-code-input {
      flex: 1;
      background: #ffffff;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      padding: 0.5rem 0.65rem;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      outline: none;
    }
    .promo-code-input:focus {
      border-color: #3b0811;
    }
    .btn-apply-coupon {
      background: #3b0811;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 0.5rem 0.85rem;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      letter-spacing: 0.04em;
    }
    .btn-apply-coupon:hover {
      background: #000000;
    }
    .suggested-coupon-pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .coupon-chip-btn {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      color: #374151;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .coupon-chip-btn:hover {
      border-color: #059669;
      color: #059669;
      background: #ecfdf5;
    }
    .coupon-notice-badge {
      margin-top: 0.6rem;
      padding: 0.45rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .coupon-notice-badge.success {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }
    .coupon-notice-badge.error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    @media (max-width: 900px) {
      .checkout-layout {
        grid-template-columns: 1fr;
      }
      .form-row-2, .form-row-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { getCartFromStorage, getCachedProduct } from '../lib/cartStore';

    function getCartHydrated() {
      const items = getCartFromStorage();
      return items.map(item => {
        const product = item.productData || getCachedProduct(item.productId) || {
          id: item.productId,
          name: `Product (${item.productId})`,
          price: 12499,
          originalPrice: 15999,
          gstRate: 18,
          hsnCode: '9503',
          image: 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400',
          category: 'engine',
          categoryLabel: 'Engine'
        };
        return {
          ...item,
          product
        };
      });
    }

    function initCheckout() {
      const itemsList = document.getElementById('summary-items-list');
      const subtotalEl = document.getElementById('chk-subtotal');
      const gstEl = document.getElementById('chk-gst');
      const totalEl = document.getElementById('chk-total');
      const placeOrderBtn = document.getElementById('place-order-btn');
      const payOptions = document.querySelectorAll('.pay-option-card');

      // B2B GST Toggle Handler
      const b2bToggle = document.getElementById('b2b-gst-toggle') as HTMLInputElement;
      const b2bFieldsContainer = document.getElementById('b2b-fields-container');

      if (b2bToggle && b2bFieldsContainer) {
        b2bToggle.addEventListener('change', () => {
          b2bFieldsContainer.style.display = b2bToggle.checked ? 'block' : 'none';
        });
      }

      payOptions.forEach(opt => {
        opt.addEventListener('click', () => {
          payOptions.forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          const radio = opt.querySelector('input[type="radio"]') as HTMLInputElement;
          if (radio) radio.checked = true;
        });
      });

      const hydrated = getCartHydrated();

      if (!itemsList) return;

      if (hydrated.length === 0) {
        itemsList.innerHTML = `<p style="font-size: 0.85rem; color: #888;">Your cart is empty. <a href="/shop" style="color: #3b0811; font-weight: 700;">Browse catalog</a></p>`;
      } else {
        itemsList.innerHTML = hydrated.map(item => {
          const gstPercent = item.product.gstRate ?? 18;
          return `
            <div class="chk-item-row">
              <img src="${item.product.image}" alt="${item.product.name}" class="chk-item-img" />
              <div class="chk-item-info">
                <div class="chk-item-name">${item.product.name}</div>
                <div class="chk-item-qty">Qty: ${item.quantity} × ₹${item.product.price.toLocaleString('en-IN')} <span style="font-size: 0.68rem; color: #059669; font-weight: 700;">(GST ${gstPercent}%)</span></div>
              </div>
              <strong>₹${(item.product.price * item.quantity).toLocaleString('en-IN')}</strong>
            </div>
          `;
        }).join('');
      }

      // Multi-tier Tax Calculation (5%, 12%, 18%)
      const rawSubtotal = hydrated.reduce((acc, cur) => acc + (cur.product.price * cur.quantity), 0);
      
      let rawEstTax = 0;
      hydrated.forEach(cur => {
        const gstRate = cur.product.gstRate ?? 18;
        const lineTotal = cur.product.price * cur.quantity;
        const baseLine = lineTotal / (1 + gstRate / 100);
        rawEstTax += (lineTotal - baseLine);
      });
      rawEstTax = Math.round(rawEstTax);

      let appliedDiscountAmount = 0;
      let appliedCouponCode = '';

      const couponInput = document.getElementById('coupon-code-input') as HTMLInputElement;
      const applyCouponBtn = document.getElementById('apply-coupon-btn');
      const couponNotice = document.getElementById('coupon-discount-notice');
      const couponDiscountRow = document.getElementById('coupon-discount-row');
      const couponDiscountEl = document.getElementById('chk-coupon-discount');
      const chipBtns = document.querySelectorAll('.coupon-chip-btn');

      function updateTotalsWithDiscount() {
        const finalSubtotal = Math.max(0, rawSubtotal - appliedDiscountAmount);
        
        let estGst = 0;
        if (rawSubtotal > 0) {
          const discountRatio = finalSubtotal / rawSubtotal;
          estGst = Math.round(rawEstTax * discountRatio);
        }

        const total = finalSubtotal;

        if (subtotalEl) subtotalEl.textContent = `₹${rawSubtotal.toLocaleString('en-IN')}.00`;
        if (gstEl) gstEl.textContent = `₹${estGst.toLocaleString('en-IN')}.00`;
        if (totalEl) totalEl.textContent = `₹${total.toLocaleString('en-IN')}.00`;

        if (appliedDiscountAmount > 0 && couponDiscountRow && couponDiscountEl) {
          couponDiscountRow.style.display = 'flex';
          couponDiscountEl.textContent = `-₹${appliedDiscountAmount.toLocaleString('en-IN')}.00`;
        } else if (couponDiscountRow) {
          couponDiscountRow.style.display = 'none';
        }
      }

      function applyCoupon(code: string) {
        const cleanCode = code.trim().toUpperCase();
        if (!cleanCode) return;

        if (cleanCode === 'SKY80') {
          appliedDiscountAmount = 80;
          appliedCouponCode = 'SKY80';
          if (couponNotice) {
            couponNotice.style.display = 'block';
            couponNotice.className = 'coupon-notice-badge success';
            couponNotice.textContent = '🎉 Coupon SKY80 Applied! ₹80 Instant Discount Granted.';
          }
        } else if (cleanCode === 'PILOT10') {
          appliedDiscountAmount = Math.round(rawSubtotal * 0.10);
          appliedCouponCode = 'PILOT10';
          if (couponNotice) {
            couponNotice.style.display = 'block';
            couponNotice.className = 'coupon-notice-badge success';
            couponNotice.textContent = `🎉 Coupon PILOT10 Applied! 10% Off (Saved ₹${appliedDiscountAmount.toLocaleString('en-IN')}).`;
          }
        } else {
          appliedDiscountAmount = 0;
          appliedCouponCode = '';
          if (couponNotice) {
            couponNotice.style.display = 'block';
            couponNotice.className = 'coupon-notice-badge error';
            couponNotice.textContent = '❌ Invalid Coupon Code. Try SKY80 or PILOT10.';
          }
        }
        updateTotalsWithDiscount();
      }

      applyCouponBtn?.addEventListener('click', () => {
        if (couponInput) applyCoupon(couponInput.value);
      });

      chipBtns.forEach(chip => {
        chip.addEventListener('click', (e) => {
          const code = (e.currentTarget as HTMLElement).getAttribute('data-code');
          if (code) {
            if (couponInput) couponInput.value = code;
            applyCoupon(code);
          }
        });
      });

      updateTotalsWithDiscount();

      // Saved Addresses Autofill
      function initSavedAddressesOnCheckout() {
        const wrap = document.getElementById('saved-addresses-checkout-wrap');
        const grid = document.getElementById('saved-addresses-grid');
        if (!wrap || !grid) return;

        try {
          const raw = localStorage.getItem('skynodes_saved_addresses');
          const list = raw ? JSON.parse(raw) : [];

          if (list.length > 0) {
            wrap.style.display = 'block';
            grid.innerHTML = list.map((a: any) => `
              <button type="button" class="btn-select-checkout-addr" data-id="${a.id}" style="text-align: left; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.65rem; cursor: pointer; transition: all 0.2s;">
                <strong style="display: block; font-size: 0.78rem; color: #1e293b;">${a.label} ${a.isDefault ? '(Default)' : ''}</strong>
                <small style="display: block; font-size: 0.72rem; color: #64748b; line-height: 1.3; margin-top: 0.2rem;">${a.name} - ${a.street}, ${a.city} (${a.pincode})</small>
              </button>
            `).join('');

            const fillForm = (a: any) => {
              (document.getElementById('cust-name') as HTMLInputElement).value = a.name || '';
              (document.getElementById('cust-phone') as HTMLInputElement).value = a.phone || '';
              (document.getElementById('cust-address') as HTMLInputElement).value = a.street || '';
              (document.getElementById('cust-city') as HTMLInputElement).value = a.city || '';
              (document.getElementById('cust-state') as HTMLSelectElement).value = a.state || 'Maharashtra';
              (document.getElementById('cust-pincode') as HTMLInputElement).value = a.pincode || '';

              const savedEmail = localStorage.getItem('skynodes_pilot_email');
              if (savedEmail) (document.getElementById('cust-email') as HTMLInputElement).value = savedEmail;
              const savedGstin = localStorage.getItem('skynodes_pilot_gstin');
              if (savedGstin) {
                (document.getElementById('cust-gstin') as HTMLInputElement).value = savedGstin;
                if (b2bToggle) {
                  b2bToggle.checked = true;
                  if (b2bFieldsContainer) b2bFieldsContainer.style.display = 'block';
                }
              }
              const savedCompany = localStorage.getItem('skynodes_pilot_company');
              if (savedCompany) (document.getElementById('cust-company') as HTMLInputElement).value = savedCompany;
            };

            const defaultAddr = list.find((a: any) => a.isDefault) || list[0];
            if (defaultAddr) fillForm(defaultAddr);

            grid.querySelectorAll('.btn-select-checkout-addr').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
                const target = list.find((a: any) => a.id === id);
                if (target) fillForm(target);
              });
            });
          }
        } catch (e) {}
      }

      initSavedAddressesOnCheckout();

      placeOrderBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('cust-name') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('cust-phone') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('cust-email') as HTMLInputElement)?.value.trim();
        const address = (document.getElementById('cust-address') as HTMLInputElement)?.value.trim();
        const city = (document.getElementById('cust-city') as HTMLInputElement)?.value.trim();
        const state = (document.getElementById('cust-state') as HTMLSelectElement)?.value.trim();
        const pincode = (document.getElementById('cust-pincode') as HTMLInputElement)?.value.trim();
        
        const isB2B = (document.getElementById('b2b-gst-toggle') as HTMLInputElement)?.checked || false;
        const companyName = (document.getElementById('cust-company') as HTMLInputElement)?.value.trim() || '';
        const gstin = (document.getElementById('cust-gstin') as HTMLInputElement)?.value.trim().toUpperCase() || '';

        if (!name || !phone || !email || !address || !city || !pincode) {
          alert('Please fill in all required Shipping Address details (*).');
          return;
        }

        if (isB2B && (!companyName || !gstin)) {
          alert('🏢 B2B Invoice Option Selected:\nPlease enter both Company Name and 15-Digit GSTIN Number.');
          return;
        }

        // Require Login or Sign-up before final order confirmation
        const isLoggedIn = localStorage.getItem('google_auth_logged_in') === 'true';
        if (!isLoggedIn) {
          alert('🔐 Account Login or Sign Up required to complete your order!\n\nOpening Pilot Portal...');
          window.dispatchEvent(new CustomEvent('open-login-modal'));
          return;
        }

        const selectedPayRadio = document.querySelector('input[name="pay-method"]:checked') as HTMLInputElement;
        const payMethodVal = selectedPayRadio?.value || 'cod';

        const subtotal = Math.max(0, rawSubtotal - appliedDiscountAmount);
        
        let gst = 0;
        if (rawSubtotal > 0) {
          const discountRatio = subtotal / rawSubtotal;
          gst = Math.round(rawEstTax * discountRatio);
        }
        const total = subtotal;

        const orderId = `#SKY-INV-2026-${Math.floor(1000 + Math.random() * 9000)}`;
        const awb = `#AWB-987${Math.floor(100000 + Math.random() * 900000)}`;
        const todayDate = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });

        const paymentLabel = payMethodVal === 'cod' ? 'CASH ON DELIVERY (COD)' : 'PAID (ONLINE)';
        const statusLabel = payMethodVal === 'cod' ? 'PENDING (COD UPON DELIVERY)' : 'PAID (ONLINE)';

        const currentOrder = {
          orderId,
          awb,
          date: todayDate,
          paymentMethod: paymentLabel,
          status: statusLabel,
          customer: {
            name,
            phone,
            email,
            address,
            city,
            state,
            pincode,
            isB2B,
            companyName,
            gstin
          },
          items: hydrated,
          subtotal,
          gst,
          total,
          appliedCouponCode,
          appliedDiscountAmount
        };

        try {
          localStorage.setItem('skynodes_last_order', JSON.stringify(currentOrder));
          if (email) localStorage.setItem('skynodes_pilot_email', email);
          if (gstin) localStorage.setItem('skynodes_pilot_gstin', gstin);
          if (companyName) localStorage.setItem('skynodes_pilot_company', companyName);
        } catch (err) {}

        window.location.href = '/invoice';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCheckout);
    } else {
      initCheckout();
    }
    document.addEventListener('astro:page-load', initCheckout);
  </script>
</BaseLayout>
