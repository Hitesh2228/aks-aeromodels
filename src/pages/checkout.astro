---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import LoginModal from '../components/LoginModal.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Express Flight Checkout | SKYNODESUAV</title>
  <meta name="description" content="Complete your aeromodelling order with secure UPI, Cards, NetBanking, or COD and instant GST tax invoice." />
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />

  <Header />
  <LoginModal />

  <main class="container page-padding reveal-on-scroll">
    <h1 class="checkout-page-title">EXPRESS FLIGHT CHECKOUT</h1>
    <p class="checkout-page-sub">Enter shipping details and choose your preferred payment method</p>

    <div class="checkout-layout">
      
      <!-- Left Column: Shipping & Payment Form -->
      <div class="checkout-form-column">
        
        <!-- Step 1: Customer Contact & Shipping Address -->
        <section class="checkout-card glass-panel">
          <h2 class="card-step-heading">
            <span class="step-num">1</span> SHIPPING ADDRESS & DETAILS
          </h2>

          <!-- Saved Address 1-Click Picker -->
          <div id="checkout-saved-addresses-wrap" style="display: none; margin-bottom: 1.5rem; background: #f0fdf4; border: 1px solid #a7f3d0; border-radius: 10px; padding: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <strong style="font-size: 0.85rem; color: #065f46;">📍 1-CLICK FILL FROM YOUR SAVED ADDRESSES:</strong>
              <a href="/profile" style="font-size: 0.75rem; color: #059669; text-decoration: underline; font-weight: 700;">Manage Address Book</a>
            </div>
            <div id="checkout-saved-addresses-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;"></div>
          </div>

          <form id="checkout-shipping-form" class="checkout-form">
            <div class="form-row-2">
              <div class="form-group">
                <label>Full Name *</label>
                <input type="text" id="cust-name" placeholder="e.g. Capt. Rajesh Sharma" required class="form-input" />
              </div>
              <div class="form-group">
                <label>Phone Number (WhatsApp) *</label>
                <input type="tel" id="cust-phone" placeholder="+91 98765 43210" required class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label>Email Address *</label>
              <input type="email" id="cust-email" placeholder="name@domain.com" required class="form-input" />
            </div>

            <div class="form-group">
              <label>Complete Delivery Address (House No, Street, Landmark) *</label>
              <input type="text" id="cust-address" placeholder="e.g. Plot No 45, Near Civil Airport Road" required class="form-input" />
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>City / District *</label>
                <input type="text" id="cust-city" placeholder="Nashik / Mumbai" required class="form-input" />
              </div>
              <div class="form-group">
                <label>State *</label>
                <input type="text" id="cust-state" placeholder="Maharashtra" required class="form-input" />
              </div>
              <div class="form-group">
                <label>PIN Code *</label>
                <input type="text" id="cust-pincode" placeholder="422 502" required class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label>B2B GSTIN Number (Optional for 18% Input Tax Credit)</label>
              <input type="text" id="cust-gstin" placeholder="27AAAAA0000A1Z5" class="form-input" />
            </div>
          </form>
        </section>

        <!-- Step 2: Payment Options -->
        <section class="checkout-card glass-panel" style="margin-top: 2rem;">
          <h2 class="card-step-heading">
            <span class="step-num">2</span> SELECT PAYMENT METHOD
          </h2>

          <div class="payment-options-grid">
            <label class="pay-option-card active">
              <input type="radio" name="pay-method" value="upi" checked />
              <div class="pay-content">
                <strong>⚡ Instant UPI / QR Code (GPay, PhonePe, Paytm)</strong>
                <small>0% Payment Fee — Instant Dispatch Confirmation</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="card" />
              <div class="pay-content">
                <strong>💳 Credit / Debit Cards (Visa, Mastercard, RuPay)</strong>
                <small>Secured 256-bit SSL Payment Gateway</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="netbanking" />
              <div class="pay-content">
                <strong>🏦 NetBanking (HDFC, SBI, ICICI, Axis)</strong>
                <small>Direct Bank Transfer</small>
              </div>
            </label>

            <label class="pay-option-card">
              <input type="radio" name="pay-method" value="cod" />
              <div class="pay-content">
                <strong>💵 Cash on Delivery (COD)</strong>
                <small>Pay cash upon delivery at your doorstep</small>
              </div>
            </label>
          </div>

          <button id="place-order-btn" class="btn-primary btn-place-order" style="margin-top: 2rem; width: 100%;">
            CONFIRM ORDER & GENERATE INVOICE BILL ➔
          </button>
        </section>

      </div>

      <!-- Right Column: Order Summary Box -->
      <aside class="checkout-summary-column">
        <div class="summary-card glass-panel sticky-summary">
          <h3 class="summary-title">ORDER SUMMARY</h3>
          
          <div class="summary-items-list" id="checkout-items-list">
            <!-- Hydrated via JS -->
          </div>

          <!-- Promo Coupon Code Box -->
          <div class="promo-coupon-box">
            <div class="promo-title-line">
              <span>🎟️ HAVE A PROMO / DISCOUNT CODE?</span>
            </div>
            <div class="promo-input-group">
              <input type="text" id="coupon-code-input" placeholder="e.g. SKY80 / PILOT10" class="promo-code-input" />
              <button type="button" id="apply-coupon-btn" class="btn-apply-coupon">APPLY</button>
            </div>
            <div class="suggested-coupon-pills">
              <button type="button" class="coupon-chip-btn" data-code="SKY80">🏷️ SKY80 (₹80 OFF)</button>
              <button type="button" class="coupon-chip-btn" data-code="PILOT10">🏷️ PILOT10 (10% OFF)</button>
            </div>
            <div id="coupon-discount-notice" class="coupon-notice-badge" style="display: none;"></div>
          </div>

          <div class="summary-totals">
            <div class="total-row">
              <span>Item Subtotal:</span>
              <strong id="chk-subtotal">₹0.00</strong>
            </div>
            <div class="total-row" id="coupon-discount-row" style="display: none; color: #059669;">
              <span>Coupon Discount:</span>
              <strong id="chk-coupon-discount">-₹0.00</strong>
            </div>
            <div class="total-row">
              <span>GST Output Tax (18% Included):</span>
              <strong id="chk-gst">₹0.00</strong>
            </div>
            <div class="total-row">
              <span>Insured Air Freight:</span>
              <strong style="color: #059669;">FREE</strong>
            </div>
            <hr class="summary-divider" />
            <div class="total-row grand-total-row">
              <span>TOTAL PAYABLE:</span>
              <strong id="chk-total" class="grand-price">₹0.00</strong>
            </div>
          </div>

          <div class="trust-guarantee-box">
            <span class="shield-icon">🛡️</span>
            <div>
              <strong>100% Transit Protection</strong>
              <small>Free replacement if damaged during courier transit.</small>
            </div>
          </div>

        </div>
      </aside>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 3rem 1.25rem 5rem;
    }
    .checkout-page-title {
      font-family: var(--font-display);
      font-size: 2rem;
      color: #1a1a1a;
      text-align: center;
      margin-bottom: 0.3rem;
    }
    .checkout-page-sub {
      text-align: center;
      color: #666666;
      font-size: 0.95rem;
      margin-bottom: 3rem;
    }

    .checkout-layout {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 2.5rem;
      align-items: flex-start;
    }

    .checkout-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 2rem;
    }
    .card-step-heading {
      font-family: var(--font-display);
      font-size: 1.15rem;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-bottom: 1.5px solid #e6e0d5;
      padding-bottom: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .step-num {
      background: #3b0811;
      color: #ffffff;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
    }

    .checkout-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.25rem;
    }
    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 0.35rem;
    }
    .form-input {
      width: 100%;
      background: #fbf9f5;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: #1a1a1a;
      font-size: 0.88rem;
      outline: none;
      transition: var(--transition-fast);
    }
    .form-input:focus {
      border-color: #3b0811;
      background: #ffffff;
    }

    /* Payment Cards */
    .payment-options-grid {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .pay-option-card {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: #fbf9f5;
      border: 1.5px solid #e6e0d5;
      border-radius: var(--radius-sm);
      padding: 1rem 1.25rem;
      cursor: pointer;
      transition: var(--transition-fast);
    }
    .pay-option-card:hover, .pay-option-card.active {
      background: #ffffff;
      border-color: #3b0811;
      box-shadow: 0 4px 15px rgba(59, 8, 17, 0.06);
    }
    .pay-option-card input {
      margin-top: 0.2rem;
      accent-color: #3b0811;
    }
    .pay-content strong {
      display: block;
      font-size: 0.9rem;
      color: #1a1a1a;
    }
    .pay-content small {
      font-size: 0.78rem;
      color: #666666;
    }

    .btn-place-order {
      background: #3b0811;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 1rem;
      border-radius: var(--radius-sm);
      letter-spacing: 0.05em;
    }
    .btn-place-order:hover {
      background: #5c121e;
      transform: translateY(-2px);
    }

    /* Summary Side */
    .sticky-summary {
      position: sticky;
      top: 90px;
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 1.75rem;
    }
    .summary-title {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: #3b0811;
      border-bottom: 1.5px solid #e6e0d5;
      padding-bottom: 0.6rem;
      margin-bottom: 1.25rem;
    }

    .summary-items-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      max-height: 280px;
      overflow-y: auto;
      margin-bottom: 1.25rem;
      padding-right: 0.25rem;
    }
    :global(.chk-item-row) {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      font-size: 0.82rem;
      border-bottom: 1px solid #f3eee7;
      padding-bottom: 0.6rem;
    }
    :global(.chk-item-img) {
      width: 48px;
      height: 48px;
      object-fit: cover;
      border-radius: 4px;
      border: 1px solid #e6e0d5;
    }
    :global(.chk-item-info) {
      flex-grow: 1;
    }
    :global(.chk-item-name) {
      font-weight: 700;
      color: #1a1a1a;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    :global(.chk-item-qty) {
      color: #666666;
      font-size: 0.75rem;
    }

    .summary-totals {
      font-size: 0.85rem;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      color: #555555;
    }
    .summary-divider {
      border: none;
      border-top: 1px solid #e6e0d5;
      margin: 0.85rem 0;
    }
    .grand-total-row {
      font-size: 1.05rem;
      color: #1a1a1a;
      font-weight: 800;
    }
    .grand-price {
      color: #3b0811;
      font-family: var(--font-display);
      font-size: 1.25rem;
    }

    /* Promo Coupon Code Box */
    .promo-coupon-box {
      margin: 1.25rem 0;
      padding: 1rem;
      background: #faf8f5;
      border: 1px dashed #d6cfc2;
      border-radius: var(--radius-sm);
    }
    .promo-title-line {
      font-size: 0.76rem;
      font-weight: 800;
      color: #1a1a1a;
      letter-spacing: 0.04em;
      margin-bottom: 0.6rem;
    }
    .promo-input-group {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
    }
    .promo-code-input {
      flex: 1;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      padding: 0.5rem 0.65rem;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      outline: none;
    }
    .promo-code-input:focus {
      border-color: #3b0811;
    }
    .btn-apply-coupon {
      background: #3b0811;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 0.5rem 0.85rem;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      letter-spacing: 0.04em;
    }
    .btn-apply-coupon:hover {
      background: #000000;
    }
    .suggested-coupon-pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .coupon-chip-btn {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      color: #374151;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .coupon-chip-btn:hover {
      border-color: #059669;
      color: #059669;
      background: #ecfdf5;
    }
    .coupon-notice-badge {
      margin-top: 0.6rem;
      padding: 0.45rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .coupon-notice-badge.success {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }
    .coupon-notice-badge.error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }

    .trust-guarantee-box {
      margin-top: 1.5rem;
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .shield-icon { font-size: 1.4rem; }
    .trust-guarantee-box strong { display: block; font-size: 0.8rem; color: #1a1a1a; }
    .trust-guarantee-box small { font-size: 0.7rem; color: #666666; }

    @media (max-width: 900px) {
      .checkout-layout { grid-template-columns: 1fr; }
      .form-row-2, .form-row-3 { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { getCartHydrated, saveCartToStorage } from '../lib/cartStore';
    import { syncCartToShopifyStorefront } from '../lib/shopify';

    document.addEventListener('DOMContentLoaded', () => {
      const itemsList = document.getElementById('checkout-items-list');
      const subtotalEl = document.getElementById('chk-subtotal');
      const gstEl = document.getElementById('chk-gst');
      const totalEl = document.getElementById('chk-total');
      const placeOrderBtn = document.getElementById('place-order-btn');
      const payOptions = document.querySelectorAll('.pay-option-card');

      payOptions.forEach(opt => {
        opt.addEventListener('click', () => {
          payOptions.forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          const radio = opt.querySelector('input[type="radio"]') as HTMLInputElement;
          if (radio) radio.checked = true;
        });
      });

      const hydrated = getCartHydrated();

      if (!itemsList) return;

      if (hydrated.length === 0) {
        itemsList.innerHTML = `<p style="font-size: 0.85rem; color: #888;">Your cart is empty. <a href="/shop" style="color: #3b0811; font-weight: 700;">Browse catalog</a></p>`;
      } else {
        const subtotal = hydrated.reduce((acc, cur) => acc + (cur.product.price * cur.quantity), 0);
        const gst = Math.round(subtotal * 0.18);
        const total = subtotal;

        if (subtotalEl) subtotalEl.textContent = `₹${subtotal.toLocaleString('en-IN')}.00`;
        if (gstEl) gstEl.textContent = `₹${gst.toLocaleString('en-IN')}.00`;
        if (totalEl) totalEl.textContent = `₹${total.toLocaleString('en-IN')}.00`;

        itemsList.innerHTML = hydrated.map(item => `
          <div class="chk-item-row">
            <img src="${item.product.image}" alt="${item.product.name}" class="chk-item-img" />
            <div class="chk-item-info">
              <div class="chk-item-name">${item.product.name}</div>
              <div class="chk-item-qty">Qty: ${item.quantity} × ₹${item.product.price.toLocaleString('en-IN')}</div>
            </div>
            <strong>₹${(item.product.price * item.quantity).toLocaleString('en-IN')}</strong>
          </div>
        `).join('');
      }

      // Promo Coupon Code Application Logic
      let appliedDiscountAmount = 0;
      let appliedCouponCode = '';

      const couponInput = document.getElementById('coupon-code-input') as HTMLInputElement;
      const applyCouponBtn = document.getElementById('apply-coupon-btn');
      const couponNotice = document.getElementById('coupon-discount-notice');
      const couponDiscountRow = document.getElementById('coupon-discount-row');
      const couponDiscountEl = document.getElementById('chk-coupon-discount');
      const chipBtns = document.querySelectorAll('.coupon-chip-btn');

      const rawSubtotal = hydrated.reduce((acc, cur) => acc + (cur.product.price * cur.quantity), 0);

      function updateTotalsWithDiscount() {
        const finalSubtotal = Math.max(0, rawSubtotal - appliedDiscountAmount);
        const gst = Math.round(finalSubtotal * 0.18);
        const total = finalSubtotal;

        if (subtotalEl) subtotalEl.textContent = `₹${rawSubtotal.toLocaleString('en-IN')}.00`;
        if (gstEl) gstEl.textContent = `₹${gst.toLocaleString('en-IN')}.00`;
        if (totalEl) totalEl.textContent = `₹${total.toLocaleString('en-IN')}.00`;

        if (appliedDiscountAmount > 0 && couponDiscountRow && couponDiscountEl) {
          couponDiscountRow.style.display = 'flex';
          couponDiscountEl.textContent = `-₹${appliedDiscountAmount.toLocaleString('en-IN')}.00`;
        } else if (couponDiscountRow) {
          couponDiscountRow.style.display = 'none';
        }
      }

      function handleApplyCoupon(codeToApply: string) {
        const code = codeToApply.trim().toUpperCase();
        if (!code) return;

        if (code === 'SKY80') {
          appliedDiscountAmount = 80;
          appliedCouponCode = 'SKY80';
          if (couponNotice) {
            couponNotice.className = 'coupon-notice-badge success';
            couponNotice.style.display = 'block';
            couponNotice.textContent = '🎉 Coupon SKY80 Applied! You saved ₹80.00';
          }
        } else if (code === 'PILOT10') {
          appliedDiscountAmount = Math.round(rawSubtotal * 0.10);
          appliedCouponCode = 'PILOT10';
          if (couponNotice) {
            couponNotice.className = 'coupon-notice-badge success';
            couponNotice.style.display = 'block';
            couponNotice.textContent = `🎉 Coupon PILOT10 Applied! You saved ₹${appliedDiscountAmount.toLocaleString('en-IN')}.00`;
          }
        } else if (code === 'FIRSTPILOT' && rawSubtotal >= 10000) {
          appliedDiscountAmount = 500;
          appliedCouponCode = 'FIRSTPILOT';
          if (couponNotice) {
            couponNotice.className = 'coupon-notice-badge success';
            couponNotice.style.display = 'block';
            couponNotice.textContent = '🎉 VIP Coupon FIRSTPILOT Applied! You saved ₹500.00';
          }
        } else {
          appliedDiscountAmount = 0;
          appliedCouponCode = '';
          if (couponNotice) {
            couponNotice.className = 'coupon-notice-badge error';
            couponNotice.style.display = 'block';
            couponNotice.textContent = '❌ Invalid or expired coupon code. Try SKY80 or PILOT10.';
          }
        }
        updateTotalsWithDiscount();
      }

      applyCouponBtn?.addEventListener('click', () => {
        if (couponInput) handleApplyCoupon(couponInput.value);
      });

      chipBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const code = btn.getAttribute('data-code');
          if (code && couponInput) {
            couponInput.value = code;
            handleApplyCoupon(code);
          }
        });
      });

      function initSavedAddressesOnCheckout() {
        const wrap = document.getElementById('checkout-saved-addresses-wrap');
        const grid = document.getElementById('checkout-saved-addresses-grid');
        if (!wrap || !grid) return;

        try {
          const raw = localStorage.getItem('skynodes_saved_addresses');
          const list = raw ? JSON.parse(raw) : [];

          if (list.length > 0) {
            wrap.style.display = 'block';
            grid.innerHTML = list.map((a: any) => `
              <button type="button" class="btn-select-checkout-addr" data-id="${a.id}" style="text-align: left; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.65rem; cursor: pointer; transition: all 0.2s;">
                <strong style="display: block; font-size: 0.78rem; color: #1e293b;">${a.label} ${a.isDefault ? '(Default)' : ''}</strong>
                <small style="display: block; font-size: 0.72rem; color: #64748b; line-height: 1.3; margin-top: 0.2rem;">${a.name} - ${a.street}, ${a.city} (${a.pincode})</small>
              </button>
            `).join('');

            const fillForm = (a: any) => {
              (document.getElementById('cust-name') as HTMLInputElement).value = a.name || '';
              (document.getElementById('cust-phone') as HTMLInputElement).value = a.phone || '';
              (document.getElementById('cust-address') as HTMLInputElement).value = a.street || '';
              (document.getElementById('cust-city') as HTMLInputElement).value = a.city || '';
              (document.getElementById('cust-state') as HTMLInputElement).value = a.state || 'Maharashtra';
              (document.getElementById('cust-pincode') as HTMLInputElement).value = a.pincode || '';

              const savedEmail = localStorage.getItem('skynodes_pilot_email');
              if (savedEmail) (document.getElementById('cust-email') as HTMLInputElement).value = savedEmail;
              const savedGstin = localStorage.getItem('skynodes_pilot_gstin');
              if (savedGstin) (document.getElementById('cust-gstin') as HTMLInputElement).value = savedGstin;
            };

            const defaultAddr = list.find((a: any) => a.isDefault) || list[0];
            if (defaultAddr) fillForm(defaultAddr);

            grid.querySelectorAll('.btn-select-checkout-addr').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
                const target = list.find((a: any) => a.id === id);
                if (target) fillForm(target);
              });
            });
          }
        } catch (e) {}
      }

      initSavedAddressesOnCheckout();

      placeOrderBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('cust-name') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('cust-phone') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('cust-email') as HTMLInputElement)?.value.trim();
        const address = (document.getElementById('cust-address') as HTMLInputElement)?.value.trim();
        const city = (document.getElementById('cust-city') as HTMLInputElement)?.value.trim();
        const state = (document.getElementById('cust-state') as HTMLInputElement)?.value.trim();
        const pincode = (document.getElementById('cust-pincode') as HTMLInputElement)?.value.trim();
        const gstin = (document.getElementById('cust-gstin') as HTMLInputElement)?.value.trim();

        if (!name || !phone || !email || !address || !city || !pincode) {
          alert('Please fill in all required Shipping Address details (*).');
          return;
        }

        // Require Login or Sign-up before final order confirmation
        const isLoggedIn = localStorage.getItem('google_auth_logged_in') === 'true';
        if (!isLoggedIn) {
          alert('🔐 Account Login or Sign Up required to complete your order!\n\nOpening Pilot Portal...');
          window.dispatchEvent(new CustomEvent('open-login-modal'));
          return;
        }

        const selectedPayRadio = document.querySelector('input[name="pay-method"]:checked') as HTMLInputElement;
        const payMethodVal = selectedPayRadio?.value || 'cod';

        const subtotal = hydrated.reduce((acc, cur) => acc + (cur.product.price * cur.quantity), 0);
        const gst = Math.round(subtotal * 0.18);
        const total = subtotal;

        const orderId = `#SKY-INV-2026-${Math.floor(1000 + Math.random() * 9000)}`;
        const awb = `#AWB-987${Math.floor(100000 + Math.random() * 900000)}`;
        const todayDate = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });

        const paymentLabel = payMethodVal === 'cod' ? 'CASH ON DELIVERY (COD)' : 'PAID (ONLINE)';
        const statusLabel = payMethodVal === 'cod' ? 'PENDING (COD UPON DELIVERY)' : 'PAID (ONLINE)';

        const orderObj: Record<string, any> = {
          orderId,
          date: todayDate,
          customer: { name, phone, email, address, city, state, pincode, gstin },
          items: hydrated,
          subtotal,
          gst,
          total,
          paymentMethod: paymentLabel,
          status: statusLabel,
          awb,
          shopifyCheckoutUrl: ''
        };

        // Save order to localStorage
        localStorage.setItem('skynodes_last_order', JSON.stringify(orderObj));
        
        try {
          const existingHistory = JSON.parse(localStorage.getItem('skynodes_orders_history') || '[]');
          localStorage.setItem('skynodes_orders_history', JSON.stringify([orderObj, ...existingHistory]));
        } catch (err) {}

        // Async sync to Shopify Storefront API to get official checkoutUrl
        let shopifyCheckoutUrl = `https://skynodesuav.myshopify.com/cart`;
        try {
          shopifyCheckoutUrl = await syncCartToShopifyStorefront(orderObj);
        } catch (err) {
          console.error('[Shopify Sync Warning]', err);
        }

        orderObj.shopifyCheckoutUrl = shopifyCheckoutUrl;
        localStorage.setItem('skynodes_last_order', JSON.stringify(orderObj));

        // Clear local cart
        saveCartToStorage([]);

        alert(`✅ Order ${orderId} Placed Successfully!\n\nRedirecting to your Official Tax Invoice Bill...`);
        window.location.href = '/invoice';
      });
    });
  </script>

</body>
</html>
