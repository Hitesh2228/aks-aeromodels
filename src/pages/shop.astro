---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import { PRODUCTS, CATEGORIES } from '../data/products';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop All Products | AKS Aeromodels</title>
  <meta name="description" content="Browse 43+ premium RC engines, Futaba transmitters, Seagull aeromodels, balsa wood sheets, and flight accessories." />
</head>
<body class="bellavita-shop-body">

  <Header />

  <!-- Shop Header Banner -->
  <div class="bellavita-shop-header">
    <div class="container">
      <h1 class="shop-page-title">ALL PRODUCTS ({PRODUCTS.length})</h1>
      <p class="shop-page-subtitle">Explore contest-grade RC engines, transmitters, aeromodels, and balsa wood</p>
    </div>
  </div>

  <main class="container shop-layout-container">
    
    <!-- Left Sidebar Filters -->
    <aside class="shop-filter-sidebar">
      
      <!-- Category Filter -->
      <div class="filter-group">
        <h3 class="filter-title">CATEGORIES</h3>
        <ul class="category-filter-list">
          <li>
            <button class="cat-filter-btn active" data-cat="all">
              <span>All Products</span> <strong>({PRODUCTS.length})</strong>
            </button>
          </li>
          {CATEGORIES.map(cat => {
            const count = PRODUCTS.filter(p => p.category === cat.id).length;
            return (
              <li>
                <button class="cat-filter-btn" data-cat={cat.id}>
                  <span>{cat.label}</span> <strong>({count})</strong>
                </button>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Price Range Filter -->
      <div class="filter-group">
        <h3 class="filter-title">MAX PRICE RANGE</h3>
        <div class="price-slider-box">
          <label for="price-slider" id="price-slider-label">Max Price: ₹85,000</label>
          <input type="range" id="price-slider" min="500" max="85000" step="500" value="85000" class="range-slider" />
        </div>
      </div>

      <!-- Stock Availability Filter -->
      <div class="filter-group">
        <h3 class="filter-title">AVAILABILITY</h3>
        <label class="stock-checkbox-label">
          <input type="checkbox" id="instock-only" checked /> In Stock Only
        </label>
      </div>
    </aside>

    <!-- Main Products Area -->
    <section class="shop-main-content">
      
      <!-- Top Action Bar -->
      <div class="shop-action-bar">
        <div class="results-text" id="results-count-text">
          Showing <strong>{PRODUCTS.length}</strong> items
        </div>

        <div class="sort-box">
          <label for="sort-select">Sort By:</label>
          <select id="sort-select" class="sort-select">
            <option value="featured">Featured & Bestsellers</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="rating">Highest Rated</option>
          </select>
        </div>
      </div>

      <!-- Product Cards Grid (Explicit CSS Grid with Clean Column Layout) -->
      <div class="catalog-grid" id="catalog-products-grid">
        {PRODUCTS.map(product => (
          <article 
            class="catalog-product-card catalog-item" 
            data-category={product.category} 
            data-price={product.price} 
            data-rating={product.rating} 
            data-name={product.name.toLowerCase()}
          >
            <div class="card-image-box">
              {product.isBestseller && <span class="badge-bestseller">BESTSELLER</span>}
              {product.discountBadge && <span class="badge-offer">{product.discountBadge}</span>}
              <a href={`/product/${product.id}`} class="img-link">
                <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
              </a>
            </div>

            <div class="card-content-box">
              <div class="cat-tag-sub">{product.categoryLabel.toUpperCase()}</div>
              <h2 class="card-product-title">
                <a href={`/product/${product.id}`}>{product.name}</a>
              </h2>

              <div class="rating-row">
                <span class="stars">★ {product.rating}</span>
                <span class="reviews">({product.reviewsCount} Reviews)</span>
              </div>

              <div class="price-row">
                <span class="current-price">₹{product.price.toLocaleString('en-IN')}</span>
                <span class="old-price">₹{product.originalPrice.toLocaleString('en-IN')}</span>
              </div>

              <button class="btn-add-cart add-to-cart-btn" data-id={product.id}>
                ADD TO CART
              </button>
            </div>
          </article>
        ))}
      </div>

    </section>

  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-shop-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .bellavita-shop-header {
      background: #f3eee7;
      border-bottom: 1px solid #e6e0d5;
      padding: 2.5rem 0;
      text-align: center;
    }
    .shop-page-title {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: #1a1a1a;
      margin-bottom: 0.4rem;
    }
    .shop-page-subtitle {
      font-size: 0.95rem;
      color: #666666;
    }

    .shop-layout-container {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 2.5rem;
      padding: 3rem 1.25rem 5rem;
    }

    /* Sidebar Filters */
    .shop-filter-sidebar {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 1.75rem;
      height: fit-content;
    }
    .filter-group {
      margin-bottom: 2rem;
    }
    .filter-group:last-child {
      margin-bottom: 0;
    }
    .filter-title {
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #3b0811;
      border-bottom: 1.5px solid #e6e0d5;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }

    .category-filter-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .cat-filter-btn {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      color: #555555;
      padding: 0.5rem 0.65rem;
      border-radius: var(--radius-sm);
      transition: var(--transition-fast);
    }
    .cat-filter-btn:hover, .cat-filter-btn.active {
      background: #f3eee7;
      color: #3b0811;
      font-weight: 700;
    }

    .price-slider-box {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: #555555;
    }
    .range-slider {
      accent-color: #3b0811;
      cursor: pointer;
    }

    .stock-checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: #555555;
      cursor: pointer;
    }

    /* Main Area */
    .shop-action-bar {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.75rem;
    }
    .results-text {
      font-size: 0.85rem;
      color: #555555;
    }
    .sort-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: #555555;
    }
    .sort-select {
      background: #f9f7f2;
      border: 1px solid #d6cfc2;
      padding: 0.4rem 0.75rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      color: #1a1a1a;
      outline: none;
      cursor: pointer;
    }

    /* Grid & Cards (Clean Vertical Card Column Fix) */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.75rem;
    }

    .catalog-product-card {
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition-smooth);
    }
    .catalog-product-card.is-hidden {
      display: none !important;
    }
    .catalog-product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      border-color: #1a1a1a;
    }

    .card-image-box {
      position: relative;
      width: 100%;
      padding-top: 75%; /* 4:3 Aspect Ratio */
      background: #ffffff;
      overflow: hidden;
    }
    .img-link {
      position: absolute;
      inset: 0;
      display: block;
    }
    .product-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .catalog-product-card:hover .product-img {
      transform: scale(1.05);
    }

    .badge-bestseller {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      background: #eab308;
      color: #000;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 2px;
      z-index: 2;
    }
    .badge-offer {
      position: absolute;
      bottom: 0.75rem;
      left: 0.75rem;
      background: #e6f7f5;
      color: #14b8a6;
      border: 1px solid rgba(20, 184, 166, 0.3);
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 2px;
      z-index: 2;
    }

    .card-content-box {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .cat-tag-sub {
      font-size: 0.65rem;
      color: #777777;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
    }
    .card-product-title {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.35;
      color: #1a1a1a;
      margin-bottom: 0.6rem;
      height: 2.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-product-title a:hover {
      color: #3b0811;
    }

    .rating-row {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      margin-bottom: 0.85rem;
    }
    .stars {
      color: #f59e0b;
      font-weight: 700;
    }
    .reviews {
      color: #666666;
      font-size: 0.75rem;
    }

    .price-row {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 1.25rem;
    }
    .current-price {
      font-size: 1.15rem;
      font-weight: 800;
      color: #1a1a1a;
      font-family: var(--font-display);
    }
    .old-price {
      font-size: 0.85rem;
      color: #888888;
      text-decoration: line-through;
    }

    .btn-add-cart {
      margin-top: auto;
      background: #1a1a1a;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.8rem;
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: var(--transition-fast);
      width: 100%;
    }
    .btn-add-cart:hover {
      background: #3b0811;
      transform: translateY(-2px);
    }

    @media (max-width: 900px) {
      .shop-layout-container {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { addToCart } from '../lib/cartStore';

    document.addEventListener('DOMContentLoaded', () => {
      const items = Array.from(document.querySelectorAll('.catalog-item')) as HTMLElement[];
      const catBtns = document.querySelectorAll('.cat-filter-btn');
      const priceSlider = document.getElementById('price-slider') as HTMLInputElement;
      const priceLabel = document.getElementById('price-slider-label');
      const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
      const gridContainer = document.getElementById('catalog-products-grid');
      const resultsText = document.getElementById('results-count-text');

      let currentCat = 'all';
      let maxPrice = 85000;

      const urlParams = new URLSearchParams(window.location.search);
      const categoryParam = urlParams.get('category');
      const searchQuery = urlParams.get('q')?.toLowerCase() || '';

      if (categoryParam) {
        currentCat = categoryParam;
        catBtns.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-cat') === currentCat);
        });
      }

      function sortDOMItems(sortVal: string) {
        if (!gridContainer) return;
        const sorted = [...items].sort((a, b) => {
          const priceA = parseInt(a.getAttribute('data-price') || '0', 10);
          const priceB = parseInt(b.getAttribute('data-price') || '0', 10);
          const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
          const ratingB = parseFloat(b.getAttribute('data-rating') || '0');

          if (sortVal === 'price-low') return priceA - priceB;
          if (sortVal === 'price-high') return priceB - priceA;
          if (sortVal === 'rating') return ratingB - ratingA;
          return 0;
        });

        sorted.forEach(el => gridContainer.appendChild(el));
      }

      function filterAndSort() {
        let visibleCount = 0;

        items.forEach(item => {
          const itemCat = item.getAttribute('data-category');
          const itemPrice = parseInt(item.getAttribute('data-price') || '0', 10);
          const itemName = item.getAttribute('data-name') || '';

          const matchesCat = currentCat === 'all' || itemCat === currentCat;
          const matchesPrice = itemPrice <= maxPrice;
          const matchesSearch = !searchQuery || itemName.includes(searchQuery);

          if (matchesCat && matchesPrice && matchesSearch) {
            item.classList.remove('is-hidden');
            visibleCount++;
          } else {
            item.classList.add('is-hidden');
          }
        });

        if (resultsText) {
          resultsText.innerHTML = `Showing <strong>${visibleCount}</strong> items`;
        }
      }

      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCat = btn.getAttribute('data-cat') || 'all';
          filterAndSort();
        });
      });

      priceSlider?.addEventListener('input', () => {
        maxPrice = parseInt(priceSlider.value, 10);
        if (priceLabel) priceLabel.textContent = `Max Price: ₹${maxPrice.toLocaleString('en-IN')}`;
        filterAndSort();
      });

      sortSelect?.addEventListener('change', () => {
        sortDOMItems(sortSelect.value);
        filterAndSort();
      });

      filterAndSort();

      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) addToCart(id, 1);
        });
      });
    });
  </script>

</body>
</html>
