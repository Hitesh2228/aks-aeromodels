---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import { PRODUCTS as staticProducts, CATEGORIES } from '../data/products';
import { getAllShopifyProducts, mapShopifyToProduct } from '../lib/shopify';
import '../styles/global.css';

const shopifyProducts = await getAllShopifyProducts();
const PRODUCTS = (shopifyProducts && shopifyProducts.length >= 5)
  ? shopifyProducts.map((sp, idx) => mapShopifyToProduct(sp, idx))
  : staticProducts;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop All Products | SKYNODESUAV</title>
  <meta name="description" content="Browse 43+ premium contest grade RC engines, Futaba transmitters, Seagull aeromodels, balsa wood sheets, and flight accessories." />
</head>
<body class="bellavita-shop-body">

  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-strip" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>›</span> <span class="active">Shop All Products</span>
    </div>
  </nav>

  <main class="container pdf-shop-container reveal-on-scroll">
    
    <!-- Top Title & Sort Action Row -->
    <div class="shop-title-action-row">
      <div>
        <h1 class="shop-pdf-title">Shop All Products</h1>
        <p class="shop-pdf-count">{PRODUCTS.length} items available in stock</p>
      </div>

      <div class="shop-right-actions">
        <div class="sort-select-wrap">
          <label for="sort-select" class="sort-lbl">Sort By:</label>
          <select id="sort-select" class="sort-dropdown">
            <option value="featured">Featured & Bestsellers</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="rating">Highest Rated</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills Strip (Exact PDF Page 1 Row) -->
    <div class="category-pills-strip">
      <button class="cat-pill-btn active" data-cat="all">All</button>
      {CATEGORIES.map(cat => (
        <button class="cat-pill-btn" data-cat={cat.id}>{cat.label}</button>
      ))}
    </div>

    <!-- 5-Column Product Cards Grid (Exact PDF Style & Perfectly Aligned Add To Cart Buttons) -->
    <div class="pdf-shop-grid-5" id="catalog-products-grid">
      {PRODUCTS.map(product => (
        <article 
          class="pdf-shop-card catalog-item" 
          data-category={product.category} 
          data-price={product.price} 
          data-rating={product.rating}
          data-bestseller={product.isBestseller ? 'true' : 'false'}
          data-crazydeal={product.isCrazyDeal ? 'true' : 'false'}
        >
          <!-- Image Stage -->
          <div class="card-img-stage">
            <div class="badges-wrapper">
              {product.isCrazyDeal && <span class="badge-tag crazy" style="background:#e63946; color:#ffffff;">🔥 CRAZY DEAL</span>}
              {product.isBestseller && <span class="badge-tag bestseller">BESTSELLER</span>}
              {product.isNewArrival && <span class="badge-tag new">NEW</span>}
            </div>
            {product.discountBadge && <span class="badge-tag offer">{product.discountBadge}</span>}
            <button type="button" class="btn-heart-wishlist wishlist-toggle-btn" data-id={product.id} aria-label="Add to Wishlist" title="Save to Wishlist">
              <svg class="heart-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
            <a href={`/product/${product.id}`}>
              <img src={product.image} alt={product.name} class="product-thumb-img" loading="lazy" />
            </a>
          </div>

          <!-- Card Content Body -->
          <div class="card-info-body">
            <div class="card-rating-line">
              <span class="star-badge-yellow">★ {product.rating}</span>
              <span class="rating-count-lbl">({product.reviewsCount})</span>
            </div>

            <div class="card-cat-label">{product.categoryLabel.toUpperCase()}</div>
            <h2 class="card-title-heading">
              <a href={`/product/${product.id}`}>{product.name}</a>
            </h2>

            <div class="saving-green-tag">
              (Saving ₹{(product.originalPrice - product.price).toLocaleString('en-IN')})
            </div>

            <div class="price-row-line">
              <span class="price-now">₹{product.price.toLocaleString('en-IN')}.00</span>
              <span class="price-was">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
            </div>

            <!-- ADD TO CART Button (100% Horizontally Aligned in 1 Line Across Grid Row) -->
            <button class="pdf-cart-btn-black add-to-cart-btn" data-id={product.id}>
              Add To Cart
            </button>
          </div>
        </article>
      ))}
    </div>

  </main>

  <CartDrawer />
  <MobileBottomNav />
  <Footer />

  <style>
    :global(body.bellavita-shop-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    /* Minimal Breadcrumb Strip */
    .breadcrumb-strip {
      background: transparent;
      padding: 1.25rem 0 0.5rem;
      font-size: 0.78rem;
      color: #777777;
    }
    .breadcrumb-strip a { color: #666666; text-decoration: none; }
    .breadcrumb-strip a:hover { color: #111111; }
    .breadcrumb-strip span { margin: 0 0.35rem; color: #aaaaaa; }
    .breadcrumb-strip .active { color: #111111; font-weight: 600; }

    /* Shop Container with Proper PDF Left/Right Margins */
    .pdf-shop-container {
      max-width: 1280px !important;
      margin: 0 auto !important;
      padding: 1rem 2rem 6rem !important;
    }

    /* Title & Sort Action Row */
    .shop-title-action-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.75rem;
    }
    .shop-pdf-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 600;
      color: #1a1a1a;
      letter-spacing: -0.01em;
    }
    .shop-pdf-count {
      font-size: 0.82rem;
      color: #666666;
    }
    .sort-select-wrap {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
    }
    .sort-lbl { color: #666666; font-weight: 600; }
    .sort-dropdown {
      background: #ffffff;
      border: 1px solid #d6cfc2;
      border-radius: 4px;
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
      color: #1a1a1a;
      outline: none;
      cursor: pointer;
    }

    /* Category Filter Pills Strip (Exact PDF Page 1) */
    .category-pills-strip {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      margin-bottom: 2.25rem;
    }
    .cat-pill-btn {
      padding: 0.5rem 1.15rem;
      font-size: 0.82rem;
      font-weight: 600;
      border-radius: 4px;
      border: 1px solid #d6cfc2;
      background: #ffffff;
      color: #1a1a1a;
      cursor: pointer;
      white-space: nowrap;
      transition: var(--transition-fast);
    }
    .cat-pill-btn:hover, .cat-pill-btn.active {
      background: #111111;
      color: #ffffff;
      border-color: #111111;
    }

    /* 5-Column Product Grid with 100% Horizontally Aligned Add To Cart Buttons */
    .pdf-shop-grid-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
    }
    .pdf-shop-card {
      background: #ffffff;
      border: 1px solid #eaeaea;
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 100%;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pdf-shop-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      border-color: #d1d1d1;
    }

    /* Bellavita Soft Off-White Framed Image Stage */
    .card-img-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #f4f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.1rem;
      box-sizing: border-box;
    }
    .product-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.05));
      transition: transform 0.3s ease;
    }
    .pdf-shop-card:hover .product-thumb-img {
      transform: scale(1.04);
    }

    .badges-wrapper {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      align-items: flex-start;
      z-index: 2;
    }

    .badge-tag {
      font-size: 0.62rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 3px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      display: inline-block;
    }
    .badge-tag.bestseller { background: #dfab85; color: #ffffff; }
    .badge-tag.new { background: #67c5a9; color: #ffffff; }
    .badge-tag.offer { position: absolute; top: 0.6rem; right: 2.8rem; background: #67c5a9; color: #ffffff; z-index: 2; }

    .btn-heart-wishlist {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 5;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .btn-heart-wishlist:hover {
      transform: scale(1.1);
      background: #ffffff;
    }
    .btn-heart-wishlist.active svg {
      fill: #dc2626;
      stroke: #dc2626;
    }

    /* Card Content Body */
    .card-info-body {
      padding: 0.9rem 1rem 1.1rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-rating-line {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.4rem;
    }
    .star-badge-yellow {
      color: #f59e0b;
      font-size: 0.76rem;
      font-weight: 700;
    }
    .rating-count-lbl { font-size: 0.74rem; color: #777777; }

    .card-cat-label { font-size: 0.65rem; color: #888888; font-weight: 600; margin-bottom: 0.25rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .card-title-heading {
      font-size: 0.86rem;
      font-weight: 600;
      color: #1a1a1a;
      line-height: 1.35;
      margin-bottom: 0.4rem;
      height: 2.3rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-family: var(--font-main);
    }
    .card-title-heading a { color: inherit; text-decoration: none; }
    .card-title-heading a:hover { color: #111111; }

    .saving-green-tag {
      font-size: 0.72rem;
      font-weight: 600;
      color: #059669;
      margin-bottom: 0.4rem;
    }

    .price-row-line {
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
      margin-bottom: 0.85rem;
      margin-top: auto;
    }
    .price-now { font-size: 1.05rem; font-weight: 700; color: #111111; }
    .price-was { font-size: 0.82rem; color: #999999; text-decoration: line-through; }

    .pdf-cart-btn-black {
      width: 100%;
      background: #111111;
      color: #ffffff;
      border: none;
      padding: 0.7rem;
      border-radius: 3px;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: background 0.2s ease;
      text-transform: uppercase;
    }
    .pdf-cart-btn-black:hover {
      background: #333333;
    }


    @media (max-width: 1100px) {
      .pdf-shop-grid-5 { grid-template-columns: repeat(3, 1fr); }
      .explore-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 700px) {
      .pdf-shop-grid-5 { grid-template-columns: repeat(2, 1fr); }
      .explore-grid { grid-template-columns: repeat(2, 1fr); }
      .pdf-shop-container { padding: 1rem 1rem 4rem !important; }
    }
  </style>

<script id="shop-products-json" type="application/json" is:inline set:html={JSON.stringify(PRODUCTS)}></script>

<script>
  import { addToCart, registerProductsCache } from '../lib/cartStore';
  import { toggleWishlist, isInWishlist } from '../lib/wishlistStore';

  function initShopControls() {
    const jsonEl = document.getElementById('shop-products-json');
    let productsList: any[] = [];
    if (jsonEl?.textContent) {
      try {
        productsList = JSON.parse(jsonEl.textContent);
        registerProductsCache(productsList);
      } catch (e) {}
    }

    // Sync Wishlist Hearts
    const heartBtns = document.querySelectorAll('.wishlist-toggle-btn');
    heartBtns.forEach(btn => {
      const pId = btn.getAttribute('data-id');
      if (pId && isInWishlist(pId)) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!pId) return;
        const targetProd = productsList.find((p: any) => p.id === pId);
        if (targetProd) {
          const isAdded = toggleWishlist(targetProd);
          if (isAdded) btn.classList.add('active');
          else btn.classList.remove('active');
        }
      });
    });

    const pills = document.querySelectorAll('.cat-pill-btn');
    const products = document.querySelectorAll('.catalog-item');
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
    const grid = document.getElementById('catalog-products-grid');

    function filterCategory(cat: string) {
      pills.forEach(p => {
        if (p.getAttribute('data-cat') === cat) p.classList.add('active');
        else p.classList.remove('active');
      });

      products.forEach(prod => {
        const itemCat = prod.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          (prod as HTMLElement).style.display = 'flex';
        } else {
          (prod as HTMLElement).style.display = 'none';
        }
      });
    }

    pills.forEach(p => {
      p.addEventListener('click', () => {
        const cat = p.getAttribute('data-cat');
        if (cat) filterCategory(cat);
      });
    });

    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    const urlFilter = params.get('filter');
    const urlSearch = params.get('search')?.toLowerCase().trim();

    if (urlSearch) {
      pills.forEach(p => p.classList.remove('active'));
      products.forEach(prod => {
        const title = (prod.querySelector('.catalog-title')?.textContent || '').toLowerCase();
        const catLabel = (prod.querySelector('.cat-tag')?.textContent || '').toLowerCase();
        const category = (prod.getAttribute('data-category') || '').toLowerCase();
        
        if (title.includes(urlSearch) || catLabel.includes(urlSearch) || category.includes(urlSearch)) {
          (prod as HTMLElement).style.display = 'flex';
        } else {
          (prod as HTMLElement).style.display = 'none';
        }
      });

      const headerTitleEl = document.querySelector('.shop-hero-title');
      if (headerTitleEl) {
        headerTitleEl.textContent = `Search Results for "${params.get('search')}"`;
      }
    } else if (urlFilter === 'crazy-deals') {
      pills.forEach(p => p.classList.remove('active'));
      products.forEach(prod => {
        const isCrazy = prod.getAttribute('data-crazydeal') === 'true';
        (prod as HTMLElement).style.display = isCrazy ? 'flex' : 'none';
      });
      const headerTitleEl = document.querySelector('.shop-hero-title');
      if (headerTitleEl) {
        headerTitleEl.textContent = `🔥 Exclusive Crazy Deals`;
      }
    } else if (urlFilter === 'bestsellers') {
      pills.forEach(p => p.classList.remove('active'));
      products.forEach(prod => {
        const isBestseller = prod.getAttribute('data-bestseller') === 'true';
        (prod as HTMLElement).style.display = isBestseller ? 'flex' : 'none';
      });
      const headerTitleEl = document.querySelector('.shop-hero-title');
      if (headerTitleEl) {
        headerTitleEl.textContent = `⭐ Best Selling Products`;
      }
    } else if (urlCat) {
      filterCategory(urlCat);
    }

    sortSelect?.addEventListener('change', () => {
      const val = sortSelect.value;
      const itemsArr = Array.from(products);

      itemsArr.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
        const ratingB = parseFloat(b.getAttribute('data-rating') || '0');
        const bestA = a.getAttribute('data-bestseller') === 'true' ? 1 : 0;
        const bestB = b.getAttribute('data-bestseller') === 'true' ? 1 : 0;

        if (val === 'price-low') return priceA - priceB;
        if (val === 'price-high') return priceB - priceA;
        if (val === 'rating') return ratingB - ratingA;
        return bestB - bestA;
      });

      itemsArr.forEach(item => grid?.appendChild(item));
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (id) addToCart(id, 1);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShopControls);
  } else {
    initShopControls();
  }
  document.addEventListener('astro:page-load', initShopControls);
</script>

</body>
</html>
