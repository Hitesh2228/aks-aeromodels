---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import Footer from '../components/Footer.astro';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import FaviconAndSeoHead from '../components/FaviconAndSeoHead.astro';
import { CATEGORIES } from '../data/products';
import { getCombinedProducts } from '../lib/shopify';
import '../styles/global.css';

const PRODUCTS = await getCombinedProducts();

// Google E-Commerce Category & Collection Schema (ItemList)
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "SKYNODES UAV Official Aeromodelling & Scale UAV Catalog",
  "description": "Authorized online store for O.S. Nitro Engines, DLE Gas Engines, Futaba 2.4GHz Transmitters, Seagull Aeromodels, and AAA Balsa Wood in India.",
  "numberOfItems": PRODUCTS.length,
  "itemListElement": PRODUCTS.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Product",
      "name": item.name,
      "url": `https://www.skynodesuav.in/product/${item.id}`,
      "image": item.image.startsWith('http') ? item.image : `https://www.skynodesuav.in${item.image}`,
      "offers": {
        "@type": "Offer",
        "price": item.price,
        "priceCurrency": "INR",
        "availability": item.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
      }
    }
  }))
};

Astro.response.headers.set('X-Robots-Tag', 'all');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <FaviconAndSeoHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop All Aeromodelling & Scale UAV Products Online India | Best Price | SKYNODES UAV</title>
  <meta name="description" content="Buy authentic O.S. Nitro Engines, DLE Gas Engines, Futaba 2.4GHz Transmitters, Seagull ARF Scale Aeromodels, and AAA Balsa Wood Sheets online in India at SKYNODES UAV. Fast express shipping & GST tax invoice." />
  <meta name="keywords" content="buy RC airplane engine India, O.S. Max nitro engine, DLE gas engine, Futaba 6K transmitter, Seagull models ARF India, balsa wood sheet 100x1000mm, aeromodelling accessories Nashik, RC hobby shop India, SKYNODES UAV" />
  <link rel="canonical" href="https://www.skynodesuav.in/shop" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- OpenGraph Collection Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SKYNODES UAV" />
  <meta property="og:title" content="Shop All Aeromodelling & Scale UAV Products Online India | SKYNODES UAV" />
  <meta property="og:description" content="Browse 45+ premium contest grade RC engines, Futaba transmitters, Seagull aeromodels, balsa wood sheets, and flight accessories with official warranty across India." />
  <meta property="og:url" content="https://www.skynodesuav.in/shop" />
  <meta property="og:image" content="https://www.skynodesuav.in/images/products/sea-1-1.jpg" />

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Shop All Aeromodelling & Scale UAV Products Online India | SKYNODES UAV" />
  <meta name="twitter:description" content="Browse 45+ premium contest grade RC engines, Futaba transmitters, Seagull aeromodels, balsa wood sheets, and flight accessories with official warranty across India." />
  <meta name="twitter:image" content="https://www.skynodesuav.in/images/products/sea-1-1.jpg" />

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</head>
<body class="bellavita-shop-body">
  <GoogleTagManagerBody />

  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-strip" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>›</span> <span class="active">Shop All Products</span>
    </div>
  </nav>

  <main class="container pdf-shop-container reveal-on-scroll">
    
    <!-- Top Title & Sort Action Row -->
    <div class="shop-title-action-row">
      <div>
        <h1 class="shop-pdf-title">Shop All Products</h1>
        <p class="shop-pdf-count">{PRODUCTS.length} items available in stock</p>
      </div>

      <div class="shop-right-actions">
        <div class="sort-select-wrap">
          <label for="sort-select" class="sort-lbl">Sort By:</label>
          <select id="sort-select" class="sort-dropdown">
            <option value="featured">Featured & Bestsellers</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="rating">Highest Rated</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills Strip (Exact PDF Page 1 Row) -->
    <div class="category-pills-strip">
      <button class="cat-pill-btn active" data-cat="all">All</button>
      {CATEGORIES.map(cat => (
        <button class="cat-pill-btn" data-cat={cat.id}>{cat.label}</button>
      ))}
    </div>

    <!-- 5-Column Product Cards Grid (Exact PDF Style & Perfectly Aligned Add To Cart Buttons) -->
    <div class="pdf-shop-grid-5" id="catalog-products-grid">
      {PRODUCTS.map(product => (
        <article 
          class="pdf-shop-card catalog-item" 
          data-id={product.id}
          data-handle={product.handle || product.id}
          data-category={product.category} 
          data-price={product.price} 
          data-rating={product.rating}
          data-bestseller={product.isBestseller ? 'true' : 'false'}
          data-crazydeal={product.isCrazyDeal ? 'true' : 'false'}
        >
          <!-- Image Stage -->
          <div class="card-img-stage">
            <div class="badges-wrapper">
              {product.isCrazyDeal && <span class="badge-tag crazy" style="background:#e63946; color:#ffffff;">🔥 CRAZY DEAL</span>}
              {product.isBestseller && <span class="badge-tag bestseller">BESTSELLER</span>}
              {product.isNewArrival && <span class="badge-tag new">NEW</span>}
            </div>
            {product.discountBadge && <span class="badge-tag offer">{product.discountBadge}</span>}
            <button type="button" class="btn-heart-wishlist wishlist-toggle-btn" data-id={product.id} aria-label="Add to Wishlist" title="Save to Wishlist">
              <svg class="heart-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
            <button type="button" class="btn-share-product" data-url={`/product/${product.id}`} data-title={product.name} data-text={`Check out ${product.name} on SKYNODES UAV!`} aria-label="Share Product" title="Share Product">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </button>
            <a href={`/product/${product.id}`}>
              <img src={product.image} alt={product.name} class="product-thumb-img" loading="lazy" />
            </a>
          </div>

          <!-- Card Content Body -->
          <div class="card-info-body">
            <div class="card-rating-line">
              <span class="star-badge-yellow">★ {product.rating}</span>
              <span class="rating-count-lbl">({product.reviewsCount})</span>
            </div>

            <div class="card-cat-label">{product.categoryLabel.toUpperCase()}</div>
            <h2 class="card-title-heading">
              <a href={`/product/${product.id}`}>{product.name}</a>
            </h2>

            <div class="saving-green-tag">
              (Saving ₹{(product.originalPrice - product.price).toLocaleString('en-IN')})
            </div>

            <div class="price-row-line">
              <span class="price-now">₹{product.price.toLocaleString('en-IN')}.00</span>
              <span class="price-was">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
            </div>

            <!-- ADD TO CART Button (100% Horizontally Aligned in 1 Line Across Grid Row) -->
            <button 
              class={`pdf-cart-btn-black add-to-cart-btn ${!product.inStock ? 'is-sold-out' : ''}`} 
              data-id={product.id}
              disabled={!product.inStock}
            >
              {product.inStock ? 'Add To Cart' : 'Sold Out'}
            </button>
          </div>
        </article>
      ))}
    </div>

    <!-- E-Commerce Buyer's Guide & SEO Directory Section (Semantic Keyword Authority) -->
    <section class="shop-seo-guide-section" aria-label="Aeromodelling Buyer Guide">
      <div class="shop-seo-card">
        <h2 class="shop-seo-title">India’s Premier Destination for Scale Aeromodels, RC Engines & Balsa Wood</h2>
        <p class="shop-seo-lead">
          Welcome to <strong>SKYNODES UAV</strong>, the authorized Indian distributor and official specialist store for high-performance aeromodelling, drone engineering kits, and RC pilot equipment. Whether you are a club novice assembling your first high-wing trainer or a competitive 3D aerobatic pilot building a giant scale IMAC model, we supply 100% authentic equipment backed by official manufacturer warranties, formal GST input tax credit (ITC) invoicing, and express pan-India dispatch from our Nashik facility.
        </p>

        <div class="shop-seo-grid">
          <div class="shop-seo-col">
            <h3>⚡ Nitro & Gasoline RC Engines</h3>
            <p>
              Explore legendary Japanese <strong>O.S. Max 2-stroke nitro engines</strong> (.46 AX II, .65 AX) engineered with Advanced Bimetallic Liner (ABL) technology and 40K carburetors for rock-solid idle and high power-to-weight ratio. For giant scale aircraft, we stock <strong>DLE gasoline engines</strong> (20cc, 35RA, 65cc) equipped with electronic auto-advancing CDI ignition, Walbro carburetors, and rear exhaust routing.
            </p>
          </div>
          <div class="shop-seo-col">
            <h3>✈️ Seagull Models ARF Scale Airplanes</h3>
            <p>
              Seagull Models Almost-Ready-to-Fly (ARF) airframes are hand-built from laser-cut balsa and aviation plywood, factory-covered in genuine German <strong>Oracover</strong> film. From stable novice trainers like the <strong>Boomerang V3</strong> and <strong>Arising Star V2</strong> to extreme 3D aerobatic airframes like the <strong>Decathlon 122" V2</strong> and <strong>Edge 540</strong>.
            </p>
          </div>
          <div class="shop-seo-col">
            <h3>📡 Futaba 2.4GHz Radios & Telemetry</h3>
            <p>
              Command your models with unmatched signal reliability using genuine <strong>Futaba computerized transmitters</strong> (Futaba 6K, TM-18) and high-sensitivity <strong>T-FHSS / FASSTest telemetry receivers</strong> (R3006SB, R3008SB) featuring digital S.BUS / S.BUS2 multi-bus wiring and real-time battery voltage monitoring.
            </p>
          </div>
          <div class="shop-seo-col">
            <h3>🪵 AAA Contest Grade Balsa Wood Sheets</h3>
            <p>
              Premium AAA contest grade balsa wood sheets (100mm width x 1000mm length) available in thicknesses from <strong>2mm to 15mm</strong>. Hand-sorted for straight uniform grain (6-12 lbs/cu.ft density), calibrated to tight aero tolerances for scratch builders, university aero-design teams, and UAV prototypes.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <MobileBottomNav />
  <Footer />

  <style>
    :global(body.bellavita-shop-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    /* Minimal Breadcrumb Strip */
    .breadcrumb-strip {
      background: transparent;
      padding: 1.25rem 0 0.5rem;
      font-size: 0.78rem;
      color: #777777;
    }
    .breadcrumb-strip a { color: #666666; text-decoration: none; }
    .breadcrumb-strip a:hover { color: #111111; }
    .breadcrumb-strip span { margin: 0 0.35rem; color: #aaaaaa; }
    .breadcrumb-strip .active { color: #111111; font-weight: 600; }

    /* Shop Container with Proper PDF Left/Right Margins */
    .pdf-shop-container {
      max-width: 1280px !important;
      margin: 0 auto !important;
      padding: 1rem 2rem 6rem !important;
    }

    /* Title & Sort Action Row */
    .shop-title-action-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.75rem;
    }
    .shop-pdf-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 600;
      color: #1a1a1a;
      letter-spacing: -0.01em;
    }
    .shop-pdf-count {
      font-size: 0.82rem;
      color: #666666;
    }
    .sort-select-wrap {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
    }
    .sort-lbl { color: #666666; font-weight: 600; }
    .sort-dropdown {
      background: #ffffff;
      border: 1px solid #d6cfc2;
      border-radius: 4px;
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
      color: #1a1a1a;
      outline: none;
      cursor: pointer;
    }

    /* Category Filter Pills Strip (Exact PDF Page 1) */
    .category-pills-strip {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      margin-bottom: 2.25rem;
    }
    .cat-pill-btn {
      padding: 0.5rem 1.15rem;
      font-size: 0.82rem;
      font-weight: 600;
      border-radius: 4px;
      border: 1px solid #d6cfc2;
      background: #ffffff;
      color: #1a1a1a;
      cursor: pointer;
      white-space: nowrap;
      transition: var(--transition-fast);
    }
    .cat-pill-btn:hover, .cat-pill-btn.active {
      background: #111111;
      color: #ffffff;
      border-color: #111111;
    }

    /* 5-Column Product Grid with 100% Horizontally Aligned Add To Cart Buttons */
    .pdf-shop-grid-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
    }
    .pdf-shop-card {
      background: #ffffff;
      border: 1px solid #eaeaea;
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 100%;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pdf-shop-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      border-color: #d1d1d1;
    }

    /* Bellavita Soft Off-White Framed Image Stage */
    .card-img-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #f4f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.1rem;
      box-sizing: border-box;
    }
    .product-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.05));
      transition: transform 0.3s ease;
    }
    .pdf-shop-card:hover .product-thumb-img {
      transform: scale(1.04);
    }

    .badges-wrapper {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      align-items: flex-start;
      z-index: 2;
    }

    .badge-tag {
      font-size: 0.62rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 3px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      display: inline-block;
    }
    .badge-tag.bestseller { background: #dfab85; color: #ffffff; }
    .badge-tag.new { background: #67c5a9; color: #ffffff; }
    .badge-tag.offer { position: absolute; top: 0.6rem; right: 2.8rem; background: #67c5a9; color: #ffffff; z-index: 2; }

    .btn-heart-wishlist {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 5;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .btn-heart-wishlist:hover {
      transform: scale(1.1);
      background: #ffffff;
    }
    .btn-heart-wishlist.active svg {
      fill: #dc2626;
      stroke: #dc2626;
    }

    .btn-share-product {
      position: absolute;
      top: 2.8rem;
      right: 0.6rem;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 5;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .btn-share-product:hover {
      transform: scale(1.1);
      background: #ffffff;
      border-color: #3b0811;
    }

    /* Card Content Body */
    .card-info-body {
      padding: 0.9rem 1rem 1.1rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-rating-line {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.4rem;
    }
    .star-badge-yellow {
      color: #f59e0b;
      font-size: 0.76rem;
      font-weight: 700;
    }
    .rating-count-lbl { font-size: 0.74rem; color: #777777; }

    .card-cat-label { font-size: 0.65rem; color: #888888; font-weight: 600; margin-bottom: 0.25rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .card-title-heading {
      font-size: 0.86rem;
      font-weight: 600;
      color: #1a1a1a;
      line-height: 1.35;
      margin-bottom: 0.4rem;
      height: 2.3rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-family: var(--font-main);
    }
    .card-title-heading a { color: inherit; text-decoration: none; }
    .card-title-heading a:hover { color: #111111; }

    .saving-green-tag {
      font-size: 0.72rem;
      font-weight: 600;
      color: #059669;
      margin-bottom: 0.4rem;
    }

    .price-row-line {
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
      margin-bottom: 0.85rem;
      margin-top: auto;
    }
    .price-now { font-size: 1.05rem; font-weight: 700; color: #111111; }
    .price-was { font-size: 0.82rem; color: #999999; text-decoration: line-through; }

    .pdf-cart-btn-black {
      width: 100%;
      background: #111111;
      color: #ffffff;
      border: none;
      padding: 0.7rem;
      border-radius: 3px;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: background 0.2s ease;
      text-transform: uppercase;
    }
    .pdf-cart-btn-black.is-sold-out {
      background: #888888 !important;
      cursor: not-allowed !important;
      opacity: 0.75;
    }
    .pdf-cart-btn-black:hover {
      background: #333333;
    }


    /* E-Commerce Buyer's Guide & SEO Section Styling */
    .shop-seo-guide-section {
      margin-top: 5rem;
      border-top: 1.5px solid #e6e0d5;
      padding-top: 3.5rem;
    }
    .shop-seo-card {
      background: #ffffff;
      border: 1px solid #e8e2d8;
      border-radius: 8px;
      padding: 2.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }
    .shop-seo-title {
      font-family: var(--font-display, serif);
      font-size: 1.45rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 1rem;
      letter-spacing: -0.01em;
    }
    .shop-seo-lead {
      font-size: 0.92rem;
      line-height: 1.75;
      color: #555555;
      margin-bottom: 2rem;
      max-width: 1050px;
    }
    .shop-seo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .shop-seo-col h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #3b0811;
      margin-bottom: 0.6rem;
    }
    .shop-seo-col p {
      font-size: 0.88rem;
      line-height: 1.65;
      color: #666666;
    }

    @media (max-width: 1100px) {
      .pdf-shop-grid-5 { grid-template-columns: repeat(3, 1fr); }
      .explore-grid { grid-template-columns: repeat(3, 1fr); }
      .shop-seo-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    }
    @media (max-width: 700px) {
      .pdf-shop-grid-5 { grid-template-columns: repeat(2, 1fr); }
      .explore-grid { grid-template-columns: repeat(2, 1fr); }
      .pdf-shop-container { padding: 1rem 1rem 4rem !important; }
      .shop-seo-card { padding: 1.5rem 1.25rem; }
      .shop-seo-title { font-size: 1.25rem; }
    }
  </style>

<script id="shop-products-json" type="application/json" is:inline set:html={JSON.stringify(PRODUCTS)}></script>

<script>
  import { addToCart, registerProductsCache } from '../lib/cartStore';
  import { toggleWishlist, isInWishlist } from '../lib/wishlistStore';
  import { initShareButtons } from '../lib/shareHelper';
  import { fetchLiveShopifyProducts } from '../lib/clientShopifySync';

  async function initShopControls() {
    const jsonEl = document.getElementById('shop-products-json');
    let productsList: any[] = [];
    if (jsonEl?.textContent) {
      try {
        productsList = JSON.parse(jsonEl.textContent);
        registerProductsCache(productsList);
      } catch (e) {}
    }

    // Sync Wishlist Hearts
    const heartBtns = document.querySelectorAll('.wishlist-toggle-btn');
    heartBtns.forEach(btn => {
      const pId = btn.getAttribute('data-id');
      if (pId && isInWishlist(pId)) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!pId) return;
        const targetProd = productsList.find((p: any) => p.id === pId);
        if (targetProd) {
          const isAdded = toggleWishlist(targetProd);
          if (isAdded) btn.classList.add('active');
          else btn.classList.remove('active');
        }
      });
    });

    const pills = document.querySelectorAll('.cat-pill-btn');
    const products = document.querySelectorAll('.catalog-item');
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
    const grid = document.getElementById('catalog-products-grid');

    function applyFiltering() {
      const params = new URLSearchParams(window.location.search);
      const urlCat = params.get('category');
      const urlFilter = params.get('filter');
      const urlSearch = params.get('search')?.toLowerCase().trim();
      const pageTitleEl = document.querySelector('.shop-pdf-title');
      const countEl = document.querySelector('.shop-pdf-count');

      let visibleCount = 0;

      if (urlSearch) {
        pills.forEach(p => p.classList.remove('active'));
        products.forEach(prod => {
          const title = (prod.querySelector('.card-title-heading')?.textContent || '').toLowerCase();
          const catLabel = (prod.querySelector('.card-cat-label')?.textContent || '').toLowerCase();
          const category = (prod.getAttribute('data-category') || '').toLowerCase();
          
          if (title.includes(urlSearch) || catLabel.includes(urlSearch) || category.includes(urlSearch)) {
            (prod as HTMLElement).style.display = 'flex';
            visibleCount++;
          } else {
            (prod as HTMLElement).style.display = 'none';
          }
        });

        if (pageTitleEl) pageTitleEl.textContent = `Search Results for "${params.get('search')}"`;
        if (countEl) countEl.textContent = `${visibleCount} items found`;
      } else if (urlFilter === 'crazy-deals') {
        pills.forEach(p => p.classList.remove('active'));
        products.forEach(prod => {
          const isCrazy = prod.getAttribute('data-crazydeal') === 'true';
          if (isCrazy) {
            (prod as HTMLElement).style.display = 'flex';
            visibleCount++;
          } else {
            (prod as HTMLElement).style.display = 'none';
          }
        });
        if (pageTitleEl) pageTitleEl.textContent = `🔥 Exclusive Crazy Deals`;
        if (countEl) countEl.textContent = `${visibleCount} deals available`;
      } else if (urlFilter === 'bestsellers') {
        pills.forEach(p => p.classList.remove('active'));
        products.forEach(prod => {
          const isBestseller = prod.getAttribute('data-bestseller') === 'true';
          if (isBestseller) {
            (prod as HTMLElement).style.display = 'flex';
            visibleCount++;
          } else {
            (prod as HTMLElement).style.display = 'none';
          }
        });
        if (pageTitleEl) pageTitleEl.textContent = `⭐ Best Selling Products`;
        if (countEl) countEl.textContent = `${visibleCount} bestsellers available`;
      } else if (urlCat && urlCat !== 'all') {
        filterCategory(urlCat);
      } else {
        products.forEach(prod => {
          (prod as HTMLElement).style.display = 'flex';
          visibleCount++;
        });
        if (countEl) countEl.textContent = `${visibleCount} items available in stock`;
      }
    }

    function filterCategory(cat: string) {
      let visibleCount = 0;
      pills.forEach(p => {
        if (p.getAttribute('data-cat') === cat) p.classList.add('active');
        else p.classList.remove('active');
      });

      products.forEach(prod => {
        const itemCat = prod.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          (prod as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (prod as HTMLElement).style.display = 'none';
        }
      });

      const countEl = document.querySelector('.shop-pdf-count');
      if (countEl) countEl.textContent = `${visibleCount} items available in stock`;
    }

    pills.forEach(p => {
      p.addEventListener('click', () => {
        const cat = p.getAttribute('data-cat');
        if (cat) filterCategory(cat);
      });
    });

    applyFiltering();

    sortSelect?.addEventListener('change', () => {
      const val = sortSelect.value;
      const itemsArr = Array.from(products);

      itemsArr.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
        const ratingB = parseFloat(b.getAttribute('data-rating') || '0');
        const bestA = a.getAttribute('data-bestseller') === 'true' ? 1 : 0;
        const bestB = b.getAttribute('data-bestseller') === 'true' ? 1 : 0;

        if (val === 'price-low') return priceA - priceB;
        if (val === 'price-high') return priceB - priceA;
        if (val === 'rating') return ratingB - ratingA;
        return bestB - bestA;
      });

      itemsArr.forEach(item => grid?.appendChild(item));
    });

    const liveProductsMap = new Map<string, any>();

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (id) {
          const target = liveProductsMap.get(id) || productsList.find((p: any) => p.id === id || p.handle === id) || id;
          addToCart(target, 1);
        }
      });
    });
    initShareButtons();

    try {
      const liveProducts = await fetchLiveShopifyProducts();
      if (liveProducts && liveProducts.length > 0) {
        liveProducts.forEach(lp => {
          liveProductsMap.set(lp.id, lp);
          if (lp.handle) liveProductsMap.set(lp.handle, lp);
          if (lp.safeId) liveProductsMap.set(lp.safeId, lp);

          let card = document.querySelector(
            `.catalog-item[data-id="${lp.id}"], .catalog-item[data-id="${lp.handle}"], .catalog-item[data-id="${lp.safeId}"], .catalog-item[data-handle="${lp.handle}"], .catalog-item[data-handle="${lp.id}"]`
          ) as HTMLElement | null;

          if (!card && lp.title) {
            const cleanLp = lp.title.toLowerCase().replace(/[^a-z0-9]/g, '');
            for (const c of document.querySelectorAll('.catalog-item')) {
              const cTitle = (c.querySelector('.card-title-heading a')?.textContent || '').toLowerCase().replace(/[^a-z0-9]/g, '');
              if (cTitle && (cTitle.includes(cleanLp) || cleanLp.includes(cTitle))) {
                card = c as HTMLElement;
                break;
              }
            }
          }

          if (card) {
            // Update attributes
            card.setAttribute('data-crazydeal', lp.isCrazyDeal ? 'true' : 'false');
            card.setAttribute('data-bestseller', lp.isBestseller ? 'true' : 'false');
            card.setAttribute('data-category', lp.category);
            card.setAttribute('data-price', lp.price.toString());

            // Update Stock Status on Card Button
            const cardCartBtn = card.querySelector('.add-to-cart-btn') as HTMLButtonElement | null;
            if (cardCartBtn && typeof lp.availableForSale === 'boolean') {
              if (lp.availableForSale) {
                cardCartBtn.removeAttribute('disabled');
                cardCartBtn.classList.remove('is-sold-out');
                cardCartBtn.textContent = 'Add To Cart';
              } else {
                cardCartBtn.setAttribute('disabled', 'true');
                cardCartBtn.classList.add('is-sold-out');
                cardCartBtn.textContent = 'Sold Out';
              }
            }

            // Update Title
            const titleLink = card.querySelector('.card-title-heading a');
            if (titleLink && lp.title) {
              titleLink.textContent = lp.title;
            }

            // Update Price
            const priceNowEl = card.querySelector('.price-now');
            if (priceNowEl && lp.price) {
              priceNowEl.textContent = `₹${lp.price.toLocaleString('en-IN')}.00`;
            }
            const priceWasEl = card.querySelector('.price-was');
            if (priceWasEl && lp.originalPrice) {
              priceWasEl.textContent = `₹${lp.originalPrice.toLocaleString('en-IN')}.00`;
            }
            const savingEl = card.querySelector('.saving-green-tag');
            if (savingEl && lp.originalPrice && lp.price) {
              const diff = lp.originalPrice - lp.price;
              if (diff > 0) {
                savingEl.textContent = `(Saving ₹${diff.toLocaleString('en-IN')})`;
              }
            }

            // Update Category Label
            const catLabelEl = card.querySelector('.card-cat-label');
            if (catLabelEl && lp.categoryLabel) {
              catLabelEl.textContent = lp.categoryLabel.toUpperCase();
            }

            // Update Badges Wrapper
            const badgesWrap = card.querySelector('.badges-wrapper');
            if (badgesWrap) {
              let crazyBadge = badgesWrap.querySelector('.badge-tag.crazy');
              if (lp.isCrazyDeal) {
                if (!crazyBadge) {
                  const span = document.createElement('span');
                  span.className = 'badge-tag crazy';
                  span.style.cssText = 'background:#e63946; color:#ffffff;';
                  span.textContent = '🔥 CRAZY DEAL';
                  badgesWrap.prepend(span);
                }
              } else if (crazyBadge) {
                crazyBadge.remove();
              }

              let bestsellerBadge = badgesWrap.querySelector('.badge-tag.bestseller');
              if (lp.isBestseller) {
                if (!bestsellerBadge) {
                  const span = document.createElement('span');
                  span.className = 'badge-tag bestseller';
                  span.textContent = 'BESTSELLER';
                  badgesWrap.appendChild(span);
                }
              } else if (bestsellerBadge) {
                bestsellerBadge.remove();
              }
            }
          }
        });

        // Re-apply filter so newly tagged crazy-deals or bestsellers display immediately
        applyFiltering();
      }
    } catch (err) {
      console.error('[Shop Sync Error]', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShopControls);
  } else {
    initShopControls();
  }
  document.addEventListener('astro:page-load', initShopControls);
</script>

</body>
</html>
