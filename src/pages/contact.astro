---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
import FaviconAndSeoHead from '../components/FaviconAndSeoHead.astro';

Astro.response.headers.set('X-Robots-Tag', 'all');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <FaviconAndSeoHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | SKYNODESUAV</title>
  <meta name="description" content="Get in touch with SKYNODESUAV technical support for engine tuning, radio pairing, or order inquiry." />
  <link rel="canonical" href="https://www.skynodesuav.in/contact" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact SKYNODES UAV Pilot Support & Distribution",
    "description": "Get in touch with SKYNODES UAV technical pilot support for engine break-in, Futaba radio binding, wingspan selection, or order status.",
    "url": "https://www.skynodesuav.in/contact",
    "mainEntity": {
      "@type": "LocalBusiness",
      "name": "SKYNODES UAV",
      "telephone": "+91-7722009120",
      "email": "support@skynodesuav.in",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Devlali Camp, Near HP Petrol Pump",
        "addressLocality": "Nashik",
        "addressRegion": "Maharashtra",
        "postalCode": "422502",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 19.9142,
        "longitude": 73.8340
      }
    }
  }
  </script>
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />

  <Header />

  <main class="container page-padding reveal-on-scroll">
    <div class="contact-grid">
      
      <!-- Contact Info Left (Monochrome SVG Line Art Icons) -->
      <div class="contact-info glass-panel">
        <h1 class="contact-title">GET IN TOUCH</h1>
        <p class="contact-subtitle">Have questions about an engine setup, wingspan compatibility, or your order?</p>

        <div class="info-blocks">
          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <strong>Office & Distribution Center</strong>
              <p>Devlali camp, near HP petrol pump, Maharashtra, India 422 502</p>
            </div>
          </div>

          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <strong>Phone & WhatsApp Support</strong>
              <p><a href="https://wa.me/917722009120" target="_blank" rel="noopener noreferrer" style="color: #3b0811; font-weight: 700;">+91-7722009120</a> (Mon-Sun: 10:00 AM - 7:00 PM)</p>
            </div>
          </div>

          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <strong>Email Inquiries</strong>
              <p><a href="mailto:support@skynodesuav.in" style="color: #3b0811; font-weight: 700;">support@skynodesuav.in</a></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Right -->
      <div class="contact-form-card glass-panel">
        <h2 class="form-title">SEND US A MESSAGE</h2>

        <!-- Luxury Success Box -->
        <div id="contact-success-box" class="contact-success-banner" style="display: none;">
          <div class="success-icon-badge">✓</div>
          <h3 class="success-title">MESSAGE RECEIVED</h3>
          <p class="success-desc">
            Your inquiry ticket <strong id="success-ticket-id">#SKY-INQ-1042</strong> has been logged into our Commander Operations desk.
          </p>
          <div class="success-timeline">
            <span>⏱️ Priority Response Time: <strong>Within 2 Hours</strong></span>
            <span>📱 Channel: <strong>WhatsApp / Phone Call</strong></span>
          </div>
          <button type="button" class="btn-send-another" id="btn-send-another">
            ← Send Another Query
          </button>
        </div>

        <form class="contact-form" id="contact-form">
          <div class="form-group">
            <label for="contact-name">Your Full Name *</label>
            <input type="text" id="contact-name" placeholder="e.g. Rahul Verma" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="contact-email">Email Address *</label>
            <input type="email" id="contact-email" placeholder="name@domain.com" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="contact-phone">Phone Number / WhatsApp *</label>
            <input type="tel" id="contact-phone" placeholder="+91 98765 43210" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="contact-topic">Inquiry Topic</label>
            <select id="contact-topic" class="form-input">
              <option value="Engine Technical Query">Engine Technical Query</option>
              <option value="Seagull ARF Specs">Seagull ARF Specs</option>
              <option value="Futaba Radio Pairing">Futaba Radio Pairing</option>
              <option value="Order & Shipping Status">Order & Shipping Status</option>
              <option value="GST Bulk Billing">GST Bulk Billing</option>
              <option value="Custom UAV Payload">Custom UAV Payload</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-message">Message Detail *</label>
            <textarea id="contact-message" rows="4" placeholder="Describe your flight query..." required class="form-input"></textarea>
          </div>

          <button type="submit" id="contact-submit-btn" class="btn-primary" style="width: 100%;">
            <span>SEND MESSAGE</span> <span>→</span>
          </button>
        </form>
      </div>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 4rem 1.25rem 6rem;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 3rem;
    }

    .contact-info {
      padding: 2.5rem;
      border-radius: var(--radius-md);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .contact-title {
      font-family: var(--font-display);
      font-size: 2rem;
      color: #1a1a1a;
      margin-bottom: 0.5rem;
    }
    .contact-subtitle {
      color: #666666;
      font-size: 0.95rem;
      margin-bottom: 2.5rem;
    }

    .info-blocks {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .info-block {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }
    .info-icon-box {
      background: #f3eee7;
      border: 1.5px solid #e6e0d5;
      width: 50px;
      height: 50px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .info-block strong {
      display: block;
      color: #1a1a1a;
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
    }
    .info-block p {
      color: #666666;
      font-size: 0.88rem;
    }

    .contact-form-card {
      padding: 2.5rem;
      border-radius: var(--radius-md);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .form-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: #1a1a1a;
      margin-bottom: 1.75rem;
    }
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-group label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    .form-input {
      background: #fbf9f5;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: #1a1a1a;
      font-size: 0.9rem;
      outline: none;
      transition: var(--transition-fast);
    }
    .form-input:focus {
      border-color: #3b0811;
      background: #ffffff;
    }

    .contact-success-banner {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      border: 1.5px solid #14b8a6;
      border-radius: var(--radius-md);
      padding: 2rem 1.5rem;
      text-align: center;
      color: #ffffff;
      animation: fadeIn 0.3s ease-in-out;
      margin-bottom: 1.5rem;
    }
    .success-icon-badge {
      width: 52px;
      height: 52px;
      background: #14b8a6;
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      font-weight: 800;
      margin: 0 auto 1rem;
      box-shadow: 0 0 20px rgba(20, 184, 166, 0.4);
    }
    .success-title {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      margin-bottom: 0.5rem;
      color: #ffffff;
    }
    .success-desc {
      font-size: 0.95rem;
      color: #cbd5e1;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .success-desc strong {
      color: #fbbf24;
      font-family: monospace;
      font-size: 1.05rem;
    }
    .success-timeline {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: rgba(255, 255, 255, 0.06);
      padding: 0.85rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      color: #94a3b8;
      margin-bottom: 1.5rem;
      text-align: left;
    }
    .success-timeline strong {
      color: #ffffff;
    }
    .btn-send-another {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      padding: 0.6rem 1.25rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-send-another:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: #ffffff;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const successBox = document.getElementById('contact-success-box');
      const ticketEl = document.getElementById('success-ticket-id');
      const submitBtn = document.getElementById('contact-submit-btn');
      const sendAnotherBtn = document.getElementById('btn-send-another');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
        const topic = (document.getElementById('contact-topic') as HTMLSelectElement)?.value;
        const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

        if (!name || !email || !message) return;

        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.innerHTML = `<span>DISPATCHING INQUIRY...</span>`;
        }

        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'contact',
              name,
              email,
              phone,
              topic,
              message
            })
          });

          const data = await res.json();
          if (data.success) {
            form.reset();
            form.style.display = 'none';
            if (successBox) {
              if (ticketEl && data.inquiry?.id) ticketEl.textContent = '#' + data.inquiry.id;
              successBox.style.display = 'block';
            }
          } else {
            alert('Could not submit inquiry: ' + (data.error || 'Server error. Please call +91 7722009120 directly.'));
          }
        } catch (err) {
          alert('Network communication error. Please contact WhatsApp +91 7722009120 directly.');
        } finally {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.innerHTML = `<span>SEND MESSAGE</span> <span>→</span>`;
          }
        }
      });

      sendAnotherBtn?.addEventListener('click', () => {
        if (successBox) successBox.style.display = 'none';
        if (form) {
          form.style.display = 'block';
          form.reset();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }
    document.addEventListener('astro:page-load', initContactForm);
  </script>

</body>
</html>
