---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | AKS Aeromodels</title>
  <meta name="description" content="Get in touch with AKS Aeromodels technical support for engine tuning, radio pairing, or order inquiry." />
</head>
<body>

  <Header />

  <main class="container page-padding">
    <div class="contact-grid">
      
      <!-- Contact Info Left -->
      <div class="contact-info glass-panel">
        <h1 class="contact-title">GET IN TOUCH</h1>
        <p class="contact-subtitle">Have questions about an engine setup, wingspan compatibility, or your order?</p>

        <div class="info-blocks">
          <div class="info-block">
            <span class="info-icon">📍</span>
            <div>
              <strong>Office & Distribution Center</strong>
              <p>Devlali camp, near HP petrol pump, Maharashtra, India 422 502</p>
            </div>
          </div>

          <div class="info-block">
            <span class="info-icon">📞</span>
            <div>
              <strong>Phone & WhatsApp Support</strong>
              <p><a href="https://wa.me/917722009120" target="_blank" rel="noopener noreferrer" style="color: #3b0811; font-weight: 700;">+91-7722009120</a> (Mon-Sun: 10:00 AM - 7:00 PM)</p>
            </div>
          </div>

          <div class="info-block">
            <span class="info-icon">✉️</span>
            <div>
              <strong>Email Inquiries</strong>
              <p>support@aks-aeromodels.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Right -->
      <div class="contact-form-card glass-panel">
        <h2 class="form-title">SEND US A MESSAGE</h2>
        <form class="contact-form" onsubmit="event.preventDefault(); alert('Message sent successfully! Our technical team will reach out within 2 hours.');">
          <div class="form-group">
            <label>Your Full Name *</label>
            <input type="text" placeholder="e.g. Rahul Verma" required class="form-input" />
          </div>

          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" placeholder="name@domain.com" required class="form-input" />
          </div>

          <div class="form-group">
            <label>Phone Number / WhatsApp</label>
            <input type="tel" placeholder="+91 77220 09120" class="form-input" />
          </div>

          <div class="form-group">
            <label>Inquiry Topic</label>
            <select class="form-input">
              <option>Engine Technical Query</option>
              <option>Seagull ARF Specs</option>
              <option>Futaba Radio Pairing</option>
              <option>Order & Shipping Status</option>
              <option>GST Bulk Billing</option>
            </select>
          </div>

          <div class="form-group">
            <label>Message Detail *</label>
            <textarea rows="4" placeholder="Describe your flight query..." required class="form-input"></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%;">SEND MESSAGE <span>→</span></button>
        </form>
      </div>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    .page-padding {
      padding: 4rem 1.25rem 6rem;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 3rem;
    }

    .contact-info {
      padding: 2.5rem;
      border-radius: var(--radius-lg);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .contact-title {
      font-size: 2rem;
      color: #1a1a1a;
      margin-bottom: 0.5rem;
    }
    .contact-subtitle {
      color: #666666;
      font-size: 0.95rem;
      margin-bottom: 2.5rem;
    }

    .info-blocks {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .info-block {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }
    .info-icon {
      font-size: 1.5rem;
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .info-block strong {
      display: block;
      color: #1a1a1a;
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
    }
    .info-block p {
      color: #666666;
      font-size: 0.88rem;
    }

    .contact-form-card {
      padding: 2.5rem;
      border-radius: var(--radius-lg);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .form-title {
      font-size: 1.4rem;
      color: #1a1a1a;
      margin-bottom: 1.75rem;
    }
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-group label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    .form-input {
      background: #fbf9f5;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: #1a1a1a;
      font-size: 0.9rem;
      outline: none;
      transition: var(--transition-fast);
    }
    .form-input:focus {
      border-color: #3b0811;
      background: #ffffff;
    }

    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

</body>
</html>
