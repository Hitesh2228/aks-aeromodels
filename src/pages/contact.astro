---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | SKYNODESUAV</title>
  <meta name="description" content="Get in touch with SKYNODESUAV technical support for engine tuning, radio pairing, or order inquiry." />
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />

  <Header />

  <main class="container page-padding reveal-on-scroll">
    <div class="contact-grid">
      
      <!-- Contact Info Left (Monochrome SVG Line Art Icons) -->
      <div class="contact-info glass-panel">
        <h1 class="contact-title">GET IN TOUCH</h1>
        <p class="contact-subtitle">Have questions about an engine setup, wingspan compatibility, or your order?</p>

        <div class="info-blocks">
          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <strong>Office & Distribution Center</strong>
              <p>Devlali camp, near HP petrol pump, Maharashtra, India 422 502</p>
            </div>
          </div>

          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <strong>Phone & WhatsApp Support</strong>
              <p><a href="https://wa.me/917722009120" target="_blank" rel="noopener noreferrer" style="color: #3b0811; font-weight: 700;">+91-7722009120</a> (Mon-Sun: 10:00 AM - 7:00 PM)</p>
            </div>
          </div>

          <div class="info-block">
            <div class="info-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <strong>Email Inquiries</strong>
              <p>support@aks-aeromodels.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Right -->
      <div class="contact-form-card glass-panel">
        <h2 class="form-title">SEND US A MESSAGE</h2>
        <form class="contact-form" onsubmit="event.preventDefault(); alert('Message sent successfully! Our technical team will reach out within 2 hours.');">
          <div class="form-group">
            <label>Your Full Name *</label>
            <input type="text" placeholder="e.g. Rahul Verma" required class="form-input" />
          </div>

          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" placeholder="name@domain.com" required class="form-input" />
          </div>

          <div class="form-group">
            <label>Phone Number / WhatsApp</label>
            <input type="tel" placeholder="+91 77220 09120" class="form-input" />
          </div>

          <div class="form-group">
            <label>Inquiry Topic</label>
            <select class="form-input">
              <option>Engine Technical Query</option>
              <option>Seagull ARF Specs</option>
              <option>Futaba Radio Pairing</option>
              <option>Order & Shipping Status</option>
              <option>GST Bulk Billing</option>
            </select>
          </div>

          <div class="form-group">
            <label>Message Detail *</label>
            <textarea rows="4" placeholder="Describe your flight query..." required class="form-input"></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%;">SEND MESSAGE <span>→</span></button>
        </form>
      </div>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 4rem 1.25rem 6rem;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 3rem;
    }

    .contact-info {
      padding: 2.5rem;
      border-radius: var(--radius-md);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .contact-title {
      font-family: var(--font-display);
      font-size: 2rem;
      color: #1a1a1a;
      margin-bottom: 0.5rem;
    }
    .contact-subtitle {
      color: #666666;
      font-size: 0.95rem;
      margin-bottom: 2.5rem;
    }

    .info-blocks {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .info-block {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }
    .info-icon-box {
      background: #f3eee7;
      border: 1.5px solid #e6e0d5;
      width: 50px;
      height: 50px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .info-block strong {
      display: block;
      color: #1a1a1a;
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
    }
    .info-block p {
      color: #666666;
      font-size: 0.88rem;
    }

    .contact-form-card {
      padding: 2.5rem;
      border-radius: var(--radius-md);
      background: #ffffff;
      border: 1px solid #e6e0d5;
    }
    .form-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: #1a1a1a;
      margin-bottom: 1.75rem;
    }
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .form-group label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    .form-input {
      background: #fbf9f5;
      border: 1px solid #d6cfc2;
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: #1a1a1a;
      font-size: 0.9rem;
      outline: none;
      transition: var(--transition-fast);
    }
    .form-input:focus {
      border-color: #3b0811;
      background: #ffffff;
    }

    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

</body>
</html>
