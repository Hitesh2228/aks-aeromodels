    import { addToCart } from '../../lib/cartStore';

    document.addEventListener('DOMContentLoaded', () => {
      let qty = 1;
      const qtyCount = document.getElementById('pdp-qty-count');
      const decBtn = document.getElementById('pdp-qty-dec');
      const incBtn = document.getElementById('pdp-qty-inc');
      const mainAddBtn = document.getElementById('pdp-main-add-btn');
      const mainImg = document.getElementById('main-display-img') as HTMLImageElement;
      const thumbs = document.querySelectorAll('.thumb-box');
      const stickyBar = document.getElementById('sticky-pdp-bar');
      const variantBtns = document.querySelectorAll('.variant-btn');

      // Mouse move zoom lens effect
      const stage = document.querySelector('.pdp-image-stage') as HTMLElement;
      if (stage && mainImg) {
        stage.addEventListener('mousemove', (e) => {
          const rect = stage.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          mainImg.style.transformOrigin = `${x}% ${y}%`;
        });
        stage.addEventListener('mouseleave', () => {
          mainImg.style.transformOrigin = 'center center';
        });
      }

      // Gallery Thumbnails Click
      thumbs.forEach(t => {
        t.addEventListener('click', () => {
          thumbs.forEach(other => other.classList.remove('active'));
          t.classList.add('active');
          const src = t.getAttribute('data-src');
          if (src && mainImg) mainImg.src = src;
        });
      });

      // Variant Selector Toggle
      variantBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          variantBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });

      // Stepper
      decBtn?.addEventListener('click', () => {
        if (qty > 1) {
          qty--;
          if (qtyCount) qtyCount.textContent = qty.toString();
        }
      });
      incBtn?.addEventListener('click', () => {
        qty++;
        if (qtyCount) qtyCount.textContent = qty.toString();
      });

      mainAddBtn?.addEventListener('click', () => {
        const id = mainAddBtn.getAttribute('data-id');
        if (id) addToCart(id, qty);
      });

      // PDF Line Accordions Toggle
      document.querySelectorAll('.pdf-acc-row').forEach(acc => {
        const btn = acc.querySelector('.pdf-acc-header');
        btn?.addEventListener('click', () => {
          acc.classList.toggle('is-open');
        });
      });

      // Add to cart generic buttons (excluding main add button to prevent double addition)
      document.querySelectorAll('.add-to-cart-btn:not(#pdp-main-add-btn)').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) addToCart(id, 1);
        });
      });

      // Sticky Bottom Bar Trigger: Reveals ONLY AFTER BEST PAIRED WITH section ends, auto-hides when scrolling back up
      const bestPairedSec = document.getElementById('best-paired-section');

      window.addEventListener('scroll', () => {
        if (!stickyBar || !bestPairedSec) return;
        const rect = bestPairedSec.getBoundingClientRect();
        if (rect.bottom <= 120) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      }, { passive: true });
    });
  </script>

</body>
</html>
