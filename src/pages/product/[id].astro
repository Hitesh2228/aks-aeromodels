---
import Header from '../../components/Header.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS, getProductById, type Product } from '../../data/products';
import { buildShopifyCheckoutUrl } from '../../lib/shopify';
import '../../styles/global.css';

export function getStaticPaths() {
  return PRODUCTS.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

if (!product) {
  return Astro.redirect('/shop');
}

const relatedProducts = PRODUCTS
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const pageTitle = `${product.name} - Buy Online at Best Price in India | AKS Aeromodels`;
const metaDescription = `${product.description} Buy ${product.name} online for ₹${product.price.toLocaleString('en-IN')}. Original factory warranty & fast shipping across India.`;
const canonicalUrl = `https://aks-aeromodels.com/product/${product.id}`;
const shopifyCheckoutLink = buildShopifyCheckoutUrl([{ product, quantity: 1 }]);

// Structured Data: Schema.org Product & Breadcrumbs
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": [product.image],
  "description": product.description,
  "sku": product.id,
  "mpn": product.id.toUpperCase(),
  "brand": {
    "@type": "Brand",
    "name": product.categoryLabel === 'Seagull Aeromodels' ? 'Seagull Models' : 'AKS Aeromodels'
  },
  "offers": {
    "@type": "Offer",
    "url": canonicalUrl,
    "priceCurrency": "INR",
    "price": product.price,
    "priceValidUntil": "2027-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "AKS Aeromodels"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating,
    "reviewCount": product.reviewsCount,
    "bestRating": "5",
    "worstRating": "1"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aks-aeromodels.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Shop Catalog",
      "item": "https://aks-aeromodels.com/shop"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.categoryLabel,
      "item": `https://aks-aeromodels.com/shop?category=${product.category}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": product.name,
      "item": canonicalUrl
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="keywords" content={`${product.name}, ${product.categoryLabel}, RC aircraft India, aeromodelling shop, AKS Aeromodels`} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OpenGraph Social Tags -->
  <meta property="og:type" content="og:product" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={product.image} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="product:price:amount" content={product.price.toString()} />
  <meta property="product:price:currency" content="INR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={product.image} />

  <!-- JSON-LD SEO Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body>

  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> / <a href="/shop">Shop</a> / <a href={`/shop?category=${product.category}`}>{product.categoryLabel}</a> / <span class="active">{product.name}</span>
    </div>
  </nav>

  <main class="container pdp-layout">
    
    <!-- Left Column: Image Gallery & Badges -->
    <div class="pdp-gallery-col">
      <div class="main-image-box glass-panel">
        {product.discountBadge && <span class="badge-offer pdp-badge">{product.discountBadge}</span>}
        {product.isBestseller && <span class="badge-bestseller pdp-badge-right">BESTSELLER</span>}
        <img src={product.image} alt={`${product.name} - Detailed View`} class="main-pdp-img" id="main-gallery-img" />
      </div>

      <!-- Trust Badges -->
      <div class="gallery-trust-grid">
        <div class="g-trust-item">
          <span class="g-icon">🚚</span>
          <div>
            <strong>Fast Express Shipping</strong>
            <small>Dispatch in 24 Hours</small>
          </div>
        </div>
        <div class="g-trust-item">
          <span class="g-icon">🛡️</span>
          <div>
            <strong>100% Genuine Guaranteed</strong>
            <small>Direct Factory Sourced</small>
          </div>
        </div>
        <div class="g-trust-item">
          <span class="g-icon">💳</span>
          <div>
            <strong>Secure Payment</strong>
            <small>UPI, Cards, NetBanking</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Details & Purchase Box -->
    <div class="pdp-details-col glass-panel">
      <div class="pdp-category">{product.categoryLabel}</div>
      <h1 class="pdp-title">{product.name}</h1>

      <!-- Rating & Stock Meta -->
      <div class="pdp-meta-row">
        <div class="pdp-rating">
          <span class="stars">★★★★★ {product.rating}</span>
          <span class="reviews">({product.reviewsCount} Verified Ratings)</span>
        </div>
        <div class="stock-status in-stock">
          <span class="dot"></span> In Stock & Ready to Ship
        </div>
      </div>

      <!-- Price Box -->
      <div class="pdp-price-box">
        <span class="pdp-price">₹{product.price.toLocaleString('en-IN')}</span>
        <span class="pdp-old-price">₹{product.originalPrice.toLocaleString('en-IN')}</span>
        <span class="pdp-save-badge">Save ₹{(product.originalPrice - product.price).toLocaleString('en-IN')} ({product.discountBadge})</span>
      </div>

      <p class="pdp-desc">{product.description}</p>

      <!-- Quantity & Buying Buttons -->
      <div class="purchase-controls">
        <div class="quantity-selector">
          <button type="button" class="qty-btn" id="pdp-qty-minus" aria-label="Decrease quantity">-</button>
          <span class="qty-display" id="pdp-qty-val">1</span>
          <button type="button" class="qty-btn" id="pdp-qty-plus" aria-label="Increase quantity">+</button>
        </div>

        <button class="btn-primary pdp-add-btn" id="pdp-add-to-cart-trigger" data-id={product.id}>
          ADD TO CART <span>🛒</span>
        </button>

        <a href={shopifyCheckoutLink} target="_blank" rel="noopener noreferrer" class="btn-buy-now">
          BUY NOW <span>⚡</span>
        </a>
      </div>

      <!-- WhatsApp Inquiry Button -->
      <a 
        href={`https://wa.me/919876543210?text=Hi%20AKS%20Aeromodels,%20I%20want%20to%20inquire%20about%20${encodeURIComponent(product.name)}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="whatsapp-inquire-btn"
      >
        💬 Inquire / Order on WhatsApp
      </a>

      <!-- Key Specifications Table -->
      <div class="specs-section">
        <h2 class="specs-heading">TECHNICAL SPECIFICATIONS</h2>
        <table class="specs-table">
          <tbody>
            {Object.entries(product.specs).map(([key, val]) => (
              <tr>
                <td class="spec-key">{key}</td>
                <td class="spec-val">{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>

  </main>

  <!-- Customer Reviews Breakdown -->
  <section class="reviews-section container">
    <div class="glass-panel reviews-card">
      <h2 class="reviews-title">PILOT REVIEWS & RATINGS</h2>
      <div class="reviews-grid">
        <div class="rating-summary">
          <div class="rating-big">{product.rating}</div>
          <div class="rating-stars-big">★★★★★</div>
          <div class="rating-count">Based on {product.reviewsCount} verified pilot reviews</div>
        </div>

        <div class="rating-bars">
          <div class="r-bar-item"><span>5 Stars</span><div class="r-bar-track"><div class="r-bar-fill" style="width: 88%;"></div></div><span>88%</span></div>
          <div class="r-bar-item"><span>4 Stars</span><div class="r-bar-track"><div class="r-bar-fill" style="width: 9%;"></div></div><span>9%</span></div>
          <div class="r-bar-item"><span>3 Stars</span><div class="r-bar-track"><div class="r-bar-fill" style="width: 3%;"></div></div><span>3%</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products Section -->
  {relatedProducts.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2 class="section-title">RECOMMENDED COMPATIBLE PRODUCTS</h2>
        <p class="section-subtitle">Pilots also bought these accessories and airframes</p>

        <div class="products-grid">
          {relatedProducts.map(rel => (
            <div class="product-card glass-panel">
              <div class="card-media">
                <a href={`/product/${rel.id}`}>
                  <img src={rel.image} alt={rel.name} class="product-img" />
                </a>
              </div>
              <div class="card-body">
                <div class="category-tag">{rel.categoryLabel}</div>
                <h3 class="product-title"><a href={`/product/${rel.id}`}>{rel.name}</a></h3>
                <div class="price-row">
                  <span class="current-price">₹{rel.price.toLocaleString('en-IN')}</span>
                  <span class="old-price">₹{rel.originalPrice.toLocaleString('en-IN')}</span>
                </div>
                <button class="btn-add-cart add-to-cart-btn" data-id={rel.id}>ADD TO CART</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CartDrawer />
  <Footer />

  <style>
    .breadcrumb-bar {
      background: #090a0e;
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.75rem 0;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .breadcrumb-bar a:hover { color: var(--accent-gold); }
    .breadcrumb-bar .active { color: var(--text-secondary); }

    .pdp-layout {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 3rem;
      padding: 3rem 1.25rem 4rem;
    }

    .main-image-box {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      padding-top: 75%;
      background: #11131a;
      border: 1px solid var(--border-subtle);
    }
    .main-pdp-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .pdp-badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 2;
    }
    .pdp-badge-right {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: #eab308;
      color: #000;
      font-weight: 800;
      font-size: 0.7rem;
      padding: 0.3rem 0.75rem;
      border-radius: 4px;
      z-index: 2;
    }

    .gallery-trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 1.5rem;
    }
    .g-trust-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      padding: 0.85rem;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .g-icon { font-size: 1.4rem; }
    .g-trust-item strong { display: block; font-size: 0.78rem; color: #fff; }
    .g-trust-item small { font-size: 0.68rem; color: var(--text-muted); }

    .pdp-details-col {
      padding: 2.25rem;
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
    }
    .pdp-category {
      font-size: 0.75rem;
      color: var(--accent-gold);
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }
    .pdp-title {
      font-size: 1.9rem;
      line-height: 1.25;
      color: #fff;
      margin-bottom: 1rem;
    }

    .pdp-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 1rem;
    }
    .pdp-rating .stars { color: var(--accent-amber); font-weight: 700; }
    .pdp-rating .reviews { color: var(--text-muted); font-size: 0.85rem; }
    .stock-status { font-size: 0.8rem; font-weight: 700; color: var(--accent-green); display: flex; align-items: center; gap: 0.4rem; }
    .stock-status .dot { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; }

    .pdp-price-box { display: flex; align-items: baseline; gap: 0.8rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .pdp-price { font-size: 2.2rem; font-weight: 800; color: #fff; font-family: var(--font-display); }
    .pdp-old-price { font-size: 1.1rem; color: var(--text-muted); text-decoration: line-through; }
    .pdp-save-badge { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px; }

    .pdp-desc { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 2rem; }

    .purchase-controls { display: flex; gap: 0.85rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .quantity-selector { display: flex; align-items: center; background: #181b26; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 0.25rem 0.5rem; }
    .qty-btn { color: #fff; width: 32px; height: 32px; font-size: 1.2rem; font-weight: 700; }
    .qty-display { width: 36px; text-align: center; font-weight: 700; color: #fff; }
    .pdp-add-btn { flex: 1; min-width: 150px; }
    .btn-buy-now {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #fff;
      font-weight: 800;
      font-size: 0.9rem;
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-md);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .btn-buy-now:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35); }

    .whatsapp-inquire-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: rgba(37, 211, 102, 0.12);
      border: 1px solid rgba(37, 211, 102, 0.3);
      color: #25d366;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-md);
      margin-bottom: 2rem;
      transition: var(--transition-fast);
    }
    .whatsapp-inquire-btn:hover { background: rgba(37, 211, 102, 0.25); }

    /* Specs Table */
    .specs-section { margin-bottom: 1.5rem; }
    .specs-heading { font-size: 0.9rem; color: var(--accent-gold); letter-spacing: 0.08em; margin-bottom: 0.75rem; font-weight: 800; }
    .specs-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .specs-table tr { border-bottom: 1px solid var(--border-subtle); }
    .specs-table td { padding: 0.6rem 0; }
    .spec-key { color: var(--text-muted); width: 40%; font-weight: 600; }
    .spec-val { color: #fff; font-weight: 700; }

    /* Reviews Section */
    .reviews-section { margin-bottom: 4rem; }
    .reviews-card { padding: 2.5rem; }
    .reviews-title { font-size: 1.3rem; color: #fff; margin-bottom: 1.5rem; font-weight: 800; }
    .reviews-grid { display: grid; grid-template-columns: 220px 1fr; gap: 3rem; align-items: center; }
    .rating-summary { text-align: center; }
    .rating-big { font-size: 3.5rem; font-weight: 900; color: #fff; font-family: var(--font-display); line-height: 1; }
    .rating-stars-big { color: var(--accent-amber); font-size: 1.2rem; margin: 0.4rem 0; }
    .rating-count { font-size: 0.78rem; color: var(--text-muted); }
    .rating-bars { display: flex; flex-direction: column; gap: 0.6rem; }
    .r-bar-item { display: flex; align-items: center; gap: 1rem; font-size: 0.8rem; color: var(--text-secondary); }
    .r-bar-track { flex: 1; height: 8px; background: rgba(255, 255, 255, 0.1); border-radius: 4px; overflow: hidden; }
    .r-bar-fill { height: 100%; background: var(--accent-amber); border-radius: 4px; }

    .related-section { padding: 4rem 0 5rem; background: #08090c; border-top: 1px solid var(--border-subtle); }

    @media (max-width: 900px) {
      .pdp-layout { grid-template-columns: 1fr; }
      .gallery-trust-grid { grid-template-columns: 1fr; }
      .reviews-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { addToCart } from '../../lib/cartStore';

    document.addEventListener('DOMContentLoaded', () => {
      let qty = 1;
      const qtyVal = document.getElementById('pdp-qty-val');
      const minusBtn = document.getElementById('pdp-qty-minus');
      const plusBtn = document.getElementById('pdp-qty-plus');
      const addBtn = document.getElementById('pdp-add-to-cart-trigger');

      minusBtn?.addEventListener('click', () => {
        if (qty > 1) {
          qty--;
          if (qtyVal) qtyVal.textContent = qty.toString();
        }
      });

      plusBtn?.addEventListener('click', () => {
        qty++;
        if (qtyVal) qtyVal.textContent = qty.toString();
      });

      addBtn?.addEventListener('click', () => {
        const id = addBtn.getAttribute('data-id');
        if (id) {
          addToCart(id, qty);
        }
      });

      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) addToCart(id, 1);
        });
      });
    });
  </script>

</body>
</html>
