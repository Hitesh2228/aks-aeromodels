---
import Header from '../../components/Header.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS, getProductById, type Product } from '../../data/products';
import { buildShopifyCheckoutUrl } from '../../lib/shopify';
import '../../styles/global.css';

export function getStaticPaths() {
  return PRODUCTS.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

if (!product) {
  return Astro.redirect('/shop');
}

const relatedProducts = PRODUCTS
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const pairedProducts = PRODUCTS
  .filter(p => p.category !== product.category)
  .slice(0, 4);

const pageTitle = `${product.name} - Buy Online at Best Price in India | AKS Aeromodels`;
const metaDescription = `${product.description} Buy ${product.name} online for ₹${product.price.toLocaleString('en-IN')}. Original factory warranty & fast shipping across India.`;
const canonicalUrl = `https://aks-aeromodels.com/product/${product.id}`;
const shopifyCheckoutLink = buildShopifyCheckoutUrl([{ product, quantity: 1 }]);

const prepaidPrice = Math.round(product.price * 0.95);

// Sample Pilot Reviews
const pilotReviews = [
  { name: "Manav R.", date: "4 months ago", rating: 5, text: "Beautifully engineered component. Smooth idle and outstanding flight response!" },
  { name: "Neha R.", date: "4 months ago", rating: 5, text: "Balanced performance for all flying styles. Delivered safely to Mumbai in 48 hours." },
  { name: "Siddharth K.", date: "4 months ago", rating: 5, text: "100% genuine factory sealed package. Excellent power output and clean finish." },
  { name: "Shreya N.", date: "7 months ago", rating: 5, text: "Great variety of accessories in the kit. Perfect for field training and competitions." }
];

// Structured Data: Schema.org Product & Breadcrumbs
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": [product.image],
  "description": product.description,
  "sku": product.id,
  "mpn": product.id.toUpperCase(),
  "brand": {
    "@type": "Brand",
    "name": product.categoryLabel === 'Seagull Aeromodels' ? 'Seagull Models' : 'AKS Aeromodels'
  },
  "offers": {
    "@type": "Offer",
    "url": canonicalUrl,
    "priceCurrency": "INR",
    "price": product.price,
    "priceValidUntil": "2027-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "AKS Aeromodels"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating,
    "reviewCount": product.reviewsCount,
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
</head>
<body class="bellavita-pdp-body">

  <Header />

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> / <a href="/shop">Products</a> / <a href={`/shop?category=${product.category}`}>{product.categoryLabel}</a> / <span class="active">{product.name}</span>
    </div>
  </nav>

  <main class="container pdp-main-layout reveal-on-scroll">
    
    <!-- 2-Column Product Showcase -->
    <div class="pdp-top-grid">
      
      <!-- Left Column: Main Image & Gallery Thumbnails -->
      <div class="pdp-gallery-column">
        <div class="main-image-container">
          {product.isBestseller && <span class="badge-bestseller pdp-badge-left">BESTSELLER</span>}
          {product.discountBadge && <span class="badge-offer pdp-badge-right">{product.discountBadge}</span>}
          <img src={product.image} alt={product.name} class="main-pdp-img" id="main-display-img" />
        </div>

        <!-- Thumbnails Strip -->
        <div class="gallery-thumbs-row">
          <div class="thumb-item active" data-src={product.image}>
            <img src={product.image} alt="Angle 1" />
          </div>
          <div class="thumb-item" data-src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop" alt="Angle 2" />
          </div>
          <div class="thumb-item" data-src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop" alt="Angle 3" />
          </div>
          <div class="thumb-item" data-src="https://images.unsplash.com/photo-1581092335397-9583fe92d232?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1581092335397-9583fe92d232?q=80&w=600&auto=format&fit=crop" alt="Angle 4" />
          </div>
        </div>
      </div>

      <!-- Right Column: Product Buy Info -->
      <div class="pdp-buy-column">
        <h1 class="pdp-product-title">{product.name}</h1>
        <p class="pdp-subtitle-tag">{product.categoryLabel.toUpperCase()} • Contest Grade Specification</p>

        <!-- Rating Pill -->
        <div class="rating-pill-row">
          <span class="rating-badge-yellow">★ {product.rating}</span>
          <span class="rating-count-text">{product.reviewsCount} reviews</span>
          <button class="btn-share-icon" title="Share Product" onclick="navigator.clipboard?.writeText(window.location.href); alert('Product link copied!');">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
        </div>

        <!-- Price Block -->
        <div class="pdp-pricing-block">
          <span class="price-main">₹{product.price.toLocaleString('en-IN')}.00</span>
          <span class="price-old">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
          <span class="save-tag">(Save {product.discountBadge || '20%'})</span>
        </div>
        <div class="tax-inclusive-lbl">Inclusive of all 18% GST taxes</div>

        <!-- Prepaid Discount Box -->
        <div class="prepaid-discount-box">
          <span class="prepaid-icon">🏷️</span>
          <span>Pay only <strong>₹{prepaidPrice.toLocaleString('en-IN')}.00</strong> with Prepaid UPI Discounts ⓘ</span>
        </div>

        <!-- Quantity & Add to Cart Controls -->
        <div class="buy-action-controls">
          <div class="pdp-qty-stepper">
            <button type="button" class="stepper-btn" id="pdp-qty-dec">-</button>
            <span class="stepper-val" id="pdp-qty-count">1</span>
            <button type="button" class="stepper-btn" id="pdp-qty-inc">+</button>
          </div>

          <button class="btn-add-to-cart-pill add-to-cart-btn" id="pdp-main-add-btn" data-id={product.id}>
            ADD TO CART
          </button>
        </div>

        <!-- WhatsApp Quick Order -->
        <a 
          href={`https://wa.me/917722009120?text=Hi%20AKS%20Aeromodels,%20I%20want%20to%20order%20${encodeURIComponent(product.name)}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="whatsapp-quick-order-btn"
        >
          💬 Order Instantly on WhatsApp
        </a>

        <!-- 4 Line-Art Trust Badges Grid -->
        <div class="trust-icons-grid">
          <div class="trust-badge-item">
            <div class="t-icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <span>Factory Import</span>
          </div>

          <div class="trust-badge-item">
            <div class="t-icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>100% Genuine</span>
          </div>

          <div class="trust-badge-item">
            <div class="t-icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <span>AMA Compliant</span>
          </div>

          <div class="trust-badge-item">
            <div class="t-icon-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b0811" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span>Insured Freight</span>
          </div>
        </div>

        <!-- Best Selling Combo Card -->
        <div class="best-combo-card">
          <h4 class="combo-title">BEST SELLING COMBO</h4>
          <div class="combo-flex">
            <img src={pairedProducts[0].image} alt="Combo item" class="combo-img" />
            <div class="combo-info">
              <strong>{product.name} + {pairedProducts[0].name}</strong>
              <div class="combo-price">
                <span>₹{(product.price + pairedProducts[0].price).toLocaleString('en-IN')}.00</span>
                <small style="text-decoration: line-through; color: #888;">₹{(product.originalPrice + pairedProducts[0].originalPrice).toLocaleString('en-IN')}.00</small>
              </div>
            </div>
            <button class="btn-combo-add add-to-cart-btn" data-id={product.id}>
              ADD COMBO
            </button>
          </div>
        </div>

        <!-- Spec Cards Highlights Grid ("Notes in This Set") -->
        <div class="component-notes-section">
          <h4 class="notes-heading">COMPONENT HIGHLIGHTS IN THIS KIT</h4>
          <div class="notes-cards-grid">
            <div class="note-card-box">
              <span class="note-icon">⚙️</span>
              <strong>Precision CNC Machined</strong>
              <small>Hardened alloy shaft</small>
            </div>
            <div class="note-card-box">
              <span class="note-icon">🌀</span>
              <strong>Dual Ball Bearings</strong>
              <small>High RPM stability</small>
            </div>
            <div class="note-card-box">
              <span class="note-icon">🔥</span>
              <strong>Heavy Duty Expansion</strong>
              <small>Low acoustic signature</small>
            </div>
          </div>
        </div>

        <!-- Where To Fly Applications ("Where To Wear It") -->
        <div class="applications-section">
          <h4 class="app-heading">WHERE TO FLY IT & RECOMMENDED USAGE</h4>
          <div class="app-items-grid">
            <div class="app-item">✈️ <span>Aerobatic Competitions</span></div>
            <div class="app-item">🎯 <span>Flight Training Clubs</span></div>
            <div class="app-item">🛠️ <span>Scale Kit Building</span></div>
            <div class="app-item">🏁 <span>High Speed Pylon Racing</span></div>
          </div>
        </div>

        <!-- Interactive Collapsible Accordions (Bellavita Accordion Style) -->
        <div class="pdp-accordions-group">
          
          <div class="accordion-item is-open">
            <button type="button" class="acc-trigger">
              <span>Technical Specifications & Dimensions</span>
              <span class="acc-icon">+</span>
            </button>
            <div class="acc-panel">
              <table class="specs-table">
                <tbody>
                  {Object.entries(product.specs).map(([k, v]) => (
                    <tr>
                      <td class="spec-k">{k}</td>
                      <td class="spec-v">{v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="acc-trigger">
              <span>In-The-Box Accessories Included</span>
              <span class="acc-icon">+</span>
            </button>
            <div class="acc-panel">
              <ul class="bullet-list">
                <li>1x Factory Assembled {product.name} Unit</li>
                <li>1x High Flow Expansion Silencer & Gasket Set</li>
                <li>1x Engine Mounting Standoff Set & Hardware</li>
                <li>1x Official Owner Manual & Tuning Guide</li>
              </ul>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="acc-trigger">
              <span>Maintenance, Fuel Ratios & Break-In Steps</span>
              <span class="acc-icon">+</span>
            </button>
            <div class="acc-panel">
              <p class="acc-text">Run 4-5 thermal heat cycles on rich needle setting before full throttle flying. Use 10-15% synthetic castor oil blend fuel for maximum bearing protection.</p>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="acc-trigger">
              <span>Shipping, Warranty & 18% GST Credit</span>
              <span class="acc-icon">+</span>
            </button>
            <div class="acc-panel">
              <p class="acc-text">Dispatched in 24 hours from Devlali Camp distribution hub. 100% transit damage insured with 1-Year Official Manufacturer Warranty. Includes 18% GST B2B tax invoice.</p>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- Best Paired With Section -->
    <section class="pdp-section-block">
      <h2 class="pdp-section-title">BEST PAIRED WITH</h2>
      <div class="products-carousel-grid">
        {pairedProducts.map(item => (
          <div class="bellavita-card">
            <div class="card-media">
              {item.isBestseller && <span class="badge-bestseller">BESTSELLER</span>}
              <a href={`/product/${item.id}`}>
                <img src={item.image} alt={item.name} class="product-img" />
              </a>
            </div>
            <div class="card-body">
              <div class="subtitle-tag">{item.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title"><a href={`/product/${item.id}`}>{item.name}</a></h3>
              <div class="price-row">
                <span class="current-price">₹{item.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{item.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>
              <button class="bellavita-cart-btn add-to-cart-btn" data-id={item.id}>ADD TO CART</button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pilot Customer Reviews & Rating Breakdown -->
    <section class="pdp-section-block">
      <h2 class="pdp-section-title">Customer Reviews</h2>
      
      <div class="reviews-summary-card">
        <div class="score-col">
          <div class="score-big">4.87</div>
          <div class="stars-gold">★★★★★</div>
          <div class="based-lbl">Based on {product.reviewsCount} reviews</div>
        </div>

        <div class="bars-col">
          <div class="bar-line"><span>5 Stars</span><div class="track"><div class="fill" style="width: 88%;"></div></div><span>890</span></div>
          <div class="bar-line"><span>4 Stars</span><div class="track"><div class="fill" style="width: 9%;"></div></div><span>348</span></div>
          <div class="bar-line"><span>3 Stars</span><div class="track"><div class="fill" style="width: 2%;"></div></div><span>29</span></div>
          <div class="bar-line"><span>2 Stars</span><div class="track"><div class="fill" style="width: 0%;"></div></div><span>0</span></div>
          <div class="bar-line"><span>1 Star</span><div class="track"><div class="fill" style="width: 1%;"></div></div><span>2</span></div>
        </div>

        <div class="action-col">
          <button class="btn-write-review" onclick="alert('Thank you! Review submission form opened.');">
            Write a review
          </button>
        </div>
      </div>

      <!-- Verified Reviews List -->
      <div class="pilot-reviews-list">
        {pilotReviews.map(rev => (
          <div class="pilot-review-card">
            <div class="rev-header">
              <div class="rev-stars">★★★★★</div>
              <span class="rev-date">{rev.date}</span>
            </div>
            <div class="rev-author-name">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#059669"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <strong>{rev.name}</strong>
              <small class="verified-tag">Verified Pilot</small>
            </div>
            <p class="rev-text">"{rev.text}"</p>
          </div>
        ))}
      </div>
    </section>

    <!-- You May Also Like Section -->
    <section class="pdp-section-block">
      <h2 class="pdp-section-title">YOU MAY ALSO LIKE</h2>
      <div class="products-carousel-grid">
        {relatedProducts.map(rel => (
          <div class="bellavita-card">
            <div class="card-media">
              {rel.isBestseller && <span class="badge-bestseller">BESTSELLER</span>}
              <a href={`/product/${rel.id}`}>
                <img src={rel.image} alt={rel.name} class="product-img" />
              </a>
            </div>
            <div class="card-body">
              <div class="subtitle-tag">{rel.categoryLabel.toUpperCase()}</div>
              <h3 class="product-title"><a href={`/product/${rel.id}`}>{rel.name}</a></h3>
              <div class="price-row">
                <span class="current-price">₹{rel.price.toLocaleString('en-IN')}.00</span>
                <span class="old-price">₹{rel.originalPrice.toLocaleString('en-IN')}.00</span>
              </div>
              <button class="bellavita-cart-btn add-to-cart-btn" data-id={rel.id}>ADD TO CART</button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <!-- Sticky Bottom Purchase Bar (On Scroll) -->
  <div class="sticky-pdp-bar" id="sticky-pdp-bar">
    <div class="container sticky-bar-flex">
      <div class="sticky-prod-info">
        <img src={product.image} alt={product.name} class="sticky-thumb" />
        <div>
          <strong class="sticky-name">{product.name}</strong>
          <span class="sticky-price">₹{product.price.toLocaleString('en-IN')}.00</span>
        </div>
      </div>
      <button class="btn-primary sticky-add-btn add-to-cart-btn" data-id={product.id}>
        ADD TO CART
      </button>
    </div>
  </div>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-pdp-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .breadcrumb-bar {
      background: #f3eee7;
      border-bottom: 1px solid #e6e0d5;
      padding: 0.85rem 0;
      font-size: 0.82rem;
      color: #666666;
    }
    .breadcrumb-bar a:hover { color: #3b0811; }
    .breadcrumb-bar .active { color: #1a1a1a; font-weight: 700; }

    .pdp-main-layout {
      padding: 3rem 1.25rem 6rem;
    }

    .pdp-top-grid {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 3rem;
      margin-bottom: 4rem;
    }

    /* Gallery Column */
    .pdp-gallery-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .main-image-container {
      position: relative;
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding-top: 85%;
      overflow: hidden;
    }
    .main-pdp-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .pdp-badge-left {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 2;
    }
    .pdp-badge-right {
      position: absolute;
      top: 1rem;
      right: 1rem;
      z-index: 2;
    }

    .gallery-thumbs-row {
      display: flex;
      gap: 0.85rem;
    }
    .thumb-item {
      width: 70px;
      height: 70px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 1.5px solid #e6e0d5;
      cursor: pointer;
      background: #ffffff;
      transition: var(--transition-fast);
    }
    .thumb-item.active, .thumb-item:hover {
      border-color: #3b0811;
      transform: translateY(-2px);
    }
    .thumb-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Buy Column */
    .pdp-buy-column {
      display: flex;
      flex-direction: column;
    }
    .pdp-product-title {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 800;
      color: #1a1a1a;
      line-height: 1.25;
      margin-bottom: 0.35rem;
    }
    .pdp-subtitle-tag {
      font-size: 0.82rem;
      color: #666666;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .rating-pill-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .rating-badge-yellow {
      background: #fef3c7;
      color: #92400e;
      font-weight: 800;
      font-size: 0.8rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }
    .rating-count-text {
      font-size: 0.82rem;
      color: #666666;
    }
    .btn-share-icon {
      margin-left: auto;
      background: none;
      border: none;
      cursor: pointer;
    }

    .pdp-pricing-block {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 0.2rem;
    }
    .price-main {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 800;
      color: #1a1a1a;
    }
    .price-old {
      font-size: 1.1rem;
      color: #888888;
      text-decoration: line-through;
    }
    .save-tag {
      font-size: 0.85rem;
      font-weight: 800;
      color: #059669;
    }
    .tax-inclusive-lbl {
      font-size: 0.78rem;
      color: #777777;
      margin-bottom: 1.25rem;
    }

    .prepaid-discount-box {
      background: #fef3c7;
      border: 1px solid #fde68a;
      color: #78350f;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .buy-action-controls {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .pdp-qty-stepper {
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 1.5px solid #e6e0d5;
      border-radius: var(--radius-sm);
      padding: 0.25rem 0.5rem;
    }
    .stepper-btn {
      width: 32px;
      height: 32px;
      font-size: 1.2rem;
      font-weight: 800;
      color: #1a1a1a;
      background: none;
      border: none;
      cursor: pointer;
    }
    .stepper-val {
      width: 36px;
      text-align: center;
      font-weight: 800;
      color: #1a1a1a;
    }

    .btn-add-to-cart-pill {
      flex: 1;
      background: #1a1a1a;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.9rem;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      letter-spacing: 0.05em;
      border: none;
      cursor: pointer;
      transition: var(--transition-fast);
    }
    .btn-add-to-cart-pill:hover {
      background: #3b0811;
      transform: translateY(-2px);
    }

    .whatsapp-quick-order-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: rgba(37, 211, 102, 0.12);
      border: 1.5px solid rgba(37, 211, 102, 0.4);
      color: #047857;
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      margin-bottom: 2rem;
    }

    /* Trust Badges Grid */
    .trust-icons-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      border-top: 1px solid #e6e0d5;
      border-bottom: 1px solid #e6e0d5;
      padding: 1.5rem 0;
      margin-bottom: 2rem;
    }
    .trust-badge-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-align: center;
    }
    .t-icon-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .trust-badge-item span {
      font-size: 0.72rem;
      font-weight: 700;
      color: #333333;
    }

    /* Combo Card */
    .best-combo-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 1.25rem;
      margin-bottom: 2rem;
    }
    .combo-title {
      font-size: 0.78rem;
      font-weight: 800;
      color: #3b0811;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .combo-flex {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .combo-img {
      width: 54px;
      height: 54px;
      object-fit: cover;
      border-radius: 4px;
      border: 1px solid #e6e0d5;
    }
    .combo-info { flex-grow: 1; font-size: 0.82rem; }
    .combo-info strong { display: block; color: #1a1a1a; margin-bottom: 0.2rem; }
    .combo-price { font-weight: 800; color: #1a1a1a; display: flex; gap: 0.4rem; }
    .btn-combo-add {
      background: #f3eee7;
      color: #3b0811;
      border: 1px solid #d6cfc2;
      font-weight: 800;
      font-size: 0.75rem;
      padding: 0.5rem 0.85rem;
      border-radius: 4px;
    }

    /* Notes Highlights Grid */
    .component-notes-section {
      margin-bottom: 2rem;
    }
    .notes-heading, .app-heading {
      font-size: 0.82rem;
      font-weight: 800;
      color: #1a1a1a;
      letter-spacing: 0.06em;
      margin-bottom: 0.85rem;
    }
    .notes-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
    }
    .note-card-box {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      text-align: center;
    }
    .note-icon { font-size: 1.4rem; display: block; margin-bottom: 0.25rem; }
    .note-card-box strong { display: block; font-size: 0.78rem; color: #1a1a1a; }
    .note-card-box small { font-size: 0.68rem; color: #666666; }

    /* Usage Applications Grid */
    .applications-section { margin-bottom: 2rem; }
    .app-items-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .app-item {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      font-weight: 700;
      color: #333333;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Accordions Group */
    .pdp-accordions-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .accordion-item {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-sm);
      overflow: hidden;
    }
    .acc-trigger {
      width: 100%;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-main);
      font-weight: 800;
      font-size: 0.88rem;
      color: #1a1a1a;
      background: none;
      border: none;
      cursor: pointer;
    }
    .acc-icon { font-size: 1.2rem; transition: transform 0.3s ease; }
    .accordion-item.is-open .acc-icon { transform: rotate(45deg); }
    
    .acc-panel {
      display: none;
      padding: 0 1.25rem 1.25rem;
      border-top: 1px solid #f3eee7;
      font-size: 0.85rem;
      color: #555555;
    }
    .accordion-item.is-open .acc-panel {
      display: block;
    }
    .specs-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
    .specs-table td { padding: 0.5rem 0; border-bottom: 1px solid #f3eee7; }
    .spec-k { width: 45%; color: #666666; font-weight: 600; }
    .spec-v { color: #1a1a1a; font-weight: 700; }
    .bullet-list { padding-left: 1.2rem; margin-top: 0.5rem; line-height: 1.6; }

    /* Sections */
    .pdp-section-block {
      margin-top: 4rem;
    }
    .pdp-section-title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 800;
      text-align: center;
      letter-spacing: 0.08em;
      margin-bottom: 2.25rem;
      color: #1a1a1a;
    }

    /* Product Cards Grid */
    .products-carousel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.75rem;
    }
    .bellavita-card {
      background: #f3eee7;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-sm);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition-smooth);
    }
    .bellavita-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      border-color: #1a1a1a;
    }
    .card-media {
      position: relative;
      padding-top: 75%;
      background: #ffffff;
    }
    .product-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .subtitle-tag {
      font-size: 0.65rem;
      color: #777777;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
    }
    .product-title {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.35;
      color: #1a1a1a;
      margin-bottom: 0.6rem;
      height: 2.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .price-row {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }
    .current-price {
      font-size: 1.15rem;
      font-weight: 800;
      color: #1a1a1a;
    }
    .old-price {
      font-size: 0.85rem;
      color: #888888;
      text-decoration: line-through;
    }
    .bellavita-cart-btn {
      background: #1a1a1a;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.8rem;
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      text-align: center;
      width: 100%;
      margin-top: auto;
    }

    /* Reviews Summary */
    .reviews-summary-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 2.5rem;
      display: grid;
      grid-template-columns: 220px 1fr 200px;
      gap: 2.5rem;
      align-items: center;
      margin-bottom: 2.5rem;
    }
    .score-col { text-align: center; }
    .score-big { font-size: 3.8rem; font-weight: 900; font-family: var(--font-display); line-height: 1; color: #1a1a1a; }
    .stars-gold { color: #f59e0b; font-size: 1.2rem; margin: 0.3rem 0; }
    .based-lbl { font-size: 0.78rem; color: #666666; }

    .bars-col { display: flex; flex-direction: column; gap: 0.5rem; }
    .bar-line { display: flex; align-items: center; gap: 1rem; font-size: 0.8rem; color: #555; }
    .track { flex: 1; height: 8px; background: #e6e0d5; border-radius: 4px; overflow: hidden; }
    .fill { height: 100%; background: #f59e0b; border-radius: 4px; }

    .action-col { text-align: center; }
    .btn-write-review {
      background: #1a1a1a;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
    }

    .pilot-reviews-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .pilot-review-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-sm);
      padding: 1.5rem;
    }
    .rev-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; }
    .rev-stars { color: #f59e0b; font-size: 0.9rem; }
    .rev-date { font-size: 0.78rem; color: #888888; }
    .rev-author-name { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; color: #1a1a1a; margin-bottom: 0.6rem; }
    .verified-tag { color: #059669; font-weight: 800; font-size: 0.72rem; }
    .rev-text { font-size: 0.9rem; color: #444444; line-height: 1.6; }

    /* Sticky Bottom Bar */
    .sticky-pdp-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #ffffff;
      border-top: 1.5px solid #e6e0d5;
      box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.08);
      z-index: 98;
      padding: 0.75rem 0;
      transform: translateY(100%);
      transition: transform 0.35s ease;
    }
    .sticky-pdp-bar.is-visible {
      transform: translateY(0);
    }
    .sticky-bar-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sticky-prod-info { display: flex; align-items: center; gap: 1rem; }
    .sticky-thumb { width: 44px; height: 44px; object-fit: cover; border-radius: 4px; border: 1px solid #e6e0d5; }
    .sticky-name { display: block; font-size: 0.9rem; color: #1a1a1a; }
    .sticky-price { font-weight: 800; color: #3b0811; font-size: 0.95rem; }
    .sticky-add-btn { padding: 0.65rem 1.5rem; font-weight: 800; }

    @media (max-width: 900px) {
      .pdp-top-grid { grid-template-columns: 1fr; }
      .trust-icons-grid { grid-template-columns: repeat(2, 1fr); }
      .reviews-summary-card { grid-template-columns: 1fr; text-align: center; }
    }
  </style>

  <script>
    import { addToCart } from '../../lib/cartStore';

    document.addEventListener('DOMContentLoaded', () => {
      let qty = 1;
      const qtyCount = document.getElementById('pdp-qty-count');
      const decBtn = document.getElementById('pdp-qty-dec');
      const incBtn = document.getElementById('pdp-qty-inc');
      const mainAddBtn = document.getElementById('pdp-main-add-btn');
      const mainImg = document.getElementById('main-display-img') as HTMLImageElement;
      const thumbs = document.querySelectorAll('.thumb-item');
      const stickyBar = document.getElementById('sticky-pdp-bar');

      // Gallery Thumbnails Click
      thumbs.forEach(t => {
        t.addEventListener('click', () => {
          thumbs.forEach(other => other.classList.remove('active'));
          t.classList.add('active');
          const src = t.getAttribute('data-src');
          if (src && mainImg) mainImg.src = src;
        });
      });

      // Stepper
      decBtn?.addEventListener('click', () => {
        if (qty > 1) {
          qty--;
          if (qtyCount) qtyCount.textContent = qty.toString();
        }
      });
      incBtn?.addEventListener('click', () => {
        qty++;
        if (qtyCount) qtyCount.textContent = qty.toString();
      });

      mainAddBtn?.addEventListener('click', () => {
        const id = mainAddBtn.getAttribute('data-id');
        if (id) addToCart(id, qty);
      });

      // Accordions Toggle
      document.querySelectorAll('.accordion-item').forEach(acc => {
        const btn = acc.querySelector('.acc-trigger');
        btn?.addEventListener('click', () => {
          acc.classList.toggle('is-open');
        });
      });

      // Add to cart generic buttons
      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) addToCart(id, 1);
        });
      });

      // Sticky Bottom Bar Scroll Observer
      window.addEventListener('scroll', () => {
        if (window.scrollY > 500) {
          stickyBar?.classList.add('is-visible');
        } else {
          stickyBar?.classList.remove('is-visible');
        }
      }, { passive: true });
    });
  </script>

</body>
</html>
