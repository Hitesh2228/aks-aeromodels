---
import Header from '../../components/Header.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import MobileBottomNav from '../../components/MobileBottomNav.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS, getProductById, type Product } from '../../data/products';
import { buildShopifyCheckoutUrl } from '../../lib/shopify';
import '../../styles/global.css';

export function getStaticPaths() {
  return PRODUCTS.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };

if (!product) {
  return Astro.redirect('/shop');
}

const relatedProducts = PRODUCTS
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const pairedProducts = PRODUCTS
  .filter(p => p.category !== product.category)
  .slice(0, 4);

const pageTitle = `${product.name} - Buy Online at Best Price in India | SKYNODESUAV`;
const metaDescription = `${product.description} Buy ${product.name} online for ₹${product.price.toLocaleString('en-IN')}. Original factory warranty & fast shipping across India.`;
const canonicalUrl = `https://aks-aeromodels.com/product/${product.id}`;
const shopifyCheckoutLink = buildShopifyCheckoutUrl([{ product, quantity: 1 }]);

const prepaidPrice = Math.round(product.price * 0.95);

// Sample Pilot Reviews
const pilotReviews = [
  { name: "Manav R.", date: "4 months ago", rating: 5, text: "Beautifully engineered component. Smooth idle and outstanding flight response!" },
  { name: "Neha R.", date: "4 months ago", rating: 5, text: "Balanced performance for all flying styles. Delivered safely to Nashik in 24 hours." },
  { name: "Siddharth K.", date: "4 months ago", rating: 5, text: "100% genuine factory sealed package. Excellent power output and clean finish." },
  { name: "Shreya N.", date: "7 months ago", rating: 5, text: "Great variety of accessories in the kit. Perfect for field training and competitions." }
];

// Component Highlights ("Notes in This Set")
const notesInSet = [
  { name: "ABL Liner", desc: "Advanced Bimetallic Liner for high heat resistance", icon: "⚙️" },
  { name: "Ball Bearings", desc: "Dual precision bearings for smooth high RPM", icon: "🌀" },
  { name: "Power Carb", desc: "21J Dual-needle carburetor for crisp throttle response", icon: "🔥" },
  { name: "E-4050 Muffler", desc: "High flow quiet silencer included in box", icon: "💨" }
];

// Usage Applications ("Where To Wear It")
const usageLocations = [
  { title: "Aerobatic Competitions", icon: "✈️" },
  { title: "Flight Training Clubs", icon: "🎯" },
  { title: "Scale Kit Building", icon: "🛠️" },
  { title: "Pylon Racing", icon: "🏁" }
];

// Structured Data (JSON-LD Product Schema for SEO & Rich Results)
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": [product.image],
  "description": product.shortDesc,
  "sku": product.id,
  "mpn": product.id,
  "brand": {
    "@type": "Brand",
    "name": product.categoryLabel === 'Seagull Aeromodels' ? 'Seagull Models' : 'SKYNODESUAV'
  },
  "offers": {
    "@type": "Offer",
    "url": canonicalUrl,
    "priceCurrency": "INR",
    "price": product.price,
    "priceValidUntil": "2026-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "SKYNODESUAV"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating,
    "reviewCount": product.reviewsCount,
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
</head>
<body class="bellavita-pdp-body">

  <Header />

  <!-- Breadcrumbs (PDF Clean Minimalist Style) -->
  <nav class="breadcrumb-strip" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>›</span> <a href="/shop">Products</a> <span>›</span> <a href={`/shop?category=${product.category}`}>{product.categoryLabel}</a> <span>›</span> <span class="active">{product.name}</span>
    </div>
  </nav>

  <main class="container pdp-container">
    
    <!-- 2-Column Product Showcase (Spacious & Clean PDF Layout) -->
    <div class="pdp-showcase-grid">
      
      <!-- Left Column: Main Image & Thumbnails (Sticky on Scroll) -->
      <div class="pdp-sticky-gallery">
        <div class="pdp-image-stage">
          {product.isBestseller && <span class="pdp-pill-badge bestseller">BESTSELLER</span>}
          {product.discountBadge && <span class="pdp-pill-badge offer">{product.discountBadge}</span>}
          <img src={product.image} alt={product.name} class="pdp-main-img" id="main-display-img" />
        </div>

        <!-- Thumbnails Row -->
        <div class="pdp-thumbs-row">
          <div class="thumb-box active" data-src={product.image}>
            <img src={product.image} alt="Angle 1" />
          </div>
          <div class="thumb-box" data-src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=600&auto=format&fit=crop" alt="Angle 2" />
          </div>
          <div class="thumb-box" data-src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop" alt="Angle 3" />
          </div>
          <div class="thumb-box" data-src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=600&auto=format&fit=crop">
            <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=600&auto=format&fit=crop" alt="Angle 4" />
          </div>
        </div>
      </div>

      <!-- Right Column: Product Specs & Buying Actions -->
      <div class="pdp-details-column">
        <h1 class="product-heading-title">{product.name}</h1>
        <p class="product-subtext">{product.specs.Displacement || product.specs.Wingspan || 'Contest Grade'} • For every pilot requirement</p>

        <!-- Rating Pill & Share -->
        <div class="rating-row">
          <span class="rating-star-pill">★ {product.rating}</span>
          <span class="rating-reviews-count">{product.reviewsCount} reviews</span>
          <button class="share-btn" title="Share Product Link" onclick="navigator.clipboard?.writeText(window.location.href); alert('Product link copied!');">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
        </div>

        <!-- Pricing Row & Stepper (Exact PDF Alignment) -->
        <div class="price-stepper-flex">
          <div class="price-block">
            <span class="price-actual">₹{product.price.toLocaleString('en-IN')}.00</span>
            <span class="price-slashed">₹{product.originalPrice.toLocaleString('en-IN')}.00</span>
            <span class="price-discount-tag">(Save {product.discountBadge || '20%'})</span>
          </div>

          <div class="qty-stepper-box">
            <button type="button" class="stepper-btn" id="pdp-qty-dec">-</button>
            <span class="stepper-count" id="pdp-qty-count">1</span>
            <button type="button" class="stepper-btn" id="pdp-qty-inc">+</button>
          </div>
        </div>
        <div class="tax-note-text">Inclusive of all taxes</div>

        <!-- Prepaid Discount Callout Banner (Exact PDF Style) -->
        <div class="prepaid-banner-pill">
          <span class="tag-icon">🏷️</span>
          <span>Pay only <strong>₹{prepaidPrice.toLocaleString('en-IN')}.00</strong> with Prepaid Discounts ⓘ</span>
        </div>

        <!-- TYPE / Variant Selector (Exact PDF Style) -->
        <div class="variant-selector-block">
          <label class="variant-label">TYPE — Engine & Kit Option</label>
          <div class="variant-buttons-row">
            <button type="button" class="variant-btn active">Standard Factory Edition</button>
            <button type="button" class="variant-btn">Pro Tuned Edition</button>
          </div>
        </div>

        <!-- ADD TO CART Button (Full Width Solid Dark PDF Pill) -->
        <button class="btn-add-to-cart-pdf add-to-cart-btn" id="pdp-main-add-btn" data-id={product.id}>
          ADD TO CART
        </button>

        <!-- 4 Line-Art Trust Badges (Exact PDF Page 1 Row) -->
        <div class="pdf-trust-badges-row">
          <div class="trust-badge-cell">
            <div class="badge-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <span>Imported Quality</span>
          </div>

          <div class="trust-badge-cell">
            <div class="badge-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>100% Genuine</span>
          </div>

          <div class="trust-badge-cell">
            <div class="badge-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <span>AMA Certified</span>
          </div>

          <div class="trust-badge-cell">
            <div class="badge-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span>Assured Delivery</span>
          </div>
        </div>

        <!-- BEST SELLING COMBOS Card (Exact PDF Style) -->
        <div class="pdf-combo-card">
          <h4 class="combo-card-title">BEST SELLING COMBOS</h4>
          <div class="combo-inner-flex">
            <img src={pairedProducts[0].image} alt="Combo item" class="combo-thumb" />
            <div class="combo-details">
              <strong>{product.name} + {pairedProducts[0].name}</strong>
              <div class="combo-prices">
                <span>₹{(product.price + pairedProducts[0].price).toLocaleString('en-IN')}.00</span>
                <small style="text-decoration: line-through; color: #888;">₹{(product.originalPrice + pairedProducts[0].originalPrice).toLocaleString('en-IN')}.00</small>
              </div>
            </div>
            <button class="btn-combo-add-pdf add-to-cart-btn" data-id={product.id}>
              ADD TO CART
            </button>
          </div>
        </div>

        <!-- Notes in This Set Section (Exact PDF Style) -->
        <div class="notes-in-set-block">
          <h3 class="block-heading">Notes in This Set</h3>
          <div class="notes-grid-4">
            {notesInSet.map(note => (
              <div class="note-item-card">
                <span class="note-emoji">{note.icon}</span>
                <strong class="note-name">{note.name}</strong>
                <small class="note-desc">{note.desc}</small>
              </div>
            ))}
          </div>
        </div>

        <!-- Where To Fly Applications ("Where To Wear It" -> PDF Style) -->
        <div class="where-to-fly-block">
          <h3 class="block-heading">Where To Fly It</h3>
          <div class="where-grid-2">
            {usageLocations.map(loc => (
              <div class="where-item">
                <span>{loc.icon}</span>
                <strong>{loc.title}</strong>
              </div>
            ))}
          </div>
          <p class="vibes-line">Vibes: <em>Versatile, confident, bold, high-performance flight.</em></p>
        </div>

        <!-- Interactive Clean Expandable Accordions (PDF Minimal Line Style) -->
        <div class="pdf-accordion-list">
          
          <div class="pdf-acc-row is-open">
            <button type="button" class="pdf-acc-header">
              <span>Product Highlights</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <p class="acc-paragraph">{product.description}</p>
            </div>
          </div>

          <div class="pdf-acc-row">
            <button type="button" class="pdf-acc-header">
              <span>Technical Specifications & Dimensions</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <table class="clean-specs-table">
                <tbody>
                  {Object.entries(product.specs).map(([k, v]) => (
                    <tr>
                      <td class="key-col">{k}</td>
                      <td class="val-col">{v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="pdf-acc-row">
            <button type="button" class="pdf-acc-header">
              <span>FAQ</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <p class="acc-paragraph"><strong>Q: Is fuel included in the box?</strong><br/>A: Fuel is shipped separately due to hazardous cargo regulations. We recommend 10-15% nitro fuel blend.</p>
            </div>
          </div>

          <div class="pdf-acc-row">
            <button type="button" class="pdf-acc-header">
              <span>All Ingredients & Material Build</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <p class="acc-paragraph">Contest grade balsa wood, aircraft grade aluminum, hardened alloy steel crankshaft, and high temperature ABL cylinder liner.</p>
            </div>
          </div>

          <div class="pdf-acc-row">
            <button type="button" class="pdf-acc-header">
              <span>Other Information & Warranty</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <p class="acc-paragraph">Includes 1-Year Official Manufacturer Warranty and 18% GST Input Tax Credit Invoice for B2B orders.</p>
            </div>
          </div>

          <div class="pdf-acc-row">
            <button type="button" class="pdf-acc-header">
              <span>How To Use & Break-In Steps</span>
              <span class="pdf-acc-icon">+</span>
            </button>
            <div class="pdf-acc-content">
              <p class="acc-paragraph">Run 4-5 thermal heat cycles on rich needle setting before full throttle flying. Use 10-15% synthetic castor oil blend fuel for maximum bearing protection.</p>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- BEST PAIRED WITH Section (Centered Spacious PDF Header & Grid) -->
    <section class="pdp-major-section" id="best-paired-section">
      <h2 class="pdf-section-heading">BEST PAIRED WITH</h2>
      
      <div class="pdf-products-grid-4">
        {pairedProducts.map(item => (
          <div class="pdf-catalog-card">
            <div class="card-image-box">
              {item.isBestseller && <span class="card-badge bestseller">BESTSELLER</span>}
              {item.discountBadge && <span class="card-badge offer">{item.discountBadge}</span>}
              <a href={`/product/${item.id}`}>
                <img src={item.image} alt={item.name} />
              </a>
            </div>
            <div class="card-content-box">
              <div class="card-cat-tag">{item.categoryLabel.toUpperCase()}</div>
              <h3 class="card-item-title"><a href={`/product/${item.id}`}>{item.name}</a></h3>
              <div class="card-rating-line">★ {item.rating} | ({item.reviewsCount} Reviews)</div>
              <div class="card-price-line">
                <span class="p-now">₹{item.price.toLocaleString('en-IN')}</span>
                <span class="p-was">₹{item.originalPrice.toLocaleString('en-IN')}</span>
              </div>
              <button class="pdf-card-cart-btn add-to-cart-btn" data-id={item.id}>ADD TO CART</button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Customer Reviews Section (Exact PDF Rating Bar & Photo Strip) -->
    <section class="pdp-major-section">
      <h2 class="pdf-section-heading">Customer Reviews</h2>
      
      <div class="pdf-reviews-summary-flex">
        <div class="score-summary-box">
          <div class="big-score-num">4.67</div>
          <div class="stars-gold-row">★★★★★</div>
          <div class="total-reviews-text">Based on {product.reviewsCount} reviews</div>
        </div>

        <div class="bars-distribution-box">
          <div class="dist-row"><span>5 Stars</span><div class="dist-track"><div class="dist-fill" style="width: 88%;"></div></div><span>890</span></div>
          <div class="dist-row"><span>4 Stars</span><div class="dist-track"><div class="dist-fill" style="width: 9%;"></div></div><span>348</span></div>
          <div class="dist-row"><span>3 Stars</span><div class="dist-track"><div class="dist-fill" style="width: 2%;"></div></div><span>29</span></div>
          <div class="dist-row"><span>2 Stars</span><div class="dist-track"><div class="dist-fill" style="width: 0%;"></div></div><span>0</span></div>
          <div class="dist-row"><span>1 Star</span><div class="dist-track"><div class="dist-fill" style="width: 1%;"></div></div><span>2</span></div>
        </div>

        <div class="write-review-box">
          <button class="btn-write-review-pdf" onclick="alert('Thank you! Review submission modal opened.');">
            Write a review
          </button>
        </div>
      </div>

      <!-- Customer Photos Strip -->
      <div class="customer-photos-strip">
        <div class="strip-label">Customer photos & videos</div>
        <div class="photos-flex">
          <img src="https://images.unsplash.com/photo-1597773150796-e5c14ebecbf5?q=80&w=200&auto=format&fit=crop" alt="Photo 1" />
          <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=200&auto=format&fit=crop" alt="Photo 2" />
          <img src="https://images.unsplash.com/photo-1581092335397-9583fe92d232?q=80&w=200&auto=format&fit=crop" alt="Photo 3" />
          <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=200&auto=format&fit=crop" alt="Photo 4" />
          <img src="https://images.unsplash.com/photo-1519074069444-1ba4ea16028d?q=80&w=200&auto=format&fit=crop" alt="Photo 5" />
        </div>
      </div>

      <!-- Verified Reviews Cards List -->
      <div class="pdf-reviews-list">
        {pilotReviews.map(rev => (
          <div class="pdf-review-card">
            <div class="rev-card-top-header">
              <div class="rev-author-stars">
                <div class="rev-stars">★★★★★</div>
                <div class="rev-author">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="#059669"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  <strong>{rev.name}</strong>
                </div>
              </div>
              <span class="rev-time-ago">{rev.date}</span>
            </div>
            <h4 class="rev-title-headline">Elegant & High Performance</h4>
            <p class="rev-body-text">{rev.text}</p>
          </div>
        ))}
      </div>

    </section>

    <!-- YOU MAY ALSO LIKE Section (PDF Page 3) -->
    <section class="pdp-major-section">
      <h2 class="pdf-section-heading">YOU MAY ALSO LIKE</h2>
      
      <div class="pdf-products-grid-4">
        {relatedProducts.map(rel => (
          <div class="pdf-catalog-card">
            <div class="card-image-box">
              {rel.isBestseller && <span class="card-badge bestseller">BESTSELLER</span>}
              {rel.discountBadge && <span class="card-badge offer">{rel.discountBadge}</span>}
              <a href={`/product/${rel.id}`}>
                <img src={rel.image} alt={rel.name} />
              </a>
            </div>
            <div class="card-content-box">
              <div class="card-cat-tag">{rel.categoryLabel.toUpperCase()}</div>
              <h3 class="card-item-title"><a href={`/product/${rel.id}`}>{rel.name}</a></h3>
              <div class="card-rating-line">★ {rel.rating} | ({rel.reviewsCount} Reviews)</div>
              <div class="card-price-line">
                <span class="p-now">₹{rel.price.toLocaleString('en-IN')}</span>
                <span class="p-was">₹{rel.originalPrice.toLocaleString('en-IN')}</span>
              </div>
              <button class="pdf-card-cart-btn add-to-cart-btn" data-id={rel.id}>ADD TO CART</button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <!-- Sticky Bottom Purchase Bar (On Scroll) -->
  <div class="sticky-pdp-bar" id="sticky-pdp-bar">
    <div class="container sticky-bar-flex">
      <div class="sticky-prod-info">
        <img src={product.image} alt={product.name} class="sticky-thumb" />
        <div>
          <strong class="sticky-name">{product.name}</strong>
          <span class="sticky-price">₹{product.price.toLocaleString('en-IN')}.00</span>
        </div>
      </div>
      <button class="btn-primary sticky-add-btn add-to-cart-btn" data-id={product.id}>
        ADD TO CART
      </button>
    </div>
  </div>

  <CartDrawer />
  <MobileBottomNav />
  <Footer />

  <style>
    :global(body.bellavita-pdp-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    /* Minimal Breadcrumb Strip */
    .breadcrumb-strip {
      background: transparent;
      padding: 1.25rem 0;
      font-size: 0.78rem;
      color: #777777;
    }
    .breadcrumb-strip a { color: #666666; text-decoration: none; }
    .breadcrumb-strip a:hover { color: #111111; }
    .breadcrumb-strip span { margin: 0 0.35rem; color: #aaaaaa; }
    .breadcrumb-strip .active { color: #111111; font-weight: 600; }

    .pdp-container {
      max-width: 1140px !important;
      margin: 0 auto !important;
      padding: 1rem 2.5rem 6rem !important;
    }

    /* 2-Column Showcase Layout with Proper Image Sizing & Margins */
    .pdp-showcase-grid {
      display: grid;
      grid-template-columns: 460px 1fr;
      gap: 4.5rem;
      align-items: flex-start;
      margin-bottom: 5rem;
    }

    /* Sticky Gallery Column - Stays pinned when scrolling through details */
    .pdp-sticky-gallery {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 95px !important;
      align-self: flex-start !important;
      width: 460px;
