  <script>
    import { getWishlistItems, removeFromWishlist } from '../lib/wishlistStore';
    import { addToCart } from '../lib/cartStore';
    import { triggerGoogleSignIn, logoutUser, getLoggedInUser } from '../lib/googleAuth';

    interface AddressItem {
      id: string;
      label: string;
      name: string;
      phone: string;
      street: string;
      city: string;
      state: string;
      pincode: string;
      isDefault: boolean;
    }

    function initProfilePage() {
      function parsePhone(rawPhone: string): { code: string; number: string } {
        if (!rawPhone) return { code: '+91', number: '' };
        let cleaned = rawPhone.trim();
        const knownCodes = [
          '+971', '+880', '+977', '+966', '+974', '+968', '+965', '+973', '+353',
          '+91', '+1', '+44', '+61', '+49', '+33', '+65', '+81', '+60', '+64',
          '+27', '+41', '+39', '+34', '+31', '+55', '+82', '+94'
        ];
        for (const c of knownCodes) {
          if (cleaned.startsWith(c)) {
            return { code: c, number: cleaned.slice(c.length).replace(/^[\s-]+/, '').trim() };
          }
        }
        if (cleaned.startsWith('+')) {
          const spaceIdx = cleaned.indexOf(' ');
          if (spaceIdx > 0) {
            return { code: cleaned.slice(0, spaceIdx), number: cleaned.slice(spaceIdx + 1).trim() };
          }
        }
        return { code: '+91', number: cleaned.replace(/^\+91[\s-]*/, '').trim() };
      }

      function attachPhoneSanitizer(inputEl: HTMLInputElement | null, selectEl: HTMLSelectElement | null) {
        if (!inputEl) return;
        inputEl.addEventListener('input', () => {
          let val = inputEl.value.trim();
          if (val.startsWith('+')) {
            const parsed = parsePhone(val);
            if (selectEl) selectEl.value = parsed.code;
            inputEl.value = parsed.number;
          }
        });
      }

      const loggedOutDiv = document.getElementById('auth-logged-out');
      const loggedInDiv = document.getElementById('auth-logged-in');

      const userDisplayName = document.getElementById('user-display-name');
      const userDisplayEmail = document.getElementById('user-display-email');
      const userDisplayPhone = document.getElementById('user-display-phone');
      const userDisplayGstin = document.getElementById('user-display-gstin');
      const logoutBtn = document.getElementById('google-logout-btn');

      const editProfileBtn = document.getElementById('open-edit-profile-btn');
      const editProfileModal = document.getElementById('edit-profile-modal');
      const closeEditProfileX = document.getElementById('close-edit-profile-x');
      const editProfileForm = document.getElementById('edit-profile-form');

      const addAddressBtn = document.getElementById('add-address-trigger-btn') as HTMLButtonElement;
      const addressModal = document.getElementById('address-modal');
      const closeAddrModalX = document.getElementById('close-address-modal-x');
      const addressForm = document.getElementById('address-form');
      const addressesGrid = document.getElementById('saved-addresses-grid');

      const userOrdersList = document.getElementById('user-orders-list');

      function getSavedAddresses(): AddressItem[] {
        try {
          const raw = localStorage.getItem('skynodes_saved_addresses');
          if (raw) return JSON.parse(raw);
        } catch (e) {}
        return [];
      }

      function saveAddresses(list: AddressItem[]) {
        localStorage.setItem('skynodes_saved_addresses', JSON.stringify(list));
        renderAddresses();
      }

      function renderAddresses() {
        const list = getSavedAddresses();
        if (addAddressBtn) {
          addAddressBtn.disabled = list.length >= 5;
          addAddressBtn.textContent = list.length >= 5 ? 'Max 5 Reached' : '➕ Add Address';
        }

        if (!addressesGrid) return;

        if (list.length === 0) {
          addressesGrid.innerHTML = `<p style="font-size: 0.82rem; color: #888;">No saved addresses yet. Click "+ Add Address" to store up to 5 delivery locations.</p>`;
          return;
        }

        addressesGrid.innerHTML = list.map(addr => `
          <div class="address-box ${addr.isDefault ? 'is-default-card' : ''}">
            <div>
              <div class="addr-tag-row">
                <span class="addr-tag-name">${addr.label}</span>
                ${addr.isDefault ? '<span class="default-tag-badge">DEFAULT</span>' : ''}
              </div>
              <div class="addr-body-text">
                <strong>${addr.name}</strong> (${addr.phone})<br/>
                ${addr.street}, ${addr.city}, ${addr.state} - ${addr.pincode}
              </div>
            </div>
            <div class="addr-actions">
              ${!addr.isDefault ? `<button class="btn-addr-mini btn-set-default" data-id="${addr.id}">Set Default</button>` : ''}
              <button class="btn-addr-mini btn-edit-addr" data-id="${addr.id}">✏️ Edit</button>
              <button class="btn-addr-mini btn-addr-delete" data-id="${addr.id}">🗑️ Delete</button>
            </div>
          </div>
        `).join('');

        // Action Listeners
        addressesGrid.querySelectorAll('.btn-set-default').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            const updated = getSavedAddresses().map(a => ({ ...a, isDefault: a.id === id }));
            saveAddresses(updated);
          });
        });

        addressesGrid.querySelectorAll('.btn-edit-addr').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            const target = getSavedAddresses().find(a => a.id === id);
            if (target) {
              (document.getElementById('addr-edit-id') as HTMLInputElement).value = target.id;
              (document.getElementById('addr-label') as HTMLInputElement).value = target.label;
              (document.getElementById('addr-name') as HTMLInputElement).value = target.name;
              const parsedTargetPhone = parsePhone(target.phone);
              const addrEditCodeSelect = document.getElementById('addr-phone-code') as HTMLSelectElement;
              const addrEditPhoneInput = document.getElementById('addr-phone') as HTMLInputElement;
              if (addrEditCodeSelect) addrEditCodeSelect.value = parsedTargetPhone.code;
              if (addrEditPhoneInput) addrEditPhoneInput.value = parsedTargetPhone.number;
              attachPhoneSanitizer(addrEditPhoneInput, addrEditCodeSelect);
              (document.getElementById('addr-street') as HTMLInputElement).value = target.street;
              (document.getElementById('addr-city') as HTMLInputElement).value = target.city;
              (document.getElementById('addr-state') as HTMLInputElement).value = target.state;
              (document.getElementById('addr-pincode') as HTMLInputElement).value = target.pincode;
              (document.getElementById('addr-is-default') as HTMLInputElement).checked = target.isDefault;

              (document.getElementById('address-modal-title') as HTMLElement).textContent = '✏️ Edit Saved Address';
              addressModal?.classList.add('active');
            }
          });
        });

        addressesGrid.querySelectorAll('.btn-addr-delete').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            if (confirm('Are you sure you want to delete this address?')) {
              const updated = getSavedAddresses().filter(a => a.id !== id);
              if (updated.length > 0 && !updated.some(a => a.isDefault)) {
                updated[0].isDefault = true;
              }
              saveAddresses(updated);
            }
          });
        });
      }

      function renderOrders() {
        if (!userOrdersList) return;
        try {
          const rawHistory = localStorage.getItem('skynodes_orders_history');
          let history = rawHistory ? JSON.parse(rawHistory) : [];

          if (history.length === 0) {
            history = [
              {
                orderId: '#SKY-INV-2026-8942',
                date: '25 Aug 2026',
                paymentMethod: 'PAID (ONLINE)',
                status: 'DISPATCHED',
                awb: '#AWB-9876543',
                total: 38790,
                customer: { name: localStorage.getItem('skynodes_pilot_name') || 'Customer', address: 'Devlali Camp, Nashik, MH' },
                items: [
                  { quantity: 1, product: { name: 'O.S. Max 0.46 AX II Nitro Engine', price: 18990 } },
                  { quantity: 1, product: { name: 'Futaba 6K 6-Channel Radio System', price: 19800 } }
                ]
              },
              {
                orderId: '#SKY-INV-2026-7819',
                date: '12 Aug 2026',
                paymentMethod: 'CASH ON DELIVERY (COD)',
                status: 'DELIVERED',
                awb: '#AWB-9871122',
                total: 84990,
                customer: { name: localStorage.getItem('skynodes_pilot_name') || 'Customer', address: 'Devlali Camp, Nashik, MH' },
                items: [
                  { quantity: 1, product: { name: 'Seagull Decathlon 122" V2 ARF Airframe', price: 84990 } }
                ]
              }
            ];
          }

          userOrdersList.innerHTML = history.map((ord: any, idx: number) => `
            <div class="order-item">
              <div class="order-header">
                <div>
                  <strong class="order-id">${ord.orderId}</strong>
                  <span class="order-date">Date: ${ord.date} • AWB: ${ord.awb || '#AWB-TRACKING'}</span>
                </div>
                <span class="${ord.paymentMethod?.includes('COD') ? 'status-badge-blue' : 'status-badge-green'}">${ord.paymentMethod?.includes('COD') ? 'PENDING COD' : 'DELIVERED'}</span>
              </div>
              <div class="order-details">
                <p style="font-weight: 700; color: #111; margin-bottom: 0.3rem;">Items Ordered:</p>
                <ul style="margin: 0 0 0.8rem 1.2rem; font-size: 0.8rem; color: #444;">
                  ${ord.items ? ord.items.map((i: any) => `<li>${i.quantity}x ${i.product?.name || 'Equipment'} (₹${((i.product?.price || 0) * i.quantity).toLocaleString('en-IN')})</li>`).join('') : '<li>Aeromodelling Equipment</li>'}
                </ul>
                <div class="order-footer">
                  <span class="order-price">Total: ₹${(ord.total || 0).toLocaleString('en-IN')}.00</span>
                  <button class="btn-view-order-inv view-invoice-link" data-index="${idx}" style="background:none; border:none; cursor:pointer; font-weight:700;">View GST Invoice 📄</button>
                </div>
              </div>
            </div>
          `).join('');

          userOrdersList.querySelectorAll('.btn-view-order-inv').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const index = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
              const selectedOrder = history[index];
              if (selectedOrder) {
                localStorage.setItem('skynodes_last_order', JSON.stringify(selectedOrder));
                window.location.href = '/invoice';
              }
            });
          });

        } catch (e) {}
      }

      function checkAuth() {
        const isLoggedIn = localStorage.getItem('google_auth_logged_in') === 'true';

        if (isLoggedIn) {
          loggedOutDiv?.classList.add('style-hidden');
          loggedInDiv?.classList.remove('style-hidden');

          const user = getLoggedInUser();
          const name = user?.name || localStorage.getItem('skynodes_pilot_user') || 'Pilot';
          const email = user?.email || '';
          const phone = user?.phone || localStorage.getItem('skynodes_pilot_phone') || 'Not Provided';
          const gstin = localStorage.getItem('skynodes_pilot_gstin') || 'Not Provided';
          const avatar = user?.picture;

          if (userDisplayName) userDisplayName.textContent = name;
          if (userDisplayEmail) userDisplayEmail.textContent = email;
          if (userDisplayPhone) userDisplayPhone.textContent = phone;
          if (userDisplayGstin) userDisplayGstin.textContent = gstin;

          const avatarImg = document.getElementById('user-avatar-img') as HTMLImageElement;
          if (avatarImg && avatar) avatarImg.src = avatar;

          renderAddresses();
          renderOrders();
        } else {
          loggedOutDiv?.classList.remove('style-hidden');
          loggedInDiv?.classList.add('style-hidden');
        }
      }

      checkAuth();

      // Logout Event
      logoutBtn?.addEventListener('click', () => {
        logoutUser();
        window.location.reload();
      });

      // Edit Profile Modal Handler
      editProfileBtn?.addEventListener('click', () => {
        const user = getLoggedInUser();
        (document.getElementById('edit-name') as HTMLInputElement).value = user?.name || '';
        (document.getElementById('edit-email') as HTMLInputElement).value = user?.email || '';
        const rawPhone = user?.phone || localStorage.getItem('skynodes_pilot_phone') || '';
        const parsed = parsePhone(rawPhone);
        const editCodeSelect = document.getElementById('edit-phone-code') as HTMLSelectElement;
        const editPhoneInput = document.getElementById('edit-phone') as HTMLInputElement;
        if (editCodeSelect) editCodeSelect.value = parsed.code;
        if (editPhoneInput) editPhoneInput.value = parsed.number;
        attachPhoneSanitizer(editPhoneInput, editCodeSelect);
        (document.getElementById('edit-gstin') as HTMLInputElement).value = localStorage.getItem('skynodes_pilot_gstin') || '';

        editProfileModal?.classList.add('active');
      });

      closeEditProfileX?.addEventListener('click', () => {
        editProfileModal?.classList.remove('active');
      });

      editProfileForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('edit-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('edit-email') as HTMLInputElement).value.trim();
        const phoneCode = (document.getElementById('edit-phone-code') as HTMLSelectElement)?.value || '+91';
        let phoneNum = (document.getElementById('edit-phone') as HTMLInputElement).value.trim();
        if (phoneNum.startsWith('+')) {
          phoneNum = parsePhone(phoneNum).number;
        }
        const phone = phoneNum ? `${phoneCode} ${phoneNum}` : '';
        const gstin = (document.getElementById('edit-gstin') as HTMLInputElement).value.trim();

        if (name && email) {
          localStorage.setItem('skynodes_pilot_name', name);
          localStorage.setItem('skynodes_pilot_email', email);
          localStorage.setItem('skynodes_pilot_phone', phone);
          localStorage.setItem('skynodes_pilot_gstin', gstin);

          editProfileModal?.classList.remove('active');
          window.dispatchEvent(new CustomEvent('user-logged-in'));
          checkAuth();
          alert('✅ Profile details updated successfully!');
        }
      });

      // Add Address Modal Handler
      addAddressBtn?.addEventListener('click', () => {
        if (getSavedAddresses().length >= 5) {
          alert('Maximum 5 saved addresses allowed.');
          return;
        }
        (document.getElementById('addr-edit-id') as HTMLInputElement).value = '';
        (document.getElementById('addr-label') as HTMLInputElement).value = '';
        (document.getElementById('addr-name') as HTMLInputElement).value = localStorage.getItem('skynodes_pilot_name') || '';
        const rawAddrPhone = localStorage.getItem('skynodes_pilot_phone') || '';
        const parsedAddr = parsePhone(rawAddrPhone);
        const addrCodeSelect = document.getElementById('addr-phone-code') as HTMLSelectElement;
        const addrPhoneInput = document.getElementById('addr-phone') as HTMLInputElement;
        if (addrCodeSelect) addrCodeSelect.value = parsedAddr.code;
        if (addrPhoneInput) addrPhoneInput.value = parsedAddr.number;
        attachPhoneSanitizer(addrPhoneInput, addrCodeSelect);
        (document.getElementById('addr-street') as HTMLInputElement).value = '';
        (document.getElementById('addr-city') as HTMLInputElement).value = '';
        (document.getElementById('addr-state') as HTMLInputElement).value = 'Maharashtra';
        (document.getElementById('addr-pincode') as HTMLInputElement).value = '';
        (document.getElementById('addr-is-default') as HTMLInputElement).checked = getSavedAddresses().length === 0;

        (document.getElementById('address-modal-title') as HTMLElement).textContent = '📍 Add New Delivery Address';
        addressModal?.classList.add('active');
      });

      closeAddrModalX?.addEventListener('click', () => {
        addressModal?.classList.remove('active');
      });

      addressForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const editId = (document.getElementById('addr-edit-id') as HTMLInputElement).value;
        const label = (document.getElementById('addr-label') as HTMLInputElement).value.trim();
        const name = (document.getElementById('addr-name') as HTMLInputElement).value.trim();
        const addrCode = (document.getElementById('addr-phone-code') as HTMLSelectElement)?.value || '+91';
        let addrNum = (document.getElementById('addr-phone') as HTMLInputElement).value.trim();
        if (addrNum.startsWith('+')) {
          addrNum = parsePhone(addrNum).number;
        }
        const phone = addrNum ? `${addrCode} ${addrNum}` : '';
        const street = (document.getElementById('addr-street') as HTMLInputElement).value.trim();
        const city = (document.getElementById('addr-city') as HTMLInputElement).value.trim();
        const state = (document.getElementById('addr-state') as HTMLInputElement).value.trim();
        const pincode = (document.getElementById('addr-pincode') as HTMLInputElement).value.trim();
        const isDefault = (document.getElementById('addr-is-default') as HTMLInputElement).checked;

        let list = getSavedAddresses();

        if (editId) {
          list = list.map(a => a.id === editId ? { id: editId, label, name, phone, street, city, state, pincode, isDefault } : (isDefault ? { ...a, isDefault: false } : a));
        } else {
          if (isDefault) {
            list = list.map(a => ({ ...a, isDefault: false }));
          }
          list.push({
            id: `addr_${Date.now()}`,
            label, name, phone, street, city, state, pincode, isDefault
          });
        }

        saveAddresses(list);
        addressModal?.classList.remove('active');
        alert('✅ Address saved to your Pilot Address Book!');
      });

      function renderWishlist() {
        const grid = document.getElementById('profile-wishlist-grid');
        const countEl = document.getElementById('profile-wishlist-count');
        const items = getWishlistItems();

        if (countEl) countEl.textContent = String(items.length);
        if (!grid) return;

        if (items.length === 0) {
          grid.innerHTML = `
            <div class="wishlist-empty-state">
              <div class="wishlist-empty-icon">🤍</div>
              <h3 class="wishlist-empty-title">Your wishlist is currently empty</h3>
              <p class="wishlist-empty-sub">Explore our aeromodelling catalog, engines, and parts, and click the heart icon to save your favorites here.</p>
              <a href="/shop" class="wishlist-explore-btn">
                <span>EXPLORE CATALOG</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          `;
          return;
        }

        grid.innerHTML = items.map(item => `
          <div class="wishlist-item-card" data-product-id="${item.id}">
            <button type="button" class="wishlist-remove-btn btn-wishlist-remove" data-id="${item.id}" title="Remove from Wishlist" aria-label="Remove item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
            <div class="wishlist-media-box">
              <a href="/product/${item.id}">
                <img src="${item.image}" alt="${item.name}" class="wishlist-thumb-img" loading="lazy" />
              </a>
            </div>
            <div class="wishlist-info-box">
              <span class="wishlist-category-tag">${(item.categoryLabel || 'SKYNODES').toUpperCase()}</span>
              <h3 class="wishlist-prod-title">
                <a href="/product/${item.id}">${item.name}</a>
              </h3>
              <div class="wishlist-price-row">
                <span class="wishlist-price-val">₹${item.price.toLocaleString('en-IN')}.00</span>
                ${item.originalPrice && item.originalPrice > item.price ? `<span class="wishlist-was-price">₹${item.originalPrice.toLocaleString('en-IN')}</span>` : ''}
              </div>
              <button type="button" class="wishlist-add-cart-btn btn-wishlist-cart" data-id="${item.id}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <span>ADD TO CART</span>
              </button>
            </div>
          </div>
        `).join('');

        grid.querySelectorAll('.btn-wishlist-cart').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const target = items.find(i => i.id === id);
            if (target) {
              addToCart(target);
              window.dispatchEvent(new CustomEvent('open-cart-drawer'));
            }
          });
        });

        grid.querySelectorAll('.btn-wishlist-remove').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            if (id) {
              removeFromWishlist(id);
              renderWishlist();
            }
          });
        });
      }

      renderWishlist();
      window.addEventListener('wishlist-updated', renderWishlist);

      // Inline Auth Form
      document.getElementById('profile-page-login-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const loginCode = (document.getElementById('page-user-country-code') as HTMLSelectElement)?.value || '+91';
        let mobile = (document.getElementById('page-user-mobile-input') as HTMLInputElement)?.value.trim();
        if (mobile) {
          if (mobile.startsWith('+')) {
            mobile = parsePhone(mobile).number;
          }
          const fullPhone = `${loginCode} ${mobile}`;
          localStorage.setItem('google_auth_logged_in', 'true');
          localStorage.setItem('skynodes_pilot_phone', fullPhone);
          localStorage.setItem('skynodes_pilot_name', 'Pilot ' + mobile.slice(-4));
          window.dispatchEvent(new CustomEvent('user-logged-in'));
          checkAuth();
        }
      });

      document.getElementById('page-google-auth-btn')?.addEventListener('click', async () => {
        await triggerGoogleSignIn(
          () => {
            checkAuth();
          },
          (err) => {
            console.error('[Google Sign-In Error]', err);
          }
        );
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProfilePage);
    } else {
      initProfilePage();
    }
    document.addEventListener('astro:page-load', initProfilePage);
  </script>

</body>
</html>
