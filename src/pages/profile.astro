---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pilot Profile & Orders | SKYNODESUAV</title>
  <meta name="description" content="Manage your pilot profile, Google sign-in credentials, shipping address, and order history." />
</head>
<body class="bellavita-page-body">

  <Header />

  <main class="container page-padding reveal-on-scroll">
    <div class="profile-container">
      
      <!-- Unauthenticated State: Rich Bellavita 2-Column Login & Signup Card Benchmark -->
      <div id="auth-logged-out" class="rich-login-card">
        <div class="login-card-grid">
          
          <!-- Left Column: Dark Brand & Feature Cards -->
          <div class="card-left-col">
            <div class="brand-header-wrap">
              <span class="brand-title-lbl">SKYNODESUAV</span>
              <span class="powered-tag">Powered by QuickAuth</span>
            </div>

            <h2 class="card-left-headline">Login now to avail best offers!</h2>

            <div class="card-feature-cards">
              <div class="card-feat-item">
                <div class="star-icon">🌟</div>
                <div class="feat-title">Customer-first</div>
                <div class="feat-desc">Putting you in the center</div>
              </div>

              <div class="card-feat-item">
                <div class="star-icon">🌟</div>
                <div class="feat-title">Transparent</div>
                <div class="feat-desc">Honest from the inside out</div>
              </div>

              <div class="card-feat-item">
                <div class="star-icon">🌟</div>
                <div class="feat-title">Innovative</div>
                <div class="feat-desc">Getting the absolute best for you</div>
              </div>
            </div>
          </div>

          <!-- Right Column: Login Form -->
          <div class="card-right-col">
            <h2 class="card-right-title">Login Here!</h2>

            <form id="profile-page-login-form" class="card-form">
              <!-- Mobile Input Box -->
              <div class="phone-input-wrap">
                <div class="flag-prefix">
                  <span>🇮🇳 +91</span>
                </div>
                <input 
                  type="tel" 
                  id="page-user-mobile-input" 
                  class="mobile-input-field" 
                  placeholder="Enter Mobile Number" 
                  pattern="[0-9]{10}"
                  required 
                />
              </div>

              <!-- Google 1-Click Option -->
              <button type="button" class="google-fast-btn" id="page-google-auth-btn">
                <svg width="18" height="18" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Or Continue with Google</span>
              </button>

              <!-- Checkbox -->
              <label class="offers-checkbox-label">
                <input type="checkbox" checked />
                <span>Notify me with offers & updates</span>
              </label>

              <!-- Submit Black Button -->
              <button type="submit" class="card-submit-btn">
                Submit
              </button>
            </form>

            <p class="card-terms-footnote">
              I accept that I have read & understood your <a href="/privacy">Privacy Policy</a> and <a href="/terms">T&Cs</a>.
            </p>
          </div>

        </div>
      </div>

      <!-- Authenticated Profile View -->
      <div id="auth-logged-in" class="profile-card-grid style-hidden">
        
        <!-- Left: Profile Card -->
        <div class="user-info-card glass-panel">
          <div class="avatar-wrapper">
            <img id="user-avatar-img" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop" alt="User Avatar" class="user-avatar" />
            <span class="online-badge">✓ Verified Pilot</span>
          </div>

          <h2 id="user-display-name" class="user-name">Capt. Hitesh Pilot</h2>
          <p id="user-display-email" class="user-email">hitesh.aeromodels@gmail.com</p>

          <div class="user-meta-list">
            <div class="meta-row">
              <span>Account Type:</span> <strong>Google Pilot Member</strong>
            </div>
            <div class="meta-row">
              <span>Default Shipping:</span> <strong id="user-address">Devlali Camp, Nashik, MH</strong>
            </div>
            <div class="meta-row">
              <span>GSTIN / Tax ID:</span> <strong>27AAAAA0000A1Z5 (Verified)</strong>
            </div>
          </div>

          <button id="google-logout-btn" class="btn-logout">
            Sign Out of Account
          </button>
        </div>

        <!-- Right: Recent Order History -->
        <div class="orders-card glass-panel">
          <h2 class="section-title-sm">RECENT FLIGHT ORDERS & INVOICES</h2>
          
          <div class="order-list">
            <div class="order-item">
              <div class="order-header">
                <div>
                  <strong class="order-id">#AKS-89421</strong>
                  <span class="order-date">Date: August 9, 2026</span>
                </div>
                <span class="status-badge-green">DISPATCHED</span>
              </div>
              <div class="order-details">
                <p>1x O.S. Max 0.46 AX II Engine + 1x Futaba Radio 6k</p>
                <div class="order-footer">
                  <span class="order-price">Total: ₹38,790.00</span>
                  <a href="/invoice" class="view-invoice-link">View GST Invoice 📄</a>
                </div>
              </div>
            </div>

            <div class="order-item">
              <div class="order-header">
                <div>
                  <strong class="order-id">#AKS-78190</strong>
                  <span class="order-date">Date: July 28, 2026</span>
                </div>
                <span class="status-badge-blue">DELIVERED</span>
              </div>
              <div class="order-details">
                <p>1x Seagull Decathlon 122" V2 ARF Airframe</p>
                <div class="order-footer">
                  <span class="order-price">Total: ₹84,990.00</span>
                  <a href="/invoice" class="view-invoice-link">View GST Invoice 📄</a>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>
  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }

    .page-padding {
      padding: 3.5rem 1.25rem 6rem;
    }
    .profile-container {
      max-width: 920px;
      margin: 0 auto;
    }

    .style-hidden {
      display: none !important;
    }

    /* Rich 2-Column Login & Signup Card */
    .rich-login-card {
      background: #000000;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
      max-width: 860px;
      margin: 0 auto;
    }
    .login-card-grid {
      display: grid;
      grid-template-columns: 1fr 1.05fr;
    }

    /* Left Column (Dark #000000) */
    .card-left-col {
      background: #000000;
      color: #ffffff;
      padding: 3rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid #1f1f1f;
    }

    .brand-header-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .brand-title-lbl {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
    }
    .powered-tag {
      font-size: 0.65rem;
      background: rgba(255, 255, 255, 0.15);
      color: #eab308;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-weight: 700;
    }

    .card-left-headline {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 2.5rem;
      color: #ffffff;
    }

    .card-feature-cards {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .card-feat-item {
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      padding: 0.85rem 1.15rem;
      background: rgba(255, 255, 255, 0.03);
      text-align: center;
    }
    .star-icon { font-size: 1.1rem; margin-bottom: 0.2rem; }
    .feat-title { font-size: 0.85rem; font-weight: 800; color: #ffffff; }
    .feat-desc { font-size: 0.72rem; color: #888888; margin-top: 0.1rem; }

    /* Right Column (White #ffffff) */
    .card-right-col {
      background: #ffffff;
      color: #1a1a1a;
      padding: 3.25rem 2.5rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .card-right-title {
      font-family: var(--font-display);
      font-size: 1.45rem;
      font-weight: 800;
      color: #000000;
      margin-bottom: 1.75rem;
      text-align: center;
    }

    .card-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .phone-input-wrap {
      display: flex;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      overflow: hidden;
      background: #ffffff;
      transition: border-color 0.2s;
    }
    .phone-input-wrap:focus-within {
      border-color: #000000;
    }

    .flag-prefix {
      background: #f9fafb;
      border-right: 1px solid #e5e7eb;
      padding: 0.75rem 0.85rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: #374151;
      display: flex;
      align-items: center;
      white-space: nowrap;
    }

    .mobile-input-field {
      flex: 1;
      border: none;
      padding: 0.75rem 0.85rem;
      font-size: 0.9rem;
      outline: none;
      color: #111111;
    }

    .google-fast-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 0.75rem;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #374151;
      cursor: pointer;
      transition: background 0.2s;
    }
    .google-fast-btn:hover { background: #f3f4f6; }

    .offers-checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      color: #6b7280;
      cursor: pointer;
    }
    .offers-checkbox-label input { accent-color: #000000; }

    .card-submit-btn {
      width: 100%;
      background: #000000;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.85rem;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .card-submit-btn:hover {
      background: #222222;
    }

    .card-terms-footnote {
      font-size: 0.72rem;
      color: #9ca3af;
      text-align: center;
      margin-top: 1.75rem;
      line-height: 1.4;
    }
    .card-terms-footnote a {
      color: #6b7280;
      text-decoration: underline;
    }

    /* Profile Grid */
    .profile-card-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 2rem;
    }

    .user-info-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 2rem;
      text-align: center;
    }
    .avatar-wrapper {
      position: relative;
      width: 100px;
      height: 100px;
      margin: 0 auto 1.25rem;
    }
    .user-avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #3b0811;
    }
    .online-badge {
      display: block;
      font-size: 0.68rem;
      font-weight: 800;
      color: #059669;
      background: #ecfdf5;
      padding: 0.2rem 0.5rem;
      border-radius: 99px;
      margin-top: 0.4rem;
    }

    .user-name {
      font-family: var(--font-display);
      font-size: 1.3rem;
      color: #1a1a1a;
      margin-bottom: 0.2rem;
    }
    .user-email {
      font-size: 0.82rem;
      color: #666666;
      margin-bottom: 1.5rem;
    }

    .user-meta-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      text-align: left;
      font-size: 0.82rem;
      border-top: 1px solid #e6e0d5;
      border-bottom: 1px solid #e6e0d5;
      padding: 1rem 0;
      margin-bottom: 1.5rem;
    }
    .meta-row span { color: #666666; display: block; }
    .meta-row strong { color: #1a1a1a; }

    .btn-logout {
      background: #f3eee7;
      color: #ef4444;
      border: 1px solid #e6e0d5;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 0.6rem 1.25rem;
      border-radius: var(--radius-sm);
      width: 100%;
      cursor: pointer;
      transition: var(--transition-fast);
    }
    .btn-logout:hover {
      background: #fee2e2;
      border-color: #fca5a5;
    }

    /* Orders Card */
    .orders-card {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-md);
      padding: 2rem;
    }
    .section-title-sm {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: #3b0811;
      border-bottom: 1.5px solid #e6e0d5;
      padding-bottom: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .order-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .order-item {
      background: #fbf9f5;
      border: 1px solid #e6e0d5;
      border-radius: var(--radius-sm);
      padding: 1.25rem;
    }
    .order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .order-id { font-size: 0.9rem; color: #1a1a1a; }
    .order-date { display: block; font-size: 0.75rem; color: #666666; }
    .status-badge-green { background: #d1fae5; color: #047857; font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; }
    .status-badge-blue { background: #e0f2fe; color: #0369a1; font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; }

    .order-details p { font-size: 0.85rem; color: #333333; margin-bottom: 0.75rem; }
    .order-footer { display: flex; justify-content: space-between; align-items: center; }
    .order-price { font-weight: 800; color: #1a1a1a; font-size: 0.95rem; }
    .view-invoice-link { font-size: 0.8rem; font-weight: 700; color: #3b0811; }

    @media (max-width: 768px) {
      .login-card-grid { grid-template-columns: 1fr; }
      .card-left-col { padding: 2rem 1.5rem 1.5rem; border-right: none; border-bottom: 1px solid #222222; }
      .card-left-headline { font-size: 1.15rem; margin-bottom: 1.25rem; }
      .card-right-col { padding: 2rem 1.5rem; }
      .profile-card-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    function initProfileAuth() {
      const loggedOutBox = document.getElementById('auth-logged-out');
      const loggedInBox = document.getElementById('auth-logged-in');
      const pageForm = document.getElementById('profile-page-login-form');
      const googleBtn = document.getElementById('page-google-auth-btn');
      const logoutBtn = document.getElementById('google-logout-btn');

      const isAuth = localStorage.getItem('google_auth_logged_in') === 'true';

      function renderState(authed: boolean) {
        if (authed) {
          loggedOutBox?.classList.add('style-hidden');
          loggedInBox?.classList.remove('style-hidden');
        } else {
          loggedOutBox?.classList.remove('style-hidden');
          loggedInBox?.classList.add('style-hidden');
        }
      }

      renderState(isAuth);

      pageForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const mobileInput = document.getElementById('page-user-mobile-input') as HTMLInputElement;
        if (mobileInput && mobileInput.value) {
          localStorage.setItem('google_auth_logged_in', 'true');
          renderState(true);
        }
      });

      googleBtn?.addEventListener('click', () => {
        localStorage.setItem('google_auth_logged_in', 'true');
        renderState(true);
      });

      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem('google_auth_logged_in');
        renderState(false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProfileAuth);
    } else {
      initProfileAuth();
    }
    document.addEventListener('astro:page-load', initProfileAuth);
  </script>

</body>
</html>
