---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dynamic 3D Flight Simulation | AKS Aeromodels</title>
  <meta name="description" content="Experience realistic 3D aerobatic flight loops, wingtip vapor trails, interactive joystick pilot controls, and real-time flight physics." />
</head>
<body class="flight-sim-theme">

  <Header />

  <!-- Fixed 3D Canvas -->
  <div id="canvas-container">
    <canvas id="webgl-canvas"></canvas>
  </div>

  <!-- Flight HUD & Pilot Controls Overlay -->
  <div class="sim-hud-overlay">
    
    <!-- Top Telemetry & Mode Selector -->
    <div class="hud-bar glass-hud-bar">
      <div class="hud-left">
        <span class="hud-radar-dot"></span>
        <span class="hud-title">3D AEROBATIC FLIGHT SIMULATOR</span>
      </div>

      <div class="hud-center-instruments">
        <div class="inst-box">
          <span class="inst-label">ALTITUDE</span>
          <span class="inst-val" id="hud-alt">320 M</span>
        </div>
        <div class="inst-box">
          <span class="inst-label">AIRSPEED</span>
          <span class="inst-val" id="hud-speed">142 KM/H</span>
        </div>
        <div class="inst-box">
          <span class="inst-label">G-FORCE</span>
          <span class="inst-val" id="hud-gforce">+3.2 G</span>
        </div>
      </div>

      <div class="hud-right">
        <button id="pilot-mode-toggle" class="cyber-btn-toggle">
          🎮 PILOT STEER MODE: <span id="pilot-mode-status">AUTOPILOT</span>
        </button>
      </div>
    </div>

    <!-- Artificial Horizon Pitch/Bank Indicator Overlay -->
    <div class="horizon-indicator glass-hud-bar">
      <div class="horizon-pitch-line" id="horizon-pitch-line"></div>
      <div class="horizon-center-cross">+</div>
      <span class="horizon-label">ATTITUDE</span>
    </div>

    <!-- Interactive Steer Hint overlay when Pilot Mode is ON -->
    <div id="pilot-hint" class="pilot-hint-box glass-hud-bar hidden">
      <span>🖱️ MOVE MOUSE TO STEER PLANE FREELY IN 3D SKY</span>
    </div>

  </div>

  <!-- Scrollable Storytelling Wrapper for Autopilot Flight Path -->
  <main class="sim-story-wrapper">
    
    <!-- Hero / Takeoff -->
    <section class="sim-section" id="flight-sec-0">
      <div class="sim-card glass-sim-card">
        <span class="sim-tag">STAGE 01 / TAKEOFF</span>
        <h1 class="sim-title">DYNAMIC 3D FLIGHT PATH</h1>
        <p class="sim-desc">
          The aircraft isn't fixed in the center. Scroll down to watch it execute high-speed barrel rolls, circular loops, and inverted flybys across full 3D space!
        </p>
        <div class="scroll-anim-hint">↓ SCROLL TO INITIATE FLIGHT LOOPS ↓</div>
      </div>
    </section>

    <!-- Maneuver 1: High Alpha Climb -->
    <section class="sim-section" id="flight-sec-1">
      <div class="sim-card glass-sim-card left-card">
        <span class="sim-tag">MANEUVER 01 / HIGH ALPHA CLIMB</span>
        <h2 class="sim-title">45° VERTICAL ASCENT</h2>
        <p class="sim-desc">
          Powered by the 2212 1400KV brushless motor, the airframe climbs rapidly while maintaining total aileron control authority.
        </p>
      </div>
    </section>

    <!-- Maneuver 2: 360 Degree Loop -->
    <section class="sim-section" id="flight-sec-2">
      <div class="sim-card glass-sim-card right-card">
        <span class="sim-tag">MANEUVER 02 / BARREL ROLL</span>
        <h2 class="sim-title">360° CIRCULAR LOOP</h2>
        <p class="sim-desc">
          Dynamic aerodynamic banking. Notice how the wings tilt gracefully along the 3D spline trajectory while trailing glowing wingtip vortices.
        </p>
      </div>
    </section>

    <!-- Maneuver 3: Low Pass Knife Edge -->
    <section class="sim-section" id="flight-sec-3">
      <div class="sim-card glass-sim-card left-card">
        <span class="sim-tag">MANEUVER 03 / KNIFE EDGE</span>
        <h2 class="sim-title">SIDEWAYS HORIZONTAL PASS</h2>
        <p class="sim-desc">
          Rudder-driven side force keeps the aircraft flying level on its side at 140 km/h with zero altitude loss.
        </p>
      </div>
    </section>

    <!-- Maneuver 4: Runway Approach -->
    <section class="sim-section" id="flight-sec-4">
      <div class="sim-card glass-sim-card right-card">
        <span class="sim-tag">MANEUVER 04 / TOUCHDOWN</span>
        <h2 class="sim-title">PRECISION RUNWAY APPROACH</h2>
        <p class="sim-desc">
          Flaps deployed, engine throttled down to 25%. Smooth flare maneuver into the illuminated landing zone.
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="sim-cta-section">
      <div class="sim-card glass-sim-card center-card">
        <h2>EXPERIENCE FULL RC AVIATION</h2>
        <p>Order your ARF aerobatic plane kit today and master contest-grade flight maneuvers.</p>
        <div class="cta-btns">
          <a href="/shop?category=aeromodels" class="btn-cyan-glow">BUY NOW ➔</a>
          <a href="/pro-experience" class="btn-outline-glow">PRO VISION SHOWCASE</a>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <Footer />

  <!-- Three.js + Spline Flight Physics Script -->
  <script>
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
    if (canvas) {
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x060913, 0.03);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 2, 12);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.3;

      // Lights
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0x00f2fe, 3.0);
      mainLight.position.set(5, 10, 5);
      scene.add(mainLight);

      const backLight = new THREE.DirectionalLight(0xff007f, 2.0);
      backLight.position.set(-5, -5, -5);
      scene.add(backLight);

      // Starfield Particle Clouds
      const pGeo = new THREE.BufferGeometry();
      const pCount = 1500;
      const pPos = new Float32Array(pCount * 3);
      for (let i = 0; i < pCount * 3; i += 3) {
        pPos[i] = (Math.random() - 0.5) * 45;
        pPos[i + 1] = (Math.random() - 0.5) * 45;
        pPos[i + 2] = (Math.random() - 0.5) * 45;
      }
      pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
      const starfield = new THREE.Points(pGeo, new THREE.PointsMaterial({
        color: 0x00f2fe, size: 0.05, transparent: true, opacity: 0.5
      }));
      scene.add(starfield);

      // 3D Aerobatic Flight Path Spline Curve (Looping across full viewport)
      const flightCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-4, -2.5, 3),   // Takeoff Bottom-Left
        new THREE.Vector3(-2, 1.5, 1),    // Climb Up
        new THREE.Vector3(3, 2.8, -2),    // Top-Right Loop
        new THREE.Vector3(4, -1.0, 0),    // Right Wing Dive
        new THREE.Vector3(0, -2.2, 2),    // Low Knife Edge Center Pass
        new THREE.Vector3(-3.5, 0.5, -1), // Inverted Bank
        new THREE.Vector3(0, 0, 1)        // Center Touchdown Final
      ]);

      // Draw Flight Path Trajectory Line
      const points = flightCurve.getPoints(100);
      const lineGeo = new THREE.BufferGeometry().setFromPoints(points);
      const lineMat = new THREE.LineDashedMaterial({
        color: 0x00f2fe,
        dashSize: 0.2,
        gapSize: 0.1,
        transparent: true,
        opacity: 0.35
      });
      const pathLine = new THREE.Line(lineGeo, lineMat);
      pathLine.computeLineDistances();
      scene.add(pathLine);

      // Aircraft Mesh Group
      const planeGroup = new THREE.Group();
      scene.add(planeGroup);

      let propMesh: THREE.Object3D;

      function createSimAirplane(): THREE.Group {
        const group = new THREE.Group();

        // Fuselage
        const fuseGeo = new THREE.ConeGeometry(0.55, 4.5, 32);
        const fuseMat = new THREE.MeshStandardMaterial({ color: 0x0e1726, metalness: 0.85, roughness: 0.2 });
        const fuselage = new THREE.Mesh(fuseGeo, fuseMat);
        fuselage.rotation.x = Math.PI / 2;
        group.add(fuselage);

        // Canopy
        const canopyGeo = new THREE.SphereGeometry(0.38, 32, 32);
        const canopyMat = new THREE.MeshPhysicalMaterial({ color: 0x00f2fe, transmission: 0.85, transparent: true, roughness: 0.05 });
        const canopy = new THREE.Mesh(canopyGeo, canopyMat);
        canopy.scale.set(0.75, 0.45, 1.9);
        canopy.position.set(0, 0.28, 0.3);
        group.add(canopy);

        // Wings
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, 0);
        wingShape.lineTo(3.8, -1.2);
        wingShape.lineTo(3.4, -1.8);
        wingShape.lineTo(0, -1.2);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.06, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: 0.03, bevelThickness: 0.03 };
        const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
        const wingMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.6, roughness: 0.3 });

        const leftWing = new THREE.Mesh(wingGeo, wingMat);
        leftWing.rotation.x = Math.PI / 2;
        leftWing.position.set(0, 0, 0.5);
        group.add(leftWing);

        const rightWing = leftWing.clone();
        rightWing.scale.x = -1;
        group.add(rightWing);

        // Propeller
        const propGeo = new THREE.BoxGeometry(1.4, 0.12, 0.03);
        const propMat = new THREE.MeshBasicMaterial({ color: 0x00f2fe });
        const prop = new THREE.Mesh(propGeo, propMat);
        prop.position.set(0, 0, 2.2);
        propMesh = prop;
        group.add(prop);

        // Tail
        const tailGeo = new THREE.BoxGeometry(0.05, 1.1, 0.9);
        const tail = new THREE.Mesh(tailGeo, wingMat);
        tail.position.set(0, 0.5, -1.7);
        tail.rotation.x = -0.2;
        group.add(tail);

        return group;
      }

      // Load Model or fallback
      const loader = new GLTFLoader();
      loader.load('/airplane.glb', (gltf) => {
        const loadedModel = gltf.scene;
        const box = new THREE.Box3().setFromObject(loadedModel);
        const scale = 5.5 / Math.max(box.getSize(new THREE.Vector3()).x, box.getSize(new THREE.Vector3()).y, box.getSize(new THREE.Vector3()).z);
        loadedModel.scale.set(scale, scale, scale);
        planeGroup.add(loadedModel);
      }, undefined, () => {
        const simMesh = createSimAirplane();
        planeGroup.add(simMesh);
      });

      // Pilot Manual Steer Mode Toggle
      let isPilotMode = false;
      let mouseX = 0;
      let mouseY = 0;

      document.getElementById('pilot-mode-toggle')?.addEventListener('click', () => {
        isPilotMode = !isPilotMode;
        const statusEl = document.getElementById('pilot-mode-status');
        const hintEl = document.getElementById('pilot-hint');
        if (statusEl) statusEl.textContent = isPilotMode ? 'MANUAL PILOT 🕹️' : 'AUTOPILOT';
        if (hintEl) hintEl.classList.toggle('hidden', !isPilotMode);
      });

      window.addEventListener('mousemove', (e) => {
        if (!isPilotMode) return;
        mouseX = (e.clientX / window.innerWidth - 0.5) * 6;
        mouseY = -(e.clientY / window.innerHeight - 0.5) * 4;
      });

      // Scroll Progress for Autopilot Flight Trajectory
      let scrollProgress = 0;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.sim-story-wrapper',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
          onUpdate: (self) => {
            scrollProgress = self.progress;

            // Dynamic HUD calculations
            const altEl = document.getElementById('hud-alt');
            const speedEl = document.getElementById('hud-speed');
            const gforceEl = document.getElementById('hud-gforce');
            const horizonLine = document.getElementById('horizon-pitch-line');

            if (altEl) altEl.textContent = `${Math.floor(180 + scrollProgress * 240)} M`;
            if (speedEl) speedEl.textContent = `${Math.floor(110 + Math.sin(scrollProgress * Math.PI * 3) * 35)} KM/H`;
            if (gforceEl) gforceEl.textContent = `+${(2.0 + Math.sin(scrollProgress * 10) * 1.8).toFixed(1)} G`;
            if (horizonLine) {
              const rollDeg = Math.sin(scrollProgress * Math.PI * 4) * 30;
              horizonLine.style.transform = `translate(-50%, -50%) rotate(${rollDeg}deg)`;
            }
          }
        }
      });

      // Render Loop & Flight Physics
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        if (propMesh) propMesh.rotation.z = elapsedTime * 25;
        starfield.rotation.y = elapsedTime * 0.01;

        if (isPilotMode) {
          // Manual Pilot Mode: Inertia follow cursor
          planeGroup.position.x += (mouseX - planeGroup.position.x) * 0.05;
          planeGroup.position.y += (mouseY - planeGroup.position.y) * 0.05;
          planeGroup.rotation.z = -(mouseX - planeGroup.position.x) * 0.2;
          planeGroup.rotation.x = (mouseY - planeGroup.position.y) * 0.15;
        } else {
          // Autopilot Mode: Follow 3D CatmullRom Curve
          const t = Math.max(0.001, Math.min(0.999, scrollProgress));
          const point = flightCurve.getPointAt(t);
          const tangent = flightCurve.getTangentAt(t).clone().normalize();

          planeGroup.position.copy(point);

          // Point aircraft nose forward along flight vector
          const lookAtTarget = point.clone().add(tangent);
          planeGroup.lookAt(lookAtTarget);
          planeGroup.rotateY(Math.PI); // Rotate 180° so nose faces forward

          // Smooth controlled wing banking into turns
          const turnBank = Math.sin(t * Math.PI * 3) * 0.35;
          planeGroup.rotateZ(turnBank);
        }

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  </script>

  <style>
    :global(body.flight-sim-theme) {
      background-color: #060913 !important;
      color: #f8fafc !important;
      overflow-x: hidden;
      font-family: var(--font-main);
    }

    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    #webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    .glass-hud-bar {
      background: rgba(10, 15, 30, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 242, 254, 0.3);
      border-radius: 12px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    }

    .sim-hud-overlay {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
    }

    .hud-bar {
      position: absolute;
      top: 5.5rem;
      left: 2rem;
      right: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1.5rem;
      pointer-events: auto;
    }

    .hud-left {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .hud-radar-dot {
      width: 10px;
      height: 10px;
      background: #00f2fe;
      border-radius: 50%;
      box-shadow: 0 0 10px #00f2fe;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.8); opacity: 0.4; }
    }
    .hud-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.12em;
    }

    .hud-center-instruments {
      display: flex;
      gap: 2rem;
    }
    .inst-box {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .inst-label { font-size: 0.65rem; color: #64748b; font-weight: 700; }
    .inst-val { font-size: 0.9rem; color: #ffffff; font-weight: 800; font-family: var(--font-display); }

    .cyber-btn-toggle {
      background: rgba(0, 242, 254, 0.12);
      border: 1px solid rgba(0, 242, 254, 0.4);
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.45rem 1rem;
      border-radius: 8px;
      letter-spacing: 0.05em;
      transition: var(--transition-fast);
    }
    .cyber-btn-toggle:hover {
      background: rgba(0, 242, 254, 0.25);
    }

    /* Artificial Horizon Indicator */
    .horizon-indicator {
      position: absolute;
      left: 2rem;
      bottom: 2rem;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      overflow: hidden;
      pointer-events: auto;
    }
    .horizon-pitch-line {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 180%;
      height: 2px;
      background: #00f2fe;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 8px #00f2fe;
    }
    .horizon-center-cross {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #ffffff;
      font-weight: 900;
      font-size: 1.2rem;
    }
    .horizon-label {
      position: absolute;
      bottom: 0.4rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.6rem;
      font-weight: 800;
      color: #64748b;
    }

    /* Pilot Hint Box */
    .pilot-hint-box {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      padding: 0.75rem 1.75rem;
      color: #00f2fe;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      pointer-events: auto;
    }
    .pilot-hint-box.hidden { display: none; }

    /* Scroll Story Wrapper */
    .sim-story-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
    }
    .sim-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 2rem 5%;
    }

    .glass-sim-card {
      background: rgba(10, 15, 30, 0.75);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(0, 242, 254, 0.25);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
      border-radius: 20px;
      padding: 2.5rem;
      max-width: 480px;
      width: 100%;
    }

    .left-card { margin-left: 5%; }
    .right-card { margin-left: auto; margin-right: 5%; }
    .center-card { margin: 0 auto; max-width: 650px; text-align: center; }

    .sim-tag {
      font-size: 0.72rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.15em;
      margin-bottom: 0.6rem;
      display: block;
    }
    .sim-title {
      font-size: 1.8rem;
      color: #ffffff;
      margin-bottom: 1rem;
      font-weight: 800;
    }
    .sim-desc {
      font-size: 0.95rem;
      color: #94a3b8;
      line-height: 1.6;
    }
    .scroll-anim-hint {
      margin-top: 1.5rem;
      font-size: 0.8rem;
      font-weight: 800;
      color: #00f2fe;
      letter-spacing: 0.1em;
      animation: bounce 1.5s infinite;
    }

    .sim-cta-section {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1.5rem;
    }
    .sim-cta-section h2 { font-size: 2.5rem; color: #ffffff; margin-bottom: 1rem; font-weight: 800; }
    .sim-cta-section p { font-size: 1.05rem; color: #94a3b8; margin-bottom: 2rem; }
    .cta-btns { display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; }

    .btn-cyan-glow {
      background: linear-gradient(135deg, #00f2fe, #06b6d4);
      color: #060913;
      font-weight: 800;
      padding: 0.9rem 2.25rem;
      border-radius: 10px;
      font-size: 0.95rem;
    }
    .btn-outline-glow {
      background: rgba(255, 255, 255, 0.05);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      color: #ffffff;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 10px;
      font-size: 0.95rem;
    }

    @media (max-width: 900px) {
      .hud-bar { flex-direction: column; gap: 0.5rem; }
      .hud-center-instruments { display: none; }
      .left-card, .right-card { margin: 0 auto; }
      .horizon-indicator { display: none; }
    }
  </style>

</body>
</html>
