---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKYNODES 3D WebGL Open-World RC Flight Simulator 2026 | Metropolis & Airport</title>
  <meta name="description" content="Fly in a massive AAA 3D WebGL Metropolis with 100+ Skyscrapers, Airport Terminal, River Bridge, City Road Networks, Runway Touchdown Landing Guidance, and Pilot Missions!" />
  <!-- Three.js 3D Engine CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body class="sim-3d-body">

  <Header />

  <main class="sim-3d-main">
    
    <!-- 3D Simulator Top Bar -->
    <div class="sim-top-bar">
      <div class="sim-brand-title">
        <span class="sim-pill-3d">🚀 2026 AAA 3D OPEN-WORLD METROPOLIS SIMULATOR</span>
        <h1 class="sim-main-headline">SKYNODES 3D AIRBORNE ACE</h1>
      </div>

      <!-- Control Bar Buttons -->
      <div class="sim-quick-toggles">
        <button type="button" id="open-hangar-btn" class="sim-toggle-btn highlight-btn">
          🛩️ HANGAR FLEET
        </button>
        <button type="button" id="toggle-cam-btn" class="sim-toggle-btn">
          🎥 CAM: <span id="cam-mode-lbl">CHASE 3D</span> <kbd>C</kbd>
        </button>
        <button type="button" id="toggle-smoke-btn" class="sim-toggle-btn">
          💨 SMOKE TRAIL <kbd>Space</kbd>
        </button>
        <button type="button" id="toggle-fullscreen-btn" class="sim-toggle-btn fs-btn">
          ⛶ FULLSCREEN
        </button>
      </div>
    </div>

    <!-- 3D WebGL Stage Viewport Box -->
    <div class="sim-3d-viewport-box" id="viewport-box">
      
      <!-- 2026 Glass HUD Dashboard -->
      <div class="hud-glass-overlay" id="hud-glass">
        
        <!-- Left HUD: Selected Aircraft & Gyro Horizon -->
        <div class="hud-widget-left">
          <div class="plane-active-badge" id="hud-active-plane-lbl">✈️ SEAGULL DECATHLON 122"</div>
          <div class="horizon-circle">
            <div class="horizon-line" id="gyro-line"></div>
          </div>
          <div class="hud-sub-stat">PITCH: <span id="pitch-deg">0°</span> | ROLL: <span id="roll-deg">0°</span></div>
        </div>

        <!-- Center HUD: Speed, Altitude & Runway Approach Guide -->
        <div class="hud-widget-center">
          <div class="hud-big-readout">
            <div class="readout-block">
              <span class="readout-label">AIRSPEED</span>
              <span class="readout-val" id="hud-spd-val">0</span>
              <span class="readout-unit">KM/H</span>
            </div>
            <div class="readout-divider"></div>
            <div class="readout-block">
              <span class="readout-label">ALTITUDE</span>
              <span class="readout-val" id="hud-alt-val">0</span>
              <span class="readout-unit">METERS</span>
            </div>
          </div>
          
          <!-- Landing Approach Guidance Banner -->
          <div class="landing-guide-banner style-hidden" id="landing-guide-hud">
            🛬 RUNWAY APPROACH ACTIVE — DEPLOY LANDING GEAR & REDUCE PWR (<kbd>Ctrl</kbd>)
          </div>

          <!-- Throttle Power Bar -->
          <div class="throttle-bar-wrap">
            <span class="t-lbl">PWR</span>
            <div class="t-track">
              <div class="t-fill" id="throttle-fill" style="width: 50%;"></div>
            </div>
            <span class="t-pct" id="throttle-pct">50%</span>
          </div>
        </div>

        <!-- Right HUD: Mission Checklist Tracker & Score -->
        <div class="hud-widget-right">
          <div class="hud-score-badge">
            <span class="score-lbl">FLIGHT SCORE</span>
            <span class="score-num" id="hud-score-num">0 PTS</span>
          </div>
          
          <!-- Mission Objectives Box -->
          <div class="hud-mission-box">
            <div class="mission-hdr">🎯 PILOT MISSIONS</div>
            <div class="mission-task" id="m-task-rings"><span>[ ] 1. Sky Rings:</span> <strong id="m-rings-cnt">0/8</strong></div>
            <div class="mission-task" id="m-task-city"><span>[ ] 2. City Slalom:</span> <strong id="m-city-st">PENDING</strong></div>
            <div class="mission-task" id="m-task-land"><span>[ ] 3. Runway Touchdown:</span> <strong id="m-land-st">PENDING</strong></div>
          </div>
        </div>

      </div>

      <!-- 3D WebGL Canvas Container -->
      <div id="three-canvas-container"></div>

      <!-- Interactive 3D Flight Control Deck (Mouse/Touch/Keyboard) -->
      <div class="sim-control-deck" id="control-deck">
        <div class="deck-group">
          <button type="button" class="deck-btn" id="btn-pitch-up">▲ PITCH UP <kbd>S</kbd> / <kbd>↓</kbd></button>
          <button type="button" class="deck-btn" id="btn-pitch-down">▼ PITCH DOWN <kbd>W</kbd> / <kbd>↑</kbd></button>
        </div>
        <div class="deck-group">
          <button type="button" class="deck-btn" id="btn-roll-l">◄ TURN LEFT <kbd>A</kbd> / <kbd>←</kbd></button>
          <button type="button" class="deck-btn" id="btn-roll-r">TURN RIGHT ► <kbd>D</kbd> / <kbd>→</kbd></button>
        </div>
        <div class="deck-group">
          <button type="button" class="deck-btn" id="btn-yaw-l">↰ YAW L <kbd>Q</kbd></button>
          <button type="button" class="deck-btn" id="btn-yaw-r">YAW R ↱ <kbd>E</kbd></button>
        </div>
        <div class="deck-group">
          <button type="button" class="deck-btn pwr-btn" id="btn-pwr-up">⚡ PWR + <kbd>Shift</kbd></button>
          <button type="button" class="deck-btn pwr-btn" id="btn-pwr-down">🛑 PWR - <kbd>Ctrl</kbd></button>
        </div>
      </div>

      <!-- Aircraft Hangar Selection Modal -->
      <div class="sim-modal-overlay" id="start-modal">
        <div class="modal-card-3d hangar-modal">
          <div class="modal-pill-tag">🛩️ SELECT YOUR 3D RC AIRCRAFT MODEL</div>
          <h2 class="modal-h2">DEVLALI METROPOLIS OPEN WORLD</h2>
          <p class="modal-p">Fly over 100+ Skyscrapers, Airport Terminals, City Roads & River Bridges! Complete 3 Pilot Missions: Clear 8 Sky Rings, Slalom between Skyscrapers, and Land on the Runway to win a **₹1,000 Coupon**.</p>

          <!-- 4 RC Aircraft Models Selection Cards -->
          <div class="hangar-fleet-grid">
            
            <!-- Aircraft 1 -->
            <div class="fleet-card active" data-plane-id="seagull">
              <div class="fleet-badge">BESTSELLER SCALE</div>
              <div class="fleet-img-wrap">
                <span class="fleet-plane-icon">✈️</span>
              </div>
              <h3 class="fleet-title">Seagull Decathlon 122"</h3>
              <p class="fleet-desc">Powered by O.S. Max 0.46 AX II Engine. High-wing scale aerobatic stability with smooth flight response.</p>
              <div class="fleet-stats">
                <span>Speed: 55 km/h</span> | <span>Handling: Stable Scale</span>
              </div>
            </div>

            <!-- Aircraft 2 -->
            <div class="fleet-card" data-plane-id="edge540">
              <div class="fleet-badge red-badge">EXTREME 3D</div>
              <div class="fleet-img-wrap">
                <span class="fleet-plane-icon">🚀</span>
              </div>
              <h3 class="fleet-title">Edge 540 3D Competition</h3>
              <p class="fleet-desc">Powered by DLE 60cc Twin Gas Engine. Low-wing precision competition plane with rapid 3D roll rate.</p>
              <div class="fleet-stats">
                <span>Speed: 85 km/h</span> | <span>Handling: Ultra Agile</span>
              </div>
            </div>

            <!-- Aircraft 3 -->
            <div class="fleet-card" data-plane-id="glider">
              <div class="fleet-badge blue-badge">THERMAL GLIDER</div>
              <div class="fleet-img-wrap">
                <span class="fleet-plane-icon">🪂</span>
              </div>
              <h3 class="fleet-title">Futaba Telemetry Glider</h3>
              <p class="fleet-desc">Wide wingspan thermal glider with low drag, long glide ratio, and ultra-smooth soaring control.</p>
              <div class="fleet-stats">
                <span>Speed: 38 km/h</span> | <span>Handling: Smooth Soar</span>
              </div>
            </div>

            <!-- Aircraft 4 -->
            <div class="fleet-card" data-plane-id="nitroracer">
              <div class="fleet-badge gold-badge">SPEED DEMON</div>
              <div class="fleet-img-wrap">
                <span class="fleet-plane-icon">🏎️</span>
              </div>
              <h3 class="fleet-title">O.S. Engine Nitro Racer</h3>
              <p class="fleet-desc">High-RPM twin-exhaust nitro speed demon for high-velocity pylon racing & vertical climbs.</p>
              <div class="fleet-stats">
                <span>Speed: 115 km/h</span> | <span>Handling: High Speed</span>
              </div>
            </div>

          </div>

          <button type="button" id="btn-start-3d-flight" class="btn-primary-3d">
            ▶ CONFIRM AIRCRAFT & TAKE OFF NOW
          </button>
        </div>
      </div>

      <!-- Game Crash Modal -->
      <div class="sim-modal-overlay style-hidden" id="crash-modal">
        <div class="modal-card-3d crash-glow">
          <div class="modal-pill-tag red-pill">💥 PLANE CRASHED!</div>
          <h2 class="modal-h2" id="crash-title-lbl">AIRCRAFT COLLISION DETECTED</h2>
          <p class="modal-p" id="crash-reason-lbl">Your RC plane collided with a city skyscraper!</p>

          <button type="button" id="btn-retry-crash" class="btn-primary-3d red-btn-3d">
            🔄 RETRY MISSION & TAKE OFF AGAIN
          </button>
        </div>
      </div>

      <!-- Game Victory / Coupon Modal -->
      <div class="sim-modal-overlay style-hidden" id="victory-modal">
        <div class="modal-card-3d victory-glow">
          <div class="modal-pill-tag gold-pill">🏆 ALL MISSIONS ACCOMPLISHED!</div>
          <h2 class="modal-h2" id="v-title-text">MASTER PILOT ACE VICTORY!</h2>
          <p class="modal-p" id="v-sub-text">You successfully cleared Sky Rings, City Slalom, and Runway Touchdown!</p>

          <div class="victory-stats-row">
            <div class="v-stat-card">
              <span class="v-label">FINAL SCORE</span>
              <span class="v-val" id="v-score-lbl">1850 PTS</span>
            </div>
            <div class="v-stat-card">
              <span class="v-label">MISSIONS PASSED</span>
              <span class="v-val">3 / 3 CLEARED</span>
            </div>
          </div>

          <!-- 2026 Discount Coupon Card -->
          <div class="reward-coupon-card">
            <div class="reward-tag-header">🎁 YOUR REWARD DISCOUNT COUPON</div>
            <div class="coupon-code-big">SKYNODE3DPILOT</div>
            <p class="coupon-desc">Use code at checkout to get ₹1,000 OFF on any O.S. Engine, Futaba Radio, or Seagull ARF model!</p>
          </div>

          <div class="modal-btns-flex">
            <button type="button" id="btn-restart-3d" class="btn-secondary-3d">
              🔄 FLY AGAIN
            </button>
            <a href="/shop" class="btn-gold-3d">
              🛒 SHOP WITH ₹1,000 OFF
            </a>
          </div>
        </div>
      </div>

    </div>

  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.sim-3d-body) {
      background-color: #030712 !important;
      color: #f9fafb !important;
      overflow-x: hidden;
    }

    .sim-3d-main {
      max-width: 1240px;
      margin: 0 auto;
      padding: 2rem 1.25rem 5rem;
    }

    .sim-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .sim-pill-3d {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      background: rgba(56, 189, 248, 0.12);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.3rem 0.85rem;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    .sim-main-headline {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: #ffffff;
    }

    .sim-quick-toggles {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .sim-toggle-btn {
      background: #111827;
      border: 1px solid #374151;
      color: #e5e7eb;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .highlight-btn {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      color: #ffffff;
      border-color: #38bdf8;
    }
    .fs-btn {
      background: #1f2937;
      border-color: #4b5563;
      color: #facc15;
    }
    .sim-toggle-btn:hover {
      border-color: #38bdf8;
      color: #ffffff;
    }

    /* 3D Viewport Frame */
    .sim-3d-viewport-box {
      position: relative;
      width: 100%;
      height: 650px;
      background: #000000;
      border-radius: 16px;
      overflow: hidden;
      border: 2px solid #1f2937;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
    }
    .sim-3d-viewport-box:fullscreen {
      border-radius: 0;
      border: none;
      height: 100vh !important;
      width: 100vw !important;
    }

    #three-canvas-container {
      width: 100%;
      height: 100%;
    }
    #three-canvas-container canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    /* Glass HUD Dashboard */
    .hud-glass-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 1.25rem 1.75rem;
      background: linear-gradient(to bottom, rgba(3, 7, 18, 0.88) 0%, rgba(3, 7, 18, 0) 100%);
      pointer-events: none;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      z-index: 10;
    }

    .plane-active-badge {
      font-size: 0.72rem;
      font-weight: 800;
      color: #facc15;
      background: rgba(17, 24, 39, 0.85);
      border: 1px solid rgba(250, 204, 21, 0.3);
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      margin-bottom: 0.6rem;
    }

    .horizon-circle {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      border: 2px solid rgba(56, 189, 248, 0.6);
      background: rgba(15, 23, 42, 0.6);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .horizon-line {
      width: 100%;
      height: 2px;
      background: #38bdf8;
      box-shadow: 0 0 8px #38bdf8;
      transition: transform 0.1s linear;
    }
    .hud-sub-stat {
      font-size: 0.68rem;
      color: #9ca3af;
      margin-top: 0.4rem;
      font-family: monospace;
    }

    .hud-widget-center {
      text-align: center;
    }
    .hud-big-readout {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.6rem 1.5rem;
      border-radius: 12px;
    }
    .readout-block {
      display: flex;
      flex-direction: column;
    }
    .readout-label {
      font-size: 0.62rem;
      color: #9ca3af;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    .readout-val {
      font-family: monospace;
      font-size: 1.6rem;
      font-weight: 900;
      color: #38bdf8;
      line-height: 1.1;
    }
    .readout-unit {
      font-size: 0.6rem;
      color: #6b7280;
      font-weight: 700;
    }
    .readout-divider {
      width: 1px;
      height: 36px;
      background: rgba(255, 255, 255, 0.15);
    }

    .landing-guide-banner {
      background: rgba(34, 197, 94, 0.9);
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      margin-top: 0.5rem;
      letter-spacing: 0.05em;
      box-shadow: 0 0 15px rgba(34, 197, 94, 0.5);
      animation: pulse 1.5s infinite;
    }

    .throttle-bar-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.6rem;
      background: rgba(17, 24, 39, 0.85);
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .t-lbl, .t-pct {
      font-size: 0.68rem;
      font-weight: 800;
      color: #facc15;
      font-family: monospace;
    }
    .t-track {
      flex: 1;
      height: 6px;
      background: #1f2937;
      border-radius: 99px;
      overflow: hidden;
      width: 120px;
    }
    .t-fill {
      height: 100%;
      background: linear-gradient(to right, #38bdf8, #facc15);
      transition: width 0.1s linear;
    }

    .hud-score-badge {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.5rem 1rem;
      border-radius: 10px;
      text-align: right;
      margin-bottom: 0.5rem;
    }
    .score-lbl { font-size: 0.62rem; color: #9ca3af; font-weight: 700; display: block; }
    .score-num { font-family: monospace; font-size: 1.3rem; font-weight: 900; color: #facc15; }

    .hud-mission-box {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.6rem 0.85rem;
      border-radius: 10px;
      text-align: left;
      font-size: 0.68rem;
      width: 200px;
    }
    .mission-hdr { font-weight: 800; color: #38bdf8; margin-bottom: 0.3rem; letter-spacing: 0.05em; }
    .mission-task { color: #cbd5e1; margin-bottom: 0.25rem; display: flex; justify-content: space-between; }
    .mission-task strong { color: #facc15; }
    .mission-task.task-done { color: #4ade80; }
    .mission-task.task-done strong { color: #4ade80; }

    /* Interactive Flight Control Deck (Bottom Bar) */
    .sim-control-deck {
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 0.6rem 1.25rem;
      display: flex;
      gap: 1.25rem;
      align-items: center;
      z-index: 15;
    }
    .deck-group {
      display: flex;
      gap: 0.4rem;
    }
    .deck-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #e2e8f0;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.5rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      touch-action: manipulation;
    }
    .deck-btn:active, .deck-btn.active {
      background: #38bdf8;
      color: #030712;
      border-color: #38bdf8;
    }
    .pwr-btn {
      background: rgba(234, 179, 8, 0.15);
      border-color: rgba(234, 179, 8, 0.4);
      color: #facc15;
    }

    /* Modals Overlays */
    .sim-modal-overlay {
      position: absolute;
      inset: 0;
      background: rgba(3, 7, 18, 0.94);
      backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      z-index: 50;
      overflow-y: auto;
    }
    .style-hidden { display: none !important; }

    .modal-card-3d {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 16px;
      padding: 2.25rem;
      max-width: 780px;
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-pill-tag {
      font-size: 0.7rem;
      font-weight: 800;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 0.85rem;
    }
    .gold-pill { background: rgba(250, 204, 21, 0.15); color: #facc15; }
    .red-pill { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

    .modal-h2 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }
    .modal-p {
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }

    /* Hangar Multi-Fleet Grid */
    .hangar-fleet-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
      text-align: left;
    }
    .fleet-card {
      background: #1e293b;
      border: 1.5px solid #334155;
      border-radius: 10px;
      padding: 1.15rem;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
    }
    .fleet-card.active, .fleet-card:hover {
      border-color: #38bdf8;
      background: #1e293b;
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
    }
    .fleet-badge {
      position: absolute;
      top: 0.85rem;
      right: 0.85rem;
      font-size: 0.62rem;
      font-weight: 800;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.15);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }
    .red-badge { color: #ef4444; background: rgba(239, 68, 68, 0.15); }
