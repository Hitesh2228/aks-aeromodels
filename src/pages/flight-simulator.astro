---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKYNODES 3D WebGL RC Flight Simulator 2026 | Next-Gen Aeromodelling Arcade</title>
  <meta name="description" content="Experience the 2026 Next-Gen 3D WebGL RC Flight Simulator by SKYNODES! Pilot 3D Seagull planes with real 6DOF physics, 3D volumetric sky, Devlali airfield runway, aerobatic rings, and unlock ₹1,000 discount coupons!" />
  <!-- Three.js 3D Engine CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body class="sim-3d-body">

  <Header />

  <main class="sim-3d-main">
    
    <!-- 3D Simulator Top Bar -->
    <div class="sim-top-bar">
      <div class="sim-brand-title">
        <span class="sim-pill-3d">🚀 2026 NEXT-GEN 3D WEBGL SIMULATOR</span>
        <h1 class="sim-main-headline">SKYNODES 3D AIRBORNE PILOT ACE</h1>
      </div>

      <!-- Quick Camera & Sound Toggles -->
      <div class="sim-quick-toggles">
        <button type="button" id="toggle-cam-btn" class="sim-toggle-btn">
          🎥 CAMERA: <span id="cam-mode-lbl">CHASE 3D</span> <kbd>C</kbd>
        </button>
        <button type="button" id="toggle-smoke-btn" class="sim-toggle-btn">
          💨 SMOKE TRAIL <kbd>Space</kbd>
        </button>
      </div>
    </div>

    <!-- 3D WebGL Stage Container -->
    <div class="sim-3d-viewport-box" id="viewport-box">
      
      <!-- 2026 Futuristic 3D Glass HUD Dashboard -->
      <div class="hud-glass-overlay" id="hud-glass">
        
        <!-- Left HUD: Gyro & Pitch -->
        <div class="hud-widget-left">
          <div class="hud-indicator-title">ARTIFICIAL HORIZON</div>
          <div class="horizon-circle">
            <div class="horizon-line" id="gyro-line"></div>
          </div>
          <div class="hud-sub-stat">PITCH: <span id="pitch-deg">0°</span> | ROLL: <span id="roll-deg">0°</span></div>
        </div>

        <!-- Center HUD: Flight Speed & Altitude -->
        <div class="hud-widget-center">
          <div class="hud-big-readout">
            <div class="readout-block">
              <span class="readout-label">AIRSPEED</span>
              <span class="readout-val" id="hud-spd-val">0</span>
              <span class="readout-unit">KM/H</span>
            </div>
            <div class="readout-divider"></div>
            <div class="readout-block">
              <span class="readout-label">ALTITUDE</span>
              <span class="readout-val" id="hud-alt-val">0</span>
              <span class="readout-unit">METERS</span>
            </div>
          </div>
          
          <!-- Throttle Power Bar -->
          <div class="throttle-bar-wrap">
            <span class="t-lbl">PWR</span>
            <div class="t-track">
              <div class="t-fill" id="throttle-fill" style="width: 50%;"></div>
            </div>
            <span class="t-pct" id="throttle-pct">50%</span>
          </div>
        </div>

        <!-- Right HUD: Checkpoint Score & Radar -->
        <div class="hud-widget-right">
          <div class="hud-score-badge">
            <span class="score-lbl">FLIGHT SCORE</span>
            <span class="score-num" id="hud-score-num">0 PTS</span>
          </div>
          <div class="hud-ring-tracker">
            <span class="tracker-lbl">3D RINGS PASSED</span>
            <span class="tracker-count" id="hud-ring-count">0 / 8</span>
          </div>
        </div>

      </div>

      <!-- 3D WebGL Canvas Container -->
      <div id="three-canvas-container"></div>

      <!-- Start Instructions Screen -->
      <div class="sim-modal-overlay" id="start-modal">
        <div class="modal-card-3d">
          <div class="modal-pill-tag">✨ 3D AEROBATIC CHALLENGE</div>
          <h2 class="modal-h2">DEVLALI AIRFIELD 3D SIMULATOR</h2>
          <p class="modal-p">Take control of the 3D Seagull Decathlon RC Aircraft! Fly through 8 Golden Aerial Rings positioned in 3D airspace. Score 1,000+ points to unlock an exclusive **₹1,000 OFF Coupon Code**!</p>

          <!-- 3D Controls Matrix -->
          <div class="controls-matrix-grid">
            <div class="ctrl-box">
              <div class="ctrl-name">ELEVATOR (PITCH)</div>
              <div class="ctrl-keys"><kbd>W</kbd> / <kbd>↑</kbd> Down | <kbd>S</kbd> / <kbd>↓</kbd> Up</div>
            </div>
            <div class="ctrl-box">
              <div class="ctrl-name">AILERON (ROLL)</div>
              <div class="ctrl-keys"><kbd>A</kbd> / <kbd>←</kbd> Left | <kbd>D</kbd> / <kbd>→</kbd> Right</div>
            </div>
            <div class="ctrl-box">
              <div class="ctrl-name">RUDDER (YAW)</div>
              <div class="ctrl-keys"><kbd>Q</kbd> Yaw Left | <kbd>E</kbd> Yaw Right</div>
            </div>
            <div class="ctrl-box">
              <div class="ctrl-name">THROTTLE & BOOST</div>
              <div class="ctrl-keys"><kbd>Shift</kbd> Throttle + | <kbd>Ctrl</kbd> Throttle -</div>
            </div>
          </div>

          <button type="button" id="btn-start-3d-flight" class="btn-primary-3d">
            🚀 START 3D FLIGHT SIMULATOR
          </button>
        </div>
      </div>

      <!-- Game Victory / Coupon Modal -->
      <div class="sim-modal-overlay style-hidden" id="victory-modal">
        <div class="modal-card-3d victory-glow">
          <div class="modal-pill-tag gold-pill">🏆 3D PILOT ACE VICTORY</div>
          <h2 class="modal-h2">AEROMODEL FLIGHT ACCOMPLISHED!</h2>
          <p class="modal-p">Outstanding aerobatic maneuvering over Devlali Airfield!</p>

          <div class="victory-stats-row">
            <div class="v-stat-card">
              <span class="v-label">FINAL SCORE</span>
              <span class="v-val" id="v-score-lbl">1450 PTS</span>
            </div>
            <div class="v-stat-card">
              <span class="v-label">RINGS CLEARED</span>
              <span class="v-val" id="v-rings-lbl">8 / 8</span>
            </div>
          </div>

          <!-- 2026 Discount Coupon Card -->
          <div class="reward-coupon-card">
            <div class="reward-tag-header">🎁 YOUR REWARD DISCOUNT COUPON</div>
            <div class="coupon-code-big">SKYNODE3DPILOT</div>
            <p class="coupon-desc">Use code at checkout to get ₹1,000 OFF on any O.S. Engine, Futaba Radio, or Seagull ARF model!</p>
          </div>

          <div class="modal-btns-flex">
            <button type="button" id="btn-restart-3d" class="btn-secondary-3d">
              🔄 FLY AGAIN
            </button>
            <a href="/shop" class="btn-gold-3d">
              🛒 SHOP WITH ₹1,000 OFF
            </a>
          </div>
        </div>
      </div>

      <!-- Mobile On-Screen 3D Joysticks -->
      <div class="mobile-3d-joysticks">
        <div class="joy-cluster">
          <button type="button" class="joy-btn" id="m-up">▲ PITCH UP</button>
          <button type="button" class="joy-btn" id="m-down">▼ PITCH DOWN</button>
        </div>
        <div class="joy-cluster">
          <button type="button" class="joy-btn" id="m-left">◄ ROLL L</button>
          <button type="button" class="joy-btn" id="m-right">ROLL R ►</button>
        </div>
        <div class="joy-cluster">
          <button type="button" class="joy-btn boost-joy-btn" id="m-boost">⚡ BOOST</button>
        </div>
      </div>

    </div>

  </main>

  <CartDrawer />
  <Footer />

  <style>
    :global(body.sim-3d-body) {
      background-color: #030712 !important;
      color: #f9fafb !important;
      overflow-x: hidden;
    }

    .sim-3d-main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.25rem 5rem;
    }

    .sim-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .sim-pill-3d {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      background: rgba(56, 189, 248, 0.12);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.3rem 0.85rem;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    .sim-main-headline {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: #ffffff;
    }

    .sim-quick-toggles {
      display: flex;
      gap: 0.75rem;
    }
    .sim-toggle-btn {
      background: #111827;
      border: 1px solid #374151;
      color: #e5e7eb;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .sim-toggle-btn:hover {
      border-color: #38bdf8;
      color: #ffffff;
    }

    /* 3D Viewport Frame */
    .sim-3d-viewport-box {
      position: relative;
      width: 100%;
      height: 620px;
      background: #000000;
      border-radius: 16px;
      overflow: hidden;
      border: 2px solid #1f2937;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
    }

    #three-canvas-container {
      width: 100%;
      height: 100%;
    }
    #three-canvas-container canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    /* Glass HUD Dashboard */
    .hud-glass-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 1.25rem 1.75rem;
      background: linear-gradient(to bottom, rgba(3, 7, 18, 0.85) 0%, rgba(3, 7, 18, 0) 100%);
      pointer-events: none;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      z-index: 10;
    }

    .hud-indicator-title {
      font-size: 0.62rem;
      font-weight: 800;
      color: #9ca3af;
      letter-spacing: 0.1em;
      margin-bottom: 0.4rem;
    }

    .horizon-circle {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      border: 2px solid rgba(56, 189, 248, 0.6);
      background: rgba(15, 23, 42, 0.6);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .horizon-line {
      width: 100%;
      height: 2px;
      background: #38bdf8;
      box-shadow: 0 0 8px #38bdf8;
      transition: transform 0.1s linear;
    }
    .hud-sub-stat {
      font-size: 0.68rem;
      color: #9ca3af;
      margin-top: 0.4rem;
      font-family: monospace;
    }

    .hud-widget-center {
      text-align: center;
    }
    .hud-big-readout {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.6rem 1.5rem;
      border-radius: 12px;
    }
    .readout-block {
      display: flex;
      flex-direction: column;
    }
    .readout-label {
      font-size: 0.62rem;
      color: #9ca3af;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    .readout-val {
      font-family: monospace;
      font-size: 1.6rem;
      font-weight: 900;
      color: #38bdf8;
      line-height: 1.1;
    }
    .readout-unit {
      font-size: 0.6rem;
      color: #6b7280;
      font-weight: 700;
    }
    .readout-divider {
      width: 1px;
      height: 36px;
      background: rgba(255, 255, 255, 0.15);
    }

    .throttle-bar-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.6rem;
      background: rgba(17, 24, 39, 0.75);
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .t-lbl, .t-pct {
      font-size: 0.68rem;
      font-weight: 800;
      color: #facc15;
      font-family: monospace;
    }
    .t-track {
      flex: 1;
      height: 6px;
      background: #1f2937;
      border-radius: 99px;
      overflow: hidden;
      width: 120px;
    }
    .t-fill {
      height: 100%;
      background: linear-gradient(to right, #38bdf8, #facc15);
      transition: width 0.1s linear;
    }

    .hud-score-badge {
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.5rem 1rem;
      border-radius: 10px;
      text-align: right;
      margin-bottom: 0.5rem;
    }
    .score-lbl { font-size: 0.62rem; color: #9ca3af; font-weight: 700; display: block; }
    .score-num { font-family: monospace; font-size: 1.3rem; font-weight: 900; color: #facc15; }

    .hud-ring-tracker {
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.4rem 1rem;
      border-radius: 10px;
      text-align: right;
    }
    .tracker-lbl { font-size: 0.62rem; color: #9ca3af; font-weight: 700; display: block; }
    .tracker-count { font-family: monospace; font-size: 1.1rem; font-weight: 800; color: #38bdf8; }

    /* Modals Overlays */
    .sim-modal-overlay {
      position: absolute;
      inset: 0;
      background: rgba(3, 7, 18, 0.92);
      backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      z-index: 50;
    }
    .style-hidden { display: none !important; }

    .modal-card-3d {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 16px;
      padding: 2.5rem;
      max-width: 620px;
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    }
    .modal-pill-tag {
      font-size: 0.7rem;
      font-weight: 800;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
      padding: 0.35rem 0.85rem;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 0.85rem;
    }
    .gold-pill { background: rgba(250, 204, 21, 0.15); color: #facc15; }

    .modal-h2 {
      font-family: var(--font-display);
      font-size: 1.6rem;
      color: #ffffff;
      margin-bottom: 0.75rem;
    }
    .modal-p {
      font-size: 0.88rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }

    .controls-matrix-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      margin-bottom: 2rem;
      text-align: left;
    }
    .ctrl-box {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 0.75rem 1rem;
      border-radius: 8px;
    }
    .ctrl-name { font-size: 0.68rem; font-weight: 800; color: #38bdf8; margin-bottom: 0.25rem; letter-spacing: 0.05em; }
    .ctrl-keys { font-size: 0.78rem; color: #e2e8f0; }

    .btn-primary-3d {
      width: 100%;
      background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
      color: #ffffff;
      font-weight: 800;
      font-size: 1.05rem;
      padding: 1rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      letter-spacing: 0.05em;
      box-shadow: 0 10px 30px rgba(56, 189, 248, 0.3);
    }
    .btn-primary-3d:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 40px rgba(56, 189, 248, 0.5);
    }

    /* Victory Card */
    .victory-stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .v-stat-card {
      background: #1e293b;
      padding: 1rem;
      border-radius: 10px;
      border: 1px solid #334155;
    }
    .v-label { font-size: 0.7rem; color: #94a3b8; font-weight: 700; display: block; margin-bottom: 0.25rem; }
    .v-val { font-family: monospace; font-size: 1.4rem; font-weight: 900; color: #facc15; }

    .reward-coupon-card {
      background: linear-gradient(135deg, #1e1b4b 0%, #311b92 100%);
      border: 2px dashed #818cf8;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .reward-tag-header { font-size: 0.75rem; font-weight: 800; color: #c7d2fe; letter-spacing: 0.08em; }
    .coupon-code-big { font-family: monospace; font-size: 2rem; font-weight: 900; color: #facc15; letter-spacing: 0.18em; margin: 0.5rem 0; text-shadow: 0 0 12px rgba(250, 204, 21, 0.4); }
    .coupon-desc { font-size: 0.78rem; color: #a5b4fc; margin: 0; }

    .modal-btns-flex {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .btn-secondary-3d {
      background: #1e293b;
      color: #ffffff;
      font-weight: 800;
      font-size: 0.9rem;
      padding: 0.85rem;
      border-radius: 8px;
      border: 1px solid #334155;
      cursor: pointer;
    }
    .btn-gold-3d {
      background: #facc15;
      color: #030712;
      font-weight: 800;
      font-size: 0.9rem;
      padding: 0.85rem;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    /* Mobile Controls */
    .mobile-3d-joysticks {
      display: none;
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      right: 1rem;
      justify-content: space-between;
      z-index: 20;
      pointer-events: auto;
    }
    .joy-cluster {
      display: flex;
      gap: 0.5rem;
    }
    .joy-btn {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.65rem 1rem;
      border-radius: 8px;
      touch-action: manipulation;
    }
    .boost-joy-btn { background: #38bdf8; color: #030712; border: none; }

    @media (max-width: 768px) {
      .sim-3d-viewport-box { height: 480px; }
      .mobile-3d-joysticks { display: flex; }
      .controls-matrix-grid { grid-template-columns: 1fr; }
      .hud-indicator-title, .horizon-circle { display: none; }
      .hud-big-readout { padding: 0.4rem 0.85rem; gap: 0.85rem; }
      .readout-val { font-size: 1.2rem; }
    }
  </style>

  <script>
    function init3DFlightSimulator() {
      const container = document.getElementById('three-canvas-container');
      if (!container || typeof (window as any).THREE === 'undefined') return;

      const THREE = (window as any).THREE;

      // 1. Three.js Scene, Camera & Renderer
      const scene = new THREE.Scene();
      scene.background = new THREE.Color('#0f172a');
      scene.fog = new THREE.FogExp2('#0f172a', 0.0008);

      const aspect = container.clientWidth / container.clientHeight;
      const camera = new THREE.PerspectiveCamera(65, aspect, 0.1, 8000);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      container.innerHTML = '';
      container.appendChild(renderer.domElement);

      // 2. Lighting Setup
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfffaed, 1.2);
      dirLight.position.set(300, 800, 400);
      dirLight.castShadow = true;
      dirLight.shadow.mapSize.width = 2048;
      dirLight.shadow.mapSize.height = 2048;
      dirLight.shadow.camera.near = 10;
      dirLight.shadow.camera.far = 2500;
      dirLight.shadow.camera.left = -500;
      dirLight.shadow.camera.right = 500;
      dirLight.shadow.camera.top = 500;
      dirLight.shadow.camera.bottom = -500;
      scene.add(dirLight);

      // Sky Dome Hemisphere Light
      const hemiLight = new THREE.HemisphereLight(0x38bdf8, 0x166534, 0.5);
      scene.add(hemiLight);

      // 3. Environment: Ground Airfield & Runway
      // Ground plane
      const groundGeo = new THREE.PlaneGeometry(8000, 8000);
      const groundMat = new THREE.MeshStandardMaterial({
        color: 0x166534, // Devlali Airfield Green Grass
        roughness: 0.8
      });
      const ground = new THREE.Mesh(groundGeo, groundMat);
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      // Runway Strip (2500m length, 120m width)
      const runwayGeo = new THREE.PlaneGeometry(120, 2500);
      const runwayMat = new THREE.MeshStandardMaterial({
        color: 0x1e293b, // Asphalt Tarmac
        roughness: 0.5
      });
      const runway = new THREE.Mesh(runwayGeo, runwayMat);
      runway.rotation.x = -Math.PI / 2;
      runway.position.set(0, 0.2, 0);
      runway.receiveShadow = true;
      scene.add(runway);

      // Runway Stripes
      for (let z = -1100; z <= 1100; z += 80) {
        const stripeGeo = new THREE.PlaneGeometry(4, 40);
        const stripeMat = new THREE.MeshBasicMaterial({ color: 0xfacc15 });
        const stripe = new THREE.Mesh(stripeGeo, stripeMat);
        stripe.rotation.x = -Math.PI / 2;
        stripe.position.set(0, 0.4, z);
        scene.add(stripe);
      }

      // Airfield Buildings / Hangar Box
      const hangarGeo = new THREE.BoxGeometry(120, 40, 80);
      const hangarMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.4 });
      const hangar = new THREE.Mesh(hangarGeo, hangarMat);
      hangar.position.set(-140, 20, -200);
      hangar.castShadow = true;
      hangar.receiveShadow = true;
      scene.add(hangar);

      // 4. Construct 3D RC Aeromodel Plane
      const planeGroup = new THREE.Group();

      // Fuselage Nose & Body
      const bodyGeo = new THREE.ConeGeometry(3, 18, 16);
      const bodyMat = new THREE.MeshStandardMaterial({ color: 0xef4444, metalness: 0.2, roughness: 0.3 }); // Red aerobatic fuselage
      const body = new THREE.Mesh(bodyGeo, bodyMat);
      body.rotation.x = Math.PI / 2;
      body.castShadow = true;
      planeGroup.add(body);

      // Wings
      const wingGeo = new THREE.BoxGeometry(32, 0.6, 6);
      const wingMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.2 }); // Crisp white wings
      const wings = new THREE.Mesh(wingGeo, wingMat);
      wings.position.set(0, 0, -2);
      wings.castShadow = true;
      planeGroup.add(wings);

      // Tail Fin
      const tailGeo = new THREE.BoxGeometry(0.5, 6, 4);
      const tailMat = new THREE.MeshStandardMaterial({ color: 0xef4444 });
      const tail = new THREE.Mesh(tailGeo, tailMat);
      tail.position.set(0, 3, 7);
      tail.castShadow = true;
      planeGroup.add(tail);

      // Horizontal Stabilizer
      const hStabGeo = new THREE.BoxGeometry(10, 0.4, 3);
      const hStab = new THREE.Mesh(hStabGeo, wingMat);
      hStab.position.set(0, 0.5, 7);
      planeGroup.add(hStab);

      // Cockpit Canopy Glass
      const canopyGeo = new THREE.SphereGeometry(2.2, 16, 16);
      const canopyMat = new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.1, transparent: true, opacity: 0.7 });
      const canopy = new THREE.Mesh(canopyGeo, canopyMat);
      canopy.scale.set(0.8, 0.8, 1.8);
      canopy.position.set(0, 1.8, -3);
      planeGroup.add(canopy);

      // 3D Propeller Blades
      const propGroup = new THREE.Group();
      const propBladeGeo = new THREE.BoxGeometry(8, 0.8, 0.2);
      const propBladeMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
      const blade1 = new THREE.Mesh(propBladeGeo, propBladeMat);
      const blade2 = new THREE.Mesh(propBladeGeo, propBladeMat);
      blade2.rotation.z = Math.PI / 2;
      propGroup.add(blade1);
      propGroup.add(blade2);
      propGroup.position.set(0, 0, -9.2);
      planeGroup.add(propGroup);

      // Initial Plane Position
      planeGroup.position.set(0, 4, -800);
      scene.add(planeGroup);

      // 5. 3D Aerobatic Checkpoint Rings
      interface Ring3D {
        mesh: any;
        passed: boolean;
        x: number;
        y: number;
        z: number;
      }
      const rings3D: Ring3D[] = [];
      const ringCountTotal = 8;

      const ringGeo = new THREE.TorusGeometry(18, 2.2, 16, 48);
      const ringMat = new THREE.MeshStandardMaterial({
        color: 0xfacc15,
        emissive: 0xfacc15,
        emissiveIntensity: 0.4,
        roughness: 0.2
      });

      for (let i = 0; i < ringCountTotal; i++) {
        const ringMesh = new THREE.Mesh(ringGeo, ringMat);
        const rx = Math.sin(i * 0.9) * 180;
        const ry = 40 + Math.cos(i * 0.8) * 35;
        const rz = -600 + i * 280;
        ringMesh.position.set(rx, ry, rz);
        scene.add(ringMesh);

        rings3D.push({
          mesh: ringMesh,
          passed: false,
          x: rx,
          y: ry,
          z: rz
        });
      }

      // 6. Web Audio Synthesizer Engine
      let audioCtx: AudioContext | null = null;
      let engineOsc: OscillatorNode | null = null;
      let engineGain: GainNode | null = null;

      function startEngineAudio() {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') audioCtx.resume();

          engineOsc = audioCtx.createOscillator();
          engineGain = audioCtx.createGain();

          engineOsc.type = 'sawtooth';
          engineOsc.frequency.setValueAtTime(120, audioCtx.currentTime);
          engineGain.gain.setValueAtTime(0.04, audioCtx.currentTime);

          engineOsc.connect(engineGain);
          engineGain.connect(audioCtx.destination);
          engineOsc.start();
        } catch (e) {}
      }

      function updateEnginePitch(spd: number) {
        if (engineOsc && audioCtx) {
          const targetFreq = 110 + spd * 2.5;
          engineOsc.frequency.setTargetAtTime(targetFreq, audioCtx.currentTime, 0.1);
        }
      }

      function playRingTone() {
        if (!audioCtx) return;
        try {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(659.25, audioCtx.currentTime); // E5
          osc.frequency.exponentialRampToValueAtTime(1046.5, audioCtx.currentTime + 0.2); // C6
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.2);
        } catch (e) {}
      }

      // 7. Flight Dynamics & Physics Engine
      let isSimRunning = false;
      let cameraChaseMode = true; // true = Chase Cam, false = Ground Pilot POV
      let throttle = 50; // 0% to 100%
      let speed = 40; // km/h
      let pitch = 0; // Pitch angle
      let roll = 0; // Roll angle
      let yaw = 0; // Yaw angle
      let score = 0;
      let ringsPassedCount = 0;

      const keys = {
        pitchUp: false,
        pitchDown: false,
        rollLeft: false,
        rollRight: false,
        yawLeft: false,
        yawRight: false,
        throttleUp: false,
        throttleDown: false
      };

      // Keyboard Controls
      window.addEventListener('keydown', (e) => {
        if (['KeyS', 'ArrowDown'].includes(e.code)) keys.pitchUp = true;
        if (['KeyW', 'ArrowUp'].includes(e.code)) keys.pitchDown = true;
        if (['KeyA', 'ArrowLeft'].includes(e.code)) keys.rollLeft = true;
        if (['KeyD', 'ArrowRight'].includes(e.code)) keys.rollRight = true;
        if (['KeyQ'].includes(e.code)) keys.yawLeft = true;
        if (['KeyE'].includes(e.code)) keys.yawRight = true;
        if (['ShiftLeft', 'ShiftRight'].includes(e.code)) keys.throttleUp = true;
        if (['ControlLeft', 'ControlRight'].includes(e.code)) keys.throttleDown = true;

        if (e.code === 'KeyC') {
          cameraChaseMode = !cameraChaseMode;
          const lbl = document.getElementById('cam-mode-lbl');
          if (lbl) lbl.textContent = cameraChaseMode ? 'CHASE 3D' : 'GROUND POV';
        }
      });

      window.addEventListener('keyup', (e) => {
        if (['KeyS', 'ArrowDown'].includes(e.code)) keys.pitchUp = false;
        if (['KeyW', 'ArrowUp'].includes(e.code)) keys.pitchDown = false;
        if (['KeyA', 'ArrowLeft'].includes(e.code)) keys.rollLeft = false;
        if (['KeyD', 'ArrowRight'].includes(e.code)) keys.rollRight = false;
        if (['KeyQ'].includes(e.code)) keys.yawLeft = false;
        if (['KeyE'].includes(e.code)) keys.yawRight = false;
        if (['ShiftLeft', 'ShiftRight'].includes(e.code)) keys.throttleUp = false;
        if (['ControlLeft', 'ControlRight'].includes(e.code)) keys.throttleDown = false;
      });

      // Mobile Touch Handlers
      const mUp = document.getElementById('m-up');
      const mDown = document.getElementById('m-down');
      const mLeft = document.getElementById('m-left');
      const mRight = document.getElementById('m-right');
      const mBoost = document.getElementById('m-boost');

      mUp?.addEventListener('touchstart', (e) => { e.preventDefault(); keys.pitchUp = true; });
      mUp?.addEventListener('touchend', (e) => { e.preventDefault(); keys.pitchUp = false; });
      mDown?.addEventListener('touchstart', (e) => { e.preventDefault(); keys.pitchDown = true; });
      mDown?.addEventListener('touchend', (e) => { e.preventDefault(); keys.pitchDown = false; });
      mLeft?.addEventListener('touchstart', (e) => { e.preventDefault(); keys.rollLeft = true; });
      mLeft?.addEventListener('touchend', (e) => { e.preventDefault(); keys.rollLeft = false; });
      mRight?.addEventListener('touchstart', (e) => { e.preventDefault(); keys.rollRight = true; });
      mRight?.addEventListener('touchend', (e) => { e.preventDefault(); keys.rollRight = false; });
      mBoost?.addEventListener('touchstart', (e) => { e.preventDefault(); keys.throttleUp = true; });
      mBoost?.addEventListener('touchend', (e) => { e.preventDefault(); keys.throttleUp = false; });

      // Start / Restart Handlers
      const startModal = document.getElementById('start-modal');
      const victoryModal = document.getElementById('victory-modal');
      const btnStart = document.getElementById('btn-start-3d-flight');
      const btnRestart = document.getElementById('btn-restart-3d');
      const toggleCamBtn = document.getElementById('toggle-cam-btn');

      toggleCamBtn?.addEventListener('click', () => {
        cameraChaseMode = !cameraChaseMode;
        const lbl = document.getElementById('cam-mode-lbl');
        if (lbl) lbl.textContent = cameraChaseMode ? 'CHASE 3D' : 'GROUND POV';
      });

      function reset3DState() {
        planeGroup.position.set(0, 4, -800);
        planeGroup.rotation.set(0, 0, 0);
        pitch = 0;
        roll = 0;
        yaw = 0;
        throttle = 50;
        speed = 45;
        score = 0;
        ringsPassedCount = 0;

        rings3D.forEach(r => {
          r.passed = false;
          r.mesh.material.color.setHex(0xfacc15);
          r.mesh.material.emissive.setHex(0xfacc15);
        });
      }

      function start3DFlight() {
        reset3DState();
        startModal?.classList.add('style-hidden');
        victoryModal?.classList.add('style-hidden');
        isSimRunning = true;
        startEngineAudio();
      }

      function finish3DFlight() {
        isSimRunning = false;
        if (engineOsc) { try { engineOsc.stop(); } catch (e) {} }

        const vScore = document.getElementById('v-score-lbl');
        const vRings = document.getElementById('v-rings-lbl');
        if (vScore) vScore.textContent = `${score} PTS`;
        if (vRings) vRings.textContent = `${ringsPassedCount} / ${ringCountTotal}`;

        victoryModal?.classList.remove('style-hidden');
      }

      btnStart?.addEventListener('click', start3DFlight);
      btnRestart?.addEventListener('click', start3DFlight);

      // HUD elements
      const hudSpd = document.getElementById('hud-spd-val');
      const hudAlt = document.getElementById('hud-alt-val');
      const hudFill = document.getElementById('throttle-fill');
      const hudPct = document.getElementById('throttle-pct');
      const hudScoreNum = document.getElementById('hud-score-num');
      const hudRingCount = document.getElementById('hud-ring-count');
      const gyroLine = document.getElementById('gyro-line');
      const pitchDeg = document.getElementById('pitch-deg');
      const rollDeg = document.getElementById('roll-deg');

      // 8. 60FPS Render & Physics Loop
      let clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const delta = Math.min(clock.getDelta(), 0.1);

        if (isSimRunning) {
          // Propeller Spin
          propGroup.rotation.z += (speed * 0.4) * delta;

          // Adjust Throttle
          if (keys.throttleUp) throttle = Math.min(100, throttle + 40 * delta);
          if (keys.throttleDown) throttle = Math.max(10, throttle - 40 * delta);

          // Speed Response to Throttle & Pitch Angle
          const targetSpeed = 30 + throttle * 0.8 - Math.sin(pitch) * 25;
          speed = speed * 0.95 + targetSpeed * 0.05;
          updateEnginePitch(speed);

          // Flight Surfaces Input
          if (keys.pitchUp) pitch += 1.2 * delta;
          if (keys.pitchDown) pitch -= 1.2 * delta;
          if (keys.rollLeft) roll += 1.8 * delta;
          if (keys.rollRight) roll -= 1.8 * delta;
          if (keys.yawLeft) yaw += 0.8 * delta;
          if (keys.yawRight) yaw -= 0.8 * delta;

          // Auto-level Roll & Pitch gradually
          roll *= 0.97;
          pitch *= 0.98;

          // Apply Rotation to Plane
          planeGroup.rotation.order = 'YXZ';
          planeGroup.rotation.x = pitch;
          planeGroup.rotation.z = roll;
          planeGroup.rotation.y += yaw * delta;

          // Velocity Vector
          const forward = new THREE.Vector3(0, 0, 1).applyQuaternion(planeGroup.quaternion);
          planeGroup.position.addScaledVector(forward, (speed * 2.5) * delta);

          // Ground Floor Collisions
          if (planeGroup.position.y < 3.5) {
            planeGroup.position.y = 3.5;
            pitch = Math.max(0, pitch); // Level out on runway
          }

          // Camera Positioning
          if (cameraChaseMode) {
            // Smooth Follow Chase Camera Behind Plane
            const camOffset = new THREE.Vector3(0, 12, -45).applyQuaternion(planeGroup.quaternion);
            const targetCamPos = planeGroup.position.clone().add(camOffset);
            camera.position.lerp(targetCamPos, 0.1);

            const lookTarget = planeGroup.position.clone().add(forward.clone().multiplyScalar(50));
            camera.lookAt(lookTarget);
          } else {
            // Stationary Pilot Box Ground Camera
            camera.position.set(-80, 12, -180);
            camera.lookAt(planeGroup.position);
          }

          // Check Ring Collisions & Passing
          rings3D.forEach(ring => {
            if (!ring.passed) {
              const dist = planeGroup.position.distanceTo(ring.mesh.position);
              if (dist < 28) {
                ring.passed = true;
                ring.mesh.material.color.setHex(0x22c55e);
                ring.mesh.material.emissive.setHex(0x22c55e);
                ringsPassedCount++;
                score += 150;
                playRingTone();

                if (ringsPassedCount >= ringCountTotal) {
                  score += 600; // Finish Bonus
                  finish3DFlight();
                }
              }
            }
          });

          // Update Glass HUD Reads
          const pDeg = Math.round(pitch * (180 / Math.PI));
          const rDeg = Math.round(roll * (180 / Math.PI));
          const altM = Math.round(planeGroup.position.y);

          if (hudSpd) hudSpd.textContent = `${Math.round(speed)}`;
          if (hudAlt) hudAlt.textContent = `${altM}`;
          if (hudFill) hudFill.style.width = `${Math.round(throttle)}%`;
          if (hudPct) hudPct.textContent = `${Math.round(throttle)}%`;
          if (hudScoreNum) hudScoreNum.textContent = `${score} PTS`;
          if (hudRingCount) hudRingCount.textContent = `${ringsPassedCount} / ${ringCountTotal}`;
          if (pitchDeg) pitchDeg.textContent = `${pDeg}°`;
          if (rollDeg) rollDeg.textContent = `${rDeg}°`;
          if (gyroLine) gyroLine.style.transform = `rotate(${rDeg}deg) translateY(${pDeg * 0.8}px)`;
        }

        renderer.render(scene, camera);
      }

      // Responsive Resize
      window.addEventListener('resize', () => {
        if (!container) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });

      animate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3DFlightSimulator);
    } else {
      init3DFlightSimulator();
    }
    document.addEventListener('astro:page-load', init3DFlightSimulator);
  </script>

</body>
</html>
