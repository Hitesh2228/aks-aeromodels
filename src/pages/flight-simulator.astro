  </style>

  <script>
    function init3DFlightSimulator() {
      const container = document.getElementById('three-canvas-container');
      if (!container || typeof (window as any).THREE === 'undefined') return;

      const THREE = (window as any).THREE;

      // 1. Three.js Scene, Camera & Renderer
      const scene = new THREE.Scene();
      scene.background = new THREE.Color('#0b1329');
      scene.fog = new THREE.FogExp2('#0b1329', 0.0004);

      const aspect = container.clientWidth / container.clientHeight;
      const camera = new THREE.PerspectiveCamera(65, aspect, 0.1, 12000);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      container.innerHTML = '';
      container.appendChild(renderer.domElement);

      // 2. Lighting Setup
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfffaed, 1.3);
      dirLight.position.set(500, 1200, 600);
      dirLight.castShadow = true;
      dirLight.shadow.mapSize.width = 2048;
      dirLight.shadow.mapSize.height = 2048;
      scene.add(dirLight);

      const hemiLight = new THREE.HemisphereLight(0x38bdf8, 0x1e293b, 0.6);
      scene.add(hemiLight);

      // 3. Environment: Realistic Multi-Texture Ground Terrain (Grass + Asphalt Roads + Water River)
      const groundGeo = new THREE.PlaneGeometry(12000, 12000);
      const groundMat = new THREE.MeshStandardMaterial({ color: 0x15803d, roughness: 0.9 });
      const ground = new THREE.Mesh(groundGeo, groundMat);
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      // Winding Blue Water River
      const riverGeo = new THREE.PlaneGeometry(350, 12000);
      const riverMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.1, metalness: 0.8 });
      const river = new THREE.Mesh(riverGeo, riverMat);
      river.rotation.x = -Math.PI / 2;
      river.position.set(1200, 0.1, 0);
      scene.add(river);

      // 3D River Suspension Bridge
      const bridgeGeo = new THREE.BoxGeometry(450, 12, 60);
      const bridgeMat = new THREE.MeshStandardMaterial({ color: 0x475569 });
      const bridge = new THREE.Mesh(bridgeGeo, bridgeMat);
      bridge.position.set(1200, 6, 0);
      scene.add(bridge);

      // Devlali Main Airport Runway
      const runwayGeo = new THREE.PlaneGeometry(160, 3600);
      const runwayMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.4 });
      const runway = new THREE.Mesh(runwayGeo, runwayMat);
      runway.rotation.x = -Math.PI / 2;
      runway.position.set(0, 0.3, 0);
      runway.receiveShadow = true;
      scene.add(runway);

      // Runway Center Line Markings & Threshold Stripes
      for (let z = -1700; z <= 1700; z += 100) {
        const stripeGeo = new THREE.PlaneGeometry(6, 50);
        const stripeMat = new THREE.MeshBasicMaterial({ color: 0xfacc15 });
        const stripe = new THREE.Mesh(stripeGeo, stripeMat);
        stripe.rotation.x = -Math.PI / 2;
        stripe.position.set(0, 0.5, z);
        scene.add(stripe);
      }

      // Runway Landing Target Zone (Glowing Green Circle)
      const landingZoneGeo = new THREE.RingGeometry(18, 36, 32);
      const landingZoneMat = new THREE.MeshBasicMaterial({ color: 0x22c55e, side: THREE.DoubleSide });
      const landingZone = new THREE.Mesh(landingZoneGeo, landingZoneMat);
      landingZone.rotation.x = -Math.PI / 2;
      landingZone.position.set(0, 0.6, 900);
      scene.add(landingZone);

      // 3D Runway Glide-Slope Guide Rings (Guiding pilot down to runway touchdown)
      const glideRingGeo = new THREE.TorusGeometry(22, 1.8, 16, 32);
      const glideRingMat = new THREE.MeshBasicMaterial({ color: 0x22c55e });
      for (let i = 1; i <= 5; i++) {
        const gRing = new THREE.Mesh(glideRingGeo, glideRingMat);
        gRing.position.set(0, 10 + i * 18, 900 - i * 180);
        scene.add(gRing);
      }

      // City Grid Asphalt Roads & Street Infrastructure
      for (let z = -2000; z <= 2000; z += 500) {
        const roadGeo = new THREE.PlaneGeometry(3000, 45);
        const roadMat = new THREE.MeshStandardMaterial({ color: 0x1f2937 });
        const road = new THREE.Mesh(roadGeo, roadMat);
        road.rotation.x = -Math.PI / 2;
        road.position.set(-1500, 0.25, z);
        scene.add(road);
      }

      // 4. Construct AAA 3D Metropolis Skyline (100+ Detailed Skyscrapers)
      interface CityBuilding {
        mesh: any;
        box: any; // THREE.Box3 for collision check
      }
      const cityBuildings: CityBuilding[] = [];

      function buildMetropolisSkyline() {
        // Build 100+ Detailed Multi-Tier Skyscrapers in City Districts
        for (let i = 0; i < 90; i++) {
          const bw = 50 + Math.random() * 60;
          const bh = 90 + Math.random() * 320; // Up to 410m tall skyscrapers
          const bd = 50 + Math.random() * 60;

          const bGroup = new THREE.Group();

          // Main Building Block
          const bGeo = new THREE.BoxGeometry(bw, bh, bd);
          const bMat = new THREE.MeshStandardMaterial({
            color: (i % 3 === 0) ? 0x0f172a : ((i % 3 === 1) ? 0x1e293b : 0x334155),
            metalness: 0.4,
            roughness: 0.2
          });
          const bMesh = new THREE.Mesh(bGeo, bMat);
          bMesh.position.y = bh / 2;
          bMesh.castShadow = true;
          bMesh.receiveShadow = true;
          bGroup.add(bMesh);

          // Rooftop Spire Antenna & Beacon Light on Tall Towers
          if (bh > 200) {
            const spireGeo = new THREE.CylinderGeometry(0.8, 1.8, 45, 8);
            const spireMat = new THREE.MeshStandardMaterial({ color: 0xef4444, emissive: 0xef4444, emissiveIntensity: 0.6 });
            const spire = new THREE.Mesh(spireGeo, spireMat);
            spire.position.y = bh + 22.5;
            bGroup.add(spire);
          }

          // Rooftop Helipad on Select Buildings
          if (i % 4 === 0) {
            const padGeo = new THREE.CircleGeometry(bw * 0.35, 16);
            const padMat = new THREE.MeshBasicMaterial({ color: 0xfacc15, side: THREE.DoubleSide });
            const pad = new THREE.Mesh(padGeo, padMat);
            pad.rotation.x = -Math.PI / 2;
            pad.position.y = bh + 0.5;
            bGroup.add(pad);
          }

          // District Layout Positioning
          const side = (i % 2 === 0 ? -1 : -2); // City positioned to the left & west of airfield
          const bx = side * (350 + (i % 8) * 110);
          const bz = -2200 + Math.floor(i / 8) * 380;

          bGroup.position.set(bx, 0, bz);
          scene.add(bGroup);

          // Add 3D Bounding Box for precise plane collision checking
          const box = new THREE.Box3().setFromObject(bGroup);
          cityBuildings.push({ mesh: bGroup, box: box });
        }

        // Add 3D Pine Trees in City Parks
        const treeTrunkGeo = new THREE.CylinderGeometry(1.2, 1.8, 12, 8);
        const treeTrunkMat = new THREE.MeshStandardMaterial({ color: 0x78350f });
        const treeFoliageGeo = new THREE.ConeGeometry(14, 30, 8);
        const treeFoliageMat = new THREE.MeshStandardMaterial({ color: 0x14532d });

        for (let t = 0; t < 120; t++) {
          const treeGroup = new THREE.Group();
          const trunk = new THREE.Mesh(treeTrunkGeo, treeTrunkMat);
          trunk.position.y = 6;
          const foliage = new THREE.Mesh(treeFoliageGeo, treeFoliageMat);
          foliage.position.y = 21;

          treeGroup.add(trunk);
          treeGroup.add(foliage);

          const tx = -300 - Math.random() * 2000;
          const tz = -2200 + Math.random() * 4400;
          treeGroup.position.set(tx, 0, tz);
          scene.add(treeGroup);
        }
      }

      buildMetropolisSkyline();

      // 5. Construct Multi-Fleet 3D RC Aircraft Models (With Landing Gear Wheels)
      let currentPlaneId = 'seagull';
      const planeGroup = new THREE.Group();
      let propGroup = new THREE.Group();

      function buildAircraftModel(planeId: string) {
        while(planeGroup.children.length > 0){ 
          planeGroup.remove(planeGroup.children[0]); 
        }

        propGroup = new THREE.Group();
        let bodyColor = 0xef4444;
        let wingColor = 0xffffff;
        let wingSpan = 34;

        if (planeId === 'edge540') {
          bodyColor = 0xd97706;
          wingColor = 0x1e293b;
          wingSpan = 28;
        } else if (planeId === 'glider') {
          bodyColor = 0x0284c7;
          wingColor = 0xffffff;
          wingSpan = 50;
        } else if (planeId === 'nitroracer') {
          bodyColor = 0x111827;
          wingColor = 0xfacc15;
          wingSpan = 24;
        }

        // Fuselage Nose facing -Z forward
        const bodyGeo = new THREE.ConeGeometry(3.2, 20, 16);
        const bodyMat = new THREE.MeshStandardMaterial({ color: bodyColor, metalness: 0.3, roughness: 0.3 });
        const body = new THREE.Mesh(bodyGeo, bodyMat);
        body.rotation.x = -Math.PI / 2;
        body.castShadow = true;
        planeGroup.add(body);

        // Wings
        const wingGeo = new THREE.BoxGeometry(wingSpan, 0.6, 6);
        const wingMat = new THREE.MeshStandardMaterial({ color: wingColor, roughness: 0.2 });
        const wings = new THREE.Mesh(wingGeo, wingMat);
        wings.position.set(0, 0, 2);
        wings.castShadow = true;
        planeGroup.add(wings);

        // Tail Fin
        const tailGeo = new THREE.BoxGeometry(0.5, 6.5, 4);
        const tailMat = new THREE.MeshStandardMaterial({ color: bodyColor });
        const tail = new THREE.Mesh(tailGeo, tailMat);
        tail.position.set(0, 3.2, 8);
        tail.castShadow = true;
        planeGroup.add(tail);

        // Horizontal Stabilizer
        const hStabGeo = new THREE.BoxGeometry(11, 0.4, 3);
        const hStab = new THREE.Mesh(hStabGeo, wingMat);
        hStab.position.set(0, 0.5, 8);
        planeGroup.add(hStab);

        // Canopy Glass
        const canopyGeo = new THREE.SphereGeometry(2.2, 16, 16);
        const canopyMat = new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.1, transparent: true, opacity: 0.7 });
        const canopy = new THREE.Mesh(canopyGeo, canopyMat);
        canopy.scale.set(0.8, 0.8, 1.8);
        canopy.position.set(0, 1.8, 2);
        planeGroup.add(canopy);

        // 3D Landing Gear Wheels Assembly
        const wheelGeo = new THREE.CylinderGeometry(1.2, 1.2, 0.8, 12);
        const wheelMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
        const strutGeo = new THREE.CylinderGeometry(0.2, 0.2, 3, 8);
        const strutMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8 });

        // Left Gear
        const sL = new THREE.Mesh(strutGeo, strutMat); sL.position.set(-3.5, -2, 1); planeGroup.add(sL);
        const wL = new THREE.Mesh(wheelGeo, wheelMat); wL.rotation.z = Math.PI / 2; wL.position.set(-3.5, -3.5, 1); planeGroup.add(wL);

        // Right Gear
        const sR = new THREE.Mesh(strutGeo, strutMat); sR.position.set(3.5, -2, 1); planeGroup.add(sR);
        const wR = new THREE.Mesh(wheelGeo, wheelMat); wR.rotation.z = Math.PI / 2; wR.position.set(3.5, -3.5, 1); planeGroup.add(wR);

        // Tail Wheel
        const wT = new THREE.Mesh(wheelGeo, wheelMat); wT.scale.set(0.6, 0.6, 0.6); wT.rotation.z = Math.PI / 2; wT.position.set(0, -1.8, 8); planeGroup.add(wT);

        // Propeller Nose Spinner
        const propBladeGeo = new THREE.BoxGeometry(9, 0.8, 0.2);
        const propBladeMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
        const b1 = new THREE.Mesh(propBladeGeo, propBladeMat);
        const b2 = new THREE.Mesh(propBladeGeo, propBladeMat);
        b2.rotation.z = Math.PI / 2;
        propGroup.add(b1);
        propGroup.add(b2);
        propGroup.position.set(0, 0, -10.2);
        planeGroup.add(propGroup);

        // Update HUD Active Badge
        const hudPlaneLbl = document.getElementById('hud-active-plane-lbl');
        if (hudPlaneLbl) {
          const nameMap: Record<string, string> = {
            seagull: '✈️ SEAGULL DECATHLON 122"',
            edge540: '🚀 EDGE 540 3D COMPETITION',
            glider: '🪂 FUTABA TELEMETRY GLIDER',
            nitroracer: '🏎️ O.S. ENGINE NITRO RACER'
          };
          hudPlaneLbl.textContent = nameMap[planeId] || '✈️ RC AIRCRAFT';
        }
      }

      buildAircraftModel(currentPlaneId);
      planeGroup.position.set(0, 4, -1200);
      scene.add(planeGroup);

      // Fleet Selection Handling
      const fleetCards = document.querySelectorAll('.fleet-card');
      fleetCards.forEach(card => {
        card.addEventListener('click', () => {
          fleetCards.forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          currentPlaneId = card.getAttribute('data-plane-id') || 'seagull';
          buildAircraftModel(currentPlaneId);
        });
      });

      // 6. 3D Aerobatic Checkpoint Rings
      interface Ring3D {
        mesh: any;
        passed: boolean;
        x: number;
        y: number;
        z: number;
      }
      const rings3D: Ring3D[] = [];
      const ringCountTotal = 8;

      const ringGeo = new THREE.TorusGeometry(20, 2.5, 16, 48);
      const ringMat = new THREE.MeshStandardMaterial({
        color: 0xfacc15,
        emissive: 0xfacc15,
        emissiveIntensity: 0.5,
        roughness: 0.2
      });

      for (let i = 0; i < ringCountTotal; i++) {
        const ringMesh = new THREE.Mesh(ringGeo, ringMat);
        const angle = (i / ringCountTotal) * Math.PI * 2;
        const rx = Math.sin(angle) * 550;
        const ry = 45 + Math.sin(i * 1.5) * 30;
        const rz = -400 + Math.cos(angle) * 650;

        ringMesh.position.set(rx, ry, rz);
        ringMesh.rotation.y = angle + Math.PI / 2;
        scene.add(ringMesh);

        rings3D.push({ mesh: ringMesh, passed: false, x: rx, y: ry, z: rz });
      }

      // 7. 3D Aerobatic Smoke Particles Trail System
      interface SmokePuff {
        mesh: any;
        opacity: number;
        scale: number;
      }
      const smokePuffs: SmokePuff[] = [];
      let isSmokeActive = true;

      const smokeGeo = new THREE.SphereGeometry(1.5, 8, 8);

      function emitSmokePuff() {
        if (!isSmokeActive || !isSimRunning) return;
        const tailWorld = new THREE.Vector3(0, 0.5, 10).applyQuaternion(planeGroup.quaternion).add(planeGroup.position);
        
        const smokeMat = new THREE.MeshBasicMaterial({
          color: 0xffffff,
          transparent: true,
          opacity: 0.55
        });
        const puffMesh = new THREE.Mesh(smokeGeo, smokeMat);
        puffMesh.position.copy(tailWorld);
        scene.add(puffMesh);

        smokePuffs.push({ mesh: puffMesh, opacity: 0.55, scale: 1.0 });
      }

      function updateSmokePuffs(delta: number) {
        for (let i = smokePuffs.length - 1; i >= 0; i--) {
          const p = smokePuffs[i];
          p.scale += 2.0 * delta;
          p.opacity -= 0.6 * delta;
          p.mesh.scale.set(p.scale, p.scale, p.scale);
          p.mesh.material.opacity = p.opacity;

          if (p.opacity <= 0) {
            scene.remove(p.mesh);
            smokePuffs.splice(i, 1);
          }
        }
      }

      // 8. Web Audio Synthesizer Engine
      let audioCtx: AudioContext | null = null;
      let engineOsc: OscillatorNode | null = null;
      let engineGain: GainNode | null = null;

      function startEngineAudio() {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') audioCtx.resume();

          engineOsc = audioCtx.createOscillator();
          engineGain = audioCtx.createGain();

          engineOsc.type = 'sawtooth';
          engineOsc.frequency.setValueAtTime(120, audioCtx.currentTime);
          engineGain.gain.setValueAtTime(0.04, audioCtx.currentTime);

          engineOsc.connect(engineGain);
          engineGain.connect(audioCtx.destination);
          engineOsc.start();
        } catch (e) {}
      }

      function updateEnginePitch(spd: number) {
        if (engineOsc && audioCtx) {
          const targetFreq = 110 + spd * 2.5;
          engineOsc.frequency.setTargetAtTime(targetFreq, audioCtx.currentTime, 0.1);
        }
      }

      function playRingTone() {
        if (!audioCtx) return;
        try {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(659.25, audioCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(1046.5, audioCtx.currentTime + 0.2);
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.2);
        } catch (e) {}
      }

      // 9. Mission & Flight Physics Engine
      let isSimRunning = false;
      let cameraMode = 1;
      let throttle = 50;
      let speed = 40;
      let pitch = 0;
      let roll = 0;
      let yawAngle = 0;
      let score = 0;
      let ringsPassedCount = 0;

      let taskCitySlalomPassed = false;
      let taskRunwayLandPassed = false;

      const keys = {
        pitchUp: false,
        pitchDown: false,
        rollLeft: false,
        rollRight: false,
        yawLeft: false,
        yawRight: false,
        throttleUp: false,
        throttleDown: false
      };

      // Prevent Page Scroll on Control Keys
      window.addEventListener('keydown', (e) => {
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'KeyW', 'KeyS', 'KeyA', 'KeyD', 'KeyQ', 'KeyE', 'ShiftLeft', 'ShiftRight', 'ControlLeft', 'ControlRight'].includes(e.code)) {
          e.preventDefault();
        }

        if (['KeyS', 'ArrowDown'].includes(e.code)) keys.pitchUp = true;
        if (['KeyW', 'ArrowUp'].includes(e.code)) keys.pitchDown = true;
        if (['KeyA', 'ArrowLeft'].includes(e.code)) keys.rollLeft = true;
        if (['KeyD', 'ArrowRight'].includes(e.code)) keys.rollRight = true;
        if (['KeyQ'].includes(e.code)) keys.yawLeft = true;
        if (['KeyE'].includes(e.code)) keys.yawRight = true;
        if (['ShiftLeft', 'ShiftRight'].includes(e.code)) keys.throttleUp = true;
        if (['ControlLeft', 'ControlRight'].includes(e.code)) keys.throttleDown = true;

        if (e.code === 'Space') {
          isSmokeActive = !isSmokeActive;
        }

        if (e.code === 'KeyC') {
          cameraMode = (cameraMode % 3) + 1;
          const lbl = document.getElementById('cam-mode-lbl');
          const modeNames: Record<number, string> = { 1: 'CHASE 3D', 2: 'COCKPIT', 3: 'GROUND TOWER' };
          if (lbl) lbl.textContent = modeNames[cameraMode];
        }
      });

      window.addEventListener('keyup', (e) => {
        if (['KeyS', 'ArrowDown'].includes(e.code)) keys.pitchUp = false;
        if (['KeyW', 'ArrowUp'].includes(e.code)) keys.pitchDown = false;
        if (['KeyA', 'ArrowLeft'].includes(e.code)) keys.rollLeft = false;
        if (['KeyD', 'ArrowRight'].includes(e.code)) keys.rollRight = false;
        if (['KeyQ'].includes(e.code)) keys.yawLeft = false;
        if (['KeyE'].includes(e.code)) keys.yawRight = false;
        if (['ShiftLeft', 'ShiftRight'].includes(e.code)) keys.throttleUp = false;
        if (['ControlLeft', 'ControlRight'].includes(e.code)) keys.throttleDown = false;
      });

      // On-Screen Control Deck Bindings
      const btnPitchUp = document.getElementById('btn-pitch-up');
      const btnPitchDown = document.getElementById('btn-pitch-down');
      const btnRollL = document.getElementById('btn-roll-l');
      const btnRollR = document.getElementById('btn-roll-r');
      const btnYawL = document.getElementById('btn-yaw-l');
      const btnYawR = document.getElementById('btn-yaw-r');
      const btnPwrUp = document.getElementById('btn-pwr-up');
      const btnPwrDown = document.getElementById('btn-pwr-down');

      const bindControl = (el: HTMLElement | null, keyName: keyof typeof keys) => {
        if (!el) return;
        const start = (e: Event) => { e.preventDefault(); keys[keyName] = true; el.classList.add('active'); };
        const end = (e: Event) => { e.preventDefault(); keys[keyName] = false; el.classList.remove('active'); };
        el.addEventListener('mousedown', start);
        el.addEventListener('mouseup', end);
        el.addEventListener('mouseleave', end);
        el.addEventListener('touchstart', start);
        el.addEventListener('touchend', end);
      };

      bindControl(btnPitchUp, 'pitchUp');
      bindControl(btnPitchDown, 'pitchDown');
      bindControl(btnRollL, 'rollLeft');
      bindControl(btnRollR, 'rollRight');
      bindControl(btnYawL, 'yawLeft');
      bindControl(btnYawR, 'yawRight');
      bindControl(btnPwrUp, 'throttleUp');
      bindControl(btnPwrDown, 'throttleDown');

      // Modals & Controls
      const startModal = document.getElementById('start-modal');
      const victoryModal = document.getElementById('victory-modal');
      const crashModal = document.getElementById('crash-modal');
      const btnStart = document.getElementById('btn-start-3d-flight');
      const btnRestart = document.getElementById('btn-restart-3d');
      const btnRetryCrash = document.getElementById('btn-retry-crash');
      const openHangarBtn = document.getElementById('open-hangar-btn');
      const toggleCamBtn = document.getElementById('toggle-cam-btn');
      const toggleSmokeBtn = document.getElementById('toggle-smoke-btn');
      const toggleFsBtn = document.getElementById('toggle-fullscreen-btn');

      openHangarBtn?.addEventListener('click', () => startModal?.classList.remove('style-hidden'));
      toggleCamBtn?.addEventListener('click', () => {
        cameraMode = (cameraMode % 3) + 1;
        const lbl = document.getElementById('cam-mode-lbl');
        const modeNames: Record<number, string> = { 1: 'CHASE 3D', 2: 'COCKPIT', 3: 'GROUND TOWER' };
        if (lbl) lbl.textContent = modeNames[cameraMode];
      });

      toggleSmokeBtn?.addEventListener('click', () => {
        isSmokeActive = !isSmokeActive;
      });

      toggleFsBtn?.addEventListener('click', () => {
        const box = document.getElementById('viewport-box');
        if (!document.fullscreenElement) {
          box?.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen();
        }
      });

      function reset3DState() {
        planeGroup.position.set(0, 4, -1200);
        planeGroup.rotation.set(0, 0, 0);
        pitch = 0;
        roll = 0;
        yawAngle = 0;
        throttle = 50;
        speed = 45;
        score = 0;
        ringsPassedCount = 0;
        taskCitySlalomPassed = false;
        taskRunwayLandPassed = false;

        rings3D.forEach(r => {
          r.passed = false;
          r.mesh.material.color.setHex(0xfacc15);
          r.mesh.material.emissive.setHex(0xfacc15);
        });

        // Reset HUD Mission UI
        const mRingsCnt = document.getElementById('m-rings-cnt');
        const mCitySt = document.getElementById('m-city-st');
        const mLandSt = document.getElementById('m-land-st');
        if (mRingsCnt) mRingsCnt.textContent = '0/8';
        if (mCitySt) mCitySt.textContent = 'PENDING';
        if (mLandSt) mLandSt.textContent = 'PENDING';

        document.getElementById('m-task-rings')?.classList.remove('task-done');
        document.getElementById('m-task-city')?.classList.remove('task-done');
        document.getElementById('m-task-land')?.classList.remove('task-done');
      }

      function start3DFlight() {
        reset3DState();
        startModal?.classList.add('style-hidden');
        victoryModal?.classList.add('style-hidden');
        crashModal?.classList.add('style-hidden');
        isSimRunning = true;
        startEngineAudio();
      }

      function triggerCrash(reason: string) {
        isSimRunning = false;
        if (engineOsc) { try { engineOsc.stop(); } catch (e) {} }

        const crashReasonLbl = document.getElementById('crash-reason-lbl');
        if (crashReasonLbl) crashReasonLbl.textContent = reason;

        crashModal?.classList.remove('style-hidden');
      }

      function checkMissionVictory() {
        if (ringsPassedCount >= ringCountTotal && taskCitySlalomPassed && taskRunwayLandPassed) {
          isSimRunning = false;
          if (engineOsc) { try { engineOsc.stop(); } catch (e) {} }

          const vScore = document.getElementById('v-score-lbl');
          if (vScore) vScore.textContent = `${score + 500} PTS`;

          victoryModal?.classList.remove('style-hidden');
        }
      }

      btnStart?.addEventListener('click', start3DFlight);
      btnRestart?.addEventListener('click', start3DFlight);
      btnRetryCrash?.addEventListener('click', start3DFlight);

      // HUD Reads
      const hudSpd = document.getElementById('hud-spd-val');
      const hudAlt = document.getElementById('hud-alt-val');
      const hudFill = document.getElementById('throttle-fill');
      const hudPct = document.getElementById('throttle-pct');
      const hudScoreNum = document.getElementById('hud-score-num');
      const gyroLine = document.getElementById('gyro-line');
      const pitchDeg = document.getElementById('pitch-deg');
      const rollDeg = document.getElementById('roll-deg');
      const landingGuideHud = document.getElementById('landing-guide-hud');

      // 10. 60FPS Render & Physics Loop
      let clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const delta = Math.min(clock.getDelta(), 0.1);

        if (isSimRunning) {
          // Propeller Spin
          propGroup.rotation.z += (speed * 0.5) * delta;

          // Adjust Throttle
          if (keys.throttleUp) throttle = Math.min(100, throttle + 45 * delta);
          if (keys.throttleDown) throttle = Math.max(10, throttle - 45 * delta);

          let mult = 1.0;
          if (currentPlaneId === 'edge540') mult = 1.35;
          if (currentPlaneId === 'glider') mult = 0.8;
          if (currentPlaneId === 'nitroracer') mult = 1.8;

          const targetSpeed = (30 + throttle * 0.8 - Math.sin(pitch) * 25) * mult;
          speed = speed * 0.95 + targetSpeed * 0.05;
          updateEnginePitch(speed);

          // Flight Surface Rotations
          if (keys.pitchUp) pitch += 1.3 * delta * mult;
          if (keys.pitchDown) pitch -= 1.3 * delta * mult;
          if (keys.rollLeft) roll += 2.2 * delta * mult;
          if (keys.rollRight) roll -= 2.2 * delta * mult;

          // Yaw & Smooth Banking Turns
          if (keys.yawLeft) yawAngle += 1.1 * delta;
          if (keys.yawRight) yawAngle -= 1.1 * delta;

          yawAngle += Math.sin(roll) * 1.1 * delta;

          roll *= 0.96;
          pitch *= 0.98;

          // Apply Rotations to 3D Plane
          planeGroup.rotation.order = 'YXZ';
          planeGroup.rotation.y = yawAngle;
          planeGroup.rotation.x = pitch;
          planeGroup.rotation.z = roll;

          // Forward Velocity Trajectory Vector along facing nose (-Z axis)
          const forwardVec = new THREE.Vector3(0, 0, -1).applyQuaternion(planeGroup.quaternion);
          planeGroup.position.addScaledVector(forwardVec, (speed * 2.5) * delta);

          // Emit 3D Aerobatic Smoke Trail
          emitSmokePuff();

          // Runway Landing Guidance Prompt
          if (planeGroup.position.y < 50 && Math.abs(planeGroup.position.x) < 150) {
            landingGuideHud?.classList.remove('style-hidden');
          } else {
            landingGuideHud?.classList.add('style-hidden');
          }

          // Real Collision Check 1: 3D Metropolis Skyscrapers
          const planeBox = new THREE.Box3().setFromObject(planeGroup);
          for (let b of cityBuildings) {
            if (planeBox.intersectsBox(b.box)) {
              triggerCrash("💥 CRASHED INTO CITY SKYSCRAPER! Avoid buildings!");
              return;
            }
          }

          // Real Collision Check 2: Ground Crash vs Touchdown Landing
          if (planeGroup.position.y <= 3.8) {
            planeGroup.position.y = 3.8;

            // Touchdown Landing Condition on Runway Strip
            if (Math.abs(planeGroup.position.x) < 90 && Math.abs(planeGroup.position.z) < 1600 && speed < 55 && pitch < 0.2) {
              if (!taskRunwayLandPassed) {
                taskRunwayLandPassed = true;
                score += 400;
                const mLandSt = document.getElementById('m-land-st');
                if (mLandSt) mLandSt.textContent = 'DONE ✓';
                document.getElementById('m-task-land')?.classList.add('task-done');
                checkMissionVictory();
              }
            } else {
              // High speed / Hard steep impact outside runway -> CRASH!
              triggerCrash("💥 HARD GROUND IMPACT! Touchdown on Runway strip!");
              return;
            }
          }

          // Task 2: City Slalom Mission Check
          if (!taskCitySlalomPassed && planeGroup.position.x < -300 && planeGroup.position.y < 140) {
            taskCitySlalomPassed = true;
            score += 350;
            const mCitySt = document.getElementById('m-city-st');
            if (mCitySt) mCitySt.textContent = 'DONE ✓';
            document.getElementById('m-task-city')?.classList.add('task-done');
            checkMissionVictory();
          }

          // Camera Modes Logic
          if (cameraMode === 1) {
            const camOffset = new THREE.Vector3(0, 14, 48).applyQuaternion(planeGroup.quaternion);
            const targetCamPos = planeGroup.position.clone().add(camOffset);
            camera.position.lerp(targetCamPos, 0.12);

            const lookTarget = planeGroup.position.clone().add(forwardVec.clone().multiplyScalar(60));
            camera.lookAt(lookTarget);
          } else if (cameraMode === 2) {
            const nosePos = planeGroup.position.clone().add(new THREE.Vector3(0, 1.8, -2).applyQuaternion(planeGroup.quaternion));
            camera.position.copy(nosePos);
            const lookTarget = planeGroup.position.clone().add(forwardVec.clone().multiplyScalar(100));
            camera.lookAt(lookTarget);
          } else {
            camera.position.set(-160, 45, -200);
            camera.lookAt(planeGroup.position);
          }

          // Check Ring Collisions
          rings3D.forEach(ring => {
            if (!ring.passed) {
              const dist = planeGroup.position.distanceTo(ring.mesh.position);
              if (dist < 32) {
                ring.passed = true;
                ring.mesh.material.color.setHex(0x22c55e);
                ring.mesh.material.emissive.setHex(0x22c55e);
                ringsPassedCount++;
                score += 150;
                playRingTone();

                const mRingsCnt = document.getElementById('m-rings-cnt');
                if (mRingsCnt) mRingsCnt.textContent = `${ringsPassedCount}/8`;

                if (ringsPassedCount >= ringCountTotal) {
                  document.getElementById('m-task-rings')?.classList.add('task-done');
                  checkMissionVictory();
                }
              }
            }
          });

          // Update HUD
          const pDeg = Math.round(pitch * (180 / Math.PI));
          const rDeg = Math.round(roll * (180 / Math.PI));
          const altM = Math.round(planeGroup.position.y);

          if (hudSpd) hudSpd.textContent = `${Math.round(speed)}`;
          if (hudAlt) hudAlt.textContent = `${altM}`;
          if (hudFill) hudFill.style.width = `${Math.round(throttle)}%`;
          if (hudPct) hudPct.textContent = `${Math.round(throttle)}%`;
          if (hudScoreNum) hudScoreNum.textContent = `${score} PTS`;
          if (pitchDeg) pitchDeg.textContent = `${pDeg}°`;
          if (rollDeg) rollDeg.textContent = `${rDeg}°`;
          if (gyroLine) gyroLine.style.transform = `rotate(${rDeg}deg) translateY(${pDeg * 0.8}px)`;
        }

        // Update Smoke Puffs Animation
        updateSmokePuffs(delta);

        renderer.render(scene, camera);
      }

      // Responsive Resize
      window.addEventListener('resize', () => {
        if (!container) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });

      animate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3DFlightSimulator);
    } else {
      init3DFlightSimulator();
    }
    document.addEventListener('astro:page-load', init3DFlightSimulator);
  </script>

</body>
</html>
