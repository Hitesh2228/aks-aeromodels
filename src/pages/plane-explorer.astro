---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Component Explorer & Exploded View | AKS Aeromodels</title>
  <meta name="description" content="Interactive 3D aircraft component inspection with camera fly-through zoom, X-Ray exploded view mode, and 3D part pinpoints." />
</head>
<body class="explorer-theme">

  <Header />

  <!-- Canvas Container -->
  <div id="canvas-container">
    <canvas id="webgl-canvas"></canvas>
  </div>

  <!-- HUD Controls Bar -->
  <div class="explorer-hud">
    <div class="hud-top-bar glass-hud">
      <div class="hud-title-group">
        <span class="pulsing-cyan-dot"></span>
        <span class="hud-main-title">3D AIRCRAFT COMPONENT EXPLORER</span>
      </div>

      <div class="hud-mode-switches">
        <button id="exploded-mode-btn" class="cyber-toggle-btn">
          <span class="btn-icon">🧩</span> X-RAY / EXPLODED VIEW: <span id="exploded-status" class="toggle-state">OFF</span>
        </button>
        <button id="wireframe-mode-btn" class="cyber-toggle-btn">
          <span class="btn-icon">🌐</span> HOLO GRID: <span id="wireframe-status" class="toggle-state">OFF</span>
        </button>
      </div>
    </div>

    <!-- Active Component Info Marker (Follows 3D Position) -->
    <div id="part-info-overlay" class="part-info-card glass-hud hidden">
      <div class="part-header">
        <span class="part-num" id="info-part-num">01</span>
        <span class="part-name" id="info-part-name">PROPELLER & SPINNER</span>
      </div>
      <p class="part-desc" id="info-part-desc">Carbon-composite 9x6 two-blade propeller balanced for maximum 14,000 RPM static thrust.</p>
      <div class="part-specs" id="info-part-specs">
        <div class="p-spec"><span>Material:</span><strong>Carbon Composite</strong></div>
        <div class="p-spec"><span>Diameter:</span><strong>9.0 Inches</strong></div>
        <div class="p-spec"><span>Pitch:</span><strong>6.0 Inches</strong></div>
      </div>
    </div>

    <!-- Interactive Component Selector List -->
    <div class="component-selector-nav glass-hud">
      <button class="comp-btn active" data-part="0"><span>00</span> FULL AIRCRAFT</button>
      <button class="comp-btn" data-part="1"><span>01</span> PROPELLER NOSE</button>
      <button class="comp-btn" data-part="2"><span>02</span> BRUSHLESS ENGINE</button>
      <button class="comp-btn" data-part="3"><span>03</span> COCKPIT AVIONICS</button>
      <button class="comp-btn" data-part="4"><span>04</span> WING & SERVO</button>
      <button class="comp-btn" data-part="5"><span>05</span> TAIL STABILIZER</button>
    </div>
  </div>

  <!-- Scroll Sections for Camera Part Fly-Through -->
  <main class="explorer-wrapper">
    
    <!-- Hero / Intro -->
    <section class="explorer-section" id="sec-0">
      <div class="intro-box glass-hud">
        <span class="tech-tag">INTERACTIVE PART FOCUS</span>
        <h1 class="intro-title">COMPONENT FLY-THROUGH</h1>
        <p class="intro-desc">
          Scroll down or click the right navigation bar to fly the 3D camera up close to each engineered component. Toggle X-Ray mode anytime to explode internal parts!
        </p>
        <div class="scroll-down-arrow">↓ SCROLL TO EXPLORE PARTS ↓</div>
      </div>
    </section>

    <!-- Part 1: Propeller -->
    <section class="explorer-section" id="sec-1">
      <!-- Spacer section for ScrollTrigger checkpoint 1 -->
    </section>

    <!-- Part 2: Brushless Engine -->
    <section class="explorer-section" id="sec-2">
      <!-- Spacer section for ScrollTrigger checkpoint 2 -->
    </section>

    <!-- Part 3: Cockpit Avionics -->
    <section class="explorer-section" id="sec-3">
      <!-- Spacer section for ScrollTrigger checkpoint 3 -->
    </section>

    <!-- Part 4: Wing Assembly & Servo -->
    <section class="explorer-section" id="sec-4">
      <!-- Spacer section for ScrollTrigger checkpoint 4 -->
    </section>

    <!-- Part 5: Tail Assembly -->
    <section class="explorer-section" id="sec-5">
      <!-- Spacer section for ScrollTrigger checkpoint 5 -->
    </section>

    <!-- CTA Section -->
    <section class="explorer-cta-section">
      <div class="cta-card glass-hud">
        <h2>READY TO CUSTOMIZE YOUR BUILD?</h2>
        <p>Explore our complete catalog of brushless engines, Futaba transmitters, and contest-grade ARF planes.</p>
        <div class="cta-flex">
          <a href="/shop?category=aeromodels" class="btn-cyber-gold">SHOP ALL AEROMODELS ➔</a>
          <a href="/aircrafts" class="btn-cyber-outline">BACK TO 3D SHOWCASE</a>
        </div>
      </div>
    </section>

  </main>

  <CartDrawer />
  <Footer />

  <!-- 3D Component Engine Script -->
  <script>
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Component Information Database
    const PARTS_DATA = [
      {
        num: '00',
        name: 'FULL AIRCRAFT VIEW',
        desc: 'Contest-grade 1200mm wingspan ARF aerobatic airframe designed for high-alpha maneuvers and high thrust-to-weight performance.',
        specs: [
          { label: 'Wingspan', val: '1200 mm' },
          { label: 'Flying Weight', val: '850 g' },
          { label: 'Airfoil', val: 'Semi-Symmetrical' }
        ],
        targetPos: { x: 0, y: 0, z: 0 },
        camPos: { x: 0, y: 0.5, z: 8.5 }
      },
      {
        num: '01',
        name: 'PROPELLER & SPINNER NOSE',
        desc: '9x6 Carbon-composite 2-blade propeller driven by a CNC precision balanced aluminum spinner cone for maximum thrust.',
        specs: [
          { label: 'Propeller Size', val: '9.0 x 6.0 In' },
          { label: 'Max Thrust RPM', val: '14,000 RPM' },
          { label: 'Blade Material', val: 'Carbon Composite' }
        ],
        targetPos: { x: 0, y: 0, z: 2.1 },
        camPos: { x: 0, y: 0.2, z: 4.0 }
      },
      {
        num: '02',
        name: '2212 1400KV BRUSHLESS ENGINE',
        desc: 'High torque outrunner motor backed by a 40A BEC electronic speed controller providing 2.5kg static thrust output.',
        specs: [
          { label: 'Motor KV Rating', val: '1400 KV' },
          { label: 'Max Current', val: '35 Amps' },
          { label: 'ESC BEC Rating', val: '40A (2-4S LiPo)' }
        ],
        targetPos: { x: 0, y: 0, z: 1.2 },
        camPos: { x: 1.5, y: 0.8, z: 3.2 }
      },
      {
        num: '03',
        name: 'COCKPIT & AVIONICS BAY',
        desc: 'Futaba T-FHSS 2.4GHz telemetry receiver and OSD flight computer insulated inside a lightweight polycarbonate canopy.',
        specs: [
          { label: 'Radio Protocol', val: 'Futaba T-FHSS' },
          { label: 'Telemetry Channels', val: '8 Channels' },
          { label: 'Canopy Type', val: 'Polycarbonate Clear' }
        ],
        targetPos: { x: 0, y: 0.3, z: 0.2 },
        camPos: { x: -1.2, y: 1.2, z: 2.5 }
      },
      {
        num: '04',
        name: 'WING ASSEMBLY & AILERON SERVO',
        desc: 'Laser-cut balsa rib structure with dual high-torque digital S.BUS servos pre-installed for precise roll response.',
        specs: [
          { label: 'Wing Spar', val: 'Carbon Fiber Tube' },
          { label: 'Servo Torque', val: '4.5 kg-cm Digital' },
          { label: 'Aileron Control', val: 'Dual Independent' }
        ],
        targetPos: { x: 2.2, y: 0, z: -0.2 },
        camPos: { x: 3.0, y: 1.5, z: 2.8 }
      },
      {
        num: '05',
        name: 'TAIL STABILIZER & RUDDER',
        desc: 'Lightweight empennage with elevator and vertical rudder control surfaces hinged with pinned nylon hinges.',
        specs: [
          { label: 'Stabilizer Span', val: '420 mm' },
          { label: 'Rudder Throw', val: '+/- 45 Degrees' },
          { label: 'Hinge Type', val: 'Pinned Nylon' }
        ],
        targetPos: { x: 0, y: 0.4, z: -1.6 },
        camPos: { x: -1.8, y: 0.9, z: -3.2 }
      }
    ];

    // Three.js Scene Setup
    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement;
    if (canvas) {
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x070a14, 0.035);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0.5, 8.5);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.3;

      // Lights
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
      scene.add(ambientLight);

      const goldLight = new THREE.DirectionalLight(0xeab308, 2.5);
      goldLight.position.set(6, 8, 6);
      scene.add(goldLight);

      const cyanLight = new THREE.DirectionalLight(0x00f2fe, 2.0);
      cyanLight.position.set(-6, -4, -4);
      scene.add(cyanLight);

      // Starfield Particle Dust
      const particleGeo = new THREE.BufferGeometry();
      const pCount = 1200;
      const pPositions = new Float32Array(pCount * 3);
      for (let i = 0; i < pCount * 3; i += 3) {
        pPositions[i] = (Math.random() - 0.5) * 35;
        pPositions[i + 1] = (Math.random() - 0.5) * 35;
        pPositions[i + 2] = (Math.random() - 0.5) * 35;
      }
      particleGeo.setAttribute('position', new THREE.BufferAttribute(pPositions, 3));
      const starfield = new THREE.Points(particleGeo, new THREE.PointsMaterial({
        color: 0xeab308, size: 0.045, transparent: true, opacity: 0.5
      }));
      scene.add(starfield);

      // Main Aircraft Group
      const mainAircraftGroup = new THREE.Group();
      scene.add(mainAircraftGroup);

      // Part References for Exploded View
      let propMesh: THREE.Object3D;
      let engineMesh: THREE.Object3D;
      let canopyMesh: THREE.Object3D;
      let leftWingMesh: THREE.Object3D;
      let rightWingMesh: THREE.Object3D;
      let tailMesh: THREE.Object3D;

      // Create Detailed Modular Aircraft Mesh
      function buildModularAirplane(): THREE.Group {
        const root = new THREE.Group();

        // Fuselage
        const fuseGeo = new THREE.ConeGeometry(0.55, 4.5, 32);
        const fuseMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.8, roughness: 0.2 });
        const fuselage = new THREE.Mesh(fuseGeo, fuseMat);
        fuselage.rotation.x = Math.PI / 2;
        root.add(fuselage);

        // Cockpit Canopy
        const canopyGeo = new THREE.SphereGeometry(0.38, 32, 32);
        const canopyMat = new THREE.MeshPhysicalMaterial({ color: 0x00f2fe, transmission: 0.85, opacity: 1, transparent: true, roughness: 0.1 });
        canopyMesh = new THREE.Mesh(canopyGeo, canopyMat);
        canopyMesh.scale.set(0.75, 0.45, 1.9);
        canopyMesh.position.set(0, 0.28, 0.2);
        root.add(canopyMesh);

        // Wings
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, 0);
        wingShape.lineTo(3.8, -1.2);
        wingShape.lineTo(3.4, -1.8);
        wingShape.lineTo(0, -1.2);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.06, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: 0.03, bevelThickness: 0.03 };
        const wingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
        const wingMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.6, roughness: 0.3 });

        leftWingMesh = new THREE.Mesh(wingGeo, wingMat);
        leftWingMesh.rotation.x = Math.PI / 2;
        leftWingMesh.position.set(0, 0, 0.5);
        root.add(leftWingMesh);

        rightWingMesh = leftWingMesh.clone();
        rightWingMesh.scale.x = -1;
        root.add(rightWingMesh);

        // Engine Cowl & Motor
        const motorGeo = new THREE.CylinderGeometry(0.4, 0.45, 0.8, 32);
        const motorMat = new THREE.MeshStandardMaterial({ color: 0xeab308, metalness: 0.9, roughness: 0.1 });
        engineMesh = new THREE.Mesh(motorGeo, motorMat);
        engineMesh.rotation.x = Math.PI / 2;
        engineMesh.position.set(0, 0, 1.7);
        root.add(engineMesh);

        // Propeller
        const propGroup = new THREE.Group();
        const bladeGeo = new THREE.BoxGeometry(1.4, 0.12, 0.03);
        const bladeMat = new THREE.MeshBasicMaterial({ color: 0x00f2fe });
        const blades = new THREE.Mesh(bladeGeo, bladeMat);
        propGroup.add(blades);

        const spinnerGeo = new THREE.ConeGeometry(0.22, 0.5, 16);
        const spinner = new THREE.Mesh(spinnerGeo, motorMat);
        spinner.rotation.x = Math.PI / 2;
        spinner.position.z = 0.2;
        propGroup.add(spinner);

        propGroup.position.set(0, 0, 2.2);
        propMesh = propGroup;
        root.add(propGroup);

        // Tail Assembly
        const tailGeo = new THREE.BoxGeometry(0.05, 1.1, 0.9);
        tailMesh = new THREE.Mesh(tailGeo, wingMat);
        tailMesh.position.set(0, 0.5, -1.7);
        tailMesh.rotation.x = -0.2;
        root.add(tailMesh);

        return root;
      }

      // Load GLB or build modular aircraft
      const loader = new GLTFLoader();
      loader.load('/airplane.glb', (gltf) => {
        const loadedModel = gltf.scene;
        const box = new THREE.Box3().setFromObject(loadedModel);
        const size = box.getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);
        const scale = 5.5 / maxDim;
        loadedModel.scale.set(scale, scale, scale);
        mainAircraftGroup.add(loadedModel);
      }, undefined, () => {
        const modularMesh = buildModularAirplane();
        mainAircraftGroup.add(modularMesh);
      });

      // Exploded View Mode State
      let isExploded = false;
      let isWireframe = false;

      document.getElementById('exploded-mode-btn')?.addEventListener('click', () => {
        isExploded = !isExploded;
        const status = document.getElementById('exploded-status');
        if (status) status.textContent = isExploded ? 'ON (DETACHED)' : 'OFF';

        // Animate part detachment in 3D space
        gsap.to(propMesh.position, { z: isExploded ? 3.8 : 2.2, duration: 0.8, ease: 'back.out(1.4)' });
        gsap.to(engineMesh.position, { z: isExploded ? 2.8 : 1.7, duration: 0.8, ease: 'back.out(1.4)' });
        gsap.to(canopyMesh.position, { y: isExploded ? 1.2 : 0.28, duration: 0.8, ease: 'back.out(1.4)' });
        gsap.to(leftWingMesh.position, { x: isExploded ? 1.5 : 0, duration: 0.8, ease: 'back.out(1.4)' });
        gsap.to(rightWingMesh.position, { x: isExploded ? -1.5 : 0, duration: 0.8, ease: 'back.out(1.4)' });
        gsap.to(tailMesh.position, { z: isExploded ? -2.8 : -1.7, duration: 0.8, ease: 'back.out(1.4)' });
      });

      document.getElementById('wireframe-mode-btn')?.addEventListener('click', () => {
        isWireframe = !isWireframe;
        const status = document.getElementById('wireframe-status');
        if (status) status.textContent = isWireframe ? 'ON' : 'OFF';

        mainAircraftGroup.traverse((child) => {
          if ((child as THREE.Mesh).isMesh) {
            ((child as THREE.Mesh).material as THREE.MeshStandardMaterial).wireframe = isWireframe;
          }
        });
      });

      // Update Part Info Card Display
      function updatePartCard(index: number) {
        const data = PARTS_DATA[index];
        const overlay = document.getElementById('part-info-overlay');
        const numEl = document.getElementById('info-part-num');
        const nameEl = document.getElementById('info-part-name');
        const descEl = document.getElementById('info-part-desc');
        const specsEl = document.getElementById('info-part-specs');

        if (index === 0) {
          overlay?.classList.add('hidden');
          return;
        }

        overlay?.classList.remove('hidden');
        if (numEl) numEl.textContent = data.num;
        if (nameEl) nameEl.textContent = data.name;
        if (descEl) descEl.textContent = data.desc;
        if (specsEl) {
          specsEl.innerHTML = data.specs.map(s => `
            <div class="p-spec"><span>${s.label}:</span><strong>${s.val}</strong></div>
          `).join('');
        }

        // Camera Fly-To Animation
        gsap.to(camera.position, {
          x: data.camPos.x,
          y: data.camPos.y,
          z: data.camPos.z,
          duration: 1.2,
          ease: 'power2.inOut'
        });

        gsap.to(mainAircraftGroup.rotation, {
          y: index * (Math.PI / 3),
          x: (index % 2 === 0) ? 0.2 : -0.1,
          duration: 1.2,
          ease: 'power2.inOut'
        });
      }

      // Nav Buttons Click Listener
      const compBtns = document.querySelectorAll('.comp-btn');
      compBtns.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          compBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          updatePartCard(idx);
        });
      });

      // GSAP ScrollTrigger Fly-Through Sequence
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.explorer-wrapper',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1,
          onUpdate: (self) => {
            const index = Math.min(5, Math.floor(self.progress * 6));
            compBtns.forEach((b, i) => b.classList.toggle('active', i === index));
            updatePartCard(index);
          }
        }
      });

      // Render Loop
      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        if (propMesh) propMesh.rotation.z = elapsedTime * 20;
        starfield.rotation.y = elapsedTime * 0.015;

        renderer.render(scene, camera);
      }
      animate();

      // Resize
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  </script>

  <style>
    :global(body.explorer-theme) {
      background-color: #070a14 !important;
      color: #f8fafc !important;
      overflow-x: hidden;
      font-family: var(--font-main);
    }

    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    #webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* HUD Elements */
    .glass-hud {
      background: rgba(11, 16, 30, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(234, 179, 8, 0.3);
      border-radius: 14px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    }

    .explorer-hud {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
    }

    .hud-top-bar {
      position: absolute;
      top: 5.5rem;
      left: 2rem;
      right: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1.5rem;
      pointer-events: auto;
    }

    .hud-title-group {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .pulsing-cyan-dot {
      width: 10px;
      height: 10px;
      background: #eab308;
      border-radius: 50%;
      box-shadow: 0 0 10px #eab308;
    }
    .hud-main-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: #eab308;
      letter-spacing: 0.12em;
    }

    .hud-mode-switches {
      display: flex;
      gap: 0.85rem;
    }
    .cyber-toggle-btn {
      background: rgba(234, 179, 8, 0.12);
      border: 1px solid rgba(234, 179, 8, 0.4);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      letter-spacing: 0.05em;
      transition: var(--transition-fast);
    }
    .cyber-toggle-btn:hover {
      background: rgba(234, 179, 8, 0.25);
    }
    .toggle-state { color: #eab308; }

    /* Part Info Overlay Card */
    .part-info-card {
      position: absolute;
      left: 2rem;
      top: 13rem;
      max-width: 380px;
      width: 100%;
      padding: 1.5rem;
      pointer-events: auto;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .part-info-card.hidden {
      opacity: 0;
      transform: translateY(20px);
      pointer-events: none;
    }

    .part-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 0.6rem;
      margin-bottom: 0.85rem;
    }
    .part-num {
      background: #eab308;
      color: #000000;
      font-weight: 900;
      font-size: 0.75rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
    }
    .part-name {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
    }
    .part-desc {
      font-size: 0.82rem;
      color: #94a3b8;
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    .part-specs {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .p-spec {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
    }
    .p-spec span { color: #64748b; }
    .p-spec strong { color: #eab308; }

    /* Component Nav Bar Right */
    .component-selector-nav {
      position: absolute;
      right: 2rem;
      top: 13rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.85rem;
      pointer-events: auto;
    }
    .comp-btn {
      text-align: left;
      font-size: 0.75rem;
      font-weight: 800;
      color: #94a3b8;
      padding: 0.5rem 0.85rem;
      border-radius: 6px;
      transition: var(--transition-fast);
    }
    .comp-btn span { color: #eab308; margin-right: 0.4rem; }
    .comp-btn:hover, .comp-btn.active {
      color: #ffffff;
      background: rgba(234, 179, 8, 0.15);
      border-left: 3px solid #eab308;
    }

    /* Scrollable Sections */
    .explorer-wrapper {
      position: relative;
      z-index: 2;
    }
    .explorer-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .intro-box {
      max-width: 680px;
      padding: 3rem 2.5rem;
      text-align: center;
    }
    .tech-tag {
      font-size: 0.75rem;
      font-weight: 800;
      color: #eab308;
