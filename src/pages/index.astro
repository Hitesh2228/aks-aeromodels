---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import TabbedProducts from '../components/TabbedProducts.astro';
import ComboDeals from '../components/ComboDeals.astro';
import ShopByNotes from '../components/ShopByNotes.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CustomerReviews from '../components/CustomerReviews.astro';

// Organization JSON-LD Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SKYNODESUAV",
  "url": "https://www.skynodesuav.in",
  "logo": "https://www.skynodesuav.in/favicon-512x512.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-9810154380",
    "contactType": "customer service",
    "areaServed": "IN",
    "availableLanguage": ["English", "Hindi"]
  }
};

// Edge CDN Cache Control (Instant Shopify live sync with short 30s edge revalidation)
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=60');
Astro.response.headers.set('X-Robots-Tag', 'all');

// LCP Hero Banner 0 Preload
const heroLcpImage = "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/eng-1-1.jpg?v=1791020055";
---

<BaseLayout schema={orgSchema} preloadImage={heroLcpImage} canonicalUrl="https://www.skynodesuav.in/">
  <main>
    <HeroCarousel />
    <CategoryGrid />
    <TabbedProducts />
    <ComboDeals />
    <ShopByNotes />
    <WhyChooseUs />
    <CustomerReviews />
  </main>
</BaseLayout>
