---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import TabbedProducts from '../components/TabbedProducts.astro';
import ComboDeals from '../components/ComboDeals.astro';
import ShopByNotes from '../components/ShopByNotes.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CustomerReviews from '../components/CustomerReviews.astro';

// Organization JSON-LD Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SKYNODESUAV",
  "url": "https://aks-aeromodels.vercel.app",
  "logo": "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-9810154380",
    "contactType": "customer service",
    "areaServed": "IN",
    "availableLanguage": ["English", "Hindi"]
  }
};

// Edge CDN Cache Control (TTFB < 50ms with stale-while-revalidate background refresh)
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

// LCP Hero Banner 0 Preload
const heroLcpImage = "https://cdn.shopify.com/s/files/1/1026/5726/1844/files/eng-1-1.jpg?v=1791020055";
---

<BaseLayout schema={orgSchema} preloadImage={heroLcpImage}>
  <main>
    <HeroCarousel />
    <CategoryGrid />
    <TabbedProducts />
    <ComboDeals />
    <ShopByNotes />
    <WhyChooseUs />
    <CustomerReviews />
  </main>
</BaseLayout>
