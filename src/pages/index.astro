---
import Header from '../components/Header.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import TabbedProducts from '../components/TabbedProducts.astro';
import ComboDeals from '../components/ComboDeals.astro';
import ShopByNotes from '../components/ShopByNotes.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Organization JSON-LD Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SKYNODESUAV",
  "url": "https://aks-aeromodels.vercel.app",
  "logo": "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=400",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-9810154380",
    "contactType": "customer service",
    "areaServed": "IN",
    "availableLanguage": ["English", "Hindi"]
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SKYNODESUAV | Premium RC Flight Systems & Aeromodels</title>
  <meta name="description" content="Shop genuine Futaba Radios, O.S. Engines, DLE Gas Engines, Seagull ARF Aeromodels, and Balsa Wood sheets." />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</head>
<body>
  
  <Header />
  
  <main>
    <HeroCarousel />
    <CategoryGrid />
    <TabbedProducts />
    <ComboDeals />
    <ShopByNotes />
    <WhyChooseUs />
    <CustomerReviews />
  </main>

  <CartDrawer />
  <Footer />

</body>
</html>
