---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleTagManagerHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Terms & Conditions | SKYNODES UAV</title>
</head>
<body class="bellavita-page-body">
  <GoogleTagManagerBody />
  <Header />
  <main class="container page-padding reveal-on-scroll">
    <div class="policy-box">
      <div class="policy-header-wrap">
        <span class="policy-tag">STATUTORY & COMMERCIAL AGREEMENT</span>
        <h1 class="policy-title">TERMS & CONDITIONS</h1>
        <p class="updated">Effective Date: October 2026 • Seller Billing Name: <strong>WAY POINT</strong> (Sky Nodes UAV)</p>
      </div>

      <div class="terms-lead-box">
        <p>
          Please read these Terms & Conditions carefully prior to order placement, quotation acceptance, or transaction confirmation. By placing an order with <strong>WAY POINT</strong> (operating online as <strong>SKYNODES UAV</strong>), the buyer accepts and agrees to be bound by the following statutory, logistical, and commercial terms:
        </p>
      </div>

      <div class="terms-numbered-list">
        <div class="term-card">
          <div class="term-badge">1</div>
          <div class="term-detail">
            <h2 class="term-title">Dispatch & Non-Returnable Policy</h2>
            <p>All goods once dispatched shall be treated as non-cancelable, non-refundable and non-returnable.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">2</div>
          <div class="term-detail">
            <h2 class="term-title">Defects, Transit Damage & Shortages Notice</h2>
            <p>Any claims regarding manufacturing defects, transit damage or shortages must be reported in writing within 5 days from the date of delivery, along with supporting evidence.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">3</div>
          <div class="term-detail">
            <h2 class="term-title">Carrier Handover & Logistics Responsibility</h2>
            <p>The seller's responsibility shall cease upon handing over the goods to the transporter or logistics provider. Thereafter, no claims for loss, damage, or shortage shall be entertained, except as stated above.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">4</div>
          <div class="term-detail">
            <h2 class="term-title">Buyer GST Number & Input Tax Credit (ITC)</h2>
            <p>The buyer is required to provide a valid and active GST number at the time of order placement. In case of non-availability or inactive GST details, the transaction shall be treated as B2C and no input tax credit shall be admissible.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">5</div>
          <div class="term-detail">
            <h2 class="term-title">Billing & Invoice Amendments</h2>
            <p>No amendments to GST or billing details shall be permitted after invoice generation.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">6</div>
          <div class="term-detail">
            <h2 class="term-title">Overdue Payment Interest</h2>
            <p>Interest at the rate of 12% (twelve percent) per annum shall be charged on all overdue amounts beyond the agreed payment terms.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">7</div>
          <div class="term-detail">
            <h2 class="term-title">Legal Jurisdiction</h2>
            <p>All disputes, if any, shall be subject to the jurisdiction in Nashik, Maharashtra.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">8</div>
          <div class="term-detail">
            <h2 class="term-title">Quotation Validity</h2>
            <p>This quotation is valid for a period of 15 days from the date of issue and shall lapse thereafter unless otherwise extended in writing.</p>
          </div>
        </div>

        <div class="term-card">
          <div class="term-badge">9</div>
          <div class="term-detail">
            <h2 class="term-title">Computer-Generated Authentication</h2>
            <p>This is a computer-generated document and does not require a physical signature.</p>
          </div>
        </div>
      </div>

      <div class="seller-details-card">
        <h3 class="seller-details-heading">Official Seller & Billing Information</h3>
        <div class="seller-info-grid">
          <div class="seller-info-item">
            <span class="s-label">Seller Billing Name:</span>
            <span class="s-val">WAY POINT</span>
          </div>
          <div class="seller-info-item">
            <span class="s-label">Brand / Platform:</span>
            <span class="s-val">Sky Nodes UAV</span>
          </div>
          <div class="seller-info-item">
            <span class="s-label">Seller GSTIN:</span>
            <span class="s-val">27ERZPS3567Q2Z5</span>
          </div>
          <div class="seller-info-item">
            <span class="s-label">Official Mobile:</span>
            <span class="s-val">+91 7722009120</span>
          </div>
          <div class="seller-info-item s-full">
            <span class="s-label">Registered Office & Logistics Hub:</span>
            <span class="s-val">Shop No. 104, Satish Complex, Howson Road, Deolali Camp, Nashik, Maharashtra – 422401</span>
          </div>
          <div class="seller-info-item">
            <span class="s-label">Support Email:</span>
            <span class="s-val">support@skynodesuav.in</span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }
    .page-padding { padding: 4rem 1.25rem 6rem; }
    .policy-box {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      padding: 3rem 2.5rem;
      border-radius: var(--radius-md, 8px);
      max-width: 900px;
      margin: 0 auto;
      line-height: 1.7;
      color: #333333;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }
    .policy-header-wrap {
      border-bottom: 2px solid #3b0811;
      padding-bottom: 1.25rem;
      margin-bottom: 2rem;
    }
    .policy-tag {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: #3b0811;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 0.4rem;
    }
    .policy-title {
      font-family: var(--font-display, serif);
      color: #3b0811;
      font-size: 2.25rem;
      font-weight: 800;
      margin: 0 0 0.4rem;
      letter-spacing: -0.01em;
    }
    .updated {
      font-size: 0.85rem;
      color: #6b7280;
      margin: 0;
      font-weight: 600;
    }
    .terms-lead-box {
      background: #faf7f2;
      border-left: 4px solid #3b0811;
      padding: 1rem 1.25rem;
      border-radius: 4px;
      margin-bottom: 2rem;
      font-size: 0.95rem;
      color: #4b5563;
    }
    .terms-numbered-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }
    .term-card {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      padding: 1.25rem 1.5rem;
      background: #fdfcf9;
      border: 1px solid #ede5da;
      border-radius: 8px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .term-card:hover {
      border-color: #3b0811;
      transform: translateY(-1px);
    }
    .term-badge {
      width: 32px;
      height: 32px;
      background: #3b0811;
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.9rem;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .term-detail {
      flex: 1;
    }
    .term-title {
      font-family: var(--font-display, serif);
      font-size: 1.05rem;
      font-weight: 700;
      color: #111827;
      margin: 0 0 0.35rem;
    }
    .term-detail p {
      font-size: 0.92rem;
      color: #4b5563;
      margin: 0;
      line-height: 1.6;
    }
    .seller-details-card {
      background: #faf7f2;
      border: 1px solid #e6ded1;
      border-radius: 8px;
      padding: 1.5rem 1.75rem;
      margin-top: 1.5rem;
    }
    .seller-details-heading {
      font-family: var(--font-display, serif);
      font-size: 1.1rem;
      font-weight: 800;
      color: #3b0811;
      margin: 0 0 1rem;
      border-bottom: 1px dashed #d9cebe;
      padding-bottom: 0.5rem;
    }
    .seller-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem 1.5rem;
      font-size: 0.88rem;
    }
    .seller-info-item {
      display: flex;
      flex-direction: column;
    }
    .s-full {
      grid-column: span 2;
    }
    .s-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .s-val {
      font-weight: 600;
      color: #111827;
    }
    @media (max-width: 640px) {
      .policy-box { padding: 1.75rem 1.25rem; }
      .term-card { flex-direction: column; gap: 0.75rem; padding: 1rem; }
      .seller-info-grid { grid-template-columns: 1fr; }
      .s-full { grid-column: span 1; }
    }
  </style>
</body>
</html>
