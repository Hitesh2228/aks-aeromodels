---
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pricing, Refund, Shipping & GST Policy | SKYNODESUAV</title>
</head>
<body class="bellavita-page-body">
  <Header />

      <section class="policy-section">
        <h2 class="policy-heading">3. Refund & Replacement Policy</h2>
        <p>Unopened items in original factory packaging can be returned within 7 days of delivery for a full refund or exchange. Defective engines or radio receivers are inspected by our technical team for immediate replacement.</p>
      </section>
    </div>
  </main>
  <CartDrawer />
  <Footer />

  <style>
    :global(body.bellavita-page-body) {
      background-color: #fbf9f5 !important;
      color: #1a1a1a !important;
    }
    .page-padding { padding: 4rem 1.25rem 6rem; }
    .policy-box {
      background: #ffffff;
      border: 1px solid #e6e0d5;
      padding: 3rem;
      border-radius: var(--radius-md);
      max-width: 900px;
      margin: 0 auto;
      line-height: 1.8;
      color: #333333;
    }
    .policy-title {
      font-family: var(--font-display);
      color: #3b0811;
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 0.3rem;
    }
    .updated { font-size: 0.85rem; color: #888888; margin-bottom: 2rem; font-weight: 600; }
    .policy-section { margin-bottom: 1.75rem; }
    .policy-heading {
      font-family: var(--font-display);
      color: #1a1a1a;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
      border-bottom: 1px solid #e6e0d5;
      padding-bottom: 0.4rem;
    }
    .policy-section p { font-size: 0.95rem; color: #555555; }
  </style>
</body>
</html>
