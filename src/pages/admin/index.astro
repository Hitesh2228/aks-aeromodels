    btnCloseOrderModal?.addEventListener('click', () => {
      if (orderDetailModal) orderDetailModal.style.display = 'none';
    });
    btnDismissOrderModal?.addEventListener('click', () => {
      if (orderDetailModal) orderDetailModal.style.display = 'none';
    });

    orderCatPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        orderCatPills.forEach(p => p.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentSelectedOrderFilter = target.getAttribute('data-order-cat') || 'all';
