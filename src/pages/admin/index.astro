      font-size: 0.78rem;
      font-weight: 700;
      color: #0f172a;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.35rem;
      transition: all 0.15s;
    }
    .btn-add-dynamic-row:hover { background: #e2e8f0; }

    /* Step Navigation */
    .tab-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--admin-border);
    }
    .btn-tab-nav-prev {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      color: #334155;
    }
    .btn-tab-nav-next {
      background: #0f172a;
      color: #ffffff;
      border: none;
      padding: 0.55rem 1.25rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
    }

    /* ---------------- STORE NAVIGATION MANAGER STYLES ---------------- */
    .nav-manager-wrapper {
      display: none;
      width: 100%;
    }
    .nav-manager-wrapper.active {
      display: block;
    }
    .nav-items-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .nav-item-edit-card {
      background: var(--admin-surface);
      border: 1.5px solid var(--admin-border);
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: var(--card-shadow);
      transition: border-color 0.15s;
    }
    .nav-item-edit-card:hover {
      border-color: #cbd5e1;
    }
    .nav-card-top-row {
      display: grid;
      grid-template-columns: 40px 1.2fr 1.5fr 140px 60px;
      gap: 0.85rem;
      align-items: center;
    }
    @media (max-width: 900px) {
      .nav-card-top-row { grid-template-columns: 1fr; }
    }
    .nav-index-badge {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: #f1f5f9;
      color: #475569;
      font-weight: 800;
      font-size: 0.82rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sub-items-box {
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      background: #f8fafc;
      border-radius: 8px;
      border: 1px dashed var(--admin-border);
    }
    .sub-item-row {
      display: grid;
      grid-template-columns: 1fr 1fr 40px;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.5rem;
    }
    .btn-del-nav-item {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #dc2626;
      border-radius: 8px;
      height: 38px;
      cursor: pointer;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Live Toast Notification */
    #admin-toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #0f172a;
      color: #ffffff;
      padding: 0.85rem 1.35rem;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
      font-weight: 700;
      font-size: 0.86rem;
      z-index: 200000;
      display: none;
      align-items: center;
      gap: 0.65rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      animation: slideInToast 0.2s ease-out;
    }
    @keyframes slideInToast {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    #admin-toast.success { background: #064e3b; border-color: #059669; }
    #admin-toast.error { background: #7f1d1d; border-color: #dc2626; }
  </style>
</head>
<body>

  <!-- 1. Secure Authentication Modal Gate -->
  <div id="auth-gate-modal">
    <div class="auth-card">
      <div class="auth-logo-badge">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <h2>SKYNODES Commander</h2>
      <p>Secure Enterprise Catalog & Navigation Portal (SKYNODES UAV)</p>

      <form id="admin-auth-form">
        <div class="auth-input-group">
          <label for="admin-passcode-input">Master Passcode</label>
          <input type="password" id="admin-passcode-input" class="auth-input" placeholder="Enter master passcode..." required autofocus />
        </div>
        <button type="submit" class="auth-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Unlock Studio Portal</span>
        </button>
        <div id="auth-error-msg" class="auth-error">Incorrect Passcode. Please try again.</div>
      </form>
    </div>
  </div>

  <!-- 2. Top Executive Header -->
  <header class="admin-header">
    <div class="admin-brand">
      <div class="admin-brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <h1>SKYNODES UAV <span>Commander Studio</span></h1>
      <span class="shopify-status-pill">Shopify Live Connected</span>
    </div>
    <div class="admin-top-actions">
      <a href="/" target="_blank" class="btn-top-view-site">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>View Live Store</span>
      </a>
      <button id="admin-logout-btn" class="btn-logout" style="display: inline-flex; align-items: center; gap: 0.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Sign Out</span>
      </button>
    </div>
  </header>

  <!-- 3. Primary Mode Switcher Subbar (5 Tabs: Products, Studio, Orders, Blogs, Navigation) -->
  <div class="admin-subbar">
    <div class="mode-tabs-segmented">
      <button class="mode-tab-btn active" id="tab-catalog-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span>Products Catalog</span>
      </button>
      <button class="mode-tab-btn" id="tab-create-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        <span>Product Studio</span>
      </button>
      <button class="mode-tab-btn" id="tab-orders-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Store Orders</span>
      </button>
      <button class="mode-tab-btn" id="tab-blogs-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10M6 14h6"/></svg>
        <span>Flight Blogs</span>
      </button>
      <button class="mode-tab-btn" id="tab-nav-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        <span>Store Navigation</span>
      </button>
    </div>
    <div class="subbar-meta">
      <span id="catalog-count-badge" class="catalog-count-pill">Loading catalog...</span>
    </div>
  </div>

  <main class="admin-container">

    <!-- ==================== VIEW 1: CATALOG OVERVIEW TABLE ==================== -->
    <div id="view-catalog" class="catalog-wrapper">
      
      <!-- Metrics Overview -->
      <div class="stats-row">
        <div class="stat-card-compact">
          <div class="stat-top-row">
            <span class="stat-label">Total Active Products</span>
            <div class="stat-icon-badge badge-crimson">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>
            </div>
          </div>
          <span class="stat-num" id="stat-total-prods">0</span>
          <div class="stat-subtext">Direct from Shopify Store</div>
        </div>
        <div class="stat-card-compact">
          <div class="stat-top-row">
            <span class="stat-label">Nitro / Gas Engines</span>
            <div class="stat-icon-badge badge-blue">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="m12 8 2 4h-4l2 4"/></svg>
            </div>
          </div>
          <span class="stat-num" id="stat-engines">0</span>
          <div class="stat-subtext">O.S. Max, DLE, Saito, NGH</div>
        </div>
        <div class="stat-card-compact">
          <div class="stat-top-row">
            <span class="stat-label">Seagull Airframes</span>
            <div class="stat-icon-badge badge-emerald">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
            </div>
          </div>
          <span class="stat-num" id="stat-airframes">0</span>
          <div class="stat-subtext">ARF Scale Aeromodels & Kits</div>
        </div>
        <div class="stat-card-compact">
          <div class="stat-top-row">
            <span class="stat-label">Balsa Wood Sheets</span>
            <div class="stat-icon-badge badge-amber">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
            </div>
          </div>
          <span class="stat-num" id="stat-balsa">0</span>
          <div class="stat-subtext">Contest grade 1mm - 15mm</div>
        </div>
        <div class="stat-card-compact">
          <div class="stat-top-row">
            <span class="stat-label">Radios & Accessories</span>
            <div class="stat-icon-badge badge-purple">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19.1"/></svg>
            </div>
          </div>
          <span class="stat-num" id="stat-radios-acc">0</span>
          <div class="stat-subtext">Futaba, Radiomaster, Servos</div>
        </div>
      </div>

      <!-- Quick Category Filter Pills -->
      <div class="catalog-filter-pills-bar" id="catalog-pills-bar">
        <button type="button" class="cat-pill-btn active" data-cat="all">All Products (<span id="pill-cnt-all">0</span>)</button>
        <button type="button" class="cat-pill-btn" data-cat="engine">Engines (<span id="pill-cnt-engine">0</span>)</button>
        <button type="button" class="cat-pill-btn" data-cat="aeromodels">Airframes (<span id="pill-cnt-aeromodels">0</span>)</button>
        <button type="button" class="cat-pill-btn" data-cat="balsa-wood">Balsa Wood (<span id="pill-cnt-balsa">0</span>)</button>
        <button type="button" class="cat-pill-btn" data-cat="radio-receiver">Radios & Acc (<span id="pill-cnt-radios">0</span>)</button>
        <button type="button" class="cat-pill-btn alert" data-cat="low-stock" style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Low Stock (<span id="pill-cnt-low">0</span>)</span>
        </button>
      </div>

      <!-- Search & Action Toolbar -->
      <div class="catalog-toolbar">
        <div class="toolbar-left">
          <div class="search-input-wrap">
            <span class="search-icon-svg" style="display: flex; align-items: center;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <input type="text" id="catalog-search-input" class="search-input-field" placeholder="Search products by title, vendor, or SKU..." />
          </div>
        </div>
        <button class="btn-create-prod-primary" id="btn-trigger-new-prod">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add New Product</span>
        </button>
      </div>

      <!-- Fixed Width Table Container -->
      <div class="table-container-card">
        <div class="table-scroll">
          <table class="compact-admin-table">
            <colgroup>
              <col style="width: 44%;" />
              <col style="width: 14%;" />
              <col style="width: 14%;" />
              <col style="width: 12%;" />
              <col style="width: 16%;" />
            </colgroup>
            <thead>
              <tr>
                <th>Product & Specifications</th>
                <th>Category</th>
                <th>Price</th>
                <th>Inventory</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody id="catalog-tbody">
              <tr>
                <td colspan="5" style="text-align: center; padding: 2.5rem; color: #64748b;">
                  Loading real-time catalog from Shopify Admin...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination Controls Bar -->
        <div class="catalog-pagination-bar" id="catalog-pagination-bar">
          <span class="pagination-info" id="pagination-info-text">Showing 1–10 of 44 products</span>
          <div class="pagination-controls">
            <button type="button" class="btn-page-nav" id="btn-page-prev">← Previous</button>
            <span class="page-current-pill" id="page-current-display">Page 1 of 5</span>
            <button type="button" class="btn-page-nav" id="btn-page-next">Next →</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== VIEW 2: PRODUCT STUDIO EDITOR ==================== -->
    <div id="view-editor" class="editor-wrapper">
      
      <!-- Sticky Action Bar -->
      <div class="studio-sticky-bar">
        <div class="studio-title-block">
          <button type="button" class="studio-back-btn" id="btn-back-to-catalog" title="Return to Catalog">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <div>
            <div class="studio-breadcrumbs">Products Studio / <span id="editor-action-subcrumb">New Product</span></div>
            <div class="studio-title-main" id="editor-action-title">Add New Product</div>
          </div>
        </div>
        <div class="studio-actions-block">
          <button type="button" class="btn-editor-cancel" id="btn-cancel-edit">Cancel</button>
          <button type="button" class="btn-editor-save-publish" id="btn-save-product-submit">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span>Save & Publish to Store</span>
          </button>
        </div>
      </div>

      <!-- 5-Section Segmented Tabs -->
      <div class="studio-section-tabs-bar">
        <button type="button" class="sub-section-tab-btn active" data-target="tab-panel-basics">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
          <span>1. Basics & Pricing</span>
        </button>
        <button type="button" class="sub-section-tab-btn" data-target="tab-panel-media">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span>2. Media & Video</span>
        </button>
        <button type="button" class="sub-section-tab-btn" data-target="tab-panel-highlights">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>3. Highlights & Badges</span>
        </button>
        <button type="button" class="sub-section-tab-btn" data-target="tab-panel-specs">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="21" y2="21"/><line x1="4" x2="20" y1="14" y2="14"/><line x1="4" x2="20" y1="7" y2="7"/></svg>
          <span>4. Specs & Materials</span>
        </button>
        <button type="button" class="sub-section-tab-btn" data-target="tab-panel-faqs">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>5. FAQs & Combo</span>
        </button>
      </div>

      <form id="product-editor-form">
        <input type="hidden" id="edit-product-id" value="" />

        <!-- ================= PANEL 1: BASICS & PRICING ================= -->
        <div id="tab-panel-basics" class="studio-tab-panel active">
          <div class="panel-grid-2-col">
            
            <!-- Left Card: Identification -->
            <div class="studio-card">
              <div class="studio-card-header">
                <span class="studio-card-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:5px;"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
                  Basic Information
                </span>
                <span class="pdp-location-pill">PDP Header</span>
              </div>
              
              <div class="form-item">
                <label for="f-title">Product Title / Name *</label>
                <input type="text" id="f-title" class="input-box" placeholder="e.g. O.S. Max 0.46 AX II Nitro Engine" required />
                <span class="field-note">Primary headline title displayed across the store and PDP.</span>
              </div>

              <div class="field-row-2">
                <div class="form-item">
                  <label for="f-category">Menu / Category *</label>
                  <select id="f-category" class="input-box" required>
                    <option value="engine">Engines & Powerplants</option>
                    <option value="aeromodels">Seagull Aeromodels</option>
                    <option value="radio-receiver">Radio & Receiver</option>
                    <option value="balsa-wood">Balsa Wood Sheets</option>
                    <option value="accessories">Flight Accessories</option>
                  </select>
                  <input type="text" id="f-custom-category-input" class="input-box" placeholder="Type new custom category name..." style="display: none; margin-top: 0.35rem;" />
                  <span class="field-note">Assigns this product to a main header menu / shop category.</span>
