        if (remainingCount > 0) {
          const allTitles = allItems.map((li: any) => `${li.quantity}x ${li.title}`).join(', ');
          itemsSummary += `<div class="order-more-items" title="${allTitles}">+${remainingCount} more item${remainingCount > 1 ? 's' : ''}</div>`;
        }

        if (!itemsSummary) {
          itemsSummary = '<span style="color:#94a3b8; font-size:0.75rem;">No items recorded</span>';
        }

        const phoneDisplay = o.customer?.phone ? `
          <div class="order-customer-contact">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; color:#64748b;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
