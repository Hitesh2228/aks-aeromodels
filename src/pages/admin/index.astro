    .studio-tab-panel.active {
      display: block;
      animation: fadeInTab 0.18s ease-out;
    }
    @keyframes fadeInTab {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Panel Card Layouts */
    .panel-grid-2-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
