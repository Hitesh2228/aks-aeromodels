          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="modal-blog-action-title">Create New Article</span>
        </div>
        <button type="button" class="admin-modal-close" id="btn-close-blog-modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="admin-modal-body">
        <input type="hidden" id="blog-edit-id" value="" />
        <input type="hidden" id="blog-edit-blog-id" value="" />

        <div class="form-item" style="margin-bottom: 1rem;">
          <label for="blog-f-title">Article Headline / Title *</label>
          <input type="text" id="blog-f-title" class="input-box" placeholder="e.g. Complete Guide: Break-in O.S. Max Nitro Engines" required />
        </div>

        <div class="field-row-2" style="margin-bottom: 1rem;">
          <div class="form-item">
            <label for="blog-f-author">Author / Pilot Officer</label>
            <input type="text" id="blog-f-author" class="input-box" placeholder="e.g. Captain R. Verma / SKYNODES Flight Team" />
          </div>
          <div class="form-item">
            <label for="blog-f-tags">Category & Tags (Comma separated)</label>
            <input type="text" id="blog-f-tags" class="input-box" placeholder="e.g. Engine Tuning, Maintenance, Nitro, Beginner" />
          </div>
        </div>

        <div class="form-item" style="margin-bottom: 1rem;">
          <label for="blog-f-image">Featured Cover Image URL</label>
          <input type="url" id="blog-f-image" class="input-box" placeholder="https://cdn.shopify.com/... or Unsplash image URL" />
          <div id="blog-image-preview" style="margin-top: 0.5rem; display: none;">
            <img id="blog-image-preview-img" src="" alt="Cover Preview" style="max-height: 120px; border-radius: 8px; border: 1px solid var(--admin-border); object-fit: cover;" />
          </div>
        </div>

        <div class="form-item" style="margin-bottom: 1rem;">
          <label for="blog-f-summary">Brief Excerpt / Summary</label>
          <textarea id="blog-f-summary" class="input-box" rows="2" placeholder="Short description shown on the blog index cards..."></textarea>
        </div>

        <div class="form-item" style="margin-bottom: 1rem;">
          <label for="blog-f-body">Full Article Content (HTML / Rich Format) *</label>
          <textarea id="blog-f-body" class="input-box" rows="10" placeholder="<p>Full article text here with <h2>, <p>, <ul>, <strong> tags...</p>" style="font-family: var(--font-mono); font-size: 0.82rem;"></textarea>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="blog-f-published" style="width: 16px; height: 16px; accent-color: #0f172a;" checked />
          <label for="blog-f-published" style="font-size: 0.82rem; font-weight: 700; cursor: pointer;">Publish Article Immediately to Live Storefront</label>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn-editor-tab-prev" id="btn-cancel-blog-modal">Cancel</button>
        <button type="button" class="btn-editor-save-publish" id="btn-save-blog-submit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Save Article to Shopify</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Live Notification Toast -->
  <div id="admin-toast"></div>

  <script>
    // Master Studio Passcodes
    const VALID_PASSCODE = 'skynodes@pilot2026';
    const ALT_PASSCODE = 'admin@skynodes';

    let allCatalogProducts: any[] = [];
    let currentFilteredProducts: any[] = [];
    let currentSelectedCategory: string = 'all';
    let currentPage: number = 1;
    const PAGE_SIZE: number = 500;

    let currentEditingProductId: string | null = null;
    let galleryUrlsList: string[] = [];

    // Navigation Menu State
    let storeNavItems: any[] = [];

    // Orders State
    let allOrders: any[] = [];
    let currentFilteredOrders: any[] = [];
    let currentSelectedOrderFilter: string = 'all';

    // Blogs State
    let allBlogs: any[] = [];
    let currentFilteredBlogs: any[] = [];
    let activeShopifyBlogId: string = '125699424532';
    let currentEditingBlogId: string | null = null;

    // DOM Elements
    const authModal = document.getElementById('auth-gate-modal');
    const authForm = document.getElementById('admin-auth-form');
    const authInput = document.getElementById('admin-passcode-input') as HTMLInputElement;
    const authError = document.getElementById('auth-error-msg');
    const logoutBtn = document.getElementById('admin-logout-btn');

    // Navigation Tabs
    const tabCatalogBtn = document.getElementById('tab-catalog-btn');
    const tabCreateBtn = document.getElementById('tab-create-btn');
    const tabNavBtn = document.getElementById('tab-nav-btn');
    const tabOrdersBtn = document.getElementById('tab-orders-btn');
    const tabBlogsBtn = document.getElementById('tab-blogs-btn');

    const viewCatalog = document.getElementById('view-catalog');
    const viewEditor = document.getElementById('view-editor');
    const viewNavigation = document.getElementById('view-navigation');
    const viewOrders = document.getElementById('view-orders');
    const viewBlogs = document.getElementById('view-blogs');

    // Orders DOM Elements
    const ordersTbody = document.getElementById('orders-tbody');
    const ordersSearchInput = document.getElementById('orders-search-input') as HTMLInputElement;
    const btnRefreshOrders = document.getElementById('btn-refresh-orders');
    const orderCatPills = document.querySelectorAll('[data-order-cat]');
    const orderDetailModal = document.getElementById('order-detail-modal');
    const orderModalContent = document.getElementById('order-modal-content');
    const modalOrderNumber = document.getElementById('modal-order-number');
    const btnCloseOrderModal = document.getElementById('btn-close-order-modal');
    const btnDismissOrderModal = document.getElementById('btn-dismiss-order-modal');

    // Blogs DOM Elements
    const blogsTbody = document.getElementById('blogs-tbody');
    const blogsSearchInput = document.getElementById('blogs-search-input') as HTMLInputElement;
    const btnRefreshBlogs = document.getElementById('btn-refresh-blogs');
    const btnTriggerNewBlog = document.getElementById('btn-trigger-new-blog');
    const blogEditorModal = document.getElementById('blog-editor-modal');
    const modalBlogActionTitle = document.getElementById('modal-blog-action-title');
    const btnCloseBlogModal = document.getElementById('btn-close-blog-modal');
    const btnCancelBlogModal = document.getElementById('btn-cancel-blog-modal');
    const btnSaveBlogSubmit = document.getElementById('btn-save-blog-submit') as HTMLButtonElement;
    const blogImageInput = document.getElementById('blog-f-image') as HTMLInputElement;
    const blogImagePreview = document.getElementById('blog-image-preview');
    const blogImagePreviewImg = document.getElementById('blog-image-preview-img') as HTMLImageElement;

    const btnBackToCatalog = document.getElementById('btn-back-to-catalog');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');

    // Editor Header Titles
    const editorActionTitle = document.getElementById('editor-action-title');
    const editorActionSubcrumb = document.getElementById('editor-action-subcrumb');
    const btnSaveProductSubmit = document.getElementById('btn-save-product-submit') as HTMLButtonElement;
    const btnSaveProductSubmitBottom = document.getElementById('btn-save-product-submit-bottom') as HTMLButtonElement;

    // Sub-Tabs
    const subSectionTabBtns = document.querySelectorAll('.sub-section-tab-btn');
    const studioTabPanels = document.querySelectorAll('.studio-tab-panel');

    // Catalog Table, Pills & Pagination
    const catalogTbody = document.getElementById('catalog-tbody');
    const searchInput = document.getElementById('catalog-search-input') as HTMLInputElement;
    const btnTriggerNewProd = document.getElementById('btn-trigger-new-prod');
    const catPillBtns = document.querySelectorAll('.cat-pill-btn');
    const btnPagePrev = document.getElementById('btn-page-prev') as HTMLButtonElement;
    const btnPageNext = document.getElementById('btn-page-next') as HTMLButtonElement;
    const paginationInfoText = document.getElementById('pagination-info-text');
    const pageCurrentDisplay = document.getElementById('page-current-display');

    // Editor Form & Containers
    const editorForm = document.getElementById('product-editor-form') as HTMLFormElement;
    const specsContainer = document.getElementById('specs-rows-container');
    const btnAddSpecRow = document.getElementById('btn-add-spec-row');
    const faqContainer = document.getElementById('faq-rows-container');
    const btnAddFaqRow = document.getElementById('btn-add-faq-row');
    const comboSelect = document.getElementById('f-combo') as HTMLSelectElement;

    // Media Elements
    const mainImgInput = document.getElementById('f-main-image') as HTMLInputElement;
    const mainPreviewFrame = document.getElementById('main-preview-frame');
    const galleryThumbnailsStrip = document.getElementById('gallery-thumbnails-strip');
    const galleryNewUrlInput = document.getElementById('gallery-new-url-input') as HTMLInputElement;
    const btnAddGalleryItem = document.getElementById('btn-add-gallery-item');
    const galleryRawInput = document.getElementById('f-gallery-images') as HTMLTextAreaElement;

    // Navigation Menu DOM Elements
    const navItemsCardsContainer = document.getElementById('nav-items-cards-container');
    const btnAddNavItem = document.getElementById('btn-add-nav-item');
    const btnAddNavItemBottom = document.getElementById('btn-add-nav-item-bottom');
    const btnSaveNavSubmit = document.getElementById('btn-save-nav-submit') as HTMLButtonElement;
    const btnSaveNavSubmitBottom = document.getElementById('btn-save-nav-submit-bottom') as HTMLButtonElement;

    // Toast Notification
    function showToast(msg: string, isError = false) {
      const toast = document.getElementById('admin-toast');
      if (!toast) return;
      const icon = isError 
        ? `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
        : `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      toast.innerHTML = `<span style="display:inline-flex; align-items:center;">${icon}</span><span>${msg}</span>`;
      toast.className = isError ? 'error' : 'success';
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }

    // 1. Auth Management
    function checkAuth() {
      const token = sessionStorage.getItem('skynodes_admin_token');
      if (token === 'pilot_authorized') {
        if (authModal) authModal.style.display = 'none';
        loadProductsFromShopify();
        loadNavigationFromShopify();
        loadOrdersFromShopify();
        loadBlogsFromShopify();
      } else {
        if (authModal) authModal.style.display = 'flex';
      }
    }

    authForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = authInput.value.trim();
      if (val === VALID_PASSCODE || val === ALT_PASSCODE) {
        sessionStorage.setItem('skynodes_admin_token', 'pilot_authorized');
        authModal!.style.display = 'none';
        if (authError) authError.style.display = 'none';
        showToast('Welcome to Commander Studio');
        loadProductsFromShopify();
        loadNavigationFromShopify();
        loadOrdersFromShopify();
        loadBlogsFromShopify();
      } else {
        if (authError) authError.style.display = 'block';
        authInput.value = '';
        authInput.focus();
      }
    });

    logoutBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('skynodes_admin_token');
      window.location.reload();
    });

    // 2. Main Mode Switching (5 Modes: Catalog, Editor, Navigation, Orders, Blogs)
    function switchMode(mode: 'catalog' | 'editor' | 'navigation' | 'orders' | 'blogs') {
      if (viewCatalog) viewCatalog.style.display = 'none';
      if (viewEditor) viewEditor.classList.remove('active');
      if (viewNavigation) viewNavigation.classList.remove('active');
      if (viewOrders) viewOrders.style.display = 'none';
      if (viewBlogs) viewBlogs.style.display = 'none';

      tabCatalogBtn?.classList.remove('active');
      tabCreateBtn?.classList.remove('active');
      tabNavBtn?.classList.remove('active');
      tabOrdersBtn?.classList.remove('active');
      tabBlogsBtn?.classList.remove('active');

      if (mode === 'catalog') {
        if (viewCatalog) viewCatalog.style.display = 'block';
        tabCatalogBtn?.classList.add('active');
      } else if (mode === 'editor') {
        viewEditor?.classList.add('active');
        tabCreateBtn?.classList.add('active');
      } else if (mode === 'navigation') {
        viewNavigation?.classList.add('active');
        tabNavBtn?.classList.add('active');
        renderNavigationEditor();
      } else if (mode === 'orders') {
        if (viewOrders) viewOrders.style.display = 'block';
        tabOrdersBtn?.classList.add('active');
        renderOrdersTable();
      } else if (mode === 'blogs') {
        if (viewBlogs) viewBlogs.style.display = 'block';
        tabBlogsBtn?.classList.add('active');
        renderBlogsTable();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    tabCatalogBtn?.addEventListener('click', () => switchMode('catalog'));
    btnBackToCatalog?.addEventListener('click', () => switchMode('catalog'));
    btnCancelEdit?.addEventListener('click', () => switchMode('catalog'));
    tabCreateBtn?.addEventListener('click', () => {
      resetEditorForm();
      switchMode('editor');
    });
    btnTriggerNewProd?.addEventListener('click', () => {
      resetEditorForm();
      switchMode('editor');
    });
    tabNavBtn?.addEventListener('click', () => switchMode('navigation'));
    tabOrdersBtn?.addEventListener('click', () => switchMode('orders'));
    tabBlogsBtn?.addEventListener('click', () => switchMode('blogs'));

    // 3. Sub-Tab Switching inside Editor
    function switchSubTab(targetId: string) {
      subSectionTabBtns.forEach(btn => {
        if (btn.getAttribute('data-target') === targetId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      studioTabPanels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    }

    subSectionTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLElement).getAttribute('data-target');
        if (target) switchSubTab(target);
      });
    });

    // Step Nav
    document.querySelectorAll('.btn-tab-nav-next').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const nextTarget = (e.currentTarget as HTMLElement).getAttribute('data-next');
        if (nextTarget) {
          switchSubTab(nextTarget);
          window.scrollTo({ top: 120, behavior: 'smooth' });
        }
      });
    });

    document.querySelectorAll('.btn-tab-nav-prev').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const prevTarget = (e.currentTarget as HTMLElement).getAttribute('data-prev');
        if (prevTarget) {
          switchSubTab(prevTarget);
          window.scrollTo({ top: 120, behavior: 'smooth' });
        }
      });
    });

    // 4. Load Products from Shopify
    async function loadProductsFromShopify() {
      if (!catalogTbody) return;
      try {
        catalogTbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 3rem; color: #64748b;">Loading real-time catalog from Shopify Admin...</td></tr>`;
        const res = await fetch('/api/admin/products');
        const data = await res.json();

        if (data.success && Array.isArray(data.products)) {
          allCatalogProducts = data.products;
          renderStatsAndPillCounts(allCatalogProducts);
          populateComboDropdown(allCatalogProducts);
          applyFilters();
        } else {
          catalogTbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2rem; color: #dc2626;">Failed to load products from Shopify: ${data.error || 'Server error'}</td></tr>`;
        }
      } catch (err: any) {
        catalogTbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2rem; color: #dc2626;">Error connecting to server: ${err.message}</td></tr>`;
      }
    }

    // Stats & Filter Pill Badges
    function renderStatsAndPillCounts(list: any[]) {
      const elTotal = document.getElementById('stat-total-prods');
      const elEng = document.getElementById('stat-engines');
      const elAir = document.getElementById('stat-airframes');
      const elBalsa = document.getElementById('stat-balsa');
      const elRad = document.getElementById('stat-radios-acc');
      const elBadge = document.getElementById('catalog-count-badge');

      const countEng = list.filter(p => p.category === 'engine').length;
      const countAir = list.filter(p => p.category === 'aeromodels').length;
      const countBalsa = list.filter(p => p.category === 'balsa-wood').length;
      const countRad = list.filter(p => p.category === 'radio-receiver' || p.category === 'accessories').length;
      const countLow = list.filter(p => {
        const s = typeof p.stock === 'number' ? p.stock : parseInt(p.stock || '0', 10);
        return !isNaN(s) && s <= 4;
      }).length;

      if (elTotal) elTotal.textContent = list.length.toString();
      if (elEng) elEng.textContent = countEng.toString();
      if (elAir) elAir.textContent = countAir.toString();
      if (elBalsa) elBalsa.textContent = countBalsa.toString();
      if (elRad) elRad.textContent = countRad.toString();
      if (elBadge) elBadge.textContent = `${list.length} Products Active in Store`;

      const pAll = document.getElementById('pill-cnt-all');
      const pEng = document.getElementById('pill-cnt-engine');
      const pAir = document.getElementById('pill-cnt-aeromodels');
      const pBal = document.getElementById('pill-cnt-balsa');
      const pRad = document.getElementById('pill-cnt-radios');
      const pLow = document.getElementById('pill-cnt-low');

      if (pAll) pAll.textContent = list.length.toString();
      if (pEng) pEng.textContent = countEng.toString();
      if (pAir) pAir.textContent = countAir.toString();
      if (pBal) pBal.textContent = countBalsa.toString();
      if (pRad) pRad.textContent = countRad.toString();
      if (pLow) pLow.textContent = countLow.toString();
    }

    // Populate Combo Dropdown
    function populateComboDropdown(list: any[]) {
      if (!comboSelect) return;
      const current = comboSelect.value;
      comboSelect.innerHTML = `<option value="">None (No paired combo)</option>` + list.map(p => 
        `<option value="${p.id}">${p.title} (₹${p.price.toLocaleString('en-IN')})</option>`
      ).join('');
      if (current) comboSelect.value = current;
    }

    // Filter Logic
    function applyFilters() {
      const query = (searchInput.value || '').toLowerCase().trim();
      const cat = currentSelectedCategory;

      currentFilteredProducts = allCatalogProducts.filter(p => {
        const matchesQuery = !query || p.title.toLowerCase().includes(query) || (p.sku && p.sku.toLowerCase().includes(query)) || (p.vendor && p.vendor.toLowerCase().includes(query));
        const s = typeof p.stock === 'number' ? p.stock : parseInt(p.stock || '0', 10);
        const actualStock = isNaN(s) ? 0 : s;
        if (cat === 'all') return matchesQuery;
        if (cat === 'low-stock') return matchesQuery && actualStock <= 4;
        return matchesQuery && (p.category === cat || (cat === 'radio-receiver' && p.category === 'accessories'));
      });

      currentPage = 1;
      renderPaginatedTable();
    }

    // Render 10 Items Per Page with FIXED Table Layout
    function renderPaginatedTable() {
      if (!catalogTbody) return;

      const total = currentFilteredProducts.length;
      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      const startIdx = (currentPage - 1) * PAGE_SIZE;
      const endIdx = Math.min(startIdx + PAGE_SIZE, total);
      const pageItems = currentFilteredProducts.slice(startIdx, endIdx);

      if (total === 0) {
        catalogTbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2.5rem; color: #64748b;">No products match your search or filter.</td></tr>`;
      } else {
        catalogTbody.innerHTML = pageItems.map(p => {
          const img = p.images?.[0] || 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?q=80&w=800';
          const rawStock = typeof p.stock === 'number' ? p.stock : parseInt(p.stock || '0', 10);
          const currentStock = isNaN(rawStock) ? 0 : rawStock;
          const isOutOfStock = currentStock <= 0;
          const isLowStock = currentStock > 0 && currentStock <= 4;
          const stockClass = isOutOfStock ? 'out' : (isLowStock ? 'low' : 'good');
          const stockLabel = isOutOfStock ? '0 (Out of Stock)' : (isLowStock ? `${currentStock} Units (Low)` : `${currentStock} Units`);
          const compareText = p.compareAtPrice > p.price ? `<span style="text-decoration: line-through; color: #94a3b8; font-size: 0.76rem; margin-left: 0.35rem;">₹${p.compareAtPrice.toLocaleString('en-IN')}</span>` : '';

          return `
            <tr>
              <td>
                <div class="prod-meta-cell">
                  <img src="${img}" class="prod-thumb-square" alt="${p.title}" />
                  <div class="prod-meta-texts">
                    <span class="prod-title-line" title="${p.title}">${p.title}</span>
                    <span class="prod-sub-line">SKU: ${p.sku || 'N/A'} • HSN: ${p.parsedDetails?.hsnCode || '95030020'}</span>
                  </div>
                </div>
              </td>
              <td>
                <span class="category-tag-pill">${(p.category || 'GENERAL').toUpperCase()}</span>
              </td>
              <td>
                <strong style="color: #0f172a;">₹${p.price.toLocaleString('en-IN')}.00</strong>
                ${compareText}
              </td>
              <td>
                <span class="stock-indicator-pill ${stockClass}">
                  ${stockLabel}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="action-buttons-inline">
                  <button class="btn-table-edit" data-id="${p.id}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    <span>Edit</span>
                  </button>
                  <a href="/product/${p.handle || p.id}" target="_blank" class="btn-table-view">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span>View</span>
                  </a>
                  <button class="btn-table-del" data-id="${p.id}" data-name="${p.title}" title="Delete Product">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      // Update Pagination UI
      if (paginationInfoText) {
        paginationInfoText.textContent = total > 0 ? `Showing all ${total} products in store catalog` : 'No products found';
      }
      if (pageCurrentDisplay) {
        pageCurrentDisplay.style.display = totalPages <= 1 ? 'none' : 'inline-block';
        pageCurrentDisplay.textContent = `Page ${currentPage} of ${totalPages}`;
      }
      if (btnPagePrev) {
        btnPagePrev.style.display = totalPages <= 1 ? 'none' : 'inline-block';
        btnPagePrev.disabled = currentPage <= 1;
      }
      if (btnPageNext) {
        btnPageNext.style.display = totalPages <= 1 ? 'none' : 'inline-block';
        btnPageNext.disabled = currentPage >= totalPages;
      }

      // Re-attach Edit & Delete Action Listeners
      catalogTbody.querySelectorAll('.btn-table-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) loadProductIntoEditor(id);
        });
      });

      catalogTbody.querySelectorAll('.btn-table-del').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const name = (e.currentTarget as HTMLElement).getAttribute('data-name');
          if (confirm(`Are you sure you want to permanently delete "${name}" from Shopify?`)) {
            try {
              const res = await fetch(`/api/admin/products?id=${id}`, { method: 'DELETE' });
              const resData = await res.json();
              if (resData.success) {
                showToast(`"${name}" removed from catalog.`);
                loadProductsFromShopify();
              } else {
                alert('Error deleting: ' + (resData.error || 'Server error'));
              }
            } catch (err: any) {
              alert('Delete error: ' + err.message);
            }
          }
        });
      });
    }

    // Pagination Listeners
    btnPagePrev?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPaginatedTable();
        window.scrollTo({ top: 180, behavior: 'smooth' });
      }
    });

    btnPageNext?.addEventListener('click', () => {
      const totalPages = Math.ceil(currentFilteredProducts.length / PAGE_SIZE);
      if (currentPage < totalPages) {
        currentPage++;
        renderPaginatedTable();
        window.scrollTo({ top: 180, behavior: 'smooth' });
      }
    });

    // Pill Filter Listeners
    catPillBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        catPillBtns.forEach(b => b.classList.remove('active'));
        const el = e.currentTarget as HTMLElement;
        el.classList.add('active');
        currentSelectedCategory = el.getAttribute('data-cat') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    // 5. Dynamic Rows (Specs & FAQs)
    function addSpecRow(key = '', val = '') {
      if (!specsContainer) return;
      const row = document.createElement('div');
      row.className = 'dynamic-row-item spec-item-row';
      row.innerHTML = `
        <input type="text" class="input-box spec-key-input" placeholder="Spec Name (e.g. Displacement / Power)" value="${key}" style="flex: 1;" />
        <input type="text" class="input-box spec-val-input" placeholder="Value (e.g. 7.45 cc / 1.65 hp)" value="${val}" style="flex: 1;" />
        <button type="button" class="btn-del-dynamic-row" title="Delete Spec Row" style="display:inline-flex; align-items:center; justify-content:center; width:34px; height:38px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      `;
      row.querySelector('.btn-del-dynamic-row')?.addEventListener('click', () => row.remove());
      specsContainer.appendChild(row);
    }

    function addFaqRow(q = '', a = '') {
      if (!faqContainer) return;
      const row = document.createElement('div');
      row.className = 'mini-sub-card faq-item-row';
      row.style.marginBottom = '0.75rem';
      row.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <span style="font-size:0.72rem; font-weight:800; color:#0f172a; text-transform:uppercase;">FAQ Question & Answer</span>
          <button type="button" class="btn-del-dynamic-row" style="padding:0.25rem 0.6rem; display:inline-flex; align-items:center; gap:0.25rem;" title="Delete FAQ">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            <span>Delete</span>
          </button>
        </div>
        <input type="text" class="input-box faq-q-input" placeholder="Question (e.g. What fuel is recommended?)" value="${q}" style="margin-bottom:0.4rem;" />
        <textarea class="input-box faq-a-input" placeholder="Answer..." style="min-height:60px;">${a}</textarea>
      `;
      row.querySelector('.btn-del-dynamic-row')?.addEventListener('click', () => row.remove());
      faqContainer.appendChild(row);
    }

    btnAddSpecRow?.addEventListener('click', () => addSpecRow());
    btnAddFaqRow?.addEventListener('click', () => addFaqRow());

    // 6. Media Management (Primary Image + Gallery Strip)
    function updatePrimaryPreview(url: string) {
      if (!mainPreviewFrame) return;
      if (url) {
        mainPreviewFrame.innerHTML = `<img src="${url}" alt="Primary Image" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\\'primary-preview-placeholder\\'><svg width=\\'22\\' height=\\'22\\' viewBox=\\'0 0 24 24\\' fill=\\'none\\' stroke=\\'currentColor\\' stroke-width=\\'2\\' stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\'><circle cx=\\'12\\' cy=\\'12\\' r=\\'10\\'/><line x1=\\'12\\' y1=\\'8\\' x2=\\'12\\' y2=\\'12\\'/><line x1=\\'12\\' y1=\\'16\\' x2=\\'12.01\\' y2=\\'16\\'/></svg><span>Invalid Image Link</span></div>';" />`;
      } else {
        mainPreviewFrame.innerHTML = `<div class="primary-preview-placeholder"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg><span>No Main Image Selected</span></div>`;
      }
    }

    mainImgInput?.addEventListener('input', () => {
      updatePrimaryPreview(mainImgInput.value.trim());
    });

    function renderGalleryStrip() {
      if (!galleryThumbnailsStrip) return;
      if (galleryUrlsList.length === 0) {
        galleryThumbnailsStrip.innerHTML = `<span style="font-size: 0.75rem; color: #94a3b8; font-style: italic;">No additional photos added yet.</span>`;
        if (galleryRawInput) galleryRawInput.value = '';
        return;
      }

      galleryThumbnailsStrip.innerHTML = galleryUrlsList.map((url, idx) => `
        <div class="gallery-thumb-item">
          <img src="${url}" alt="Gallery ${idx + 1}" onerror="this.style.opacity='0.3';" />
          <button type="button" class="gallery-thumb-del-btn" data-index="${idx}" title="Remove photo">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      `).join('');

      if (galleryRawInput) galleryRawInput.value = galleryUrlsList.join('\n');

      galleryThumbnailsStrip.querySelectorAll('.gallery-thumb-del-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '-1', 10);
          if (idx >= 0) {
            galleryUrlsList.splice(idx, 1);
            renderGalleryStrip();
          }
        });
      });
    }

    btnAddGalleryItem?.addEventListener('click', () => {
      const url = galleryNewUrlInput?.value.trim();
      if (!url) return;
      galleryUrlsList.push(url);
      galleryNewUrlInput.value = '';
      renderGalleryStrip();
    });

    galleryNewUrlInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        btnAddGalleryItem?.click();
      }
    });

    // 7. Reset Form
    function resetEditorForm() {
      currentEditingProductId = null;
      (document.getElementById('edit-product-id') as HTMLInputElement).value = '';
      if (editorActionTitle) editorActionTitle.textContent = 'Add New Product';
      if (editorActionSubcrumb) editorActionSubcrumb.textContent = 'New Product';
      editorForm?.reset();
      const stockInputEl = document.getElementById('f-stock') as HTMLInputElement;
      if (stockInputEl) stockInputEl.value = '0';

      galleryUrlsList = [];
      renderGalleryStrip();
      updatePrimaryPreview('');

      if (specsContainer) specsContainer.innerHTML = '';
      if (faqContainer) faqContainer.innerHTML = '';

      // Clean empty starter rows for the pilot to fill
      addSpecRow('', '');
      addFaqRow('', '');

      const subInput = document.getElementById('f-subcategory') as HTMLInputElement;
      if (subInput) subInput.value = '';
      const customCat = document.getElementById('f-custom-category-input') as HTMLInputElement;
      if (customCat) {
        customCat.value = '';
        customCat.style.display = 'none';
      }
      syncCategorySelectOptions('engine');

      switchSubTab('tab-panel-basics');
    }

    // 8. Load Existing Product into Editor
    function loadProductIntoEditor(productId: string) {
      const p = allCatalogProducts.find(item => String(item.id) === String(productId));
      if (!p) return;

      currentEditingProductId = p.id;
      (document.getElementById('edit-product-id') as HTMLInputElement).value = p.id;
      if (editorActionTitle) editorActionTitle.textContent = `Edit Product: ${p.title}`;
      if (editorActionSubcrumb) editorActionSubcrumb.textContent = p.title;

      // Basics
      (document.getElementById('f-title') as HTMLInputElement).value = p.title || '';
      syncCategorySelectOptions(p.category || 'engine');
      const d = p.parsedDetails || {};
      const subCatVal = d.subCategory || (p as any).subCategory || '';
      (document.getElementById('f-subcategory') as HTMLInputElement).value = subCatVal;
      handleCategoryChanged();
      const subSelect = document.getElementById('f-subcategory-select') as HTMLSelectElement;
      if (subSelect && subCatVal) {
        subSelect.value = subCatVal;
      }
      (document.getElementById('f-vendor') as HTMLInputElement).value = p.vendor || 'SKYNODES UAV';
      (document.getElementById('f-sku') as HTMLInputElement).value = p.sku || '';
      (document.getElementById('f-price') as HTMLInputElement).value = (p.price !== undefined ? p.price : 0).toString();
      (document.getElementById('f-compare-price') as HTMLInputElement).value = (p.compareAtPrice || '').toString();
      const stockNum = typeof p.stock === 'number' ? p.stock : parseInt(p.stock || '0', 10);
      (document.getElementById('f-stock') as HTMLInputElement).value = (!isNaN(stockNum) ? stockNum : 0).toString();
      (document.getElementById('f-desc') as HTMLTextAreaElement).value = p.description ? p.description.replace(/<[^>]*>/g, '') : '';

      (document.getElementById('f-gst') as HTMLSelectElement).value = (d.gstRate || 18).toString();
      (document.getElementById('f-hsn') as HTMLInputElement).value = d.hsnCode || '95030020';
      (document.getElementById('f-warranty') as HTMLInputElement).value = d.warrantyPeriod || '1-Year Official Warranty';

      // Badges
      (document.getElementById('f-badge') as HTMLInputElement).value = d.discountBadge || '';
      (document.getElementById('f-is-bestseller') as HTMLInputElement).checked = !!d.isBestseller;
      (document.getElementById('f-is-crazy') as HTMLInputElement).checked = !!d.isCrazyDeal;
      (document.getElementById('f-is-hero') as HTMLInputElement).checked = !!d.isHero;

      // Images
      const mainImg = p.images?.[0] || '';
      mainImgInput.value = mainImg;
      updatePrimaryPreview(mainImg);

      galleryUrlsList = (p.images || []).slice(1);
      renderGalleryStrip();

      // Trust Badges (Exact values, no forced overwrites)
      const trust = d.trustBadges || [];
      (document.getElementById('f-trust-1') as HTMLInputElement).value = trust[0] || '';
      (document.getElementById('f-trust-2') as HTMLInputElement).value = trust[1] || '';
      (document.getElementById('f-trust-3') as HTMLInputElement).value = trust[2] || '';
      (document.getElementById('f-trust-4') as HTMLInputElement).value = trust[3] || '';

      // Notes in set (Exact values, no forced overwrites)
      const notes = d.notesInSet || [];
      (document.getElementById('f-note-1-name') as HTMLInputElement).value = notes[0]?.name || '';
      (document.getElementById('f-note-1-desc') as HTMLInputElement).value = notes[0]?.desc || '';
      (document.getElementById('f-note-2-name') as HTMLInputElement).value = notes[1]?.name || '';
      (document.getElementById('f-note-2-desc') as HTMLInputElement).value = notes[1]?.desc || '';
      (document.getElementById('f-note-3-name') as HTMLInputElement).value = notes[2]?.name || '';
      (document.getElementById('f-note-3-desc') as HTMLInputElement).value = notes[2]?.desc || '';
      (document.getElementById('f-note-4-name') as HTMLInputElement).value = notes[3]?.name || '';
      (document.getElementById('f-note-4-desc') as HTMLInputElement).value = notes[3]?.desc || '';

      // Where to fly (Exact values, no forced overwrites)
      const fly = d.whereToFly || [];
      (document.getElementById('f-fly-1') as HTMLInputElement).value = fly[0] || '';
      (document.getElementById('f-fly-2') as HTMLInputElement).value = fly[1] || '';
      (document.getElementById('f-fly-3') as HTMLInputElement).value = fly[2] || '';
      (document.getElementById('f-fly-4') as HTMLInputElement).value = fly[3] || '';
      (document.getElementById('f-vibes') as HTMLInputElement).value = d.vibesText || '';

      // Specs (Exact keys and values)
      if (specsContainer) specsContainer.innerHTML = '';
      const specsObj = d.specs || {};
      const specEntries = Object.entries(specsObj);
      if (specEntries.length > 0) {
        for (const [k, v] of specEntries) {
          addSpecRow(k, String(v));
        }
      } else {
        addSpecRow('', '');
      }

      // Video & Details
      (document.getElementById('f-video') as HTMLInputElement).value = d.youtubeVideoId || '';
      (document.getElementById('f-material') as HTMLTextAreaElement).value = d.materialText || '';
      (document.getElementById('f-howtouse') as HTMLTextAreaElement).value = d.howToUseText || '';
      if (comboSelect) comboSelect.value = d.comboId || '';

      // FAQs (Exact questions and answers)
      if (faqContainer) faqContainer.innerHTML = '';
      const faqs = d.faqList || [];
      if (faqs.length > 0) {
        faqs.forEach((f: any) => addFaqRow(f.q, f.a));
      } else {
        addFaqRow('', '');
      }

      switchSubTab('tab-panel-basics');
      switchMode('editor');
    }

    // 9. Save Product to Shopify REST API
    async function handleSaveProduct() {
      const title = (document.getElementById('f-title') as HTMLInputElement)?.value.trim();
      const priceStr = (document.getElementById('f-price') as HTMLInputElement)?.value.trim();

      if (!title) {
        alert('Please enter a Product Title in Tab 1 (Basics & Pricing).');
        switchSubTab('tab-panel-basics');
        document.getElementById('f-title')?.focus();
        return;
      }
      if (!priceStr || isNaN(parseFloat(priceStr))) {
        alert('Please enter a valid Selling Price in Tab 1 (Basics & Pricing).');
        switchSubTab('tab-panel-basics');
        document.getElementById('f-price')?.focus();
        return;
      }

      const saveBtns = [btnSaveProductSubmit, btnSaveProductSubmitBottom].filter(Boolean);
      saveBtns.forEach(b => {
        b.disabled = true;
        b.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="spin-icon"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> <span>Syncing with Shopify...</span>`;
      });

      try {
        // Collect Images
        const mainImg = (document.getElementById('f-main-image') as HTMLInputElement)?.value.trim();
        const allImages = [mainImg, ...galleryUrlsList].filter(Boolean);

        // Collect Trust Badges
        const trustBadges = [
          (document.getElementById('f-trust-1') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-trust-2') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-trust-3') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-trust-4') as HTMLInputElement)?.value.trim()
        ].filter(Boolean);

        // Collect Notes in this set
        const notesInSet = [
          { name: (document.getElementById('f-note-1-name') as HTMLInputElement)?.value.trim(), desc: (document.getElementById('f-note-1-desc') as HTMLInputElement)?.value.trim() },
          { name: (document.getElementById('f-note-2-name') as HTMLInputElement)?.value.trim(), desc: (document.getElementById('f-note-2-desc') as HTMLInputElement)?.value.trim() },
          { name: (document.getElementById('f-note-3-name') as HTMLInputElement)?.value.trim(), desc: (document.getElementById('f-note-3-desc') as HTMLInputElement)?.value.trim() },
          { name: (document.getElementById('f-note-4-name') as HTMLInputElement)?.value.trim(), desc: (document.getElementById('f-note-4-desc') as HTMLInputElement)?.value.trim() }
        ].filter(n => n.name);

        // Collect Where to fly
        const whereToFly = [
          (document.getElementById('f-fly-1') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-fly-2') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-fly-3') as HTMLInputElement)?.value.trim(),
          (document.getElementById('f-fly-4') as HTMLInputElement)?.value.trim()
        ].filter(Boolean);

        // Collect Specs
        const specs: Record<string, string> = {};
        document.querySelectorAll('.spec-item-row').forEach(row => {
          const k = (row.querySelector('.spec-key-input') as HTMLInputElement)?.value.trim();
          const v = (row.querySelector('.spec-val-input') as HTMLInputElement)?.value.trim();
          if (k && v) specs[k] = v;
        });

        // Collect FAQs
        const faqList: Array<{ q: string; a: string }> = [];
        document.querySelectorAll('.faq-item-row').forEach(row => {
          const q = (row.querySelector('.faq-q-input') as HTMLInputElement)?.value.trim();
          const a = (row.querySelector('.faq-a-input') as HTMLTextAreaElement)?.value.trim();
          if (q && a) faqList.push({ q, a });
        });

        // Parse YouTube ID
        let ytVal = (document.getElementById('f-video') as HTMLInputElement)?.value.trim();
        if (ytVal.includes('v=')) ytVal = ytVal.split('v=')[1]?.split('&')[0];
        else if (ytVal.includes('youtu.be/')) ytVal = ytVal.split('youtu.be/')[1]?.split('?')[0];

        const catSelect = document.getElementById('f-category') as HTMLSelectElement;
        const customCatInput = document.getElementById('f-custom-category-input') as HTMLInputElement;
        const categoryVal = (catSelect?.value === '__custom__' && customCatInput?.value.trim())
          ? slugify(customCatInput.value)
          : (catSelect?.value || 'engine');
        const subCategoryVal = (document.getElementById('f-subcategory') as HTMLInputElement)?.value.trim() || undefined;

        const payload: any = {
          id: currentEditingProductId || undefined,
          title,
          category: categoryVal,
          subCategory: subCategoryVal,
          vendor: (document.getElementById('f-vendor') as HTMLInputElement)?.value.trim(),
          price: parseFloat(priceStr),
          compareAtPrice: parseFloat((document.getElementById('f-compare-price') as HTMLInputElement)?.value) || undefined,
          sku: (document.getElementById('f-sku') as HTMLInputElement)?.value.trim(),
          stock: !isNaN(parseInt((document.getElementById('f-stock') as HTMLInputElement)?.value, 10)) ? Math.max(0, parseInt((document.getElementById('f-stock') as HTMLInputElement)?.value, 10)) : 0,
          hsnCode: (document.getElementById('f-hsn') as HTMLInputElement)?.value.trim(),
          gstRate: parseInt((document.getElementById('f-gst') as HTMLSelectElement)?.value, 10) || 18,
          description: (document.getElementById('f-desc') as HTMLTextAreaElement)?.value.trim(),
          images: allImages,
          discountBadge: (document.getElementById('f-badge') as HTMLInputElement)?.value.trim(),
          isBestseller: (document.getElementById('f-is-bestseller') as HTMLInputElement)?.checked,
          isCrazyDeal: (document.getElementById('f-is-crazy') as HTMLInputElement)?.checked,
          isHero: (document.getElementById('f-is-hero') as HTMLInputElement)?.checked,
          trustBadges,
          notesInSet,
          whereToFly,
          vibesText: (document.getElementById('f-vibes') as HTMLInputElement)?.value.trim(),
          specs,
          youtubeVideoId: ytVal,
          faqList,
          materialText: (document.getElementById('f-material') as HTMLTextAreaElement)?.value.trim(),
          howToUseText: (document.getElementById('f-howtouse') as HTMLTextAreaElement)?.value.trim(),
          comboId: (document.getElementById('f-combo') as HTMLSelectElement)?.value,
          warrantyPeriod: (document.getElementById('f-warranty') as HTMLInputElement)?.value.trim()
        };

        const res = await fetch('/api/admin/save-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const resData = await res.json();
        if (resData.success) {
          showToast(currentEditingProductId ? 'Product updated and synced with Shopify' : 'New Product created and published live');
          await loadProductsFromShopify();
          switchMode('catalog');
        } else {
          alert('Shopify Error: ' + (JSON.stringify(resData.error) || 'Failed to save product'));
        }
      } catch (err: any) {
        alert('Network/System Error: ' + err.message);
      } finally {
        saveBtns.forEach(b => {
          b.disabled = false;
          b.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> <span>Save & Publish to Store</span>`;
        });
      }
    }

    btnSaveProductSubmit?.addEventListener('click', handleSaveProduct);
    btnSaveProductSubmitBottom?.addEventListener('click', handleSaveProduct);

    // ----------------------------------------------------
    // 10. STORE NAVIGATION MANAGER & CATEGORY SYNC
    // ----------------------------------------------------
    function slugify(text: string): string {
      return (text || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
    }

    function syncCategorySelectOptions(selectedVal = '') {
      const catSelect = document.getElementById('f-category') as HTMLSelectElement;
      if (!catSelect) return;

      const currentVal = selectedVal || catSelect.value || 'engine';
      const defaultCategories = [
        { id: 'engine', label: 'Engines & Powerplants' },
        { id: 'aeromodels', label: 'Seagull Aeromodels' },
        { id: 'radio-receiver', label: 'Radio & Receiver' },
        { id: 'balsa-wood', label: 'Balsa Wood Sheets' },
        { id: 'accessories', label: 'Flight Accessories' }
      ];

      let navGroupHtml = '';
      storeNavItems.forEach(item => {
        const lbl = (item.label || '').trim();
        const slug = slugify(lbl);
        if (slug && !['shop-all', 'crazy-deals', 'bestsellers'].includes(slug)) {
          navGroupHtml += `<option value="${slug}">Menu: ${lbl.toUpperCase()}</option>`;
        }
      });

      let html = '';
      if (navGroupHtml) {
        html += `<optgroup label="Storefront Navigation Menus (Live)">${navGroupHtml}</optgroup>`;
      }

      html += `<optgroup label="Standard Categories">`;
      defaultCategories.forEach(d => {
        html += `<option value="${d.id}">${d.label}</option>`;
      });
      html += `</optgroup>`;
      html += `<option value="__custom__">+ Add Custom Category...</option>`;

      catSelect.innerHTML = html;

      // Select existing value or insert as custom option if not present
      if (currentVal) {
        if (!catSelect.querySelector(`option[value="${currentVal}"]`)) {
          const opt = document.createElement('option');
          opt.value = currentVal;
          opt.textContent = `Category: ${currentVal.toUpperCase()}`;
          catSelect.appendChild(opt);
        }
        catSelect.value = currentVal;
      }

      handleCategoryChanged();
    }

    function handleCategoryChanged() {
      const catSelect = document.getElementById('f-category') as HTMLSelectElement;
      const customInput = document.getElementById('f-custom-category-input') as HTMLInputElement;
      const subSelect = document.getElementById('f-subcategory-select') as HTMLSelectElement;

      if (!catSelect) return;
      const val = catSelect.value;

      if (val === '__custom__') {
        if (customInput) {
          customInput.style.display = 'block';
          customInput.focus();
        }
      } else {
        if (customInput) customInput.style.display = 'none';
      }

      // Check if this category has subItems in storeNavItems
      const matchedNavItem = storeNavItems.find(item => {
        const slug = slugify(item.label);
        return slug === val || item.label.toLowerCase() === val.toLowerCase();
      });

      if (matchedNavItem && Array.isArray(matchedNavItem.subItems) && matchedNavItem.subItems.length > 0) {
        if (subSelect) {
          subSelect.style.display = 'block';
          subSelect.innerHTML = `<option value="">-- Quick Pick: Sub-Item from ${matchedNavItem.label} --</option>` +
            matchedNavItem.subItems.map((s: any) => `<option value="${s.label}">${s.label}</option>`).join('');
        }
      } else {
        if (subSelect) {
          subSelect.style.display = 'none';
        }
      }
    }

    document.getElementById('f-category')?.addEventListener('change', handleCategoryChanged);
    document.getElementById('f-subcategory-select')?.addEventListener('change', (e) => {
      const val = (e.currentTarget as HTMLSelectElement).value;
      const subInput = document.getElementById('f-subcategory') as HTMLInputElement;
      if (val && subInput) {
        subInput.value = val;
      }
    });

    async function loadNavigationFromShopify() {
      try {
        const res = await fetch('/api/admin/navigation');
        const data = await res.json();
        if (data.success && Array.isArray(data.navigation)) {
          // Normalize items and auto-resolve any bare /shop URLs on category menus
          storeNavItems = data.navigation.map((item: any) => {
            const lbl = (item.label || '').trim();
            const slug = slugify(lbl);
            let href = item.href || '/shop';
            if (href === '/shop' && slug && !['shop-all', 'crazy-deals', 'bestsellers'].includes(slug) && item.subItems && item.subItems.length > 0) {
              href = `/shop?category=${slug}`;
            }

            const subItems = Array.isArray(item.subItems) ? item.subItems.map((sub: any) => {
              let sHref = sub.href || '';
              if ((!sHref || sHref === '/shop') && sub.label) {
                sHref = `/shop?category=${slug}&search=${encodeURIComponent(sub.label)}`;
              }
              return { ...sub, href: sHref };
            }) : [];

            return {
              ...item,
              href,
              subItems
            };
          });

          if (viewNavigation?.classList.contains('active')) {
            renderNavigationEditor();
          }
          syncCategorySelectOptions();
        }
      } catch (err) {
        console.error('Failed to load navigation from Shopify:', err);
      }
    }

    function renderNavigationEditor() {
      if (!navItemsCardsContainer) return;
      if (storeNavItems.length === 0) {
        navItemsCardsContainer.innerHTML = `<div style="text-align: center; padding: 2rem; color: #64748b;">No navigation items configured yet. Click "+ Add Menu Item" to start.</div>`;
        return;
      }

      navItemsCardsContainer.innerHTML = storeNavItems.map((item, itemIdx) => {
        const subItemsList = Array.isArray(item.subItems) ? item.subItems : [];
        const isHighlight = !!item.highlight;
        const parentSlug = slugify(item.label) || 'all';

        // Detect current preset
        let preset = 'custom';
        const rawHref = (item.href || '').trim();
        if (rawHref === `/shop?category=${parentSlug}` || (rawHref.startsWith('/shop?category=') && !rawHref.includes('&'))) {
          preset = 'auto_cat';
        } else if (rawHref === '/shop' || rawHref === '/shop?category=all') {
          preset = '/shop';
        } else if (rawHref === '/shop?filter=crazy-deals') {
          preset = '/shop?filter=crazy-deals';
        } else if (rawHref === '/shop?filter=bestsellers') {
          preset = '/shop?filter=bestsellers';
        } else if (rawHref === '/blog') {
          preset = '/blog';
        } else if (rawHref === '/about') {
          preset = '/about';
        } else if (rawHref === '/contact') {
          preset = '/contact';
        }

        const subItemsHtml = subItemsList.map((sub: any, subIdx: number) => {
          let sHref = (sub.href || '').trim();
          if ((!sHref || sHref === '/shop') && sub.label) {
            sHref = `/shop?category=${parentSlug}&search=${encodeURIComponent(sub.label)}`;
          }

          return `
          <div class="sub-item-row" data-item-idx="${itemIdx}" data-sub-idx="${subIdx}">
            <div>
              <label style="font-size: 0.68rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.2rem;">Sub-Item Label *</label>
              <input type="text" class="input-box nav-sub-label-input" placeholder="e.g. RC AIRPLANE" value="${sub.label || ''}" />
            </div>
            <div>
              <label style="font-size: 0.68rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.2rem;">Target Link (Auto-Generated)</label>
              <div style="display: flex; gap: 0.35rem; align-items: center;">
                <input type="text" class="input-box nav-sub-href-input" placeholder="e.g. /shop?category=toy&search=RC+AIRPLANE" value="${sHref}" />
                <button type="button" class="btn-sub-auto-slug" data-item-idx="${itemIdx}" data-sub-idx="${subIdx}" title="Auto-Generate Link" style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.65rem; font-size: 0.72rem; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; cursor: pointer; white-space: nowrap;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  <span>Auto Link</span>
                </button>
              </div>
            </div>
            <div style="text-align: right; padding-top: 1rem;">
              <button type="button" class="btn-del-dynamic-row btn-del-sub-nav" data-item-idx="${itemIdx}" data-sub-idx="${subIdx}" title="Delete Sub-Item" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 38px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
            </div>
          </div>
          `;
        }).join('');

        return `
          <div class="nav-item-edit-card" data-item-idx="${itemIdx}">
            <div class="nav-card-top-row">
              <div class="nav-index-badge">#${itemIdx + 1}</div>
              <div>
                <label style="font-size: 0.72rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.2rem;">Menu Label *</label>
                <input type="text" class="input-box nav-label-input" placeholder="e.g. ENGINES or TOY" value="${item.label || ''}" />
              </div>
              <div>
                <label style="font-size: 0.72rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.2rem;">Page / Destination *</label>
                <select class="input-box nav-preset-select" data-item-idx="${itemIdx}">
                  <option value="auto_cat" ${preset === 'auto_cat' ? 'selected' : ''}>Shop Category (Auto: /shop?category=...)</option>
                  <option value="/shop" ${preset === '/shop' ? 'selected' : ''}>All Products Catalog (/shop)</option>
                  <option value="/shop?filter=crazy-deals" ${preset === '/shop?filter=crazy-deals' ? 'selected' : ''}>Crazy Deals Promotion (/shop?filter=crazy-deals)</option>
                  <option value="/shop?filter=bestsellers" ${preset === '/shop?filter=bestsellers' ? 'selected' : ''}>Best Sellers (/shop?filter=bestsellers)</option>
                  <option value="/blog" ${preset === '/blog' ? 'selected' : ''}>Flight Blog Articles (/blog)</option>
                  <option value="/about" ${preset === '/about' ? 'selected' : ''}>About Us (/about)</option>
                  <option value="/contact" ${preset === '/contact' ? 'selected' : ''}>Contact Us (/contact)</option>
                  <option value="custom" ${preset === 'custom' ? 'selected' : ''}>Custom URL / External Link</option>
                </select>
                <input type="text" class="input-box nav-href-input" placeholder="e.g. /shop?category=toy" value="${item.href || ''}" style="${preset === 'custom' ? 'margin-top: 0.35rem;' : 'display: none;'}" />
                <div class="nav-preview-wrap" style="font-size: 0.7rem; color: #64748b; margin-top: 0.25rem;">
                  <span>Link: </span><span class="nav-preview-text" style="color: #0f172a; font-weight: 700; font-family: monospace;">${item.href || '/shop'}</span>
                </div>
              </div>
              <div style="display: flex; align-items: center; justify-content: center; padding-top: 1rem;">
                <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.75rem; font-weight: 700; cursor: pointer;">
                  <input type="checkbox" class="nav-highlight-checkbox" ${isHighlight ? 'checked' : ''} style="width: 16px; height: 16px; accent-color: #881337;" />
                  <span>Highlight (Red)</span>
                </label>
              </div>
              <div style="padding-top: 1rem; text-align: right;">
                <button type="button" class="btn-del-nav-item btn-del-top-nav" data-item-idx="${itemIdx}" title="Delete Menu Item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                </button>
              </div>
            </div>

            <!-- Sub Items Accordion / Box -->
            <div class="sub-items-box">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
                <div>
                  <span style="font-size: 0.75rem; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: 0.04em;">
                    Dropdown Sub-Menu Links (${subItemsList.length} Items)
                  </span>
                  <span style="display: block; font-size: 0.68rem; color: #64748b; margin-top: 2px;">
                    Shown in header dropdown on hover. Products tagged with matching sub-category name appear here automatically.
                  </span>
                </div>
                <button type="button" class="btn-add-dynamic-row btn-add-sub-nav" data-item-idx="${itemIdx}" style="margin: 0; padding: 0.35rem 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                  <span>Add Sub-Item</span>
                </button>
              </div>

              <div class="sub-items-list-container" data-item-idx="${itemIdx}">
                ${subItemsHtml.length > 0 ? subItemsHtml : '<span style="font-size: 0.74rem; color: #94a3b8; font-style: italic;">No dropdown sub-items configured. Click "+ Add Sub-Item" to create dropdown menu.</span>'}
              </div>
            </div>
          </div>
        `;
      }).join('');

      attachNavigationListeners();
    }

    function attachNavigationListeners() {
      if (!navItemsCardsContainer) return;

      // 1. Top Level Label Input -> Auto-Update URL if preset is auto_cat
      navItemsCardsContainer.querySelectorAll('.nav-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const card = (e.currentTarget as HTMLElement).closest('.nav-item-edit-card');
          if (!card) return;
          const labelVal = (card.querySelector('.nav-label-input') as HTMLInputElement)?.value.trim() || '';
          const presetSelect = card.querySelector('.nav-preset-select') as HTMLSelectElement;
          const hrefInput = card.querySelector('.nav-href-input') as HTMLInputElement;
          const previewText = card.querySelector('.nav-preview-text');

          if (presetSelect && presetSelect.value === 'auto_cat') {
            const slug = slugify(labelVal) || 'all';
            const autoUrl = `/shop?category=${slug}`;
            if (hrefInput) hrefInput.value = autoUrl;
            if (previewText) previewText.textContent = autoUrl;

            // Also update any sub-items that follow auto pattern
            card.querySelectorAll('.sub-item-row').forEach(row => {
              const subLabel = (row.querySelector('.nav-sub-label-input') as HTMLInputElement)?.value.trim();
              const subHrefInput = row.querySelector('.nav-sub-href-input') as HTMLInputElement;
              if (subLabel && subHrefInput) {
                subHrefInput.value = `/shop?category=${slug}&search=${encodeURIComponent(subLabel)}`;
              }
            });
          }
        });
      });

      // 2. Preset Select Change
      navItemsCardsContainer.querySelectorAll('.nav-preset-select').forEach(select => {
        select.addEventListener('change', (e) => {
          const card = (e.currentTarget as HTMLElement).closest('.nav-item-edit-card');
          if (!card) return;
          const sel = e.currentTarget as HTMLSelectElement;
          const hrefInput = card.querySelector('.nav-href-input') as HTMLInputElement;
          const previewText = card.querySelector('.nav-preview-text');
          const labelVal = (card.querySelector('.nav-label-input') as HTMLInputElement)?.value.trim() || '';

          if (sel.value === 'auto_cat') {
            const slug = slugify(labelVal) || 'all';
            const autoUrl = `/shop?category=${slug}`;
            if (hrefInput) {
              hrefInput.value = autoUrl;
              hrefInput.style.display = 'none';
            }
            if (previewText) previewText.textContent = autoUrl;
          } else if (sel.value === 'custom') {
            if (hrefInput) {
              hrefInput.style.display = 'block';
              hrefInput.focus();
            }
          } else {
            if (hrefInput) {
              hrefInput.value = sel.value;
              hrefInput.style.display = 'none';
            }
            if (previewText) previewText.textContent = sel.value;
          }
        });
      });

      // 3. Custom Href Input Change
      navItemsCardsContainer.querySelectorAll('.nav-href-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const card = (e.currentTarget as HTMLElement).closest('.nav-item-edit-card');
          if (!card) return;
          const previewText = card.querySelector('.nav-preview-text');
          if (previewText) previewText.textContent = (e.currentTarget as HTMLInputElement).value.trim();
        });
      });

      // 4. Sub-Item Label Input -> Auto-generate URL
      navItemsCardsContainer.querySelectorAll('.nav-sub-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const row = (e.currentTarget as HTMLElement).closest('.sub-item-row');
          const card = (e.currentTarget as HTMLElement).closest('.nav-item-edit-card');
          if (!row || !card) return;

          const parentLabel = (card.querySelector('.nav-label-input') as HTMLInputElement)?.value.trim() || '';
          const parentSlug = slugify(parentLabel) || 'all';
          const subLabel = (e.currentTarget as HTMLInputElement).value.trim();
          const subHrefInput = row.querySelector('.nav-sub-href-input') as HTMLInputElement;

          if (subHrefInput && subLabel) {
            subHrefInput.value = `/shop?category=${parentSlug}&search=${encodeURIComponent(subLabel)}`;
          }
        });
      });

      // 5. Sub-Item Auto-Slug Button
      navItemsCardsContainer.querySelectorAll('.btn-sub-auto-slug').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const row = (e.currentTarget as HTMLElement).closest('.sub-item-row');
          const card = (e.currentTarget as HTMLElement).closest('.nav-item-edit-card');
          if (!row || !card) return;

          const parentLabel = (card.querySelector('.nav-label-input') as HTMLInputElement)?.value.trim() || '';
          const parentSlug = slugify(parentLabel) || 'all';
          const subLabel = (row.querySelector('.nav-sub-label-input') as HTMLInputElement)?.value.trim() || '';
          const subHrefInput = row.querySelector('.nav-sub-href-input') as HTMLInputElement;

          if (subHrefInput && subLabel) {
            subHrefInput.value = `/shop?category=${parentSlug}&search=${encodeURIComponent(subLabel)}`;
            showToast(`Generated link: ${subHrefInput.value}`);
          }
        });
      });

      // 6. Sub-Item Add
      navItemsCardsContainer.querySelectorAll('.btn-add-sub-nav').forEach(btn => {
        btn.addEventListener('click', (e) => {
          collectNavigationFromDOM();
          const itemIdx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-item-idx') || '-1', 10);
          if (itemIdx >= 0 && storeNavItems[itemIdx]) {
            if (!Array.isArray(storeNavItems[itemIdx].subItems)) storeNavItems[itemIdx].subItems = [];
            const parentSlug = slugify(storeNavItems[itemIdx].label) || 'all';
            storeNavItems[itemIdx].subItems.push({
              label: 'New Sub-Link',
              href: `/shop?category=${parentSlug}&search=New+Sub-Link`
            });
            renderNavigationEditor();
          }
        });
      });

      // 7. Sub-Item Delete
      navItemsCardsContainer.querySelectorAll('.btn-del-sub-nav').forEach(btn => {
        btn.addEventListener('click', (e) => {
          collectNavigationFromDOM();
          const itemIdx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-item-idx') || '-1', 10);
          const subIdx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-sub-idx') || '-1', 10);
          if (itemIdx >= 0 && subIdx >= 0 && storeNavItems[itemIdx]?.subItems) {
            storeNavItems[itemIdx].subItems.splice(subIdx, 1);
            renderNavigationEditor();
          }
        });
      });

      // 8. Top Item Delete
      navItemsCardsContainer.querySelectorAll('.btn-del-top-nav').forEach(btn => {
        btn.addEventListener('click', (e) => {
          collectNavigationFromDOM();
          const itemIdx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-item-idx') || '-1', 10);
          if (itemIdx >= 0 && confirm('Are you sure you want to remove this navigation menu item?')) {
            storeNavItems.splice(itemIdx, 1);
            renderNavigationEditor();
          }
        });
      });
    }

    function collectNavigationFromDOM() {
      if (!navItemsCardsContainer) return;
      const cards = navItemsCardsContainer.querySelectorAll('.nav-item-edit-card');
      const updatedList: any[] = [];

      cards.forEach((card, idx) => {
        const label = (card.querySelector('.nav-label-input') as HTMLInputElement)?.value.trim() || 'Menu';
        const presetSelect = card.querySelector('.nav-preset-select') as HTMLSelectElement;
        const hrefInput = card.querySelector('.nav-href-input') as HTMLInputElement;

        let href = hrefInput?.value.trim() || '/shop';
        if (presetSelect && presetSelect.value === 'auto_cat') {
          href = `/shop?category=${slugify(label) || 'all'}`;
        } else if (presetSelect && presetSelect.value !== 'custom') {
          href = presetSelect.value;
        }

        const highlight = (card.querySelector('.nav-highlight-checkbox') as HTMLInputElement)?.checked || false;

        const subRows = card.querySelectorAll('.sub-item-row');
        const subItems: any[] = [];
        subRows.forEach(row => {
          const sLabel = (row.querySelector('.nav-sub-label-input') as HTMLInputElement)?.value.trim();
          let sHref = (row.querySelector('.nav-sub-href-input') as HTMLInputElement)?.value.trim();
          if (sLabel) {
            if (!sHref || sHref === '/shop') {
              sHref = `/shop?category=${slugify(label) || 'all'}&search=${encodeURIComponent(sLabel)}`;
            }
            subItems.push({ label: sLabel, href: sHref });
          }
        });

        updatedList.push({
          label,
          href,
          highlight,
          ...(subItems.length > 0 ? { subItems } : {})
        });
      });

      storeNavItems = updatedList;
      syncCategorySelectOptions();
    }

    function addNewTopMenuItem() {
      collectNavigationFromDOM();
      storeNavItems.push({
        label: 'NEW MENU',
        href: '/shop?category=new-menu',
        highlight: false,
        subItems: []
      });
      renderNavigationEditor();
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    btnAddNavItem?.addEventListener('click', addNewTopMenuItem);
    btnAddNavItemBottom?.addEventListener('click', addNewTopMenuItem);

    async function handleSaveNavigation() {
      collectNavigationFromDOM();
      const saveNavBtns = [btnSaveNavSubmit, btnSaveNavSubmitBottom].filter(Boolean);
      saveNavBtns.forEach(b => {
        b.disabled = true;
        b.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="spin-icon"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> <span>Saving to Shopify...</span>`;
      });

      try {
        const res = await fetch('/api/admin/navigation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: storeNavItems })
        });
        const resData = await res.json();
        if (resData.success) {
          showToast('Navigation Menu saved and synced with live storefront');
        } else {
          alert('Error saving navigation: ' + (resData.error || 'Server error'));
        }
      } catch (err: any) {
        alert('Network Error: ' + err.message);
      } finally {
        saveNavBtns.forEach(b => {
          b.disabled = false;
          b.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> <span>Save Navigation to Store</span>`;
        });
      }
    }

    btnSaveNavSubmit?.addEventListener('click', handleSaveNavigation);
    btnSaveNavSubmitBottom?.addEventListener('click', handleSaveNavigation);

    // ==================== ORDERS MODULE LOGIC ====================
    async function loadOrdersFromShopify() {
      if (!ordersTbody) return;
      ordersTbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:3rem; color:#64748b;">Loading real-time orders from Shopify Admin...</td></tr>`;
      try {
        const res = await fetch('/api/admin/orders');
        const data = await res.json();
        if (data.success && Array.isArray(data.orders)) {
          allOrders = data.orders;
          updateOrdersMetrics(allOrders);
          applyOrdersFilters();
        } else {
          ordersTbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:2rem; color:#dc2626;">Failed to load orders: ${data.error || 'Unknown error'}</td></tr>`;
        }
      } catch (err: any) {
        ordersTbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:2rem; color:#dc2626;">Network error loading orders.</td></tr>`;
      }
    }

    function formatWhatsAppPhone(rawPhone: string): string {
      let digits = (rawPhone || '').replace(/\D/g, '');
      if (digits.length === 10) return '91' + digits;
      if (digits.length === 12 && digits.startsWith('91')) return digits;
      if (digits.length > 10 && digits.startsWith('0')) return '91' + digits.substring(1);
      if (digits.length > 0) return digits;
      return '';
    }

    function generateWhatsAppDispatchMsg(o: any): string {
      const name = o.customer?.name || 'Valued Pilot';
      const itemsList = (o.lineItems || []).map((li: any) => `• ${li.quantity}x ${li.title}`).join('\n');
      const city = o.shippingAddress?.city || o.shippingAddress?.province || '';
      const destText = city ? `${city}, India` : (o.shippingAddress?.address1 ? o.shippingAddress.address1 : 'Pilot Shipping Address');
      const finStatus = (o.financialStatus || 'Paid').toUpperCase();

      return `Dear ${name},

Greetings from SKYNODES UAV Flight Operations!

We are pleased to inform you that your order #${o.name} has been safely packed and dispatched from our flight facility.

Order Summary:
• Order ID: #${o.name}
${itemsList}
• Total Amount: ₹${Number(o.totalPrice).toLocaleString('en-IN')} (${finStatus})
• Destination: ${destText}

Your shipment is en route. If you require real-time tracking assistance or technical flight support, simply reply directly to this message.

Thank you for choosing SKYNODES UAV!
Official Store: https://skynodesuav.in`;
    }

    function openWhatsAppDispatch(orderId: string) {
      const o = allOrders.find(item => String(item.id) === String(orderId));
      if (!o) return;

      let phone = formatWhatsAppPhone(o.customer?.phone || '');
      if (!phone) {
        const input = prompt(`WhatsApp phone number for ${o.customer?.name || 'Pilot'} (${o.name}) not detected on file.\nPlease enter 10-digit mobile number:`, '');
        if (!input) return;
        phone = formatWhatsAppPhone(input);
      }

      if (!phone) {
        alert('Invalid phone number provided. Could not open WhatsApp.');
        return;
      }

      const msg = generateWhatsAppDispatchMsg(o);
      const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
      showToast(`WhatsApp dispatch chat opened for ${o.name}`);
    }

    async function handleToggleFulfillOrder(orderId: string, targetAction: 'fulfill' | 'unfulfill') {
      const order = allOrders.find(item => String(item.id) === String(orderId));
      if (!order) return;

      try {
        showToast(targetAction === 'fulfill' ? `Processing pack & dispatch for #${order.name}...` : `Reverting fulfillment for #${order.name}...`);
        const res = await fetch('/api/admin/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, action: targetAction })
        });
        const data = await res.json();
        if (data.success) {
          order.fulfillmentStatus = targetAction === 'fulfill' ? 'fulfilled' : 'unfulfilled';
          if (targetAction === 'fulfill') {
            if (!order.tags) order.tags = 'Fulfilled, Dispatched';
            else if (!order.tags.includes('Fulfilled')) order.tags += ', Fulfilled, Dispatched';
          } else {
            if (order.tags) {
              order.tags = order.tags.replace(/Fulfilled/gi, '').replace(/Dispatched/gi, '').trim();
            }
          }

          updateOrdersMetrics(allOrders);
          applyOrdersFilters();

          if (targetAction === 'fulfill') {
            showToast(`Order #${order.name} packed & dispatched successfully!`);
            // Update open modal if currently viewing this order
            if (orderDetailModal && orderDetailModal.style.display !== 'none') {
              openOrderDetailsModal(orderId);
            }
          } else {
            showToast(`Order #${order.name} marked as unfulfilled.`);
            if (orderDetailModal && orderDetailModal.style.display !== 'none') {
              openOrderDetailsModal(orderId);
            }
          }
        } else {
          alert('Failed to update order fulfillment: ' + (data.error || 'Server error'));
        }
      } catch (err: any) {
        alert('Network error updating fulfillment: ' + err.message);
      }
    }

    function updateOrdersMetrics(orders: any[]) {
      const elTotal = document.getElementById('stat-total-orders');
      const elRev = document.getElementById('stat-revenue-orders');
      const elB2B = document.getElementById('stat-b2b-orders');
      const elB2BRev = document.getElementById('stat-b2b-revenue');
      const elB2C = document.getElementById('stat-b2c-orders');
      const elB2CRev = document.getElementById('stat-b2c-revenue');
      const elUnfulfilled = document.getElementById('stat-unfulfilled-orders');
      const elFulfilled = document.getElementById('stat-fulfilled-orders');

      const totalCount = orders.length;
      const totalRev = orders.reduce((sum, o) => sum + (Number(o.totalPrice) || 0), 0);

      const b2bOrders = orders.filter(o => o.isB2B || (o.channel || '').toUpperCase() === 'B2B');
      const b2cOrders = orders.filter(o => !o.isB2B && (o.channel || '').toUpperCase() !== 'B2B');

      const b2bCount = b2bOrders.length;
      const b2bRev = b2bOrders.reduce((sum, o) => sum + (Number(o.totalPrice) || 0), 0);

      const b2cCount = b2cOrders.length;
      const b2cRev = b2cOrders.reduce((sum, o) => sum + (Number(o.totalPrice) || 0), 0);

      const paidCount = orders.filter(o => (o.financialStatus || '').toLowerCase() === 'paid').length;
      const pendingCount = orders.filter(o => (o.financialStatus || '').toLowerCase() === 'pending').length;
      const unfulfilledCount = orders.filter(o => (o.fulfillmentStatus || '').toLowerCase() !== 'fulfilled').length;
      const fulfilledCount = orders.filter(o => (o.fulfillmentStatus || '').toLowerCase() === 'fulfilled').length;

      if (elTotal) elTotal.textContent = totalCount.toString();
      if (elRev) elRev.textContent = `₹${totalRev.toLocaleString('en-IN')}`;
      if (elB2B) elB2B.textContent = b2bCount.toString();
      if (elB2BRev) elB2BRev.textContent = `₹${b2bRev.toLocaleString('en-IN')} • Corporate / GST`;
      if (elB2C) elB2C.textContent = b2cCount.toString();
      if (elB2CRev) elB2CRev.textContent = `₹${b2cRev.toLocaleString('en-IN')} • Individual Pilots`;
      if (elUnfulfilled) elUnfulfilled.textContent = unfulfilledCount.toString();
      if (elFulfilled) elFulfilled.textContent = fulfilledCount.toString();

      const pAll = document.getElementById('pill-cnt-orders-all');
      const pB2C = document.getElementById('pill-cnt-orders-b2c');
      const pB2B = document.getElementById('pill-cnt-orders-b2b');
      const pUnf = document.getElementById('pill-cnt-orders-unfulfilled');
      const pFul = document.getElementById('pill-cnt-orders-fulfilled');
      const pPaid = document.getElementById('pill-cnt-orders-paid');
      const pPending = document.getElementById('pill-cnt-orders-pending');

      if (pAll) pAll.textContent = totalCount.toString();
      if (pB2C) pB2C.textContent = b2cCount.toString();
      if (pB2B) pB2B.textContent = b2bCount.toString();
      if (pUnf) pUnf.textContent = unfulfilledCount.toString();
      if (pFul) pFul.textContent = fulfilledCount.toString();
      if (pPaid) pPaid.textContent = paidCount.toString();
      if (pPending) pPending.textContent = pendingCount.toString();
    }

    function applyOrdersFilters() {
      const query = (ordersSearchInput?.value || '').toLowerCase().trim();
      const filter = currentSelectedOrderFilter;

      currentFilteredOrders = allOrders.filter(o => {
        const matchesQuery = !query || 
          (o.name && o.name.toLowerCase().includes(query)) ||
          (o.customer?.name && o.customer.name.toLowerCase().includes(query)) ||
          (o.customer?.phone && o.customer.phone.toLowerCase().includes(query)) ||
          (o.customer?.email && o.customer.email.toLowerCase().includes(query)) ||
          (o.b2bInfo && o.b2bInfo.toLowerCase().includes(query)) ||
          (o.lineItems && o.lineItems.some((li: any) => li.title && li.title.toLowerCase().includes(query)));

        if (!matchesQuery) return false;
        if (filter === 'all') return true;
        if (filter === 'b2c') return !o.isB2B && (o.channel || '').toUpperCase() !== 'B2B';
        if (filter === 'b2b') return o.isB2B || (o.channel || '').toUpperCase() === 'B2B';
        if (filter === 'paid') return (o.financialStatus || '').toLowerCase() === 'paid';
        if (filter === 'pending') return (o.financialStatus || '').toLowerCase() === 'pending';
        if (filter === 'unfulfilled') return (o.fulfillmentStatus || '').toLowerCase() !== 'fulfilled';
        if (filter === 'fulfilled') return (o.fulfillmentStatus || '').toLowerCase() === 'fulfilled';
        return true;
      });

      renderOrdersTable();
    }

    function renderOrdersTable() {
      if (!ordersTbody) return;
      if (currentFilteredOrders.length === 0) {
        ordersTbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:3rem; color:#64748b;">No store orders match your search or filter.</td></tr>`;
        return;
      }

      ordersTbody.innerHTML = currentFilteredOrders.map(o => {
        const dateStr = o.createdAt ? new Date(o.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';
        const finStatus = (o.financialStatus || 'pending').toLowerCase();
        const isFulfilled = (o.fulfillmentStatus || '').toLowerCase() === 'fulfilled';
        const fulStatus = isFulfilled ? 'fulfilled' : 'unfulfilled';
        const isB2B = o.isB2B || (o.channel || '').toUpperCase() === 'B2B';

        const allItems = o.lineItems || [];
        const visibleItems = allItems.slice(0, 2);
        const remainingCount = allItems.length - 2;

        let itemsSummary = visibleItems.map((li: any) => `
          <div class="order-item-chip">
            <span class="order-item-qty">${li.quantity}x</span>
            <span class="order-item-title" title="${li.title}">${li.title}</span>
          </div>
