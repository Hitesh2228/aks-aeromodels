    // ==================== BLOGS MODULE LOGIC ====================
    async function loadBlogsFromShopify() {
      if (!blogsTbody) return;
      blogsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:3rem; color:#64748b;">Loading flight articles from Shopify...</td></tr>`;
      try {
        const res = await fetch('/api/admin/blogs');
        const data = await res.json();
        if (data.success && Array.isArray(data.articles)) {
          allBlogs = data.articles;
          if (data.blogId) activeShopifyBlogId = String(data.blogId);
          updateBlogsMetrics(allBlogs);
          applyBlogsFilters();
        } else {
          blogsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:2rem; color:#dc2626;">Failed to load articles: ${data.error || 'Unknown error'}</td></tr>`;
        }
      } catch (err: any) {
        blogsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:2rem; color:#dc2626;">Network error loading articles.</td></tr>`;
      }
    }

    let currentSelectedBlogFilter: string = 'all';

    function updateBlogsMetrics(articles: any[]) {
      const elTotal = document.getElementById('stat-total-articles');
      const elPub = document.getElementById('stat-published-articles');
      const elDraft = document.getElementById('stat-draft-articles');
      const elCatCount = document.getElementById('stat-categories-count');

      const total = articles.length;
      const published = articles.filter(a => a.isPublished).length;
      const drafts = total - published;

      const tagSet = new Set<string>();
      articles.forEach(a => {
        if (a.tags) {
          a.tags.split(',').forEach((t: string) => {
            const tr = t.trim();
            if (tr) tagSet.add(tr);
          });
        }
      });

      if (elTotal) elTotal.textContent = total.toString();
      if (elPub) elPub.textContent = published.toString();
      if (elDraft) elDraft.textContent = drafts.toString();
      if (elCatCount) elCatCount.textContent = tagSet.size.toString();

      const pAll = document.getElementById('pill-cnt-blogs-all');
      const pPub = document.getElementById('pill-cnt-blogs-pub');
      const pDraft = document.getElementById('pill-cnt-blogs-draft');
      if (pAll) pAll.textContent = total.toString();
      if (pPub) pPub.textContent = published.toString();
      if (pDraft) pDraft.textContent = drafts.toString();
    }

    function applyBlogsFilters() {
      const query = (blogsSearchInput?.value || '').toLowerCase().trim();
      const filter = currentSelectedBlogFilter;

      currentFilteredBlogs = allBlogs.filter(a => {
        const matchesQuery = !query || 
          (a.title && a.title.toLowerCase().includes(query)) ||
          (a.author && a.author.toLowerCase().includes(query)) ||
          (a.tags && a.tags.toLowerCase().includes(query));

        if (!matchesQuery) return false;
        if (filter === 'all') return true;
        if (filter === 'published') return !!a.isPublished;
        if (filter === 'draft') return !a.isPublished;
        return true;
      });

      renderBlogsTable();
    }

    function renderBlogsTable() {
      if (!blogsTbody) return;
      if (currentFilteredBlogs.length === 0) {
        blogsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:3rem; color:#64748b;">No flight articles match your search or filter.</td></tr>`;
        return;
      }

      blogsTbody.innerHTML = currentFilteredBlogs.map(a => {
        const img = a.image || 'https://cdn.shopify.com/s/files/1/1026/5726/1844/files/sea-1-1.jpg?v=1791020060';
        const dateStr = a.publishedAt ? new Date(a.publishedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Draft';
        
        const rawTags = (a.tags || 'Technical Guide').split(',').map((t: string) => t.trim()).filter(Boolean);
        let tagsHtml = '';
        if (rawTags.length <= 2) {
          tagsHtml = rawTags.map((t: string) => `<span class="blog-tag-pill">${t}</span>`).join('');
        } else {
          const visible = rawTags.slice(0, 2);
          const remaining = rawTags.length - 2;
          const fullList = rawTags.join(', ');
          tagsHtml = visible.map((t: string) => `<span class="blog-tag-pill">${t}</span>`).join('') +
                     `<span class="blog-tag-pill-more" title="${fullList}">+${remaining} more</span>`;
        }

        const authorInitials = (a.author || 'FT').split(' ').map((n: string) => n[0]).slice(0, 2).join('').toUpperCase();

        return `
          <tr>
            <td>
              <div class="prod-meta-cell">
                <img src="${img}" class="prod-thumb-square" alt="${a.title}" style="object-fit:cover;" />
                <div class="prod-meta-texts">
                  <span class="prod-title-line" title="${a.title}">${a.title}</span>
                  <span class="prod-sub-line">/blog/${a.handle || a.id}</span>
                </div>
              </div>
            </td>
            <td>
              <div class="blog-author-cell">
                <span class="blog-author-avatar">${authorInitials}</span>
                <span class="blog-author-name" title="${a.author || 'Flight Team'}">${a.author || 'Flight Team'}</span>
              </div>
            </td>
            <td>
              <div style="display: flex; flex-wrap: wrap; align-items: center;">${tagsHtml}</div>
            </td>
            <td>
              <span style="font-size:0.78rem; color:#64748b; font-weight:600;">${dateStr}</span>
            </td>
            <td>
              <span class="blog-status-pill ${a.isPublished ? 'published' : 'draft'}">${a.isPublished ? 'Published' : 'Draft'}</span>
            </td>
            <td style="text-align: right;">
              <div class="action-buttons-inline">
                <button class="btn-table-edit btn-blog-edit" data-id="${a.id}" title="Edit Article">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  <span>Edit</span>
                </button>
                <a href="/blog/${a.handle || a.id}" target="_blank" class="btn-table-view" title="View Article on Live Storefront">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>View</span>
                </a>
                <button class="btn-table-del btn-blog-del" data-id="${a.id}" data-title="${encodeURIComponent(a.title)}" title="Delete Article">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      document.querySelectorAll('.btn-blog-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) openBlogEditor(id);
        });
      });

      document.querySelectorAll('.btn-blog-del').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const title = decodeURIComponent((e.currentTarget as HTMLElement).getAttribute('data-title') || 'Article');
          if (!id) return;
          if (confirm(`Are you sure you want to delete the article "${title}"? This cannot be undone.`)) {
            await handleDeleteBlog(id, title);
          }
        });
      });
    }

    function openBlogEditor(articleId?: string) {
      if (!blogEditorModal) return;
      currentEditingBlogId = articleId || null;

      const titleInput = document.getElementById('blog-f-title') as HTMLInputElement;
      const authorInput = document.getElementById('blog-f-author') as HTMLInputElement;
      const tagsInput = document.getElementById('blog-f-tags') as HTMLInputElement;
      const imgInput = document.getElementById('blog-f-image') as HTMLInputElement;
      const summaryInput = document.getElementById('blog-f-summary') as HTMLTextAreaElement;
      const bodyInput = document.getElementById('blog-f-body') as HTMLTextAreaElement;
      const pubCheckbox = document.getElementById('blog-f-published') as HTMLInputElement;
      const editIdInput = document.getElementById('blog-edit-id') as HTMLInputElement;
      const editBlogIdInput = document.getElementById('blog-edit-blog-id') as HTMLInputElement;

      if (articleId) {
        const a = allBlogs.find(item => String(item.id) === String(articleId));
        if (a) {
          if (modalBlogActionTitle) modalBlogActionTitle.textContent = `Edit Article: ${a.title}`;
          editIdInput.value = a.id;
          editBlogIdInput.value = a.blogId || activeShopifyBlogId;
          titleInput.value = a.title || '';
          authorInput.value = a.author || '';
          tagsInput.value = a.tags || '';
          imgInput.value = a.image || '';
          summaryInput.value = a.summary || '';
          bodyInput.value = a.bodyHtml || '';
          pubCheckbox.checked = !!a.isPublished;

          if (a.image && blogImagePreview && blogImagePreviewImg) {
            blogImagePreviewImg.src = a.image;
            blogImagePreview.style.display = 'block';
          } else if (blogImagePreview) {
            blogImagePreview.style.display = 'none';
          }
        }
      } else {
        if (modalBlogActionTitle) modalBlogActionTitle.textContent = 'Create New Flight Article';
        editIdInput.value = '';
        editBlogIdInput.value = activeShopifyBlogId;
        titleInput.value = '';
        authorInput.value = 'SKYNODES UAV Technical Flight Team';
        tagsInput.value = 'Flight Journal, Technical Guide, Aeromodels';
        imgInput.value = '';
        summaryInput.value = '';
        bodyInput.value = '';
        pubCheckbox.checked = true;
        if (blogImagePreview) blogImagePreview.style.display = 'none';
      }

      blogEditorModal.style.display = 'flex';
    }

    blogImageInput?.addEventListener('input', () => {
      const url = blogImageInput.value.trim();
      if (url && blogImagePreview && blogImagePreviewImg) {
        blogImagePreviewImg.src = url;
        blogImagePreview.style.display = 'block';
      } else if (blogImagePreview) {
        blogImagePreview.style.display = 'none';
      }
    });

    btnTriggerNewBlog?.addEventListener('click', () => openBlogEditor());
    btnCloseBlogModal?.addEventListener('click', () => {
      if (blogEditorModal) blogEditorModal.style.display = 'none';
    });
    btnCancelBlogModal?.addEventListener('click', () => {
      if (blogEditorModal) blogEditorModal.style.display = 'none';
    });
    blogsSearchInput?.addEventListener('input', applyBlogsFilters);

    document.querySelectorAll('[data-blog-cat]').forEach(pill => {
      pill.addEventListener('click', (e) => {
        document.querySelectorAll('[data-blog-cat]').forEach(p => p.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentSelectedBlogFilter = target.getAttribute('data-blog-cat') || 'all';
        applyBlogsFilters();
      });
    });

    btnRefreshBlogs?.addEventListener('click', () => {
      showToast('Refreshing live flight articles from Shopify...');
      loadBlogsFromShopify();
    });

    async function handleSaveBlog() {
      const title = (document.getElementById('blog-f-title') as HTMLInputElement)?.value.trim();
      const bodyHtml = (document.getElementById('blog-f-body') as HTMLTextAreaElement)?.value.trim();
      const author = (document.getElementById('blog-f-author') as HTMLInputElement)?.value.trim();
      const tags = (document.getElementById('blog-f-tags') as HTMLInputElement)?.value.trim();
      const image = (document.getElementById('blog-f-image') as HTMLInputElement)?.value.trim();
      const summary = (document.getElementById('blog-f-summary') as HTMLTextAreaElement)?.value.trim();
      const published = (document.getElementById('blog-f-published') as HTMLInputElement)?.checked;
      const id = (document.getElementById('blog-edit-id') as HTMLInputElement)?.value;
      const blogId = (document.getElementById('blog-edit-blog-id') as HTMLInputElement)?.value || activeShopifyBlogId;

      if (!title) {
        alert('Please enter an Article Headline / Title.');
        document.getElementById('blog-f-title')?.focus();
        return;
      }

      if (!bodyHtml) {
        alert('Please enter Article Content.');
        document.getElementById('blog-f-body')?.focus();
        return;
      }

      const origText = btnSaveBlogSubmit.innerHTML;
      btnSaveBlogSubmit.disabled = true;
      btnSaveBlogSubmit.innerHTML = `<span class="spin-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></span><span>Saving to Shopify...</span>`;

      try {
        const res = await fetch('/api/admin/blogs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: id || undefined,
            blogId,
            title,
            author,
            tags,
            image,
            summary,
            bodyHtml,
            published
          })
        });

        const data = await res.json();
        if (data.success) {
          showToast(data.message || 'Article saved successfully in Shopify!');
          if (blogEditorModal) blogEditorModal.style.display = 'none';
          await loadBlogsFromShopify();
        } else {
          showToast(data.error || 'Failed to save article in Shopify', true);
        }
      } catch (err: any) {
        showToast('Network error saving article.', true);
      } finally {
        btnSaveBlogSubmit.disabled = false;
        btnSaveBlogSubmit.innerHTML = origText;
      }
    }

    btnSaveBlogSubmit?.addEventListener('click', handleSaveBlog);

    async function handleDeleteBlog(articleId: string, title: string) {
      try {
        const res = await fetch(`/api/admin/blogs?id=${articleId}&blogId=${activeShopifyBlogId}`, {
          method: 'DELETE'
        });
        const data = await res.json();
        if (data.success) {
          showToast(`Article "${title}" deleted from Shopify.`);
          await loadBlogsFromShopify();
        } else {
          showToast(data.error || 'Failed to delete article', true);
        }
      } catch (err: any) {
        showToast('Network error deleting article', true);
      }
    }

    // Initial Auth Check
    checkAuth();
  </script>
</body>
</html>
