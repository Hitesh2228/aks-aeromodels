      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }
    .admin-modal-close:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    .admin-modal-body {
      padding: 1.5rem 1.75rem;
      overflow-y: auto;
    }
    .admin-modal-footer {
      padding: 1rem 1.75rem;
      border-top: 1px solid var(--admin-border);
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      background: #f8fafc;
      border-radius: 0 0 16px 16px;
    }

