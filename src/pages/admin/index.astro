    .studio-title-block {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .studio-back-btn {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      width: 34px;
      height: 34px;
      border-radius: 8px;
