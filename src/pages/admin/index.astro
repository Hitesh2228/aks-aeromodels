               <span>Dispatched</span>
             </button>`
          : `<button class="btn-table-dispatch btn-order-toggle-fulfill" data-id="${o.id}" data-action="fulfill" title="Action Required: Pack items and mark dispatched">
               <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>
               <span>Pack & Dispatch</span>
             </button>`;

        const whatsappBtn = `<button class="btn-table-whatsapp btn-order-whatsapp" data-id="${o.id}" title="Send official dispatch notification to customer on WhatsApp">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>WhatsApp</span>
        </button>`;

        const detailsBtn = `<button class="btn-table-edit btn-order-view-dossier" data-id="${o.id}">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>Details</span>
        </button>`;

        return `
          <tr>
            <td>
              <div class="order-ref-title">${o.name}</div>
              <div class="order-date-text">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>${dateStr}</span>
              </div>
            </td>
            <td>
              <div class="order-customer-name">${o.customer?.name || 'Pilot (Guest)'}</div>
              ${phoneDisplay}
              <div style="margin-top: 2px;">${channelBadge}</div>
            </td>
            <td>
              <div>${itemsSummary}</div>
            </td>
            <td>
              <span class="order-status-pill ${finStatus === 'paid' ? 'paid' : 'pending'}">${finStatus}</span>
              <div style="font-size: 0.72rem; color: #64748b; margin-top: 0.25rem;">${o.paymentMethod || 'Online'}</div>
            </td>
            <td>
              <span class="order-status-pill ${fulStatus === 'fulfilled' ? 'fulfilled' : 'unfulfilled'}">${fulStatus}</span>
            </td>
            <td>
              <span class="order-price-val">₹${Number(o.totalPrice).toLocaleString('en-IN')}.00</span>
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <div style="display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.35rem;">
                ${dispatchBtn}
                ${whatsappBtn}
                ${detailsBtn}
              </div>
            </td>
          </tr>
        `;
      }).join('');

      document.querySelectorAll('.btn-order-view-dossier').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) openOrderDetailsModal(id);
        });
      });

      document.querySelectorAll('.btn-order-toggle-fulfill').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          const id = el.getAttribute('data-id');
          const action = (el.getAttribute('data-action') || 'fulfill') as 'fulfill' | 'unfulfill';
          if (id) handleToggleFulfillOrder(id, action);
        });
