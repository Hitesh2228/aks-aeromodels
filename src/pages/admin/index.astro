        ` : (o.customer?.email ? `<div class="order-customer-contact">${o.customer.email}</div>` : '');

        const channelBadge = isB2B
          ? `<span class="order-b2b-badge" title="${o.b2bInfo || 'Commercial Tax Invoice'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg> B2B Commercial</span>`
          : `<span class="order-b2c-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> B2C Retail</span>`;

        const dispatchBtn = isFulfilled
