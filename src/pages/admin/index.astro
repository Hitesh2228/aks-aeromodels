      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-bottom: 0.85rem;
    }
    .form-item label {
      font-size: 0.76rem;
      font-weight: 700;
      color: #334155;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .form-item .field-note {
      font-size: 0.7rem;
      color: var(--admin-text-muted);
      margin-top: -0.15rem;
    }
    .input-box {
      width: 100%;
      padding: 0.65rem 0.85rem;
      border: 1.5px solid var(--admin-border);
